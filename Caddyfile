# Used only by the optional `caddy` service in compose.yaml (commented out by
# default). SITE_ADDRESS and ACME_EMAIL come from the container environment.
# See README "HTTPS with Caddy (optional)".
{
	email {$ACME_EMAIL}
}

{$SITE_ADDRESS} {
	reverse_proxy aldevtoolbox:8080 {
		# /readyz is 503 until startup (migrations + seed) finishes, so Caddy
		# holds traffic off a half-initialised container. See .design/deployment.md.
		health_uri /readyz
		health_interval 10s
		# The probe would otherwise carry `Host: aldevtoolbox:8080`, which an
		# AllowedHosts set to the public domain refuses with 400 - and Caddy
		# then marks the only upstream down ("no upstreams available").
		health_headers {
			Host {$SITE_ADDRESS}
		}
	}
}
