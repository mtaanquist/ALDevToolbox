@page "/admin/administration/repositories"
@attribute [Authorize(Roles = "Admin")]
@rendermode InteractiveServer
@inject OrganizationConfigService Config
@inject GitHubConnectionService GitHub
@inject GitHubAppClient GitHubApi
@inject ILogger<AdminAdministrationRepositories> Log
@using ALDevToolbox.Services
@using ALDevToolbox.Services.GitHub
@using ALDevToolbox.Domain.ValueObjects

@*
    Per-organisation source-control settings. The admin picks which Git hosts the
    org's solutions may use; members store their own Personal Access Tokens under
    Account → Repository tokens. The solution-build pipeline clones each repo as the
    user who triggered the build, using that user's token. See .design/artifacts.md.

    The GitHub organisation connection lives here rather than on a tab of its own
    (a deliberate deviation from issue #620): this tab is already
    "per-organisation source-control settings", and an admin looking for "where do
    I connect our GitHub" looks under Repositories, not next to Teams and Export.
    See the deviation note in .design/github-integration.md.
*@

<PageTitle>Repositories · Administration · AL Dev Toolbox</PageTitle>

<AdministrationHeader ActiveTab="AdministrationHeader.Tab.Repositories">
    <Alerts>
        @if (!string.IsNullOrEmpty(_okMessage))
        {
            <p class="alert alert--success" role="status">
                <Icon Name="circle-check" Width="16" Height="16" /><span>@_okMessage</span>
            </p>
        }
        @if (!string.IsNullOrEmpty(_errMessage))
        {
            <p class="alert alert--danger" role="alert">
                <Icon Name="circle-alert" Width="16" Height="16" /><span>@_errMessage</span>
            </p>
        }
    </Alerts>
    <Body>
        @if (_loading)
        {
            <div class="loading-block"><span class="spinner"></span><span>Loading...</span></div>
        }
        else
        {
            <div class="setting-list">
                <SettingRow Name="Where your code lives">
                    <HintContent>
                        Pick at least one. Your team only sees these when adding a
                        repository or setting up access, so an organisation that uses
                        one host never has to think about the other.
                    </HintContent>
                    <ChildContent>
                        <div class="check-list">
                            <label class="check @(_saving ? "is-disabled" : "")">
                                <input type="checkbox" @bind="_allowGitHub" disabled="@_saving" />
                                <span class="check__box"><Icon Name="check" Width="12" Height="12" /></span>
                                <span>GitHub <span class="u-muted">· github.com</span></span>
                            </label>
                            <label class="check @(_saving ? "is-disabled" : "")">
                                <input type="checkbox" @bind="_allowAzureDevOps" disabled="@_saving" />
                                <span class="check__box"><Icon Name="check" Width="12" Height="12" /></span>
                                <span>Azure DevOps <span class="u-muted">· dev.azure.com</span></span>
                            </label>
                        </div>
                    </ChildContent>
                </SettingRow>

                @if (_github is { IsConnected: false })
                {
                    <SettingRow Name="Your GitHub organisation">
                        <HintContent>
                            Connect once, and your team can create repositories and save
                            work straight from the toolbox - without anyone sharing a
                            personal access token to do it. You will be sent to GitHub to
                            pick the organisation and confirm what the toolbox may do there.
                        </HintContent>
                        <ChildContent>
                            @if (!_github.DeploymentConfigured)
                            {
                                <p class="alert alert--info">
                                    <Icon Name="info" Width="16" Height="16" />
                                    <span>
                                        GitHub is not set up on this server yet. Ask whoever
                                        runs AL Dev Toolbox to add it, then come back here.
                                    </span>
                                </p>
                            }
                            else
                            {
                                <form method="post" action="/admin/github/connect">
                                    <AntiforgeryToken />
                                    <button type="submit" class="btn">
                                        <Icon Name="plug" Width="16" Height="16" />
                                        <span>Connect a GitHub organisation</span>
                                    </button>
                                </form>
                            }
                        </ChildContent>
                    </SettingRow>
                }
                else if (_github is { IsConnected: true })
                {
                    <SettingRow Name="Your GitHub organisation"
                                Hint="The GitHub organisation this toolbox organisation works with.">
                        <div class="u-stack">
                            <span class="u-row">
                                <Icon Name="folder-git-2" Width="16" Height="16" />
                                <a href="https://github.com/@_github.OrgLogin" target="_blank" rel="noopener">@_github.OrgLogin</a>
                                <span class="status-pill status-pill--success">Connected</span>
                            </span>
                            @if (_github.ConnectedAt is DateTime connectedAt)
                            {
                                <span class="u-muted">Connected @connectedAt.ToLocalTime().ToString("d MMMM yyyy")</span>
                            }
                        </div>
                    </SettingRow>

                    <SettingRow Name="What the toolbox may do there"
                                Hint="Chosen on GitHub when the app was installed. To change it, an owner of your GitHub organisation edits the app's access there.">
                        <div class="u-stack">
                            @if (_github.Permissions.Count == 0)
                            {
                                <span class="u-muted">GitHub did not report any permissions for this installation.</span>
                            }
                            else
                            {
                                @foreach (var permission in _github.Permissions)
                                {
                                    <span class="u-row">
                                        <Icon Name="check" Width="14" Height="14" />
                                        <span>@GitHubPermissionLabels.Describe(permission.Key, permission.Value)</span>
                                    </span>
                                }
                            }
                            @if (!_github.CanCreateRepositories)
                            {
                                <p class="alert alert--warn">
                                    <Icon Name="triangle-alert" Width="16" Height="16" />
                                    <span>
                                        Creating repositories from the toolbox will not work.
                                        An owner of your GitHub organisation needs to give the
                                        app permission to create new repositories, and approve
                                        the change - then disconnect and connect again here.
                                    </span>
                                </p>
                            }
                        </div>
                    </SettingRow>

                    <SettingRow Name="Check the connection"
                                Hint="Asks GitHub whether the toolbox can still act for your organisation. Nothing is changed.">
                        <div class="u-stack">
                            @* The button sits in a u-row so it keeps its own width:
                               a bare button as a flex child of u-stack stretches to
                               the full control column and reads as a text field. *@
                            <div class="u-row">
                                <button type="button" class="btn" @onclick="TestAsync" disabled="@_testing">
                                    <Icon Name="refresh-cw" Width="16" Height="16" />
                                    <span>@(_testing ? "Checking..." : "Check connection")</span>
                                </button>
                            </div>
                            @if (!string.IsNullOrEmpty(_testMessage))
                            {
                                <p class="alert @(_testOk ? "alert--success" : "alert--danger")" role="status">
                                    <Icon Name="@(_testOk ? "circle-check" : "circle-alert")" Width="16" Height="16" />
                                    <span>@_testMessage</span>
                                </p>
                            }
                        </div>
                    </SettingRow>

                    <SettingRow Name="Disconnect from GitHub" Danger="true"
                                Lock="Asks for confirmation and is written to the audit log"
                                Hint="The toolbox stops using GitHub for this organisation. Nothing on GitHub is deleted - the app stays installed until an owner of your GitHub organisation removes it there.">
                        <div class="u-row">
                            <button type="button" class="btn btn--danger" @onclick="DisconnectAsync" disabled="@_disconnecting">
                                <Icon Name="circle-minus" Width="16" Height="16" />
                                <span>@(_disconnecting ? "Disconnecting..." : "Disconnect")</span>
                            </button>
                        </div>
                    </SettingRow>
                }
            </div>
        }
    </Body>
    <Foot>
        @if (!_loading)
        {
            <button type="button" class="btn btn--primary" @onclick="SaveAsync" disabled="@_saving">
                <Icon Name="save" Width="16" Height="16" />
                <span>@(_saving ? "Saving..." : "Save changes")</span>
            </button>
        }
    </Foot>
    <Aside>
        <p class="alert alert--info">
            <Icon Name="info" Width="16" Height="16" />
            <span>
                Everyone signs in to the host themselves under
                <a href="/account?section=repos">Account &#8594; Repository tokens</a>.
                A build runs as whoever started it, so it only reaches what that
                person can reach.
            </span>
        </p>
    </Aside>
</AdministrationHeader>

<ConfirmDialog @ref="_confirmDisconnect"
               Title="Disconnect from GitHub?"
               Message="Your team will not be able to create repositories or save work to GitHub from the toolbox until you connect again. Nothing on GitHub is deleted."
               ConfirmLabel="Disconnect"
               ConfirmButtonClass="btn--danger" ConfirmIcon="circle-minus" />

@code {
    [SupplyParameterFromQuery(Name = "ok")] public string? Ok { get; set; }
    [SupplyParameterFromQuery(Name = "msg")] public string? Msg { get; set; }

    private bool _loading = true;
    private bool _saving;
    private bool _testing;
    private bool _disconnecting;
    private bool _testOk;
    private string? _okMessage;
    private string? _errMessage;
    private string? _testMessage;

    private bool _allowGitHub;
    private bool _allowAzureDevOps;

    private GitHubConnectionStatus? _github;
    private ConfirmDialog? _confirmDisconnect;

    protected override async Task OnInitializedAsync()
    {
        // The install handshake leaves the app and comes back through
        // /github/setup, so its outcome arrives as a query string rather than
        // through this circuit.
        if (Ok == "github-connected")
        {
            _okMessage = "Connected. Your team can now work with this GitHub organisation from the toolbox.";
        }
        _errMessage = string.IsNullOrWhiteSpace(Msg) ? null : Msg;

        await ReloadAsync();
        _loading = false;
    }

    private async Task ReloadAsync()
    {
        var allowed = await Config.GetAllowedProvidersAsync();
        _allowGitHub = allowed.Contains(RepositoryProvider.GitHub);
        _allowAzureDevOps = allowed.Contains(RepositoryProvider.AzureDevOps);
        _github = await GitHub.GetStatusAsync();
    }

    private async Task SaveAsync()
    {
        if (_saving) return;
        _saving = true;
        _okMessage = _errMessage = null;
        try
        {
            var providers = new List<RepositoryProvider>();
            if (_allowGitHub) providers.Add(RepositoryProvider.GitHub);
            if (_allowAzureDevOps) providers.Add(RepositoryProvider.AzureDevOps);

            await Config.SaveAllowedProvidersAsync(providers);
            await ReloadAsync();
            _okMessage = "Saved. Your team can now add repositories from the hosts you ticked.";
        }
        catch (PlanValidationException ex)
        {
            _errMessage = ex.Errors.FirstOrDefault().Value ?? "That did not save. Check the values and try again.";
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "Failed to save allowed repository providers.");
            _errMessage = "An unexpected error occurred. The change was not saved.";
        }
        finally
        {
            _saving = false;
        }
    }

    /// <summary>
    /// Proves the connection end to end by asking GitHub for a fresh access
    /// token for this installation - the same credential every GitHub feature
    /// uses, so a green result here means those features will work.
    /// </summary>
    private async Task TestAsync()
    {
        if (_testing || _github?.InstallationId is not long installationId) return;
        _testing = true;
        _testMessage = null;
        try
        {
            await GitHubApi.GetInstallationTokenAsync(installationId);
            _testOk = true;
            _testMessage = $"All good. The toolbox can act for {_github.OrgLogin} on GitHub.";
        }
        catch (GitHubAppNotConfiguredException)
        {
            _testOk = false;
            _testMessage = "GitHub is not set up on this server any more. Ask whoever runs AL Dev Toolbox to check it.";
        }
        catch (GitHubApiException ex)
        {
            _testOk = false;
            _testMessage = $"GitHub refused: {ex.Message}";
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "GitHub connection check failed for installation {InstallationId}.", installationId);
            _testOk = false;
            _testMessage = "Could not reach GitHub. Try again in a moment.";
        }
        finally
        {
            _testing = false;
        }
    }

    private async Task DisconnectAsync()
    {
        if (_disconnecting || _confirmDisconnect is null) return;
        if (!await _confirmDisconnect.OpenAsync()) return;

        _disconnecting = true;
        _okMessage = _errMessage = _testMessage = null;
        try
        {
            await GitHub.DisconnectAsync();
            await ReloadAsync();
            _okMessage = "Disconnected. The app is still installed on GitHub until an owner there removes it.";
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "Failed to disconnect the GitHub organisation.");
            _errMessage = "An unexpected error occurred. Nothing was disconnected.";
        }
        finally
        {
            _disconnecting = false;
        }
    }
}
