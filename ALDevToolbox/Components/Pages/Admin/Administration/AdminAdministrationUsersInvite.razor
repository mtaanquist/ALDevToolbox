@page "/admin/administration/users/new"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@rendermode InteractiveServer
@using ALDevToolbox.Components.Shared
@using ALDevToolbox.Endpoints
@using ALDevToolbox.Services
@using Microsoft.AspNetCore.DataProtection
@inject IHttpContextAccessor Http
@inject IDataProtectionProvider Protection
@inject IEmailService EmailSvc
@inject IJSRuntime JS

@*
    Create-or-invite sub-page. The Users tab is read-mostly - pending invites,
    pending signups, active user management - and this page owns the two
    add-a-user flows so the forms aren't competing for attention with the
    tables on every visit.
*@

<PageTitle>Add a user · Administration · AL Dev Toolbox</PageTitle>

<div class="page">
    <header class="page-head">
        <div>
            <p class="page-head__crumbs">
                <a href="/admin/administration/users">Users</a>
                <Icon Name="chevron-right" Width="12" Height="12" />
                <span>Add a user</span>
            </p>
            <h1 class="page-head__title">Add a user</h1>
            <p class="page-head__sub">
                Adds someone to this organisation and sends them an invite.
            </p>
        </div>
        <div class="page-head__actions">
            <a class="btn btn--sm" href="/admin/administration/users">
                <Icon Name="arrow-left" Width="14" Height="14" />
                <span>Back to users</span>
            </a>
        </div>
    </header>

    @if (!string.IsNullOrEmpty(Error))
    {
        <p class="alert alert--danger" role="alert">
            <Icon Name="circle-alert" Width="16" Height="16" /><span>@Error</span>
        </p>
    }

    @if (Ok == "created" && !string.IsNullOrEmpty(_oneShotLink))
    {
        <section class="card" role="status">
            <div class="card__head">
                <div>
                    <h2 class="card__title">User created</h2>
                    <p class="card__sub">Share this single-use link. It works once and expires in 7 days.</p>
                </div>
            </div>
            <div class="card__body">
                <div class="code-block">
                    <div class="code-block__bar">
                        <span class="code-block__name">Invite link</span>
                        <button type="button" class="btn btn--sm copy-btn" @onclick="CopyLinkAsync">
                            <Icon Name="copy" Width="14" Height="14" />
                            <span>Copy</span>
                        </button>
                    </div>
                    <pre>@_oneShotLink</pre>
                </div>
            </div>
        </section>
    }
    else if (Ok == "invited")
    {
        <p class="alert alert--success" role="status">
            <Icon Name="circle-check" Width="16" Height="16" />
            <span>Invite sent. The link is valid for 7 days.</span>
        </p>
    }

    <section class="card">
        @* No card head: it is the only card on the page and would just repeat
           the page title back at you. *@
        @* One form, one decision. This was two forms -- "Create a user (link)"
           and "Invite a user (email)" -- with the same three fields and an
           "also send by email" checkbox that made the first do the second's job.
           An admin had to read two headings, two captions and a checkbox to
           find out there was really one question: how does this person get
           their invite. Issue #543.

           /admin/users/create is a strict superset of /admin/users/invite --
           same InviteService.CreateAsync, plus the one-shot link and an
           optional email -- so the merged form posts there and the radio just
           sets SendEmail. *@
        <form method="post" action="/admin/users/create">
            <AntiforgeryToken />
            <div class="card__body form-sec">
                <p class="form-sec__cap">
                    They pick their own password from a single-use link that lasts 7 days.
                </p>
                <div class="form-grid">
                    <div class="field">
                        <label class="field__label" for="cu-email">Email</label>
                        <input class="input" id="cu-email" type="email" name="Email" required maxlength="254" placeholder="e.g. alice@example.com" />
                    </div>
                    <div class="field">
                        <label class="field__label" for="cu-role">Role</label>
                        <span class="select-wrap">
                            <select class="select" id="cu-role" name="Role">
                                <option value="User" selected>User</option>
                                <option value="Editor">Editor</option>
                                <option value="Admin">Administrator</option>
                            </select>
                            <Icon Name="chevron-down" Width="15" Height="15" Css="select-wrap__caret" />
                        </span>
                    </div>
                    <div class="field field--full">
                        <label class="field__label" for="cu-message">Welcome message (optional)</label>
                        <textarea class="textarea" id="cu-message" name="WelcomeMessage" rows="2" maxlength="2000" placeholder="A short note shown in the invite."></textarea>
                    </div>
                </div>

                <div class="field">
                    <span class="field__label">How should they get the invite?</span>
                    <div class="check-list">
                        <label class="check @(_sendEmail ? "is-checked" : "") @(_smtpConfigured ? "" : "is-disabled")">
                            <input type="radio" name="SendEmail" value="true"
                                   checked="@_sendEmail" disabled="@(!_smtpConfigured)"
                                   @onchange="@(() => _sendEmail = true)" />
                            <span class="check__dot"></span>
                            <span>Send it by email</span>
                        </label>
                        <label class="check @(_sendEmail ? "" : "is-checked")">
                            <input type="radio" name="SendEmail" value="false"
                                   checked="@(!_sendEmail)"
                                   @onchange="@(() => _sendEmail = false)" />
                            <span class="check__dot"></span>
                            <span>Give me a link to share</span>
                        </label>
                    </div>
                    @if (!_smtpConfigured)
                    {
                        <span class="field__hint">Email isn't set up on this site, so a link is the only way to share this invite.</span>
                    }
                </div>
            </div>
            <div class="card__foot">
                <button type="submit" class="btn btn--primary">
                    <Icon Name="user-plus" Width="16" Height="16" />
                    <span>Create user</span>
                </button>
            </div>
        </form>
    </section>
</div>

@code {
    [SupplyParameterFromQuery(Name = "err")] public string? Error { get; set; }
    [SupplyParameterFromQuery(Name = "ok")] public string? Ok { get; set; }

    private string? _oneShotLink;
    private bool _sendEmail = true;
    private bool _smtpConfigured;

    protected override async Task OnInitializedAsync()
    {
        _smtpConfigured = await EmailSvc.IsConfiguredAsync();
        // A disabled checkbox posts nothing, so leaving it ticked when there is
        // no email to send by only told the admin something untrue.
        if (!_smtpConfigured) _sendEmail = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        var ctx = Http.HttpContext;
        if (ctx is null) return;
        // The create endpoint stashes the accept URL in a one-shot Data
        // Protection-encrypted cookie so it can survive the redirect back here
        // without ending up in the URL or a query string.
        _oneShotLink = EndpointHelpers.ReadAndClearOneShotInviteCookie(ctx, Protection);
        if (_oneShotLink is not null) StateHasChanged();
    }

    private async Task CopyLinkAsync()
    {
        if (_oneShotLink is null) return;
        try { await JS.InvokeVoidAsync("aldtCopy", _oneShotLink); }
        catch { /* clipboard API blocked - admin can copy the displayed text manually */ }
    }
}
