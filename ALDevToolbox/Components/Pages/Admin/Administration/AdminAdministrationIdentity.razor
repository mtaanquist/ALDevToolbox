@page "/admin/administration/identity"
@attribute [Authorize(Roles = "Admin")]
@rendermode InteractiveServer
@inject OrganizationConfigService Config
@inject OrganizationAdminService OrgAdmin
@inject AppDbContext Db
@inject IOrganizationContext OrgCtx
@inject NavigationManager Nav
@inject ILogger<AdminAdministrationIdentity> Log
@using ALDevToolbox.Data
@using ALDevToolbox.Domain.Entities
@using ALDevToolbox.Domain.ValueObjects
@using Microsoft.EntityFrameworkCore

@*
    Organisation identity and email-domain claims. The display name shown in
    the top bar comes from Organization.Name; rename it here. Email domains
    are globally unique - claiming one routes future signups from that domain
    into this org as Pending users (admin still approves via the Users tab).
*@

<PageTitle>Identity · Administration · AL Dev Toolbox</PageTitle>

<div class="admin-page admin-configuration">
    <AdministrationHeader ActiveTab="AdministrationHeader.Tab.Identity" />

    @if (_loading)
    {
        <p class="muted">Loading...</p>
    }
    else
    {
        <section class="admin-section">
            <h2>Organisation name</h2>
            @if (!string.IsNullOrEmpty(_nameOkMessage))
            {
                <p class="form-success" role="status">@_nameOkMessage</p>
            }
            @if (!string.IsNullOrEmpty(_nameErrMessage))
            {
                <div class="form-error" role="alert"><p>@_nameErrMessage</p></div>
            }
            <div class="form-grid form-grid--narrow">
                <section class="form-section">
                    <label class="section-label" for="org-name">Name</label>
                    <input id="org-name" type="text" required minlength="2" maxlength="80"
                           @bind="_name" @bind:event="oninput" />
                    <small class="muted">
                        Shown next to the user's name in the top bar and in the admin tools.
                        Renaming takes effect for new logins - current sessions keep their
                        cached name until they sign out and back in.
                    </small>
                </section>
                <section class="form-section">
                    <label class="section-label" for="org-slug">Slug (read-only)</label>
                    <input id="org-slug" type="text" value="@_slug" readonly disabled />
                    <small class="muted">
                        The slug is baked into every signed-in cookie's org claim and
                        every saved URL; it can't be changed without invalidating both.
                    </small>
                </section>
                <section class="form-section">
                    <button type="button" class="btn btn--primary"
                            @onclick="SaveNameAsync"
                            disabled="@(_savingName || _name == _baseName)">
                        <Icon Name="save" Width="14" Height="14" />
                        <span>@(_savingName ? "Saving..." : "Save changes")</span>
                    </button>
                </section>
            </div>
        </section>

        <section class="admin-section">
            <h2>Strong authentication</h2>
            <p class="muted">
                Require every member of this organisation to have either two-factor
                authentication (authenticator app or email codes) or a passkey
                configured. Users without one will be sent to
                <a href="/account">your account</a> at the next request and can't
                reach anything else until they enrol.
            </p>
            @if (!string.IsNullOrEmpty(_strongAuthOkMessage))
            {
                <p class="form-success" role="status">@_strongAuthOkMessage</p>
            }
            @if (!string.IsNullOrEmpty(_strongAuthErrMessage))
            {
                <div class="form-error" role="alert"><p>@_strongAuthErrMessage</p></div>
            }
            <label class="checkbox-label">
                <input type="checkbox" @bind="_requireStrongAuth" @bind:after="SaveRequireStrongAuthAsync"
                       disabled="@_savingStrongAuth" />
                Require strong authentication for everyone in this organisation
            </label>
        </section>

        <section class="admin-section">
            <h2>Email domains</h2>
            <p class="muted">
                When someone signs up with an email at one of these domains we
                attach them to this organisation. By default they land as a
                Pending user needing an admin's approval via the
                <a href="/admin/administration/users">Users</a> tab; turn on
                auto-join below to admit verified addresses straight away.
                A domain belongs to exactly one organisation deployment-wide.
            </p>
            @if (!string.IsNullOrEmpty(_domainOkMessage))
            {
                <p class="form-success" role="status">@_domainOkMessage</p>
            }
            @if (!string.IsNullOrEmpty(_domainErrMessage))
            {
                <div class="form-error" role="alert"><p>@_domainErrMessage</p></div>
            }

            @if (_domains.Count == 0)
            {
                <p class="muted">No email domains claimed yet.</p>
            }
            else
            {
                <ul class="email-domain-list">
                    @foreach (var domain in _domains)
                    {
                        <li class="email-domain-row">
                            <code>@domain.Domain</code>
                            <button type="button" class="btn btn--sm" @onclick="() => RemoveAsync(domain.Id)" disabled="@_savingDomain">
                                <Icon Name="trash-2" Width="14" Height="14" />
                                <span>Remove</span>
                            </button>
                        </li>
                    }
                </ul>
            }

            <div class="form-grid form-grid--narrow">
                <section class="form-section">
                    <label class="section-label" for="org-domain">Add domain</label>
                    <input id="org-domain" type="text" placeholder="e.g. cronus.com" maxlength="253"
                           @bind="_newDomain" @bind:event="oninput" />
                    <small class="muted">Lowercased; a leading <code>@@</code> is stripped if you paste it.</small>
                </section>
                <section class="form-section">
                    <button type="button" class="btn"
                            @onclick="AddAsync"
                            disabled="@(_savingDomain || string.IsNullOrWhiteSpace(_newDomain))">
                        <Icon Name="plus" Width="14" Height="14" />
                        <span>@(_savingDomain ? "Saving..." : "Add domain")</span>
                    </button>
                </section>
            </div>

            @if (!string.IsNullOrEmpty(_autoJoinOkMessage))
            {
                <p class="form-success" role="status">@_autoJoinOkMessage</p>
            }
            @if (!string.IsNullOrEmpty(_autoJoinErrMessage))
            {
                <div class="form-error" role="alert"><p>@_autoJoinErrMessage</p></div>
            }
            <label class="checkbox-label">
                <input type="checkbox" @bind="_autoJoinVerifiedDomainUsers" @bind:after="SaveAutoJoinAsync"
                       disabled="@_savingAutoJoin" />
                Auto-join verified users from these domains (skip admin approval)
            </label>
            <small class="muted">
                Only applies when email verification is on (SMTP configured). A new user must still
                confirm they own the address before they're admitted.
            </small>
        </section>

        <section class="admin-section">
            <h2>Microsoft sign-in</h2>
            <p class="muted">
                Let members sign in with their work Microsoft account (Entra ID).
                Only accounts from the tenants you list here can sign in - people
                from any other Microsoft tenant are turned away. When it's on, a
                "Sign in with Microsoft" button appears on the login page.
            </p>
            @if (!string.IsNullOrEmpty(_entraOkMessage))
            {
                <p class="form-success" role="status">@_entraOkMessage</p>
            }
            @if (!string.IsNullOrEmpty(_entraErrMessage))
            {
                <div class="form-error" role="alert"><p>@_entraErrMessage</p></div>
            }

            @if (_deploymentAppConfigured)
            {
                <p class="muted">
                    Ready - Microsoft sign-in for this server is set up. You only
                    need your tenant ID below.
                </p>
            }
            else
            {
                <p class="muted">
                    Not set up yet - ask whoever runs this AL Dev Toolbox server to
                    configure Microsoft sign-in, or use your own app registration
                    below.
                </p>
            }

            <label class="checkbox-label">
                <input type="checkbox" @bind="_entraEnabled"
                       disabled="@(_savingEntra || (!_deploymentAppConfigured && string.IsNullOrWhiteSpace(_entraClientId)))" />
                Allow members to sign in with Microsoft
            </label>

            @if (_entraTenantIds.Count == 0)
            {
                <p class="muted">Turn this on, then add the Microsoft tenant your colleagues sign in from.</p>
            }
            else
            {
                <ul class="email-domain-list">
                    @foreach (var tenantId in _entraTenantIds)
                    {
                        <li class="email-domain-row">
                            <code>@tenantId</code>
                            <button type="button" class="btn btn--sm" @onclick="() => RemoveTenantId(tenantId)" disabled="@_savingEntra">
                                <Icon Name="trash-2" Width="14" Height="14" />
                                <span>Remove</span>
                            </button>
                        </li>
                    }
                </ul>
            }

            <div class="form-grid form-grid--narrow">
                <section class="form-section">
                    <label class="section-label" for="entra-tenant">Add tenant ID</label>
                    <input id="entra-tenant" type="text" maxlength="36"
                           placeholder="e.g. 00000000-0000-0000-0000-000000000000"
                           @bind="_newTenantId" @bind:event="oninput" />
                    <small class="muted">
                        Your company's Directory (tenant) ID, from the Microsoft Entra
                        admin center's Overview page.
                    </small>
                </section>
                <section class="form-section">
                    <button type="button" class="btn"
                            @onclick="AddTenantId"
                            disabled="@(_savingEntra || string.IsNullOrWhiteSpace(_newTenantId))">
                        <Icon Name="plus" Width="14" Height="14" />
                        <span>Add to list</span>
                    </button>
                </section>
            </div>

            <details class="entra-own-app" open="@(!string.IsNullOrEmpty(_entraClientId))">
                <summary>Use your own app registration (optional)</summary>
                <p class="muted">
                    Sign-in normally runs through the Microsoft app registration set
                    up by whoever runs this AL Dev Toolbox server, and you only need
                    the tenant ID above. Fill this in instead if your security policy
                    requires the app registration to live in your own tenant.
                </p>
                <p class="muted">
                    When you create the registration, add this as its
                    <strong>Redirect URI</strong> (under Authentication → Add a
                    platform → Web): <code>@RedirectUri</code>
                </p>
                <div class="form-grid form-grid--narrow">
                    <section class="form-section">
                        <label class="section-label" for="entra-client-id">Application (client) ID</label>
                        <input id="entra-client-id" type="text" maxlength="36"
                               placeholder="e.g. 00000000-0000-0000-0000-000000000000"
                               @bind="_entraClientId" @bind:event="oninput" />
                        <small class="muted">Clear this field and save to go back to the shared registration.</small>
                    </section>
                    <section class="form-section">
                        <label class="section-label" for="entra-client-secret">Client secret</label>
                        <input id="entra-client-secret" type="password" autocomplete="off"
                               placeholder="@(_entraHasSecret ? "(leave blank to keep current)" : "Paste the secret value")"
                               @bind="_entraClientSecret" @bind:event="oninput" />
                        <small class="muted">
                            Stored encrypted. Leave blank to keep the current secret.
                        </small>
                    </section>
                </div>
            </details>

            @if (IsEntraDirty)
            {
                <p class="muted">Not saved yet - select "Save Microsoft sign-in settings" below.</p>
            }
            @if (_entraEnabled && _entraTenantIds.Count == 0)
            {
                <p class="muted">Add at least one tenant ID before turning this on.</p>
            }
            <div class="form-grid form-grid--narrow">
                <section class="form-section">
                    <button type="button" class="btn"
                            @onclick="SaveEntraAsync"
                            disabled="@(_savingEntra || !IsEntraDirty || (_entraEnabled && _entraTenantIds.Count == 0))">
                        <Icon Name="save" Width="14" Height="14" />
                        <span>@(_savingEntra ? "Saving..." : "Save Microsoft sign-in settings")</span>
                    </button>
                </section>
            </div>
        </section>
    }
</div>

@code {
    private bool _loading = true;
    private bool _savingName;
    private bool _savingDomain;
    private bool _savingStrongAuth;
    private bool _savingAutoJoin;
    private string? _nameOkMessage;
    private string? _nameErrMessage;
    private string? _domainOkMessage;
    private string? _domainErrMessage;
    private string? _strongAuthOkMessage;
    private string? _strongAuthErrMessage;
    private string? _autoJoinOkMessage;
    private string? _autoJoinErrMessage;

    private string _name = string.Empty;
    private string _baseName = string.Empty;
    private string _slug = string.Empty;
    private string _newDomain = string.Empty;
    private bool _requireStrongAuth;
    private bool _autoJoinVerifiedDomainUsers;
    private List<OrganizationEmailDomain> _domains = new();

    private bool _savingEntra;
    private string? _entraOkMessage;
    private string? _entraErrMessage;
    private bool _entraEnabled;
    private List<string> _entraTenantIds = new();
    private string _newTenantId = string.Empty;
    private string _entraClientId = string.Empty;
    private string _entraClientSecret = string.Empty;
    private bool _entraHasSecret;
    private bool _deploymentAppConfigured;
    private bool _baseEntraEnabled;
    private List<string> _baseEntraTenantIds = new();
    private string _baseEntraClientId = string.Empty;

    /// <summary>
    /// The section saves explicitly (unlike the toggle-to-save checkboxes
    /// above), so the pending state must be visible: this drives the "Not
    /// saved yet" caption and the Save button's enabled state.
    /// </summary>
    private bool IsEntraDirty =>
        _entraEnabled != _baseEntraEnabled
        || !_entraTenantIds.SequenceEqual(_baseEntraTenantIds)
        || _entraClientId.Trim().ToLowerInvariant() != _baseEntraClientId
        || _entraClientSecret.Length > 0;

    private string RedirectUri => Nav.BaseUri.TrimEnd('/') + "/signin-microsoft";

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var orgId = OrgCtx.CurrentOrganizationId
            ?? throw new InvalidOperationException("No organisation in scope.");
        var org = await Db.Organizations.AsNoTracking().FirstAsync(o => o.Id == orgId);
        _name = _baseName = org.Name;
        _slug = org.Slug;
        var settings = await Db.OrganizationSettings.AsNoTracking()
            .Where(s => s.OrganizationId == orgId)
            .Select(s => new { s.RequireStrongAuth, s.AutoJoinVerifiedDomainUsers })
            .FirstOrDefaultAsync();
        _requireStrongAuth = settings?.RequireStrongAuth ?? false;
        _autoJoinVerifiedDomainUsers = settings?.AutoJoinVerifiedDomainUsers ?? false;
        _domains = await OrgAdmin.ListEmailDomainsAsync();
        ApplyEntraView(await OrgAdmin.GetEntraViewAsync());
        _loading = false;
    }

    private void ApplyEntraView(OrgEntraView view)
    {
        _entraEnabled = _baseEntraEnabled = view.Enabled;
        _entraTenantIds = view.AllowedTenantIds.ToList();
        _baseEntraTenantIds = view.AllowedTenantIds.ToList();
        _entraClientId = _baseEntraClientId = view.ClientId ?? string.Empty;
        _entraHasSecret = view.HasClientSecret;
        _deploymentAppConfigured = view.DeploymentAppConfigured;
    }

    private void AddTenantId()
    {
        var trimmed = _newTenantId.Trim().ToLowerInvariant();
        if (trimmed.Length == 0) return;
        _entraErrMessage = null;
        if (!Guid.TryParse(trimmed, out _))
        {
            // Instant feedback; SaveEntraAsync re-validates server-side.
            _entraErrMessage = $"'{trimmed}' is not a tenant ID. Enter the Directory (tenant) ID - a GUID like 00000000-0000-0000-0000-000000000000.";
            return;
        }
        if (!_entraTenantIds.Contains(trimmed)) _entraTenantIds.Add(trimmed);
        _newTenantId = string.Empty;
    }

    private void RemoveTenantId(string tenantId)
    {
        _entraTenantIds.Remove(tenantId);
    }

    private async Task SaveEntraAsync()
    {
        if (_savingEntra) return;
        _savingEntra = true;
        _entraOkMessage = null;
        _entraErrMessage = null;
        try
        {
            await OrgAdmin.SaveEntraAsync(new OrgEntraInput(
                Enabled: _entraEnabled,
                AllowedTenantIds: _entraTenantIds,
                ClientId: _entraClientId,
                ClientSecret: _entraClientSecret,
                ClearClientSecret: false));
            _entraClientSecret = string.Empty;
            ApplyEntraView(await OrgAdmin.GetEntraViewAsync());
            _entraOkMessage = _entraEnabled
                ? "Saved. Members from the listed tenants can use \"Sign in with Microsoft\" on the login page."
                : "Saved. Microsoft sign-in is off.";
        }
        catch (PlanValidationException ex)
        {
            _entraErrMessage = ex.Errors.FirstOrDefault().Value ?? "Validation failed.";
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "Failed to save Microsoft sign-in settings.");
            _entraErrMessage = "An unexpected error occurred. The change was not saved.";
        }
        finally
        {
            _savingEntra = false;
        }
    }

    private async Task SaveRequireStrongAuthAsync()
    {
        if (_savingStrongAuth) return;
        _savingStrongAuth = true;
        _strongAuthOkMessage = null;
        _strongAuthErrMessage = null;
        try
        {
            await OrgAdmin.SetRequireStrongAuthAsync(_requireStrongAuth);
            _strongAuthOkMessage = _requireStrongAuth
                ? "Strong authentication is now required. Members without an authenticator app, email codes, or a passkey will be asked to set one up the next time they use the tool."
                : "Strong-auth requirement is now off.";
        }
        catch (PlanValidationException ex)
        {
            // Revert the toggle so the UI reflects the unchanged DB state.
            _requireStrongAuth = !_requireStrongAuth;
            _strongAuthErrMessage = ex.Errors.FirstOrDefault().Value ?? "Validation failed.";
        }
        catch (Exception ex)
        {
            _requireStrongAuth = !_requireStrongAuth;
            Log.LogError(ex, "Failed to toggle strong-auth requirement.");
            _strongAuthErrMessage = "An unexpected error occurred. The change was not saved.";
        }
        finally
        {
            _savingStrongAuth = false;
        }
    }

    private async Task SaveAutoJoinAsync()
    {
        if (_savingAutoJoin) return;
        _savingAutoJoin = true;
        _autoJoinOkMessage = null;
        _autoJoinErrMessage = null;
        try
        {
            await OrgAdmin.SetAutoJoinVerifiedDomainUsersAsync(_autoJoinVerifiedDomainUsers);
            _autoJoinOkMessage = _autoJoinVerifiedDomainUsers
                ? "Verified users from your claimed domains will now join automatically - no approval needed."
                : "Auto-join is off. New users from your domains land Pending for approval.";
        }
        catch (Exception ex)
        {
            // Revert the toggle so the UI reflects the unchanged DB state.
            _autoJoinVerifiedDomainUsers = !_autoJoinVerifiedDomainUsers;
            Log.LogError(ex, "Failed to toggle auto-join for verified domain users.");
            _autoJoinErrMessage = "An unexpected error occurred. The change was not saved.";
        }
        finally
        {
            _savingAutoJoin = false;
        }
    }

    private async Task SaveNameAsync()
    {
        if (_savingName || _name == _baseName) return;
        _savingName = true;
        _nameOkMessage = null;
        _nameErrMessage = null;
        try
        {
            await Config.RenameOrganizationAsync(_name);
            _baseName = _name.Trim();
            _name = _baseName;
            _nameOkMessage = "Organisation renamed. Sign out and back in to see it in the top bar.";
        }
        catch (PlanValidationException ex)
        {
            _nameErrMessage = ex.Errors.FirstOrDefault().Value ?? "Validation failed.";
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "Failed to rename organisation.");
            _nameErrMessage = "An unexpected error occurred. The change was not saved.";
        }
        finally
        {
            _savingName = false;
        }
    }

    private async Task AddAsync()
    {
        if (_savingDomain) return;
        _savingDomain = true;
        _domainOkMessage = null;
        _domainErrMessage = null;
        try
        {
            await OrgAdmin.AddEmailDomainAsync(_newDomain);
            _newDomain = string.Empty;
            _domains = await OrgAdmin.ListEmailDomainsAsync();
            _domainOkMessage = "Domain added.";
        }
        catch (PlanValidationException ex)
        {
            _domainErrMessage = ex.Errors.FirstOrDefault().Value ?? "Validation failed.";
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "Failed to add email domain.");
            _domainErrMessage = "An unexpected error occurred. The change was not saved.";
        }
        finally
        {
            _savingDomain = false;
        }
    }

    private async Task RemoveAsync(int domainId)
    {
        if (_savingDomain) return;
        _savingDomain = true;
        _domainOkMessage = null;
        _domainErrMessage = null;
        try
        {
            await OrgAdmin.RemoveEmailDomainAsync(domainId);
            _domains = await OrgAdmin.ListEmailDomainsAsync();
            _domainOkMessage = "Domain removed.";
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "Failed to remove email domain.");
            _domainErrMessage = "An unexpected error occurred. The change was not saved.";
        }
        finally
        {
            _savingDomain = false;
        }
    }
}
