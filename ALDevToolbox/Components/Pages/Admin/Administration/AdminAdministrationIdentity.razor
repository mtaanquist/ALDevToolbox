@page "/admin/administration/identity"
@attribute [Authorize(Roles = "Admin")]
@rendermode InteractiveServer
@inject OrganizationConfigService Config
@inject OrganizationAdminService OrgAdmin
@inject AppDbContext Db
@inject IOrganizationContext OrgCtx
@inject NavigationManager Nav
@inject ILogger<AdminAdministrationIdentity> Log
@using ALDevToolbox.Data
@using ALDevToolbox.Domain.Entities
@using ALDevToolbox.Domain.ValueObjects
@using Microsoft.EntityFrameworkCore

@*
    Organisation identity and email-domain claims. The display name shown in
    the top bar comes from Organization.Name; rename it here. Email domains
    are globally unique - claiming one routes future signups from that domain
    into this org as Pending users (admin still approves via the Users tab).
*@

<PageTitle>Identity · Administration · AL Dev Toolbox</PageTitle>

<AdministrationHeader ActiveTab="AdministrationHeader.Tab.Identity">
    <Body>
        @if (_loading)
        {
            <div class="loading-block"><span class="spinner"></span><span>Loading...</span></div>
        }
        else
        {
            <div class="setting-list">
                <SettingRow Name="Organisation name"
                            Hint="Shown beside your name in the top bar. A rename takes effect the next time someone signs in.">
                    <span class="u-row">
                        <input class="input" id="org-name" type="text" required minlength="2" maxlength="80"
                               aria-label="Organisation name"
                               @bind="_name" @bind:event="oninput" />
                        <button type="button" class="btn btn--primary"
                                @onclick="SaveNameAsync"
                                disabled="@(_savingName || _name == _baseName)">
                            <Icon Name="save" Width="14" Height="14" />
                            <span>@(_savingName ? "Saving..." : "Save")</span>
                        </button>
                    </span>
                    <FeedbackLine Ok="@_nameOkMessage" Error="@_nameErrMessage" />
                </SettingRow>

                <SettingRow Name="Web address"
                            Hint="Part of every link people have saved and of every signed-in session, so it cannot be changed.">
                    <input class="input" id="org-slug" type="text" value="@_slug" readonly disabled
                           aria-label="Web address" />
                </SettingRow>

                <SettingRow Name="Require a second step to sign in">
                    <HintContent>
                        Everyone here must set up an authenticator app, email codes or a
                        passkey. Anyone without one is sent to
                        <a href="/account">their account page</a> and cannot use anything
                        else until they have.
                    </HintContent>
                    <ChildContent>
                        <Switch Checked="_requireStrongAuth" CheckedChanged="OnStrongAuthChangedAsync"
                                Disabled="@_savingStrongAuth"
                                Label="@(_requireStrongAuth ? "Required" : "Not required")" />
                        <FeedbackLine Ok="@_strongAuthOkMessage" Error="@_strongAuthErrMessage" />
                    </ChildContent>
                </SettingRow>

                <SettingRow Name="Email domains">
                    <HintContent>
                        Anyone signing up with an address at one of these domains joins
                        this organisation. A domain can belong to only one organisation.
                    </HintContent>
                    <ChildContent>
                        <div class="sub-rows sub-rows--plain">
                            @if (_domains.Count == 0)
                            {
                                <p class="sub-rows__empty">No domains yet - add one below to route signups here.</p>
                            }
                            else
                            {
                                @foreach (var domain in _domains)
                                {
                                    <div class="sub-row">
                                        <span class="sub-row__val">@domain.Domain</span>
                                        <span class="sub-row__acts">
                                            <button type="button" class="btn btn--sm" @onclick="() => RemoveAsync(domain.Id)" disabled="@_savingDomain">
                                                <Icon Name="trash-2" Width="14" Height="14" />
                                                <span>Remove</span>
                                            </button>
                                        </span>
                                    </div>
                                }
                            }
                            <div class="sub-rows__foot">
                                <label class="u-sr" for="org-domain">Domain to add</label>
                                <input class="input" id="org-domain" type="text" placeholder="e.g. cronus.com" maxlength="253"
                                       @bind="_newDomain" @bind:event="oninput" />
                                <button type="button" class="btn"
                                        @onclick="AddAsync"
                                        disabled="@(_savingDomain || string.IsNullOrWhiteSpace(_newDomain))">
                                    <Icon Name="plus" Width="14" Height="14" />
                                    <span>@(_savingDomain ? "Saving..." : "Add domain")</span>
                                </button>
                            </div>
                        </div>
                        <FeedbackLine Ok="@_domainOkMessage" Error="@_domainErrMessage" />
                    </ChildContent>
                </SettingRow>

                <SettingRow Name="Let them in without approval"
                            Hint="Only works once email is set up on this site, so the address can be confirmed first. Otherwise new people wait for an admin.">
                    <Switch Checked="_autoJoinVerifiedDomainUsers" CheckedChanged="OnAutoJoinChangedAsync"
                            Disabled="@_savingAutoJoin"
                            Label="@(_autoJoinVerifiedDomainUsers ? "Join straight away" : "Wait for approval")" />
                    <FeedbackLine Ok="@_autoJoinOkMessage" Error="@_autoJoinErrMessage" />
                </SettingRow>
            </div>
        }
    </Body>
    <Aside>
        <section class="card">
            <div class="card__head"><div><h2 class="card__title">Who can get in</h2></div></div>
            <div class="card__body settings-aside__body">
                <a class="btn btn--sm" href="/admin/administration/users">
                    <Icon Name="users" Width="14" Height="14" />
                    <span>Manage users</span>
                </a>
            </div>
        </section>
        <p class="alert alert--info">
            <Icon Name="info" Width="16" Height="16" />
            <span>Everything on this page applies to this organisation only.</span>
        </p>
    </Aside>
</AdministrationHeader>

@code {
    private bool _loading = true;
    private bool _savingName;
    private bool _savingDomain;
    private bool _savingStrongAuth;
    private bool _savingAutoJoin;
    private string? _nameOkMessage;
    private string? _nameErrMessage;
    private string? _domainOkMessage;
    private string? _domainErrMessage;
    private string? _strongAuthOkMessage;
    private string? _strongAuthErrMessage;
    private string? _autoJoinOkMessage;
    private string? _autoJoinErrMessage;

    private string _name = string.Empty;
    private string _baseName = string.Empty;
    private string _slug = string.Empty;
    private string _newDomain = string.Empty;
    private bool _requireStrongAuth;
    private bool _autoJoinVerifiedDomainUsers;
    private List<OrganizationEmailDomain> _domains = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var orgId = OrgCtx.CurrentOrganizationId
            ?? throw new InvalidOperationException("No organisation in scope.");
        var org = await Db.Organizations.AsNoTracking().FirstAsync(o => o.Id == orgId);
        _name = _baseName = org.Name;
        _slug = org.Slug;
        var settings = await Db.OrganizationSettings.AsNoTracking()
            .Where(s => s.OrganizationId == orgId)
            .Select(s => new { s.RequireStrongAuth, s.AutoJoinVerifiedDomainUsers })
            .FirstOrDefaultAsync();
        _requireStrongAuth = settings?.RequireStrongAuth ?? false;
        _autoJoinVerifiedDomainUsers = settings?.AutoJoinVerifiedDomainUsers ?? false;
        _domains = await OrgAdmin.ListEmailDomainsAsync();
        _loading = false;
    }

    /// <summary>
    /// The switch reports the value it moved to rather than writing a bound
    /// field, so a failed save can put it back where it was without the two
    /// ever disagreeing.
    /// </summary>
    private async Task OnStrongAuthChangedAsync(bool next)
    {
        if (_savingStrongAuth) return;
        _requireStrongAuth = next;
        _savingStrongAuth = true;
        _strongAuthOkMessage = null;
        _strongAuthErrMessage = null;
        try
        {
            await OrgAdmin.SetRequireStrongAuthAsync(_requireStrongAuth);
            _strongAuthOkMessage = _requireStrongAuth
                ? "Strong-auth requirement is now on. Members without a 2FA method or passkey will be redirected to /account on their next request."
                : "Strong-auth requirement is now off.";
        }
        catch (PlanValidationException ex)
        {
            // Revert the toggle so the UI reflects the unchanged DB state.
            _requireStrongAuth = !_requireStrongAuth;
            _strongAuthErrMessage = ex.Errors.FirstOrDefault().Value ?? "Validation failed.";
        }
        catch (Exception ex)
        {
            _requireStrongAuth = !_requireStrongAuth;
            Log.LogError(ex, "Failed to toggle strong-auth requirement.");
            _strongAuthErrMessage = "An unexpected error occurred. The change was not saved.";
        }
        finally
        {
            _savingStrongAuth = false;
        }
    }

    private async Task OnAutoJoinChangedAsync(bool next)
    {
        if (_savingAutoJoin) return;
        _autoJoinVerifiedDomainUsers = next;
        _savingAutoJoin = true;
        _autoJoinOkMessage = null;
        _autoJoinErrMessage = null;
        try
        {
            await OrgAdmin.SetAutoJoinVerifiedDomainUsersAsync(_autoJoinVerifiedDomainUsers);
            _autoJoinOkMessage = _autoJoinVerifiedDomainUsers
                ? "Verified users from your claimed domains will now join automatically - no approval needed."
                : "Auto-join is off. New users from your domains land Pending for approval.";
        }
        catch (Exception ex)
        {
            // Revert the toggle so the UI reflects the unchanged DB state.
            _autoJoinVerifiedDomainUsers = !_autoJoinVerifiedDomainUsers;
            Log.LogError(ex, "Failed to toggle auto-join for verified domain users.");
            _autoJoinErrMessage = "An unexpected error occurred. The change was not saved.";
        }
        finally
        {
            _savingAutoJoin = false;
        }
    }

    private async Task SaveNameAsync()
    {
        if (_savingName || _name == _baseName) return;
        _savingName = true;
        _nameOkMessage = null;
        _nameErrMessage = null;
        try
        {
            await Config.RenameOrganizationAsync(_name);
            _baseName = _name.Trim();
            _name = _baseName;
            _nameOkMessage = "Organisation renamed. Sign out and back in to see it in the top bar.";
        }
        catch (PlanValidationException ex)
        {
            _nameErrMessage = ex.Errors.FirstOrDefault().Value ?? "Validation failed.";
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "Failed to rename organisation.");
            _nameErrMessage = "An unexpected error occurred. The change was not saved.";
        }
        finally
        {
            _savingName = false;
        }
    }

    private async Task AddAsync()
    {
        if (_savingDomain) return;
        _savingDomain = true;
        _domainOkMessage = null;
        _domainErrMessage = null;
        try
        {
            await OrgAdmin.AddEmailDomainAsync(_newDomain);
            _newDomain = string.Empty;
            _domains = await OrgAdmin.ListEmailDomainsAsync();
            _domainOkMessage = "Domain added.";
        }
        catch (PlanValidationException ex)
        {
            _domainErrMessage = ex.Errors.FirstOrDefault().Value ?? "Validation failed.";
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "Failed to add email domain.");
            _domainErrMessage = "An unexpected error occurred. The change was not saved.";
        }
        finally
        {
            _savingDomain = false;
        }
    }

    private async Task RemoveAsync(int domainId)
    {
        if (_savingDomain) return;
        _savingDomain = true;
        _domainOkMessage = null;
        _domainErrMessage = null;
        try
        {
            await OrgAdmin.RemoveEmailDomainAsync(domainId);
            _domains = await OrgAdmin.ListEmailDomainsAsync();
            _domainOkMessage = "Domain removed.";
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "Failed to remove email domain.");
            _domainErrMessage = "An unexpected error occurred. The change was not saved.";
        }
        finally
        {
            _savingDomain = false;
        }
    }
}
