@page "/admin/administration/export"
@attribute [Authorize(Roles = "Admin")]

@*
    Export tab of the Administration surface. Per-organisation TOML export
    and configuration import. Database backups live on /site-admin/backups
    and are SiteAdmin-only; tenants only ever see this page and its TOML
    snapshot workflow. No global "Save changes" here - each form submits
    immediately to its own endpoint.
*@

<PageTitle>Export · Administration · AL Dev Toolbox</PageTitle>

<div class="page">
    <AdministrationHeader ActiveTab="AdministrationHeader.Tab.Export" />

    @if (Ok == "imported")
    {
        <p class="alert alert--success" role="status">
            <Icon Name="circle-check" Width="16" Height="16" /><span>Configuration imported.</span>
        </p>
    }
    @if (!string.IsNullOrEmpty(Msg))
    {
        <p class="alert alert--danger" role="alert">
            <Icon Name="circle-alert" Width="16" Height="16" /><span>@Msg</span>
        </p>
    }

    <section class="card">
        <div class="card__head"><h2 class="card__title">Export</h2></div>
        <div class="card__body form-sec">
            <p class="form-sec__cap">
                Download every active template, module, and catalogue entry as a
                TOML ZIP. Use it as a point-in-time snapshot or to read the live
                state outside the app.
            </p>
        </div>
        <form method="post" action="/admin/export/download" class="card__foot">
            <AntiforgeryToken />
            <button type="submit" class="btn">
                <Icon Name="download" Width="16" Height="16" />
                <span>Export all to TOML</span>
            </button>
        </form>
    </section>

    <section class="card card--danger">
        <div class="card__head"><h2 class="card__title">Restore configuration</h2></div>
        <form method="post" action="/admin/export/import">
            <AntiforgeryToken />
            <div class="card__body form-sec">
                <p class="form-sec__cap">
                    Paste an <code class="code">organization-config.toml</code> from an export ZIP and
                    replace this organisation's defaults, logo and file list. Existing
                    values are wiped - confirm before submitting.
                </p>
                <div class="field">
                    <label class="field__label" for="cfg-import-toml">TOML</label>
                    <textarea class="textarea" id="cfg-import-toml" name="Toml" rows="8"
                              placeholder="[settings]&#10;default_publisher = ..."></textarea>
                </div>
                <label class="check" id="cfg-import-confirm">
                    <input type="checkbox" name="Confirm" value="true" />
                    <span class="check__box"><Icon Name="check" Width="12" Height="12" /></span>
                    <span>I understand this overwrites the current configuration.</span>
                </label>
            </div>
            <div class="card__foot">
                <button type="submit" class="btn btn--danger">
                    <Icon Name="upload" Width="14" Height="14" />
                    <span>Restore from TOML</span>
                </button>
            </div>
        </form>
    </section>
</div>

@code {
    [SupplyParameterFromQuery(Name = "ok")] public string? Ok { get; set; }
    [SupplyParameterFromQuery(Name = "err")] public string? Err { get; set; }
    [SupplyParameterFromQuery(Name = "msg")] public string? Msg { get; set; }
}
