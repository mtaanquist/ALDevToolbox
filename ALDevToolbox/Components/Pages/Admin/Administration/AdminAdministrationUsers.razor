@page "/admin/administration/users"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@rendermode InteractiveServer
@using ALDevToolbox.Data
@using ALDevToolbox.Domain.Entities
@using ALDevToolbox.Domain.ValueObjects
@using ALDevToolbox.Endpoints
@using ALDevToolbox.Services
@using Microsoft.AspNetCore.DataProtection
@using Microsoft.EntityFrameworkCore
@using static ALDevToolbox.Components.Shared.AdminPageHelpers
@inject IOrganizationContext Org
@inject ALDevToolbox.Services.Account.UserAdministrationService Accounts
@inject IDataProtectionProvider Protection
@inject IHttpContextAccessor Http
@inject IJSRuntime JS
@inject ILogger<AdminAdministrationUsers> Log

@*
    Users tab of the Administration surface. Read-mostly: pending invites,
    pending signups, and active/disabled user management with per-row and
    bulk actions. Per-row actions POST to the existing /admin/users/*
    endpoints (which stayed at their original URLs after the page move);
    role changes run inside this circuit via UserAdministrationService.
    There's no global "Save changes" button here - every action mutates a
    single row at submit time, so dirty state never accumulates.
*@

<PageTitle>Users · Administration · AL Dev Toolbox</PageTitle>

<AdministrationHeader ActiveTab="AdministrationHeader.Tab.Users">
    <Actions>
        <a class="btn btn--sm btn--primary" href="/admin/administration/users/new">
            <Icon Name="user-plus" Width="14" Height="14" />
            <span>Add user</span>
        </a>
    </Actions>
    <Body>

    @if (!string.IsNullOrEmpty(Error))
    {
        <p class="alert alert--danger" role="alert">
            <Icon Name="circle-alert" Width="16" Height="16" /><span>@Error</span>
        </p>
    }
    @if (Ok == "invite-revoked")
    {
        <p class="alert alert--success" role="status">
            <Icon Name="circle-check" Width="16" Height="16" /><span>Invite revoked.</span>
        </p>
    }
    else if (Ok == "email-pending")
    {
        <div class="alert alert--success" role="status">
            <Icon Name="circle-check" Width="16" Height="16" />
            <span>
                Email change requested. We sent a confirmation link to the new address; it expires in 24 hours.
                @if (!string.IsNullOrEmpty(_oneShotLink))
                {
                    <span>If email isn't reaching the user, share this link with them instead:</span>
                    <span class="u-row">
                        <code class="code">@_oneShotLink</code>
                        <button type="button" class="btn btn--sm" @onclick="CopyLinkAsync">
                            <Icon Name="copy" Width="14" Height="14" />
                            <span>Copy</span>
                        </button>
                    </span>
                }
            </span>
        </div>
    }

    @if (_pending is null || _active is null || _invites is null)
    {
        <div class="loading-block"><span class="spinner"></span><span>Loading...</span></div>
    }
    else
    {
        <section class="card">
            <div class="card__head"><h2 class="card__title">Pending invites (@_invites.Count)</h2></div>
            @if (_invites.Count == 0)
            {
                @* Quiet: this is a secondary section that is empty most days, and
                   "Add user" is already the page's primary action in the header. *@
                <div class="empty-state empty-state--quiet">
                    <span class="empty-state__title">No pending invites</span>
                    <span class="empty-state__text">Invites you send appear here until they're accepted or they expire.</span>
                </div>
            }
            else
            {
                <table class="data-table">
                    <thead>
                        <tr><th>Email</th><th>Role</th><th>Invited by</th><th>Expires</th><th class="data-table__actions"></th></tr>
                    </thead>
                    <tbody>
                    @foreach (var (invite, invitedBy) in _invites)
                    {
                        <tr>
                            <td>@invite.Email</td>
                            <td>@invite.Role</td>
                            <td>@(invitedBy?.DisplayName ?? "—")</td>
                            <td class="u-muted u-num">@invite.ExpiresAt.ToString("yyyy-MM-dd HH:mm 'UTC'")</td>
                            <td class="data-table__actions">
                                <form method="post" action="/admin/users/invites/@invite.Id/revoke">
                                    <AntiforgeryToken />
                                    <button type="submit" class="btn btn--sm">Revoke</button>
                                </form>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            }
        </section>

        <section class="card">
            <div class="card__head"><h2 class="card__title">Pending signups (@_pending.Count)</h2></div>
            @if (_pending.Count == 0)
            {
                <div class="empty-state empty-state--quiet">
                    <span class="empty-state__title">Nobody waiting for approval</span>
                    <span class="empty-state__text">
                        People who sign up with an email at one of your claimed domains land here
                        until an admin approves them.
                    </span>
                </div>
            }
            else
            {
                <table class="data-table">
                    <thead>
                        <tr><th>Email</th><th>Full name</th><th>Requested</th><th class="data-table__actions"></th></tr>
                    </thead>
                    <tbody>
                    @foreach (var (request, user) in _pending)
                    {
                        <tr>
                            <td>@request.Email</td>
                            <td>@(user?.DisplayName ?? "—")</td>
                            <td class="u-muted u-num">@request.RequestedAt.ToString("yyyy-MM-dd HH:mm 'UTC'")</td>
                            <td class="data-table__actions">
                                <span class="u-row">
                                    <form method="post" action="/admin/users/@request.Id/approve">
                                        <AntiforgeryToken />
                                        <button type="submit" class="btn btn--sm">Approve</button>
                                    </form>
                                    <form method="post" action="/admin/users/@request.Id/reject">
                                        <AntiforgeryToken />
                                        <button type="submit" class="btn btn--sm">Reject</button>
                                    </form>
                                </span>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            }
        </section>

        @if (_selected.Count > 0)
        {
            <div class="bulk-bar" role="region" aria-label="Bulk actions" aria-live="polite">
                <span class="bulk-bar__summary">@_selected.Count selected</span>
                <div class="bulk-bar__actions">
                    <button type="button" class="btn btn--sm" @onclick="() => RequestBulkAsync(BulkAction.Disable)" disabled="@_busy">
                        <Icon Name="user-x" Width="14" Height="14" />
                        <span>Disable</span>
                    </button>
                    <button type="button" class="btn btn--sm" @onclick="() => RequestBulkAsync(BulkAction.Enable)" disabled="@_busy">
                        <Icon Name="user-check" Width="14" Height="14" />
                        <span>Re-enable</span>
                    </button>
                    <button type="button" class="btn btn--sm" @onclick="() => RequestBulkAsync(BulkAction.PromoteAdmin)" disabled="@_busy">
                        <Icon Name="shield" Width="14" Height="14" />
                        <span>Promote to Admin</span>
                    </button>
                    <button type="button" class="btn btn--sm" @onclick="() => RequestBulkAsync(BulkAction.DemoteUser)" disabled="@_busy">
                        <Icon Name="shield-off" Width="14" Height="14" />
                        <span>Demote to User</span>
                    </button>
                    <button type="button" class="btn btn--sm" @onclick="ClearSelection" disabled="@_busy">
                        <Icon Name="x" Width="14" Height="14" />
                        <span>Clear</span>
                    </button>
                </div>
            </div>
        }

        @if (_lastError is not null)
        {
            <p class="alert alert--danger" role="alert">
                <Icon Name="circle-alert" Width="16" Height="16" /><span>@_lastError</span>
            </p>
        }
        @if (_lastSuccess is not null)
        {
            <p class="alert alert--success" role="status">
                <Icon Name="circle-check" Width="16" Height="16" /><span>@_lastSuccess</span>
            </p>
        }
        @if (_lastFailures.Count > 0)
        {
            <div class="alert alert--warn" role="alert">
                <Icon Name="triangle-alert" Width="16" Height="16" />
                <span>
                    <strong>Some users couldn't be updated</strong>
                    <ul>
                        @foreach (var f in _lastFailures)
                        {
                            <li>@f.DisplayName: @f.Reason</li>
                        }
                    </ul>
                </span>
            </div>
        }

        <section class="card">
            <div class="card__head"><h2 class="card__title">Active &amp; disabled (@_active.Count)</h2></div>
            <table class="data-table data-table--edge">
                <thead>
                    <tr>
                        <th class="data-table__col-check">
                            <label class="check">
                                <input type="checkbox" aria-label="Select all visible"
                                       checked="@AllVisibleSelected" @onchange="ToggleSelectAllVisible" />
                                <span class="check__box"><Icon Name="check" Width="12" Height="12" /></span>
                            </label>
                        </th>
                        <th class="data-table__col-state"><span class="u-sr">Status</span></th>
                        <th>Email</th>
                        <th>Full name</th>
                        <th>Role</th>
                        <th>Last login</th>
                        <th class="data-table__actions"></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var u in _active)
                {
                    var state = u.Status == UserStatus.Active ? "active" : "archived";
                    <tr class="@RowStateIcon.RowClass(state) @(_selected.Contains(u.Id) ? "is-selected" : "")">
                        <td class="data-table__col-check">
                            <label class="check">
                                <input type="checkbox" aria-label="@($"Select {u.DisplayName}")"
                                       checked="@_selected.Contains(u.Id)"
                                       @onchange="(e) => ToggleRow(u.Id, e)" />
                                <span class="check__box"><Icon Name="check" Width="12" Height="12" /></span>
                            </label>
                        </td>
                        <td class="data-table__col-state">
                            <RowStateIcon State="@state" Label="@u.Status.ToString()" />
                        </td>
                        <td>
                            <span class="u-row">
                                <span>@u.Email</span>
                                @if (_entraLinkedUserIds.Contains(u.Id))
                                {
                                    @* Says how this person gets in, next to the address they
                                       get in with. It matters here because an admin looking at
                                       "why can't they sign in" needs to know a password reset
                                       is not the answer for this row. *@
                                    <span class="tag" title="Signs in with a Microsoft account">Microsoft</span>
                                }
                            </span>
                        </td>
                        <td>@u.DisplayName</td>
                        <td>
                            <span class="select-wrap">
                                <select class="select select--sm" aria-label="@($"Role for {u.DisplayName}")"
                                        value="@u.Role"
                                        disabled="@_busy"
                                        @onchange="(e) => ChangeRoleAsync(u, e)">
                                    @foreach (var role in Enum.GetValues<UserRole>())
                                    {
                                        <option value="@role">@role</option>
                                    }
                                </select>
                                <Icon Name="chevron-down" Width="15" Height="15" Css="select-wrap__caret" />
                            </span>
                        </td>
                        <td class="u-muted u-num">@(u.LastLoginAt?.ToString("yyyy-MM-dd HH:mm 'UTC'") ?? "—")</td>
                        <td class="data-table__actions">
                            <span class="u-row">
                                @if (u.Status == UserStatus.Active)
                                {
                                    <form method="post" action="/admin/users/@u.Id/disable">
                                        <AntiforgeryToken />
                                        <button type="submit" class="btn btn--sm">Disable</button>
                                    </form>
                                }
                                else if (u.Status == UserStatus.Disabled)
                                {
                                    <form method="post" action="/admin/users/@u.Id/enable">
                                        <AntiforgeryToken />
                                        <button type="submit" class="btn btn--sm">Re-enable</button>
                                    </form>
                                }
                                <button type="button" class="btn btn--sm" @onclick="() => OpenNameRow(u)">
                                    <Icon Name="pencil" Width="14" Height="14" />
                                    <span>Edit name</span>
                                </button>
                                <button type="button" class="btn btn--sm" @onclick="() => ToggleEmailRow(u.Id)">
                                    <Icon Name="mail" Width="14" Height="14" />
                                    <span>Change email</span>
                                </button>
                            </span>
                        </td>
                    </tr>
                    @if (_nameRowOpen == u.Id)
                    {
                        <tr class="is-subrow">
                            <td colspan="7">
                                <div class="u-row">
                                    <input class="input input--sm" type="text" @bind="_nameDraft" @bind:event="oninput"
                                           minlength="2" maxlength="80" aria-label="Full name" placeholder="Full name" />
                                    <button type="button" class="btn btn--sm btn--primary"
                                            @onclick="() => SaveNameAsync(u)" disabled="@_busy">Save name</button>
                                    <button type="button" class="btn btn--sm" @onclick="CloseNameRow">Cancel</button>
                                    @if (_nameError is not null)
                                    {
                                        <span class="field-error" role="alert">
                                            <Icon Name="circle-alert" Width="13" Height="13" />@_nameError
                                        </span>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                    @if (_emailRowOpen == u.Id)
                    {
                        <tr class="is-subrow">
                            <td colspan="7">
                                @if (!string.IsNullOrEmpty(u.PendingEmail))
                                {
                                    <p class="field__hint">
                                        Pending change to <strong>@u.PendingEmail</strong> (requested @u.PendingEmailAt?.ToString("yyyy-MM-dd HH:mm 'UTC'")).
                                    </p>
                                }
                                <form method="post" action="/admin/users/@u.Id/email" class="u-row">
                                    <AntiforgeryToken />
                                    <input class="input input--sm" type="email" name="NewEmail" required maxlength="254"
                                           aria-label="New email address" placeholder="new@example.com" />
                                    <button type="submit" class="btn btn--sm btn--primary">Send confirmation</button>
                                    <button type="button" class="btn btn--sm" @onclick="() => ToggleEmailRow(0)">Cancel</button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </section>
    }
    </Body>
</AdministrationHeader>

<ConfirmDialog @ref="_confirm" />

@code {
    [SupplyParameterFromQuery(Name = "err")] public string? Error { get; set; }
    [SupplyParameterFromQuery(Name = "ok")] public string? Ok { get; set; }

    private List<(SignupRequest Request, User? User)>? _pending;
    private List<User>? _active;
    private List<(Invite Invite, User? InvitedBy)>? _invites;

    private readonly HashSet<int> _selected = new();
    private HashSet<int> _entraLinkedUserIds = new();
    private bool _busy;
    private string? _lastError;
    private string? _lastSuccess;
    private IReadOnlyList<BulkActionFailure> _lastFailures = Array.Empty<BulkActionFailure>();
    private ConfirmDialog? _confirm;
    private int _emailRowOpen;
    private string? _oneShotLink;
    private int _nameRowOpen;
    private string _nameDraft = string.Empty;
    private string? _nameError;

    private void ToggleEmailRow(int id) => _emailRowOpen = _emailRowOpen == id ? 0 : id;

    private void OpenNameRow(User user)
    {
        _nameRowOpen = user.Id;
        _nameDraft = user.DisplayName;
        _nameError = null;
    }

    private void CloseNameRow()
    {
        _nameRowOpen = 0;
        _nameError = null;
    }

    private async Task SaveNameAsync(User user)
    {
        if (_busy) return;
        var orgId = Org.CurrentOrganizationId;
        if (orgId is null) return;

        _busy = true;
        _nameError = null;
        try
        {
            await Accounts.ChangeDisplayNameAsync(user.Id, _nameDraft, orgId.Value);
            // The reloaded table is the confirmation - the row shows the new
            // name. Close the editor and drop any stale per-row error.
            _nameRowOpen = 0;
            await LoadAsync();
        }
        catch (PlanValidationException ex)
        {
            _nameError = ex.Errors.FirstOrDefault().Value ?? "The name was rejected.";
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "Failed to change full name for user {Id}.", user.Id);
            _nameError = "An unexpected error occurred. The name was not changed.";
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task CopyLinkAsync()
    {
        if (_oneShotLink is null) return;
        try { await JS.InvokeVoidAsync("aldtCopy", _oneShotLink); }
        catch { /* clipboard API blocked - user can copy manually */ }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        var ctx = Http.HttpContext;
        if (ctx is null) return;
        _oneShotLink = EndpointHelpers.ReadAndClearOneShotInviteCookie(ctx, Protection);
        if (_oneShotLink is not null) StateHasChanged();
    }

    private enum BulkAction { Disable, Enable, PromoteAdmin, DemoteUser }

    private bool AllVisibleSelected =>
        _active is { Count: > 0 } && _active.All(u => _selected.Contains(u.Id));

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        var orgId = Org.CurrentOrganizationId;
        if (orgId is null) return;

        var page = await Accounts.GetAdministrationPageAsync(orgId.Value);
        _pending = page.Pending;
        _active = page.Active;
        // Which members sign in with Microsoft - drives the badge on the row.
        _entraLinkedUserIds = page.EntraLinkedUserIds;
        _invites = page.Invites;
        _selected.RemoveWhere(id => !_active.Any(u => u.Id == id));
    }

    private void ToggleRow(int id, ChangeEventArgs e)
    {
        if (e.Value is bool checkedNow && checkedNow) _selected.Add(id);
        else _selected.Remove(id);
    }

    private void ToggleSelectAllVisible(ChangeEventArgs e)
    {
        var checkedNow = e.Value is bool b && b;
        if (_active is null) return;
        foreach (var u in _active)
        {
            if (checkedNow) _selected.Add(u.Id);
            else _selected.Remove(u.Id);
        }
    }

    private void ClearSelection()
    {
        _selected.Clear();
        _lastError = null;
        _lastSuccess = null;
        _lastFailures = Array.Empty<BulkActionFailure>();
    }

    private async Task ChangeRoleAsync(User user, ChangeEventArgs e)
    {
        if (_busy || _active is null) return;
        var orgId = Org.CurrentOrganizationId;
        if (orgId is null) return;
        var raw = e.Value?.ToString();
        if (string.IsNullOrEmpty(raw) || !Enum.TryParse<UserRole>(raw, out var newRole) || newRole == user.Role)
        {
            return;
        }

        if (_confirm is not null)
        {
            var confirmed = await _confirm.OpenAsync(
                title: $"Change {user.DisplayName}'s role?",
                message: $"Set role to {newRole}. The change applies immediately.",
                confirmLabel: "Change role",
                confirmButtonClass: newRole == UserRole.User ? "btn--danger" : "btn--primary");
            if (!confirmed)
            {
                // The select's bound value already changed; reload restores it.
                await LoadAsync();
                return;
            }
        }

        _busy = true;
        _lastError = null;
        _lastSuccess = null;
        try
        {
            await Accounts.ChangeRoleAsync(user.Id, newRole, orgId.Value);
            _lastSuccess = $"{user.DisplayName} is now a {newRole}.";
            await LoadAsync();
        }
        catch (PlanValidationException ex)
        {
            _lastError = ex.Errors.FirstOrDefault().Value ?? "The role change was rejected.";
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "Failed to change role for user {Id}.", user.Id);
            _lastError = "An unexpected error occurred. The role was not changed.";
            await LoadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task RequestBulkAsync(BulkAction action)
    {
        if (_selected.Count == 0 || _busy || _active is null) return;
        var orgId = Org.CurrentOrganizationId;
        if (orgId is null) return;

        var ids = _selected.ToList();
        var affected = _active.Where(u => ids.Contains(u.Id)).ToList();
        var label = action switch
        {
            BulkAction.Disable => "disable",
            BulkAction.Enable => "re-enable",
            BulkAction.PromoteAdmin => "promote to Admin",
            BulkAction.DemoteUser => "demote to User",
            _ => action.ToString(),
        };
        if (_confirm is not null)
        {
            var names = string.Join(", ", affected.Take(8).Select(u => u.DisplayName));
            if (affected.Count > 8) names += $", and {affected.Count - 8} more";
            var confirmed = await _confirm.OpenAsync(
                title: $"{Capitalize(label)} {affected.Count} user(s)?",
                message: $"This will {label}: {names}.",
                confirmLabel: Capitalize(label),
                confirmButtonClass: action == BulkAction.Disable ? "btn--danger" : "btn--primary");
            if (!confirmed) return;
        }

        _busy = true;
        _lastError = null;
        _lastSuccess = null;
        _lastFailures = Array.Empty<BulkActionFailure>();
        try
        {
            BulkActionResult result = action switch
            {
                BulkAction.Disable => await Accounts.BulkDisableUsersAsync(ids, orgId.Value),
                BulkAction.Enable => await Accounts.BulkEnableUsersAsync(ids, orgId.Value),
                BulkAction.PromoteAdmin => await Accounts.BulkChangeRoleAsync(ids, UserRole.Admin, orgId.Value),
                BulkAction.DemoteUser => await Accounts.BulkChangeRoleAsync(ids, UserRole.User, orgId.Value),
                _ => throw new InvalidOperationException($"Unknown action {action}"),
            };
            _lastFailures = result.Failures;
            if (result.AllSucceeded)
            {
                _lastSuccess = $"Bulk {label} applied to {result.SucceededCount} user(s).";
            }
            else if (result.SucceededCount == 0)
            {
                _lastError = $"Bulk {label} failed for all {result.FailedCount} selected user(s). See details below.";
            }
            else
            {
                _lastSuccess = $"Bulk {label} applied to {result.SucceededCount} of {result.TotalRequested} user(s).";
            }
            _selected.Clear();
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "Bulk {Action} on users raised an unexpected error.", label);
            _lastError = "An unexpected error occurred. The change was not saved.";
        }
        finally
        {
            _busy = false;
        }
    }

}
