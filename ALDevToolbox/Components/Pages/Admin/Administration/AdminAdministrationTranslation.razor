@page "/admin/administration/translation"
@attribute [Authorize(Roles = "Admin")]
@rendermode InteractiveServer
@inject MachineTranslationSettingsService MtSettings
@inject MachineTranslationService Mt
@inject ILogger<AdminAdministrationTranslation> Log
@using ALDevToolbox.Domain.ValueObjects
@using ALDevToolbox.Services
@using ALDevToolbox.Services.Translation

@*
    Per-organisation machine-translation (BYOK) configuration. Admins enter the
    org's own provider API key - encrypted with the Data Protection key ring -
    and choose when the Translator calls out. "Off" is the default and the master
    switch. See .design/translator/ for the feature design.
*@

<PageTitle>Translation · Administration · AL Dev Toolbox</PageTitle>

<AdministrationHeader ActiveTab="AdministrationHeader.Tab.Translation">
    <Alerts>
        @if (!string.IsNullOrEmpty(_okMessage))
        {
            <p class="alert alert--success" role="status">
                <Icon Name="circle-check" Width="16" Height="16" /><span>@_okMessage</span>
            </p>
        }
        @if (!string.IsNullOrEmpty(_errMessage))
        {
            <p class="alert alert--danger" role="alert">
                <Icon Name="circle-alert" Width="16" Height="16" /><span>@_errMessage</span>
            </p>
        }
        @if (!string.IsNullOrEmpty(_testMessage))
        {
            <p class="alert @(_testOk ? "alert--success" : "alert--danger")" role="status">
                <Icon Name="@(_testOk ? "circle-check" : "circle-alert")" Width="16" Height="16" /><span>@_testMessage</span>
            </p>
        }
    </Alerts>
    <Body>
        @if (_loading)
        {
            <div class="loading-block"><span class="spinner"></span><span>Loading...</span></div>
        }
        else
        {
            <div class="setting-list">
                <SettingRow Name="When to translate automatically">
                    <HintContent>
                        DeepL charges per character, so this is the setting that decides
                        the bill. "Only when asked" is the cheapest.
                    </HintContent>
                    <ChildContent>
                        <span class="select-wrap">
                            <select id="mt-trigger" class="select" @bind="_trigger" disabled="@_saving"
                                    aria-label="When to translate automatically">
                                <option value="@MtTrigger.Off">Never - no translation service is used</option>
                                <option value="@MtTrigger.OnDemand">Only when asked</option>
                                <option value="@MtTrigger.AutoWhenNoExactMatch">When there is no match in your memory</option>
                                <option value="@MtTrigger.AlwaysAuto">For everything</option>
                            </select>
                            <Icon Name="chevron-down" Width="15" Height="15" Css="select-wrap__caret" />
                        </span>
                    </ChildContent>
                </SettingRow>

                <SettingRow Name="Service">
                    <HintContent>
                        Today the only choice is
                        <a href="https://www.deepl.com/pro-api" target="_blank" rel="noopener">DeepL</a>.
                        Free and paid keys both work.
                    </HintContent>
                    <ChildContent>
                        <span class="select-wrap">
                            <select id="mt-provider" class="select" @bind="_provider" disabled="@_saving"
                                    aria-label="Translation service">
                                <option value="deepl">DeepL</option>
                            </select>
                            <Icon Name="chevron-down" Width="15" Height="15" Css="select-wrap__caret" />
                        </span>
                    </ChildContent>
                </SettingRow>

                <SettingRow Name="Your key">
                    <HintContent>
                        Stored encrypted, and only ever sent to DeepL. Free keys end in
                        <code class="code">:fx</code>.
                    </HintContent>
                    <ChildContent>
                        <input id="mt-key" type="password" class="input" autocomplete="off"
                               aria-label="Translation service key"
                               placeholder="@(_hasStoredKey ? "Unchanged" : "Paste your DeepL key")"
                               @bind="_apiKey" disabled="@(_saving || _clearKey)" />
                        @if (_hasStoredKey)
                        {
                            <label class="check @(_saving ? "is-disabled" : "")">
                                <input type="checkbox" @bind="_clearKey" disabled="@_saving" />
                                <span class="check__box"><Icon Name="check" Width="12" Height="12" /></span>
                                <span>Forget the saved key</span>
                            </label>
                        }
                    </ChildContent>
                </SettingRow>

                <SettingRow Name="Test it"
                            Hint="Checks the key as it is currently saved, so save any changes first.">
                    <span>
                        <button type="button" class="btn" @onclick="TestAsync"
                                disabled="@(_saving || _testing || _trigger == MtTrigger.Off)"
                                title="@(_trigger == MtTrigger.Off ? "Pick something other than Never, then save." : null)">
                            <Icon Name="plug" Width="14" Height="14" />
                            <span>@(_testing ? "Testing..." : "Test the connection")</span>
                        </button>
                    </span>
                </SettingRow>
            </div>
        }
    </Body>
    <Foot>
        @if (!_loading)
        {
            <button type="button" class="btn btn--primary" @onclick="SaveAsync" disabled="@_saving">
                <Icon Name="save" Width="16" Height="16" />
                <span>@(_saving ? "Saving..." : "Save changes")</span>
            </button>
        }
    </Foot>
    <Aside>
        <p class="alert alert--info">
            <Icon Name="info" Width="16" Height="16" />
            <span>
                Your key stays on this site. It is only used to call DeepL when the
                setting above says to.
            </span>
        </p>
    </Aside>
</AdministrationHeader>

@code {
    private bool _loading = true;
    private bool _saving;
    private bool _testing;
    private string? _okMessage;
    private string? _errMessage;
    private string? _testMessage;
    private bool _testOk;

    private MtTrigger _trigger = MtTrigger.Off;
    private string _provider = "deepl";
    private string? _apiKey;
    private bool _clearKey;
    private bool _hasStoredKey;

    protected override async Task OnInitializedAsync()
    {
        await ReloadAsync();
        _loading = false;
    }

    private async Task ReloadAsync()
    {
        var view = await MtSettings.GetMachineTranslationViewAsync();
        _trigger = view.Trigger;
        _provider = view.Provider;
        _hasStoredKey = view.HasApiKey;
        _apiKey = null;
        _clearKey = false;
    }

    private async Task SaveAsync()
    {
        if (_saving) return;
        _saving = true;
        _okMessage = _errMessage = _testMessage = null;
        try
        {
            await MtSettings.SaveMachineTranslationAsync(new MtSettingsInput(_provider, _apiKey, _clearKey, _trigger));
            await ReloadAsync();
            _okMessage = "Translation settings saved.";
        }
        catch (PlanValidationException ex)
        {
            _errMessage = ex.Errors.FirstOrDefault().Value ?? "That did not save. Check the values and try again.";
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "Failed to save machine-translation settings.");
            _errMessage = "An unexpected error occurred. The change was not saved.";
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task TestAsync()
    {
        if (_saving || _testing) return;
        _testing = true;
        _okMessage = _errMessage = _testMessage = null;
        try
        {
            var result = await Mt.TestConnectionAsync();
            _testOk = result.Success;
            _testMessage = result.Message;
        }
        catch (Exception ex)
        {
            Log.LogWarning(ex, "Machine-translation test connection failed.");
            _testOk = false;
            // The provider's own exception text is a stack-shaped HTTP message, not
            // something an admin can act on. It is already logged above.
            _testMessage = "Could not reach the translation service. Check the key and try again.";
        }
        finally
        {
            _testing = false;
        }
    }
}
