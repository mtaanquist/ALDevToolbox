@page "/admin/audit/{id:int}/diff"
@attribute [Authorize(Roles = "Admin")]
@inject AuditService Audit
@inject NavigationManager Nav
@using ALDevToolbox.Domain.Entities
@using ALDevToolbox.Components.Shared
@using static ALDevToolbox.Components.Shared.AdminPageHelpers

<PageTitle>Audit change · AL Dev Toolbox</PageTitle>

@*
    The permalink target for one audit entry, on archetype 3's detail pieces:
    .detail-head for the title row and .meta-row for the facts that used to sit
    in a <dl>. The diff itself is AuditDiffViewer, already on the design
    system's .diff block from 8a. See .design/design-migration.md.
*@

<div class="page">
    @* No wrapper class: .page is a grid with its own gap, and .rd-back's extra
       margin is scoped to the recipe page anyway. *@
    <div>
        <a class="btn" href="/admin/audit">
            <Icon Name="arrow-left" Width="14" Height="14" />
            <span>Back to audit log</span>
        </a>
    </div>

    @if (_entry is null)
    {
        <div class="loading-block">
            <span class="spinner"></span><span>Loading change...</span>
        </div>
    }
    else if (_notFound)
    {
        <div class="card">
            <div class="empty-state">
                <span class="empty-state__icon"><Icon Name="circle-alert" Width="21" Height="21" /></span>
                <span class="empty-state__title">That change is not here</span>
                <span class="empty-state__text">
                    Entry <code>#@Id</code> does not exist in your organisation. It may
                    belong to another one, or have been removed with the record it
                    described.
                </span>
                <a class="btn empty-state__action" href="/admin/audit">Back to audit log</a>
            </div>
        </div>
    }
    else
    {
        <div class="detail-head">
            <div>
                <div class="detail-head__title-row">
                    <h1 class="detail-head__title">
                        @FriendlyAuditType(_entry.EntityType) <code>#@_entry.EntityId</code>
                    </h1>
                    <span class="status-pill @AuditActionPill(_entry.Action)">@_entry.Action</span>
                </div>
                <p class="page-head__sub">
                    What changed when @_entry.ChangedBy @AuditVerb(_entry.Action) this record.
                    The "after" side is taken from the next change to the same record, so the
                    most recent change has nothing to compare against yet.
                </p>
            </div>
        </div>

        <div class="meta-row">
            <div class="meta-item">
                <span class="meta-item__label">When (UTC)</span>
                <span class="meta-item__value">@_entry.Timestamp.ToString("yyyy-MM-dd HH:mm:ss")</span>
            </div>
            <div class="meta-item">
                <span class="meta-item__label">Changed by</span>
                <span class="meta-item__value">@_entry.ChangedBy</span>
            </div>
        </div>

        <AuditDiffViewer
            BeforeJson="@_beforeJson"
            AfterJson="@_afterJson"
            BeforeLabel="@_beforeLabel"
            AfterLabel="@_afterLabel" />
    }
</div>

@code {
    [Parameter] public int Id { get; set; }

    private AuditLogEntry? _entry;
    private bool _notFound;
    private string? _beforeJson;
    private string? _afterJson;
    private string? _beforeLabel;
    private string? _afterLabel;

    protected override async Task OnInitializedAsync()
    {
        var entry = await Audit.GetByIdAsync(Id);
        if (entry is null)
        {
            _notFound = true;
            _entry = new AuditLogEntry();
            return;
        }
        _entry = entry;
        // The audit-log snapshot is the state *before* the change captured by
        // this row. To produce a sensible "after", grab the snapshot of the
        // next-newer audit row for the same entity. None means we hit either
        // the entity's current state (no later change yet) or a deletion.
        _beforeJson = entry.SnapshotJson;
        _beforeLabel = entry.Action == AuditAction.Created
            ? "no prior state (created)"
            : entry.Timestamp.ToString("yyyy-MM-dd HH:mm:ss");

        var next = await Audit.GetNextForEntityAsync(entry);
        if (next is not null)
        {
            _afterJson = next.SnapshotJson;
            _afterLabel = next.Timestamp.ToString("yyyy-MM-dd HH:mm:ss");
        }
        else if (entry.Action == AuditAction.Deleted)
        {
            _afterJson = null;
            _afterLabel = "deleted (no later state)";
        }
        else
        {
            _afterJson = null;
            _afterLabel = "no later audit entry recorded yet";
        }
    }
}
