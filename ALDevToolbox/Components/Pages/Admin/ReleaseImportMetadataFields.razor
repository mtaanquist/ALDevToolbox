@*
    The Release identity fields shared by the Third-party, DVD, and C/AL import
    tabs, rendered inside each tab's <form data-oe-import-form>. The Kind is
    fixed per tab (a hidden input) except on the DVD tab, which legitimately
    hosts both Microsoft and partner DVDs and keeps a two-option select;
    object-explorer-import.js hides Parent/Publisher there when First-party is
    picked (no-JS submits leave them visible, which the endpoint tolerates).
    The Artifacts tab doesn't use this - those releases are always first-party
    with an auto-generated label. The C/AL tab passes ShowParent/ShowPublisher
    false: a C/AL export is self-contained, so only the Label applies.
*@

@using ALDevToolbox.Services.ObjectExplorer

<section class="form-sec">
    <label class="field">
        <span class="field__label">Label</span>
        <input type="text" name="Label" required maxlength="120"
               placeholder="@LabelPlaceholder"
               class="input" />
        <small class="field__hint">
            Shown when you pick this release in the Object Explorer. Use
            something memorable - "@LabelGoodExample" beats "@LabelBadExample".
        </small>
    </label>

    @if (FixedKind is not null)
    {
        <input type="hidden" name="Kind" value="@FixedKind" />
    }
    else
    {
        <label class="field">
            <span class="field__label">Kind</span>
            <span class="select-wrap">
                <select name="Kind" required class="select">
                    <option value="first_party">First-party (Microsoft)</option>
                    <option value="third_party">Third-party / partner</option>
                </select>
                <Icon Name="chevron-down" Width="15" Height="15" Css="select-wrap__caret" />
            </span>
            <small class="field__hint">
                Third-party releases build on top of a Microsoft (first-party)
                release - pick that base below.
            </small>
        </label>
    }

    @if (ShowParent)
    {
        <label class="field" data-oe-field-parent>
            <span class="field__label">Parent Release (optional)</span>
            <span class="select-wrap">
                <select name="ParentReleaseId" class="select">
                    <option value="">- no base release -</option>
                    @if (ParentCandidates is not null)
                    {
                        @foreach (var r in ParentCandidates)
                        {
                            <option value="@r.Id">@r.Label</option>
                        }
                    }
                </select>
                <Icon Name="chevron-down" Width="15" Height="15" Css="select-wrap__caret" />
            </span>
            <small class="field__hint">
                The Microsoft release this app extends, so references to its
                objects resolve correctly.
            </small>
        </label>
    }

    @if (ShowPublisher)
    {
        <label class="field" data-oe-field-publisher>
            <span class="field__label">Publisher (optional)</span>
            <input type="text" name="Publisher" maxlength="200"
                   placeholder="e.g. Continia Software"
                   class="input" />
            <small class="field__hint">
                Who publishes this extension. Releases are grouped by publisher
                in the Object Explorer.
            </small>
        </label>
    }
</section>

@code {
    /// <summary>Ready first-party Releases offered as parents in the dropdown.</summary>
    [Parameter] public IReadOnlyList<ReleaseListItem>? ParentCandidates { get; set; }

    /// <summary>
    /// When set, the Kind is posted as a hidden input with this value and no
    /// select is rendered. Null (the DVD tab) keeps the First-/Third-party select.
    /// </summary>
    [Parameter] public string? FixedKind { get; set; }

    [Parameter] public bool ShowParent { get; set; } = true;
    [Parameter] public bool ShowPublisher { get; set; } = true;

    /// <summary>Label placeholder/caption examples, overridable per tab (the C/AL tab shows a C/AL-flavoured one).</summary>
    [Parameter] public string LabelPlaceholder { get; set; } = "e.g. BC 25.18 DK or CRONUS on BC 25.18";
    [Parameter] public string LabelGoodExample { get; set; } = "BC 25.18 DK";
    [Parameter] public string LabelBadExample { get; set; } = "release_20260601_v3";
}
