@page "/admin/cookbook/suggestions"
@attribute [Authorize(Roles = "Admin,Editor")]
@rendermode InteractiveServer
@inject RecipeSuggestionService Suggestions
@using ALDevToolbox.Domain.Entities

<PageTitle>Recipe suggestions · Admin · AL Dev Toolbox</PageTitle>

<div class="admin-page">
    <a class="btn btn--sm" href="/admin/cookbook">
        <Icon Name="arrow-left" Width="14" Height="14" />
        <span>Back to cookbook</span>
    </a>

    <h1>Recipe suggestions</h1>
    <p class="muted">
        Drafts submitted by users. Open one to review it in full and approve
        or reject it.
    </p>

    @if (_pending is null)
    {
        <p class="muted">Loading...</p>
    }
    else if (_pending.Count == 0)
    {
        <p class="muted">No pending suggestions. New ones appear here as users submit them.</p>
    }
    else
    {
        <table class="data-table">
            <thead>
                <tr>
                    <th>Title</th>
                    <th>Type</th>
                    <th>Submitted by</th>
                    <th>Files</th>
                    <th>Submitted (UTC)</th>
                    <th class="data-table__actions"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in _pending)
                {
                    <tr>
                        <td>@s.Title</td>
                        <td>@s.Type</td>
                        <td class="muted">@(s.SuggestedByUser?.DisplayName ?? "unknown user")</td>
                        <td>@s.Files.Count</td>
                        <td><time datetime="@s.RequestedAt.ToString("O")">@s.RequestedAt.ToString("yyyy-MM-dd HH:mm:ss")</time></td>
                        <td class="data-table__actions">
                            <a class="btn btn--sm" href="@($"/admin/cookbook/suggestions/{s.Id}")">
                                <Icon Name="inbox" Width="14" Height="14" />
                                <span>Review</span>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    private List<RecipeSuggestion>? _pending;

    protected override async Task OnInitializedAsync()
    {
        _pending = await Suggestions.GetPendingAsync();
    }
}
