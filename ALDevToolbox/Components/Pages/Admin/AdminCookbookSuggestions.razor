@page "/admin/cookbook/suggestions"
@attribute [Authorize(Roles = "Admin,Editor")]
@rendermode InteractiveServer
@inject RecipeSuggestionService Suggestions
@using ALDevToolbox.Domain.Entities

<PageTitle>Recipe suggestions · Admin · AL Dev Toolbox</PageTitle>

<div class="page">
    <header class="page-head">
        <div>
            <p class="page-head__crumbs">
                <a href="/admin/cookbook">Cookbook</a>
                <Icon Name="chevron-right" Width="12" Height="12" />
                <span>Suggestions</span>
            </p>
            <h1 class="page-head__title">Recipe suggestions</h1>
            <p class="page-head__sub">
                Drafts your team has submitted. Open one to review it in full and
                approve or reject it.
            </p>
        </div>
        <div class="page-head__actions">
            <a class="btn btn--sm" href="/admin/cookbook">
                <Icon Name="arrow-left" Width="14" Height="14" />
                <span>Back to cookbook</span>
            </a>
        </div>
    </header>

    @if (_pending is null)
    {
        <div class="loading-block"><span class="spinner"></span><span>Loading...</span></div>
    }
    else if (_pending.Count == 0)
    {
        <div class="card">
            <div class="empty-state">
                <span class="empty-state__icon"><Icon Name="inbox" Width="21" Height="21" /></span>
                <span class="empty-state__title">Nothing waiting</span>
                <span class="empty-state__text">Recipes your team submits appear here for review.</span>
            </div>
        </div>
    }
    else
    {
        <table class="data-table">
            <thead>
                <tr>
                    <th>Title</th>
                    <th>Type</th>
                    <th>Submitted by</th>
                    <th>Files</th>
                    <th>Submitted (UTC)</th>
                    <th class="data-table__actions"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in _pending)
                {
                    <tr>
                        <td>@s.Title</td>
                        <td>@s.Type</td>
                        <td class="u-muted">@(s.SuggestedByUser?.DisplayName ?? "unknown user")</td>
                        <td>@s.Files.Count</td>
                        <td><time datetime="@s.RequestedAt.ToString("O")">@s.RequestedAt.ToString("yyyy-MM-dd HH:mm:ss")</time></td>
                        <td class="data-table__actions">
                            <a class="btn btn--sm" href="@($"/admin/cookbook/suggestions/{s.Id}")">
                                <Icon Name="inbox" Width="14" Height="14" />
                                <span>Review</span>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    private List<RecipeSuggestion>? _pending;

    protected override async Task OnInitializedAsync()
    {
        _pending = await Suggestions.GetPendingAsync();
    }
}
