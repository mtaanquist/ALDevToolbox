@page "/admin/cookbook/suggestions"
@attribute [Authorize(Roles = "Admin,Editor")]
@rendermode InteractiveServer
@inject RecipeSuggestionService Suggestions
@using ALDevToolbox.Domain.Entities
@using ALDevToolbox.Services.Cookbook

<PageTitle>Recipe suggestions · Admin · AL Dev Toolbox</PageTitle>

<ListPage Title="Recipe suggestions" ShowActions="true" FiltersWhenEmpty="true"
          IsLoading="@(_pending is null)"
          IsEmpty="@(_pending is not null && _pending.Count == 0)" Sticky="true"
          Trail='@([new("Cookbook", "/admin/cookbook"), new("Suggestions")])'>
    <SubtitleContent>
        Drafts your team has submitted. Open one to review it in full and
        approve or reject it.
    </SubtitleContent>
    <Loading>
        <LoadingBlock Text="Loading..." />
    </Loading>
    <Empty>
        <div class="card">
            <EmptyState Icon="inbox" Title="Nothing waiting">
                <Text>Recipes your team submits appear here for review.</Text>
            </EmptyState>
        </div>
    </Empty>
    <ChildContent>
        <table class="data-table">
            <thead>
                <tr>
                    <th>Title</th>
                    <th>Type</th>
                    <th>Submitted by</th>
                    <th>Files</th>
                    <th>Submitted (UTC)</th>
                    <th class="data-table__actions">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in _pending ?? new())
                {
                    <tr>
                        <td>@s.Title</td>
                        <td>@s.Type</td>
                        <td class="u-muted">@(s.SuggestedByUser?.DisplayName ?? "unknown user")</td>
                        <td>@s.Files.Count</td>
                        <td><time datetime="@s.RequestedAt.ToString("O")">@s.RequestedAt.ToString("yyyy-MM-dd HH:mm:ss")</time></td>
                        <td class="data-table__actions">
                            <a class="btn btn--sm" href="@($"/admin/cookbook/suggestions/{s.Id}")">
                                <Icon Name="inbox" Width="14" Height="14" />
                                <span>Review</span>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </ChildContent>
</ListPage>

@code {
    private List<RecipeSuggestion>? _pending;

    protected override async Task OnInitializedAsync()
    {
        _pending = await Suggestions.GetPendingAsync();
    }
}
