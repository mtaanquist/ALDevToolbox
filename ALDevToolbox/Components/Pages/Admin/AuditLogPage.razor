@page "/admin/audit"
@attribute [Authorize(Roles = "Admin")]
@inject AuditService Audit
@using ALDevToolbox.Components.Shared
@using ALDevToolbox.Domain.Entities
@using ALDevToolbox.Services
@using static ALDevToolbox.Components.Shared.AdminPageHelpers

<PageTitle>Audit log · AL Dev Toolbox</PageTitle>

@*
    The org-wide audit log, on the same .audit list as AuditHistoryPanel (8a) --
    the two are the same list with a different filter, so they should not look
    like different things.

    Unlike the panel, a row here does not expand: the panel's entries are all one
    entity, so the state after entry i is entry i-1's snapshot and pairing is
    free. This list is cross-entity and paginated, so neighbouring rows are
    unrelated and an expansion would cost a query each. Rows link to the diff
    page instead, which already renders the pairing properly.

    That also retires the "Snapshot / Show JSON" column. It printed the raw
    before-state; the page it now links to shows before AND after with the
    changed fields marked, so nothing is lost.
    See .design/design-migration.md.
*@

<div class="page">
    <div class="page-head">
        <div>
            <h1 class="page-head__title">Audit log</h1>
            <p class="page-head__sub">
                Every change to templates, modules, the dependency catalogue,
                recipes and other tracked records - newest first. Open an entry
                to see exactly which fields changed.
            </p>
        </div>
    </div>

    @*
        Filters apply on change rather than waiting for a submit button: selects
        fire change events synchronously, and the text inputs submit on Enter or
        when they lose focus. Keeping the form GET-based preserves bookmarkable
        URLs and uses the same SupplyParameterFromQuery wiring as the rest of the
        audit family.
    *@
    <form method="get" action="/admin/audit" class="card filter-grid" onchange="this.submit()">
        <label class="field">
            <span class="field__label">Entity type</span>
            <span class="select-wrap">
                <select class="select" name="entityType">
                    <option value="">Any</option>
                    @foreach (var type in Enum.GetValues<AuditEntityType>())
                    {
                        <option value="@type" selected="@(EntityType == type.ToString())">@FriendlyAuditType(type)</option>
                    }
                </select>
                <Icon Name="chevron-down" Width="15" Height="15" Css="select-wrap__caret" />
            </span>
        </label>
        <label class="field">
            <span class="field__label">Action</span>
            <span class="select-wrap">
                <select class="select" name="action">
                    <option value="">Any</option>
                    @foreach (var act in Enum.GetValues<AuditAction>())
                    {
                        <option value="@act" selected="@(Action == act.ToString())">@act</option>
                    }
                </select>
                <Icon Name="chevron-down" Width="15" Height="15" Css="select-wrap__caret" />
            </span>
        </label>
        <label class="field">
            <span class="field__label">Record id</span>
            <input class="input" type="text" name="entityId" value="@EntityId" placeholder="exact match" />
        </label>
        <label class="field">
            <span class="field__label">Changed by</span>
            <input class="input" type="text" name="actor" value="@Actor" placeholder="email or name" />
        </label>
        <label class="field">
            <span class="field__label">From (UTC)</span>
            <input class="input" type="datetime-local" name="from" value="@FromUtc" />
        </label>
        <label class="field">
            <span class="field__label">To (UTC)</span>
            <input class="input" type="datetime-local" name="to" value="@ToUtc" />
        </label>
    </form>

    @if (_entries is null)
    {
        <div class="loading-block">
            <span class="spinner"></span><span>Loading changes...</span>
        </div>
    }
    else if (_entries.Count == 0)
    {
        <div class="card">
            @if (_total == 0 && !HasAnyFilter())
            {
                <div class="empty-state">
                    <span class="empty-state__icon"><Icon Name="history" Width="21" Height="21" /></span>
                    <span class="empty-state__title">No changes recorded yet</span>
                    <span class="empty-state__text">
                        As soon as someone edits a template, module, catalogue entry
                        or recipe, the change shows up here with who made it.
                    </span>
                </div>
            }
            else
            {
                <div class="empty-state">
                    <span class="empty-state__icon"><Icon Name="funnel-x" Width="21" Height="21" /></span>
                    <span class="empty-state__title">No changes match these filters</span>
                    <span class="empty-state__text">Try widening the date range, or clear the filters to see everything.</span>
                    <a class="btn empty-state__action" href="/admin/audit">Clear filters</a>
                </div>
            }
        </div>
    }
    else
    {
        <div class="card">
            <div class="audit">
                @foreach (var e in _entries)
                {
                    <div class="audit__entry">
                        <a class="audit__sum" href="@($"/admin/audit/{e.Id}/diff")">
                            <span class="audit__time">
                                <time datetime="@e.Timestamp.ToString("O")">@e.Timestamp.ToString("yyyy-MM-dd HH:mm")</time>
                            </span>
                            <span class="audit__avatar" aria-hidden="true">@Avatar.Initials(e.ChangedBy)</span>
                            <span class="audit__what">
                                <span class="audit__who">@e.ChangedBy</span>
                                @AuditVerb(e.Action) <AuditSubjectText EntityType="e.EntityType" EntityId="e.EntityId" EntityName="@e.EntityName" SnapshotJson="@e.SnapshotJson" />
                            </span>
                            <span class="status-pill @AuditActionPill(e.Action)">@e.Action</span>
                            <Icon Name="chevron-right" Width="15" Height="15" Css="audit__caret" />
                        </a>
                    </div>
                }
            </div>
        </div>

        @* Only when there is somewhere to go. A pager with both buttons dead
           is furniture, and the count is already implied by the list. *@
        <nav class="pager" aria-label="Audit log pages" hidden="@(_totalPages <= 1)">
            <span class="pager__count">
                Showing @_firstRowNumber.ToString("N0")-@_lastRowNumber.ToString("N0") of @_total.ToString("N0")
            </span>
            @{
                var currentPage = Page ?? 1;
                var hasPrev = currentPage > 1;
                var hasNext = currentPage < _totalPages;
            }
            <span class="pager__buttons">
                @* Rendered as a span rather than a disabled link on the first and
                   last page: an <a> with no href is not focusable and needs no
                   aria-disabled, where a link that looks live and does nothing
                   invites the click twice. *@
                @if (hasPrev)
                {
                    <a class="btn btn--sm" href="@BuildPageUrl(currentPage - 1)">
                        <Icon Name="chevron-left" Width="14" Height="14" />
                        <span>Previous</span>
                    </a>
                }
                else
                {
                    <span class="btn btn--sm is-disabled" aria-hidden="true">
                        <Icon Name="chevron-left" Width="14" Height="14" />
                        <span>Previous</span>
                    </span>
                }
                @if (hasNext)
                {
                    <a class="btn btn--sm" href="@BuildPageUrl(currentPage + 1)">
                        <span>Next</span>
                        <Icon Name="chevron-right" Width="14" Height="14" />
                    </a>
                }
                else
                {
                    <span class="btn btn--sm is-disabled" aria-hidden="true">
                        <span>Next</span>
                        <Icon Name="chevron-right" Width="14" Height="14" />
                    </span>
                }
            </span>
        </nav>
    }
</div>

@code {
    private const int PageSize = 50;

    [SupplyParameterFromQuery(Name = "entityType")] public string? EntityType { get; set; }
    [SupplyParameterFromQuery(Name = "action")] public string? Action { get; set; }
    [SupplyParameterFromQuery(Name = "entityId")] public string? EntityId { get; set; }
    [SupplyParameterFromQuery(Name = "actor")] public string? Actor { get; set; }
    [SupplyParameterFromQuery(Name = "from")] public string? FromUtc { get; set; }
    [SupplyParameterFromQuery(Name = "to")] public string? ToUtc { get; set; }
    [SupplyParameterFromQuery(Name = "page")] public int? Page { get; set; }

    private List<AuditLogEntry>? _entries;
    private int _total;
    private int _totalPages;
    private int _firstRowNumber;
    private int _lastRowNumber;

    protected override async Task OnParametersSetAsync()
    {
        if (Page is null or < 1) Page = 1;
        var filter = new AuditFilter(
            EntityType: Enum.TryParse<AuditEntityType>(EntityType, ignoreCase: false, out var et) ? et : null,
            Action: Enum.TryParse<AuditAction>(Action, ignoreCase: false, out var ac) ? ac : null,
            EntityId: string.IsNullOrWhiteSpace(EntityId) ? null : EntityId.Trim(),
            Actor: string.IsNullOrWhiteSpace(Actor) ? null : Actor,
            From: DateTime.TryParse(FromUtc, out var f) ? DateTime.SpecifyKind(f, DateTimeKind.Utc) : null,
            To: DateTime.TryParse(ToUtc, out var t) ? DateTime.SpecifyKind(t, DateTimeKind.Utc) : null);

        var skip = (Page!.Value - 1) * PageSize;
        var (items, total) = await Audit.GetPagedAsync(filter, skip, PageSize);
        _entries = items;
        _total = total;
        _totalPages = Math.Max(1, (int)Math.Ceiling(total / (double)PageSize));
        _firstRowNumber = total == 0 ? 0 : skip + 1;
        _lastRowNumber = skip + items.Count;
    }

    private bool HasAnyFilter() =>
        !string.IsNullOrWhiteSpace(EntityType)
        || !string.IsNullOrWhiteSpace(Action)
        || !string.IsNullOrWhiteSpace(EntityId)
        || !string.IsNullOrWhiteSpace(Actor)
        || !string.IsNullOrWhiteSpace(FromUtc)
        || !string.IsNullOrWhiteSpace(ToUtc);

    private string BuildPageUrl(int page)
    {
        var parts = new List<string>(8);
        if (!string.IsNullOrWhiteSpace(EntityType)) parts.Add("entityType=" + Uri.EscapeDataString(EntityType));
        if (!string.IsNullOrWhiteSpace(Action)) parts.Add("action=" + Uri.EscapeDataString(Action));
        if (!string.IsNullOrWhiteSpace(EntityId)) parts.Add("entityId=" + Uri.EscapeDataString(EntityId));
        if (!string.IsNullOrWhiteSpace(Actor)) parts.Add("actor=" + Uri.EscapeDataString(Actor));
        if (!string.IsNullOrWhiteSpace(FromUtc)) parts.Add("from=" + Uri.EscapeDataString(FromUtc));
        if (!string.IsNullOrWhiteSpace(ToUtc)) parts.Add("to=" + Uri.EscapeDataString(ToUtc));
        if (page > 1) parts.Add("page=" + page);
        return parts.Count == 0 ? "/admin/audit" : "/admin/audit?" + string.Join("&", parts);
    }
}
