@page "/admin/templates/files"
@attribute [Authorize(Roles = "Admin,Editor")]
@rendermode InteractiveServer
@inject OrganizationConfigService Config
@inject NavigationManager Nav
@inject ILogger<AdminTemplateFiles> Log
@using ALDevToolbox.Domain.ValueObjects
@using ALDevToolbox.Services.Organizations

@*
    Always-included files sub-page (Issue #61). Text files written at the
    workspace root on every generation. The hint at the top lists the mustache
    variables substituted when "variables on" is set per file.
*@

<PageTitle>Files · Configuration · AL Dev Toolbox</PageTitle>

<div class="page">
    <header class="page-head">
        <div>
            <h1 class="page-head__title">Always-included files</h1>
            <p class="page-head__sub">
                Text files written into every workspace you generate. Turn on
                variable substitution per file to have names and IDs filled in.
            </p>
        </div>
        <div class="page-head__actions">
            <a class="btn btn--sm" href="/admin">
                <Icon Name="arrow-left" Width="14" Height="14" />
                <span>Back to admin</span>
            </a>
            @* Save lives in the sticky .form-actions bar at the foot of the form.
               This page runs to roughly two and a half viewports; a save that only
               exists above the fold is a save you cannot reach when you finish. *@
        </div>
    </header>

    @if (_loading)
    {
        <div class="loading-block"><span class="spinner"></span><span>Loading...</span></div>
    }
    else
    {
        @if (!string.IsNullOrEmpty(_okMessage))
        {
            <p class="alert alert--success" role="status">
                <Icon Name="circle-check" Width="16" Height="16" /><span>@_okMessage</span>
            </p>
        }
        @if (!string.IsNullOrEmpty(_errMessage))
        {
            <p class="alert alert--danger" role="alert">
                <Icon Name="circle-alert" Width="16" Height="16" /><span>@_errMessage</span>
            </p>
        }

        @* The generator's form-plus-sticky-aside archetype: the file list and
           its editor on the left, the variable reference parked on the right
           where it stays in view while you type. *@
        <div class="gen">
            <div class="gen__form u-stack">
                <section class="card">
                    <div class="card__head"><h2 class="card__title">Files (@_files.Count)</h2></div>
                    <div class="card__body form-sec">
                        @if (_files.Count == 0)
                        {
                            <div class="empty-state empty-state--quiet">
                                <span class="empty-state__title">No files yet</span>
                                <span class="empty-state__text">
                                    Add a <code class="code">.editorconfig</code>, a house
                                    <code class="code">README.md</code>, or anything else that should
                                    ship with every workspace. Use the form below.
                                </span>
                            </div>
                        }
                        else
                        {
                            @foreach (var file in _files.OrderBy(f => f.Ordering))
                            {
                                <div class="code-block">
                                    <div class="code-block__bar">
                                        <span class="u-row">
                                            <span class="code-block__name">@file.Path</span>
                                            <span class="field__hint">
                                                @(file.Scope == OrganizationFileScope.EveryExtension ? "per extension" : "workspace root")
                                                · @(file.MustacheEnabled ? "variables on" : "variables off")
                                            </span>
                                        </span>
                                        <span class="u-row">
                                            <button type="button" class="btn btn--sm" @onclick="() => StartEdit(file)">
                                                <Icon Name="pencil" Width="12" Height="12" />
                                                <span>Edit</span>
                                            </button>
                                            <button type="button" class="btn btn--sm" @onclick="() => RemoveFile(file)">
                                                <Icon Name="trash-2" Width="12" Height="12" />
                                                <span>Remove</span>
                                            </button>
                                        </span>
                                    </div>
                                    <pre>@TruncateForPreview(file.Content)</pre>
                                </div>
                            }
                        }
                    </div>
                </section>

                <section class="card">
                    <div class="card__head">
                        <h2 class="card__title">@(_editing is null ? "Add a file" : $"Editing {_editing.Path}")</h2>
                    </div>
                    <div class="card__body form-sec">
                        <div class="field">
                            <label class="field__label" for="cfg-file-path">Path</label>
                            <input class="input" id="cfg-file-path" type="text" placeholder=".editorconfig"
                                   @bind="_editPath" @bind:event="oninput" />
                        </div>
                        <div class="field">
                            <label class="field__label" for="cfg-file-content">Content</label>
                            <textarea class="textarea" id="cfg-file-content" rows="6"
                                      @bind="_editContent" @bind:event="oninput"></textarea>
                        </div>
                        <label class="check @(_editMustache ? "is-checked" : "")">
                            <input type="checkbox" @bind="_editMustache" />
                            <span class="check__box"><Icon Name="check" Width="12" Height="12" /></span>
                            <span>Substitute template variables when generating</span>
                        </label>

                        <div class="field">
                            <span class="field__label">Emit into</span>
                            <div class="check-list">
                                <label class="check @(_editScope == OrganizationFileScope.WorkspaceRoot ? "is-checked" : "")">
                                    <input type="radio" name="cfg-file-scope"
                                           checked="@(_editScope == OrganizationFileScope.WorkspaceRoot)"
                                           @onchange="@(() => _editScope = OrganizationFileScope.WorkspaceRoot)" />
                                    <span class="check__dot"></span>
                                    <span>Workspace root - once, at the top of the workspace.</span>
                                </label>
                                <label class="check @(_editScope == OrganizationFileScope.EveryExtension ? "is-checked" : "")">
                                    <input type="radio" name="cfg-file-scope"
                                           checked="@(_editScope == OrganizationFileScope.EveryExtension)"
                                           @onchange="@(() => _editScope = OrganizationFileScope.EveryExtension)" />
                                    <span class="check__dot"></span>
                                    <span>Every extension - a copy inside each extension folder, with variables resolved per extension.</span>
                                </label>
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(_localError))
                        {
                            <span class="field-error" role="alert">
                                <Icon Name="circle-alert" Width="13" Height="13" />@_localError
                            </span>
                        }
                    </div>
                    <div class="card__foot">
                        @if (_editing is not null)
                        {
                            <button type="button" class="btn btn--sm" @onclick="CancelEdit">Cancel</button>
                        }
                        <button type="button" class="btn btn--sm" @onclick="ApplyEdit">
                            <Icon Name="check" Width="12" Height="12" />
                            <span>@(_editing is null ? "Add to list" : "Apply changes")</span>
                        </button>
                    </div>
                </section>
            </div>

            <aside class="gen__aside">
                <details class="card card--collapsible" open>
                    <summary class="card__head"><h2 class="card__title">Template variables</h2></summary>
                    <div class="card__body form-sec">
                        <p class="form-sec__cap">
                            Substituted into file contents at generation time when
                            "Substitute template variables" is on for a file. Anything
                            we don't recognise is left exactly as you typed it.
                        </p>
                        @* Reads from MustacheVariableCatalog so this hint
                           never drifts from the generator's actual switch.
                           Lists All so admins authoring the per-extension
                           app.json see the full set including
                           {{dependencies_array}} and {{id_ranges_array}}. *@
                        <dl class="hint-details__list">
                            @foreach (var v in MustacheVariableCatalog.All)
                            {
                                <dt><code class="code">@($"{{{{{v.Name}}}}}")</code></dt>
                                <dd>@v.Caption</dd>
                            }
                        </dl>
                    </div>
                </details>
            </aside>
        </div>

        <div class="form-actions form-actions--sticky">
            <span class="form-actions__spacer"></span>
            @if (IsDirty)
            {
                <span class="form-actions__note">Unsaved changes</span>
            }
            <button type="button" class="btn btn--primary"
                    @onclick="SaveAsync"
                    disabled="@(_saving || !IsDirty)">
                <Icon Name="save" Width="16" Height="16" />
                <span>@(_saving ? "Saving..." : "Save changes")</span>
            </button>
        </div>
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "ok")] public string? OkParam { get; set; }

    private bool _loading = true;
    private bool _saving;
    private string? _okMessage;
    private string? _errMessage;
    private string? _localError;

    private List<FileRow> _files = new();
    private List<FileRow> _baseFiles = new();

    private FileRow? _editing;
    private string _editPath = string.Empty;
    private string _editContent = string.Empty;
    private bool _editMustache;
    private OrganizationFileScope _editScope = OrganizationFileScope.WorkspaceRoot;

    private sealed class FileRow
    {
        public int? Id { get; set; }
        public string Path { get; set; } = string.Empty;
        public string Content { get; set; } = string.Empty;
        public bool MustacheEnabled { get; set; }
        public OrganizationFileScope Scope { get; set; } = OrganizationFileScope.WorkspaceRoot;
        public int Ordering { get; set; }

        public FileRow Clone() => new()
        {
            Id = Id, Path = Path, Content = Content,
            MustacheEnabled = MustacheEnabled, Scope = Scope, Ordering = Ordering,
        };
    }

    private bool IsDirty
    {
        get
        {
            if (_files.Count != _baseFiles.Count) return true;
            for (var i = 0; i < _files.Count; i++)
            {
                var a = _files[i]; var b = _baseFiles[i];
                if (a.Id != b.Id || a.Path != b.Path || a.Content != b.Content
                    || a.MustacheEnabled != b.MustacheEnabled || a.Scope != b.Scope || a.Ordering != b.Ordering)
                {
                    return true;
                }
            }
            return false;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        _okMessage = OkParam == "saved" ? "Always-included files saved." : null;
    }

    private async Task LoadAsync()
    {
        var config = await Config.GetCurrentAsync();
        _files = config.Files
            .Select(f => new FileRow
            {
                Id = f.Id, Path = f.Path, Content = f.Content,
                MustacheEnabled = f.MustacheEnabled, Scope = f.Scope, Ordering = f.Ordering,
            })
            .ToList();
        _baseFiles = _files.Select(f => f.Clone()).ToList();
        _loading = false;
    }

    private void StartEdit(FileRow row)
    {
        _editing = row;
        _editPath = row.Path;
        _editContent = row.Content;
        _editMustache = row.MustacheEnabled;
        _editScope = row.Scope;
        _localError = null;
    }

    private void CancelEdit()
    {
        _editing = null;
        _editPath = string.Empty;
        _editContent = string.Empty;
        _editMustache = false;
        _editScope = OrganizationFileScope.WorkspaceRoot;
        _localError = null;
    }

    private void ApplyEdit()
    {
        var path = _editPath.Trim();
        if (string.IsNullOrEmpty(path))
        {
            _localError = "Path is required.";
            return;
        }
        if (path.Contains(".."))
        {
            _localError = "Path must not contain '..' segments.";
            return;
        }
        var conflict = _files.Any(f => f != _editing && string.Equals(f.Path, path, StringComparison.OrdinalIgnoreCase));
        if (conflict)
        {
            _localError = $"Another file already uses path '{path}'.";
            return;
        }

        if (_editing is null)
        {
            _files.Add(new FileRow
            {
                Path = path,
                Content = _editContent,
                MustacheEnabled = _editMustache,
                Scope = _editScope,
                Ordering = _files.Count,
            });
        }
        else
        {
            _editing.Path = path;
            _editing.Content = _editContent;
            _editing.MustacheEnabled = _editMustache;
            _editing.Scope = _editScope;
        }
        CancelEdit();
    }

    private void RemoveFile(FileRow row)
    {
        _files.Remove(row);
        for (var i = 0; i < _files.Count; i++) _files[i].Ordering = i;
        if (_editing == row) CancelEdit();
    }

    private async Task SaveAsync()
    {
        if (_saving || !IsDirty) return;
        _saving = true;
        _errMessage = null;
        _okMessage = null;
        try
        {
            for (var i = 0; i < _files.Count; i++) _files[i].Ordering = i;
            var inputs = _files
                .Select(f => new OrganizationFileInput(
                    Id: f.Id, Path: f.Path, Content: f.Content,
                    MustacheEnabled: f.MustacheEnabled, Scope: f.Scope))
                .ToList();
            await Config.SaveFilesAsync(inputs);
            Nav.NavigateTo("/admin/templates/files?ok=saved", forceLoad: true);
        }
        catch (PlanValidationException ex)
        {
            _errMessage = ex.Errors.FirstOrDefault().Value ?? "Validation failed.";
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "Failed to save organisation files.");
            _errMessage = "An unexpected error occurred. The change was not saved.";
        }
        finally
        {
            _saving = false;
        }
    }

    private static string TruncateForPreview(string content)
    {
        if (string.IsNullOrEmpty(content)) return string.Empty;
        const int max = 240;
        return content.Length <= max ? content : content.Substring(0, max) + "...";
    }
}
