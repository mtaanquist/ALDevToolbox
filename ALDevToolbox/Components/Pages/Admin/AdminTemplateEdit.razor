@page "/admin/templates/new"
@page "/admin/templates/{Key}"
@attribute [Authorize(Roles = "Admin,Editor")]
@rendermode InteractiveServer
@inject TemplateService Templates
@inject ApplicationVersionService Versions
@inject OrganizationConfigService OrgConfig
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject ILogger<AdminTemplateEdit> Log
@implements IAsyncDisposable
@using System.Text.Json
@using ALDevToolbox.Components.Shared
@using ALDevToolbox.Domain.Entities
@using ALDevToolbox.Domain.ValueObjects
@using ALDevToolbox.Services

@*
    Combined create/edit page.
    - /admin/templates/new      → no [Key] route value. Opens in TOML mode
                                  because authoring a fresh template is usually
                                  faster as a single TOML document than
                                  clicking through the structured form.
    - /admin/templates/{key}    → loads the existing row by key. Opens in the
                                  structured form because surgical edits are
                                  what people do most often.

    Reordering uses Up/Down buttons rather than HTML5 drag-and-drop because the
    latter would need .razor.js plumbing for v1; can be upgraded later if asked
    for. Form state lives in TemplateFormState (Components/Shared) so the
    recursive folder editor can bind against the same models the page does;
    on save we pack into TemplateAuthoring and call TemplateService directly.
*@

<PageTitle>@PageTitleText · Admin · AL Dev Toolbox</PageTitle>

<div class="page">
    <header class="page-head">
        <div>
            <h1 class="page-head__title">@PageTitleText</h1>
            <p class="page-head__sub">
                @if (IsEdit)
                {
                    <span>You're editing the <code class="code">@Key</code> workspace template. Saved changes apply the next time someone generates a workspace from it.</span>
                }
                else
                {
                    <span>Set up a new workspace template - the shape, defaults, and extensions every workspace generated from it inherits. You can come back and tweak any of this later.</span>
                }
            </p>
        </div>
        <div class="page-head__actions">
            <a class="btn btn--sm" href="/admin/templates">
                <Icon Name="arrow-left" Width="14" Height="14" />
                <span>Back to list</span>
            </a>
            @* No save button here. It used to be duplicated up from the form so it
               stayed reachable on a page several viewports tall, at the cost of two
               primary buttons on one screen. The form's own action row is
               .form-actions--sticky now, so it never leaves the viewport and the
               page head is back to navigation only. *@
        </div>
    </header>

    @if (IsEdit && _loadFailed)
    {
        <p class="alert alert--danger" role="alert">
            <Icon Name="circle-alert" Width="16" Height="16" />
            <span>
                No template with key <code class="code">@Key</code> was found. It may have been
                renamed or permanently removed.
            </span>
        </p>
    }
    else if (_form is null)
    {
        <div class="loading-block"><span class="spinner"></span><span>Loading...</span></div>
    }
    else
    {
        <div class="pill-tabs" role="tablist" aria-label="Editor mode">
            <button type="button"
                    class="@ModeButtonClass(EditorMode.Form)"
                    role="tab"
                    aria-selected="@(_mode == EditorMode.Form)"
                    @onclick="() => SwitchModeAsync(EditorMode.Form)">
                <Icon Name="list" Width="14" Height="14" />
                <span>Structured form</span>
            </button>
            <button type="button"
                    class="@ModeButtonClass(EditorMode.Toml)"
                    role="tab"
                    aria-selected="@(_mode == EditorMode.Toml)"
                    @onclick="() => SwitchModeAsync(EditorMode.Toml)">
                <Icon Name="file-code" Width="14" Height="14" />
                <span>TOML</span>
            </button>
        </div>

        @if (_saveError is not null)
        {
            <div class="alert alert--danger" role="alert">
                <Icon Name="circle-alert" Width="16" Height="16" />
                <span>
                    @_saveError
                    @if (_fieldErrors.Count > 0)
                    {
                        <ul>
                            @foreach (var e in _fieldErrors)
                            {
                                <li><code class="code">@e.Key</code>: @e.Value</li>
                            }
                        </ul>
                    }
                </span>
            </div>
        }
        @if (_saveSuccess is not null)
        {
            <p class="alert alert--success" role="status">
                <Icon Name="circle-check" Width="16" Height="16" /><span>@_saveSuccess</span>
            </p>
        }
    }

    @if (_form is not null)
    {
        <div class="gen">
            <div class="gen__form u-stack">
                @if (_mode == EditorMode.Toml)
                {
        <form id="tpl-toml-form" class="edit-col" @onsubmit="SaveTomlAsync" @onsubmit:preventDefault>
            <section class="card">
                <div class="card__head"><h2 class="card__title">template.toml</h2></div>
                <div class="card__body form-sec">
                    <div class="code-editor" @ref="_tomlContainer"></div>
                    @if (_tomlIssues.Count > 0)
                    {
                        <div class="alert alert--danger" role="alert">
                            <Icon Name="circle-alert" Width="16" Height="16" />
                            <span>
                                <ul>
                                    @foreach (var issue in _tomlIssues)
                                    {
                                        <li>line @issue.Line: @issue.Message</li>
                                    }
                                </ul>
                            </span>
                        </div>
                    }
                    <p class="form-sec__cap">
                        Edits the same data the structured form does. The
                        <code class="code">deprecated</code> flag and the extension order are only
                        editable in the structured view.
                    </p>
                </div>
                <div class="card__foot">
                    <button type="button" class="btn" @onclick="() => SwitchModeAsync(EditorMode.Form)" disabled="@_saving">
                        <span>Discard &amp; back to form</span>
                    </button>
                    <button type="button" class="btn" @onclick="RefreshPreviewAsync" disabled="@_saving"
                            title="Parse the TOML and rebuild the preview without leaving this view">
                        <Icon Name="refresh-cw" Width="14" Height="14" />
                        <span>Refresh preview</span>
                    </button>
                    <button type="submit" class="btn btn--primary" disabled="@_saving">
                        <Icon Name="save" Width="16" Height="16" />
                        <span>@(_saving ? "Saving..." : (IsEdit ? "Save TOML" : "Create from TOML"))</span>
                    </button>
                </div>
            </section>
        </form>
                }
                else
                {
        <form id="tpl-form" class="edit-col" @onsubmit="SaveAsync" @onsubmit:preventDefault>
            <section class="card">
                <div class="card__head"><h2 class="card__title">Identity</h2></div>
                <div class="card__body form-sec">
                    <div class="form-grid">
                        <div class="field">
                            <label class="field__label" for="tpl-key">Key</label>
                            <input class="input" id="tpl-key" type="text" @bind="_form.Key" @bind:event="oninput"
                                   readonly="@IsEdit" pattern="[a-z0-9-]+" required
                                   placeholder="e.g. new-workspace-template" />
                            <span class="field__hint">
                                @(IsEdit ? "The key is fixed once a template is created." : "Lowercase letters, digits, hyphens. Used in admin URLs.")
                            </span>
                            <FieldError Field="Key" Errors="_fieldErrors" />
                        </div>

                        <div class="field">
                            <label class="field__label" for="tpl-name">Name</label>
                            <input class="input" id="tpl-name" type="text" required
                                   @bind="_form.Name" @bind:event="oninput"
                                   placeholder="e.g. Namespace Workspace Template (v28)" />
                            <FieldError Field="Name" Errors="_fieldErrors" />
                        </div>

                        <div class="field field--full">
                            <label class="field__label" for="tpl-description">Description</label>
                            <textarea class="textarea" id="tpl-description" rows="2"
                                      @bind="_form.Description" @bind:event="oninput"></textarea>
                            <span class="field__hint">Caption shown under the template dropdown on the New Workspace page.</span>
                        </div>
                    </div>
                </div>
            </section>

            <section class="card">
                <div class="card__head"><h2 class="card__title">Versioning &amp; ID ranges</h2></div>
                <div class="card__body form-sec">
                    <div class="field">
                        <label class="field__label" for="tpl-app-version">Application version</label>
                        <span class="select-wrap">
                            <select class="select" id="tpl-app-version" required
                                    @bind="_form.DefaultApplicationVersionKey"
                                    @bind:after="OnApplicationVersionChanged">
                                <option value="" disabled>(pick a curated entry)</option>
                                @* "Latest" sentinel: resolves to the highest-ordered
                                   active catalogue row at the moment a user opens the
                                   New Workspace / New Extension form. The persisted
                                   template carries the bool flag, not a FK. *@
                                <option value="@ApplicationVersionService.LatestSentinel">Latest (always highest)</option>
                                @foreach (var v in _availableApplicationVersions)
                                {
                                    <option value="@v.Key">
                                        @v.Name (@v.Application / @v.Runtime)@(v.Deprecated ? " - deprecated" : null)
                                    </option>
                                }
                            </select>
                            <Icon Name="chevron-down" Width="15" Height="15" Css="select-wrap__caret" />
                        </span>
                        <span class="field__hint u-row">
                            <span>
                                Sets the BC version every extension from this template targets.
                                Curate the list under <a href="/admin/application-versions">Application versions</a>;
                                users can still override it per solution.
                            </span>
                            @if (string.Equals(_form.DefaultApplicationVersionKey, ApplicationVersionService.LatestSentinel, StringComparison.Ordinal))
                            {
                                <span class="tag">highest active entry, resolved when the form opens</span>
                            }
                            else if (_selectedApplicationVersion is not null)
                            {
                                <span class="tag">runtime @_selectedApplicationVersion.Runtime · application @_selectedApplicationVersion.Application</span>
                            }
                        </span>
                        <FieldError Field="DefaultApplicationVersionKey" Errors="_fieldErrors" />
                    </div>

                    <div class="form-grid">
                        <div class="field">
                            <span class="field__label">Core ID range</span>
                            <span class="id-range">
                                <label class="u-sr" for="tpl-core-from">Core ID range from</label>
                                <input class="input input--num" id="tpl-core-from" type="number" required min="1"
                                       @bind="_form.CoreIdRangeFrom" @bind:event="oninput" />
                                <span class="id-range__sep" aria-hidden="true"></span>
                                <label class="u-sr" for="tpl-core-to">Core ID range to</label>
                                <input class="input input--num" id="tpl-core-to" type="number" required min="1"
                                       @bind="_form.CoreIdRangeTo" @bind:event="oninput" />
                            </span>
                            <FieldError Field="CoreIdRangeFrom" Errors="_fieldErrors" />
                            <FieldError Field="CoreIdRangeTo" Errors="_fieldErrors" />
                        </div>

                        <div class="field">
                            <span class="field__label">Module ID ranges</span>
                            <span class="id-range">
                                <label class="u-sr" for="tpl-mod-start">Module ID range start</label>
                                <input class="input input--num" id="tpl-mod-start" type="number" required min="1"
                                       @bind="_form.ModuleIdRangeStart" @bind:event="oninput" />
                                <span class="id-range__count">+</span>
                                <label class="u-sr" for="tpl-mod-size">Module ID range size</label>
                                <input class="input input--num" id="tpl-mod-size" type="number" required min="1"
                                       @bind="_form.ModuleIdRangeSize" @bind:event="oninput" />
                            </span>
                            <span class="field__hint">Start of the first module's range, and how many IDs each module gets. If a workspace changes the Core range, this start moves with it by the same amount.</span>
                            <FieldError Field="ModuleIdRangeStart" Errors="_fieldErrors" />
                            <FieldError Field="ModuleIdRangeSize" Errors="_fieldErrors" />
                        </div>
                    </div>
                </div>
            </section>

            @* The defaults_json and app_source_cop_json blobs are no longer
               edited from the structured form: their visible knobs moved to
               /admin/templates/defaults (url, logo, supported countries,
               publisher) and the rest stays on the entity for the TOML editor
               to round-trip. Only the optional workspace-settings overlay
               survives here since it's per-template by design.
               The Deprecated flag also lives on the templates list as a bulk
               action / per-row toggle; it's not part of authoring. *@
            <section class="card">
                <div class="card__head">
                    <div>
                        <h2 class="card__title">Workspace settings overlay</h2>
                        <p class="card__sub">Optional. Additions to the organisation's workspace file, for this template only.</p>
                    </div>
                </div>
                <div class="card__body form-sec">
                    @* Read-only reference panel showing the org-wide base this
                       per-template overlay merges onto, so admins can see what
                       they'd be duplicating before they add it here.  *@
                    @if (!string.IsNullOrWhiteSpace(_orgCodeWorkspaceJson))
                    {
                        <details class="hint-details">
                            <summary>
                                <Icon Name="eye" Width="14" Height="14" />
                                <span>Organisation base (read-only - edit at <a href="/admin/templates/workspace">Templates · Workspace</a>)</span>
                            </summary>
                            <div class="code-block"><pre>@_orgCodeWorkspaceJson</pre></div>
                        </details>
                    }

                    <div class="field">
                        <label class="field__label" for="tpl-workspace">Per-template addition</label>
                        <textarea class="textarea" id="tpl-workspace" rows="6" spellcheck="false"
                                  placeholder='{ "settings": { "al.newSetting": "..." } }'
                                  @bind="_form.CodeWorkspaceJson" @bind:event="oninput"></textarea>
                        <span class="field__hint">
                            Merged on top of the organisation base above. Individual
                            settings are merged one by one and this template wins where
                            they clash; any other top-level block replaces the
                            organisation's outright. Leave blank to inherit it unchanged.
                        </span>
                        <FieldError Field="CodeWorkspaceJson" Errors="_fieldErrors" />
                    </div>

                    @* No MustacheVarsHint here: this page carries the full variable
                       reference in its aside, permanently visible, and that list is
                       MustacheVariableCatalog.All rather than the hint's admin-content
                       subset. The other four pages that use the hint have no aside. *@
                </div>
            </section>

            <section class="card">
                <div class="card__head">
                    <div>
                        <h2 class="card__title">Default modules</h2>
                        <p class="card__sub">
                            Pre-ticked on the New Workspace form when this template is picked.
                            Users can still opt out of any of them.
                        </p>
                    </div>
                </div>
                <div class="card__body form-sec">
                    @if (_availableModules.Count == 0)
                    {
                        <div class="empty-state empty-state--quiet">
                            <span class="empty-state__title">No modules yet</span>
                            <span class="empty-state__text">
                                <a href="/admin/modules">Add one under Modules</a> and it will show up here.
                            </span>
                        </div>
                    }
                    else
                    {
                        <div class="module-list">
                            @foreach (var m in _availableModules)
                            {
                                var isChecked = _form.DefaultModuleKeys.Contains(m.Key);
                                <label class="module-card @(isChecked ? "is-selected" : "")">
                                    <input type="checkbox"
                                           checked="@isChecked"
                                           @onchange="e => OnDefaultModuleToggled(m.Key, (bool)(e.Value ?? false))" />
                                    <span class="module-card__row">
                                        <span class="module-card__title">@m.Name</span>
                                        @if (m.Deprecated)
                                        {
                                            <span class="tag">deprecated</span>
                                        }
                                        <span class="module-card__id">@m.Key</span>
                                    </span>
                                    @* Same dependency line the end user gets on New
                                       Workspace. An admin picking the defaults needs to
                                       see what each module drags in at least as much as
                                       the person who later un-ticks them. *@
                                    <span class="module-card__deps">
                                        <Icon Name="link" Width="12" Height="12" />
                                        @(m.Dependencies.Count == 0
                                            ? "no extra dependencies"
                                            : $"+ {m.Dependencies.Count} {(m.Dependencies.Count == 1 ? "dependency" : "dependencies")}")
                                    </span>
                                    <span class="module-card__check"><Icon Name="check" Width="12" Height="12" /></span>
                                </label>
                            }
                        </div>
                        <FieldError Field="DefaultModuleKeys" Errors="_fieldErrors" />
                    }
                </div>
            </section>

            <section class="card">
                <div class="card__head">
                    <div>
                        <h2 class="card__title">Always-included files</h2>
                        <p class="card__sub">
                            Which of the shared files ship with a workspace built from this
                            template. New ones start off until you tick them.
                        </p>
                    </div>
                    <a class="btn btn--sm" href="/admin/templates/files">
                        <Icon Name="pencil" Width="14" Height="14" />
                        <span>Edit the files</span>
                    </a>
                </div>
                <div class="card__body form-sec">
                    @if (_availableOrgFiles.Count == 0)
                    {
                        <div class="empty-state empty-state--quiet">
                            <span class="empty-state__title">No shared files yet</span>
                            <span class="empty-state__text">
                                <a href="/admin/templates/files">Add one under Templates &middot; Files</a>
                                and it will show up here.
                            </span>
                        </div>
                    }
                    else
                    {
                        <div class="module-list">
                            @foreach (var f in _availableOrgFiles)
                            {
                                var isChecked = _form.IncludedFilePaths.Contains(f.Path);
                                <label class="module-card @(isChecked ? "is-selected" : "")">
                                    <input type="checkbox"
                                           checked="@isChecked"
                                           @onchange="e => OnIncludedFileToggled(f.Path, (bool)(e.Value ?? false))" />
                                    <span class="module-card__title">@f.Path</span>
                                    <span class="module-card__text">
                                        @(f.Scope == ALDevToolbox.Domain.ValueObjects.OrganizationFileScope.EveryExtension ? "per extension" : "workspace root")
                                        · @(f.MustacheEnabled ? "variables on" : "literal")
                                    </span>
                                    <span class="module-card__check"><Icon Name="check" Width="12" Height="12" /></span>
                                    <span class="module-card__lock"
                                          title="The file itself is edited under Templates &middot; Files. Ticking here only decides whether this template ships it.">
                                        <Icon Name="lock" Width="12" Height="12" />
                                    </span>
                                </label>
                            }
                        </div>
                        <FieldError Field="IncludedFilePaths" Errors="_fieldErrors" />
                    }
                </div>
            </section>

            <section class="card">
                <div class="card__head"><h2 class="card__title">Extensions</h2></div>
                <div class="card__body form-sec">
                    <TemplateExtensionsEditor Form="_form" Errors="_fieldErrors" />
                </div>
            </section>

            @* Mirror of the header save button so admins who scroll all
               the way down don't have to scroll back up to commit. *@
            @* --sticky because this page runs to several viewports. Before it did,
               the save had to be duplicated into the page head to stay reachable,
               which put two primary buttons on one screen. *@
            <div class="form-actions form-actions--sticky">
                @if (IsEdit && _existingId is not null)
                {
                    @if (_isDeleted)
                    {
                        <button type="button" class="btn" @onclick="RestoreAsync" disabled="@_saving">
                            <Icon Name="rotate-ccw" Width="16" Height="16" />
                            <span>Restore</span>
                        </button>
                    }
                    else
                    {
                        <button type="button" class="btn" @onclick="ConfirmDeleteAsync" disabled="@_saving">
                            <Icon Name="trash-2" Width="16" Height="16" />
                            <span>Delete</span>
                        </button>
                    }
                }
                <span class="form-actions__spacer"></span>
                <button type="submit" class="btn btn--primary" disabled="@_saving">
                    <Icon Name="save" Width="16" Height="16" />
                    <span>@(_saving ? "Saving..." : (IsEdit ? "Save changes" : "Create template"))</span>
                </button>
            </div>
        </form>

                }
            </div>
            <aside class="gen__aside">
                <details class="card card--collapsible" open>
                    <summary class="card__head"><h2 class="card__title">Template variables</h2></summary>
                    <div class="card__body form-sec">
                        <p class="form-sec__cap">
                            Substituted into file contents at generation time. Anything
                            we don't recognise is left exactly as you typed it.
                        </p>
                        @* Reads from MustacheVariableCatalog so this hint
                           never drifts from the generator's actual switch
                           (the same source of truth MustacheVarsHint reads).
                           Lists All - including per-file vars like {{name}}
                           and {{namespace}} - because admins authoring AL
                           file content here legitimately use them. *@
                        <dl class="hint-details__list">
                            @foreach (var v in MustacheVariableCatalog.All)
                            {
                                <dt><code class="code">@($"{{{{{v.Name}}}}}")</code></dt>
                                <dd>@v.Caption</dd>
                            }
                        </dl>
                    </div>
                </details>
                <details class="card card--collapsible" open>
                    <summary class="card__head"><h2 class="card__title">Preview</h2></summary>
                    <div class="card__body form-sec">
                        @if (_mode == EditorMode.Toml)
                        {
                            <p class="form-sec__cap">
                                Showing the last form-side state. Switch back to the
                                structured form to refresh.
                            </p>
                        }
                        <FolderTreePreview Root="BuildPreview()" />
                    </div>
                </details>
            </aside>
        </div>
    }

    @if (_form is not null && IsEdit && _existingId is not null)
    {
        <AuditHistoryPanel EntityType="AuditEntityType.RuntimeTemplate" EntityId="_existingId.Value" Title="Template history" />
    }
</div>

<ConfirmDialog @ref="_deleteConfirm"
               Title="Soft-delete this template?"
               Message="It will disappear from the user-facing dropdown. You can restore it from this page; the audit log keeps the change either way."
               ConfirmLabel="Soft-delete"
               ConfirmIcon="trash-2" />

<ConfirmDialog @ref="_leaveConfirm"
               Title="Leave with unsaved changes?"
               Message="You have unsaved edits on this template. Leaving now will discard them."
               ConfirmLabel="Discard changes"
               CancelLabel="Stay on page"
               ConfirmIcon="log-out" />

@code {
    [Parameter] public string? Key { get; set; }

    /// <summary>
    /// When the new-template form is opened via the list-page Duplicate
    /// action, this carries the source template's key. The form prefills
    /// from that template and clears the Key field so the admin can pick a
    /// fresh one before saving.
    /// </summary>
    [SupplyParameterFromQuery(Name = "from")] public string? DuplicateFrom { get; set; }

    private bool IsEdit => !string.IsNullOrEmpty(Key);
    private string PageTitleText => IsEdit ? "Edit template" : "New template";

    private TemplateFormState? _form;
    private int? _existingId;
    private bool _isDeleted;
    private bool _loadFailed;
    private bool _saving;
    // Tracks the route key the editor was last hydrated for. When the user
    // navigates between two /admin/templates/{Key} pages without leaving the
    // component, OnParametersSetAsync needs to tear down the stale CodeMirror
    // mount so the next render doesn't shovel new content into the previous
    // template's editor instance.
    private string? _lastHydratedKey;
    private List<ALDevToolbox.Domain.Entities.Module> _availableModules = new();
    private List<ApplicationVersion> _availableApplicationVersions = new();
    private List<ALDevToolbox.Domain.Entities.OrganizationFile> _availableOrgFiles = new();
    /// <summary>
    /// Pretty-printed JSON snapshot of the organisation's base
    /// <c>.code-workspace</c> template, shown as a read-only reference next
    /// to the per-template overlay textarea. Empty / null when the org row
    /// hasn't been customised - the generator falls back to its hard-coded
    /// default in that case.
    /// </summary>
    private string _orgCodeWorkspaceJson = string.Empty;

    /// <summary>
    /// Cached lookup of the currently picked ApplicationVersion so the read-only
    /// summary under the select shows the runtime/application pair without
    /// rebuilding the list every render.
    /// </summary>
    private ApplicationVersion? _selectedApplicationVersion =>
        string.IsNullOrEmpty(_form?.DefaultApplicationVersionKey)
            ? null
            : _availableApplicationVersions.FirstOrDefault(v =>
                string.Equals(v.Key, _form.DefaultApplicationVersionKey, StringComparison.Ordinal));
    private ConfirmDialog? _deleteConfirm;
    private ConfirmDialog? _leaveConfirm;
    private IDisposable? _locationChangingRegistration;

    /// <summary>
    /// JSON snapshot of <see cref="_form"/> captured after each successful
    /// load / save, used by the structured-form dirty check. <c>null</c>
    /// means "no baseline yet - don't gate navigation".
    /// </summary>
    private string? _formBaselineJson;
    private string? _saveError;
    private string? _saveSuccess;
    private IReadOnlyDictionary<string, string> _fieldErrors = new Dictionary<string, string>();
    private EditorMode _mode = EditorMode.Form;
    private string _toml = string.Empty;
    // CodeMirror 6 plumbing. The editor module is loaded lazily the first
    // time the TOML tab is rendered, so the structured-form path doesn't pay
    // the import cost. _editorId is the JS-side handle returned by mount().
    private ElementReference _tomlContainer;
    private IJSObjectReference? _editorModule;
    private int _editorId;
    private string _editorMountedToml = string.Empty;
    private List<TomlParseIssue> _tomlIssues = new();
    private bool _editorIssueSyncPending;
    // Guards against OnAfterRenderAsync re-entrancy: a second render can fire
    // while the first mount() is still awaiting and would otherwise spin up a
    // duplicate editor.
    private bool _editorMounting;

    /// <summary>
    /// Which editor surface is currently visible. The structured form is the
    /// default; TOML mode is opt-in for admins comfortable with the seed file
    /// shape. The DB stays the source of truth either way.
    /// </summary>
    private enum EditorMode { Form, Toml }

    protected override void OnInitialized()
    {
        // Intercept SPA navigation (sidebar links, "Back to list", browser
        // back to an in-app URL) so we can warn before the user discards
        // unsaved TOML edits. Browser-level navigation (full reload, tab
        // close, back to an external URL) goes through beforeunload in the
        // .razor.js companion.
        _locationChangingRegistration = Nav.RegisterLocationChangingHandler(OnLocationChangingAsync);
    }

    private async ValueTask OnLocationChangingAsync(LocationChangingContext context)
    {
        if (_leaveConfirm is null) return;

        var dirty = false;

        // TOML pane: ask the CodeMirror module whether its contents differ
        // from the pristine baseline captured on mount.
        if (_editorId != 0 && _editorModule is not null)
        {
            try
            {
                dirty = await _editorModule.InvokeAsync<bool>("isDirty", _editorId);
            }
            catch (Exception ex)
            {
                // Fail open - blocking nav on a transient JS hiccup would be
                // worse than the rare lost edit.
                Log.LogWarning(ex, "Failed to read dirty state from editor; allowing navigation.");
                return;
            }
        }

        // Structured form: compare the live form-state's JSON serialisation
        // to the baseline captured on load. Cheap (one round-trip + string
        // compare) and stays correct as new form fields are added.
        if (!dirty && _form is not null && _formBaselineJson is not null)
        {
            dirty = !string.Equals(_formBaselineJson, SerializeFormForDirtyCheck(_form), StringComparison.Ordinal);
        }

        if (!dirty) return;

        var leave = await _leaveConfirm.OpenAsync();
        if (!leave)
        {
            context.PreventNavigation();
        }
    }

    private static string SerializeFormForDirtyCheck(TemplateFormState form) =>
        System.Text.Json.JsonSerializer.Serialize(form.ToAuthoring(), DirtyCheckJsonOptions);

    private static readonly System.Text.Json.JsonSerializerOptions DirtyCheckJsonOptions = new()
    {
        WriteIndented = false,
    };

    private static readonly System.Text.Json.JsonSerializerOptions PrettyJsonOptions = new()
    {
        WriteIndented = true,
    };

    /// <summary>
    /// Reformats <paramref name="json"/> with two-space indentation for the
    /// read-only reference panel. Returns the original string on parse
    /// failure - the panel is informational, not validated.
    /// </summary>
    private static string PrettyPrintJson(string? json)
    {
        if (string.IsNullOrWhiteSpace(json)) return string.Empty;
        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(json);
            return System.Text.Json.JsonSerializer.Serialize(doc.RootElement, PrettyJsonOptions);
        }
        catch (System.Text.Json.JsonException)
        {
            return json;
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        _saveError = null;
        _saveSuccess = null;
        _fieldErrors = new Dictionary<string, string>();
        _tomlIssues = new();
        _editorIssueSyncPending = false;

        // Route changed (or we landed on /new from another template's edit
        // page). Drop the CodeMirror mount and the cached TOML so the next
        // render doesn't pump fresh content into the previous template's
        // editor instance.
        if (_lastHydratedKey != Key)
        {
            if (_editorId != 0)
            {
                await DisposeEditorAsync();
            }
            _editorMountedToml = string.Empty;
            _toml = string.Empty;
            _lastHydratedKey = Key;
        }

        // Module list drives the default-module multi-select. Include
        // deprecated entries so admins can keep them ticked on legacy
        // templates without losing the reference; the user-facing
        // dropdown filters them out separately.
        _availableModules = await Templates.GetModulesAsync(includeDeprecated: true);
        _availableApplicationVersions = await Versions.GetActiveAsync(includeDeprecated: true);
        var orgConfig = await OrgConfig.GetCurrentAsync();
        _availableOrgFiles = orgConfig.Files.OrderBy(f => f.Ordering).ToList();
        _orgCodeWorkspaceJson = PrettyPrintJson(orgConfig.Settings.CodeWorkspaceJson);

        if (!IsEdit)
        {
            _existingId = null;
            _isDeleted = false;
            _loadFailed = false;

            // Duplicate flow: prefill the new-template form from an existing
            // template's authoring shape. The Key is intentionally cleared so
            // the admin has to pick a fresh one; every other field carries
            // over and can be tweaked before save.
            if (!string.IsNullOrWhiteSpace(DuplicateFrom))
            {
                var source = await Templates.GetAuthoringByKeyAsync(DuplicateFrom);
                if (source is not null)
                {
                    _form = TemplateFormState.From(source);
                    _form.Key = string.Empty;
                    _form.Name = string.IsNullOrWhiteSpace(source.Name)
                        ? string.Empty
                        : $"{source.Name} (copy)";
                    // Don't carry the deprecated flag onto a brand-new copy.
                    _form.Deprecated = false;
                    // Treat the duplicated form as "dirty" from the start -
                    // capture the source baseline so editing further still
                    // triggers the confirm, but the copy itself is unsaved.
                    _formBaselineJson = SerializeFormForDirtyCheck(_form);
                    _mode = EditorMode.Form;
                    _saveSuccess = $"Duplicated from \"{source.Key}\". Pick a new key, then click Create template.";
                    return;
                }
                Log.LogWarning("Duplicate source template '{Key}' not found; falling back to blank form.", DuplicateFrom);
            }

            _form = TemplateFormState.Blank();
            _formBaselineJson = SerializeFormForDirtyCheck(_form);
            // New-template flow opens in TOML - pasting a template.toml is the
            // common path. Pre-render the blank scaffold once so the textarea
            // has something useful to start from.
            _mode = EditorMode.Toml;
            _toml = TemplateTomlMapper.BlankToml();
            return;
        }

        var existing = await Templates.GetAuthoringByKeyAsync(Key!);
        if (existing is null)
        {
            _loadFailed = true;
            _form = null;
            return;
        }

        // Need the existing row's id (and the soft-delete flag) for the
        // delete/restore buttons; the authoring payload doesn't carry it.
        var entity = await Templates.GetByKeyAsync(Key!);
        _loadFailed = false;
        _existingId = entity?.Id;
        _isDeleted = entity?.DeletedAt is not null;
        _form = TemplateFormState.From(existing);
        _formBaselineJson = SerializeFormForDirtyCheck(_form);
        _mode = EditorMode.Form;
    }

    private void OnDefaultModuleToggled(string key, bool isChecked)
    {
        if (_form is null) return;
        if (isChecked)
        {
            if (!_form.DefaultModuleKeys.Contains(key))
            {
                _form.DefaultModuleKeys.Add(key);
            }
        }
        else
        {
            _form.DefaultModuleKeys.Remove(key);
        }
    }

    /// <summary>
    /// Mirrors the picked <see cref="ApplicationVersion"/>'s scalars onto the
    /// hidden Runtime / DefaultApplication / DefaultPlatform form fields so
    /// the underlying entity columns (defaults_json, runtime) stay in sync
    /// with the FK without exposing free-text inputs on the structured form.
    /// </summary>
    private void OnApplicationVersionChanged()
    {
        if (_form is null) return;
        // "Latest" sentinel: the runtime/application strings are resolved
        // per-request at form-submit time, so we don't write a concrete
        // value back into the hidden form fields here. The bool flag on
        // the form state carries the choice; the template editor saves
        // it through ToAuthoring() which sets DefaultApplicationVersionLatest.
        if (string.Equals(_form.DefaultApplicationVersionKey, ApplicationVersionService.LatestSentinel, StringComparison.Ordinal))
        {
            _form.DefaultApplicationVersionLatest = true;
            return;
        }
        _form.DefaultApplicationVersionLatest = false;
        var picked = _selectedApplicationVersion;
        if (picked is null) return;
        _form.Runtime = picked.Runtime;
        _form.DefaultApplication = picked.Application;
        // Platform isn't part of ApplicationVersion; leave whatever was there
        // (defaults to "1.0.0.0" on Blank()). Admins who need to change it
        // edit via TOML - same escape hatch as defaults.json today.
    }

    private void OnIncludedFileToggled(string path, bool isChecked)
    {
        if (_form is null) return;
        if (isChecked)
        {
            if (!_form.IncludedFilePaths.Contains(path))
            {
                _form.IncludedFilePaths.Add(path);
            }
        }
        else
        {
            _form.IncludedFilePaths.Remove(path);
        }
    }

    // ===== Save / delete / restore =====

    private async Task SaveAsync()
    {
        if (_form is null || _saving) return;
        _saving = true;
        _saveError = null;
        _saveSuccess = null;
        _fieldErrors = new Dictionary<string, string>();

        var payload = _form.ToAuthoring();

        try
        {
            if (IsEdit && _existingId is not null)
            {
                await Templates.UpdateAsync(_existingId.Value, payload);
                _saveSuccess = "Saved.";
            }
            else
            {
                await Templates.CreateAsync(payload);
                // Reset the baseline so post-save navigation away doesn't
                // trip the leave-confirm dialog.
                _formBaselineJson = _form is null ? null : SerializeFormForDirtyCheck(_form);
                // Land back on the list so admins can immediately see the new
                // row in context. Editing it further is one click away.
                Nav.NavigateTo("/admin/templates");
                return;
            }
        }
        catch (PlanValidationException ex)
        {
            _fieldErrors = ex.Errors;
            _saveError = $"Couldn't save: {ex.Errors.Count} validation error(s). See messages next to each field.";
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "Unexpected error saving template '{Key}'.", payload.Key);
            _saveError = "An unexpected error occurred. The change was not saved.";
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task ConfirmDeleteAsync()
    {
        if (_existingId is null || _saving || _deleteConfirm is null) return;
        if (!await _deleteConfirm.OpenAsync()) return;
        _saving = true;
        try
        {
            await Templates.SoftDeleteAsync(_existingId.Value);
            // The form's contents are now moot - clear the baseline so the
            // post-delete navigation away doesn't trip the leave-confirm.
            _formBaselineJson = null;
            Nav.NavigateTo("/admin/templates");
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "Failed to soft-delete template id={Id}.", _existingId);
            _saveError = "Couldn't delete the template. Check the logs.";
            _saving = false;
        }
    }

    private async Task RestoreAsync()
    {
        if (_existingId is null || _saving) return;
        _saving = true;
        try
        {
            await Templates.RestoreAsync(_existingId.Value);
            _isDeleted = false;
            _saveSuccess = "Template restored.";
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "Failed to restore template id={Id}.", _existingId);
            _saveError = "Couldn't restore the template. Check the logs.";
        }
        finally
        {
            _saving = false;
        }
    }

    // ===== Mode switching =====

    private async Task SwitchModeAsync(EditorMode mode)
    {
        if (_form is null || _mode == mode || _saving) return;

        if (_mode == EditorMode.Toml && mode == EditorMode.Form)
        {
            // Validate-on-switch: parse what's in the editor and rebuild form
            // state from it. If the TOML doesn't parse, the gutter markers
            // stay visible and we refuse the switch - bidirectional sync only
            // works when both sides agree on the data shape.
            if (!await TryHydrateFormFromEditorAsync())
            {
                return;
            }
        }
        else if (_mode == EditorMode.Form && mode == EditorMode.Toml)
        {
            // Form → TOML: render the current form state. The TOML doc
            // becomes the source of truth from this point until the next
            // switch back; the editor's pristine baseline is reset by the
            // setValue call OnAfterRenderAsync issues when _toml changes.
            _toml = BuildTomlFromFormState();
            _tomlIssues = new();
        }

        _mode = mode;
        _saveError = null;
        _saveSuccess = null;
        _fieldErrors = new Dictionary<string, string>();
    }

    private async Task RefreshPreviewAsync()
    {
        if (_form is null || _saving) return;
        if (await TryHydrateFormFromEditorAsync())
        {
            _saveError = null;
            _saveSuccess = "Preview refreshed.";
        }
    }

    /// <summary>
    /// Pulls the current TOML out of the editor, parses it, and rebuilds
    /// <see cref="_form"/> from the result. Returns <c>false</c> (and surfaces
    /// the parse issues to the caller's UI state) when the TOML is malformed,
    /// so the caller can refuse the mode switch.
    /// </summary>
    private async Task<bool> TryHydrateFormFromEditorAsync()
    {
        if (_form is null) return false;

        if (_editorId != 0 && _editorModule is not null)
        {
            try
            {
                _toml = await _editorModule.InvokeAsync<string>("getValue", _editorId);
                _editorMountedToml = _toml;
            }
            catch (Exception ex)
            {
                Log.LogWarning(ex, "Failed to read TOML value from editor on mode switch.");
                _saveError = "Couldn't read the editor contents. Try again or refresh.";
                return false;
            }
        }

        try
        {
            var parsed = TemplateTomlMapper.FromToml(_toml, deprecated: _form.Deprecated);
            _form = TemplateFormState.From(parsed);
            // Switching from TOML → form leaves the parsed payload as the
            // structured baseline; any further form edits become dirty.
            _formBaselineJson = SerializeFormForDirtyCheck(_form);
            _tomlIssues = new();
            _saveError = null;
            return true;
        }
        catch (TomlParseException ex)
        {
            _tomlIssues = ex.Issues.ToList();
            _editorIssueSyncPending = true;
            _saveError = _tomlIssues.Count == 1
                ? $"TOML parse error on line {_tomlIssues[0].Line}. Fix it to refresh the preview or switch to the form view."
                : $"TOML parse error: {_tomlIssues.Count} issue(s). See gutter markers - fix them to refresh the preview or switch to the form view.";
            return false;
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "Unexpected error parsing TOML.");
            _saveError = "Couldn't parse the TOML. Fix the issue, or save anyway from the TOML view.";
            return false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_form is null) return;

        // Tear down first so a mode flip in the same render doesn't leak the
        // previous editor instance.
        if (_mode != EditorMode.Toml && _editorId != 0)
        {
            await DisposeEditorAsync();
        }

        if (_mode == EditorMode.Toml && _editorId == 0 && !_editorMounting)
        {
            _editorMounting = true;
            try
            {
                _editorModule ??= await JS.InvokeAsync<IJSObjectReference>(
                    "import", "/code-editor.js");
                _editorId = await _editorModule.InvokeAsync<int>("mount", _tomlContainer, _toml, "toml");
                _editorMountedToml = _toml;
                if (_tomlIssues.Count > 0)
                {
                    _editorIssueSyncPending = true;
                }
            }
            catch (Exception ex)
            {
                Log.LogError(ex, "Failed to mount the CodeMirror TOML editor.");
                return;
            }
            finally
            {
                _editorMounting = false;
            }
        }

        if (_mode == EditorMode.Toml && _editorId != 0 && _editorModule is not null)
        {
            if (_editorMountedToml != _toml)
            {
                await _editorModule.InvokeVoidAsync("setValue", _editorId, _toml);
                _editorMountedToml = _toml;
            }

            if (_editorIssueSyncPending)
            {
                _editorIssueSyncPending = false;
                var payload = _tomlIssues
                    .Select(i => new { line = i.Line, message = i.Message, severity = "error" })
                    .ToArray();
                await _editorModule.InvokeVoidAsync("setIssues", _editorId, payload);
            }
        }
    }

    private async Task DisposeEditorAsync()
    {
        if (_editorId == 0 || _editorModule is null) return;
        try
        {
            await _editorModule.InvokeVoidAsync("dispose", _editorId);
        }
        catch (JSDisconnectedException)
        {
            // Circuit gone - JS already cleaned up.
        }
        catch (Exception ex)
        {
            Log.LogWarning(ex, "Disposing the CodeMirror TOML editor failed.");
        }
        finally
        {
            _editorId = 0;
            _editorMountedToml = string.Empty;
        }
    }

    public async ValueTask DisposeAsync()
    {
        _locationChangingRegistration?.Dispose();
        _locationChangingRegistration = null;
        await DisposeEditorAsync();
        if (_editorModule is not null)
        {
            try
            {
                await _editorModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // Circuit already gone.
            }
            catch (Exception ex)
            {
                Log.LogWarning(ex, "Disposing the editor module failed.");
            }
            _editorModule = null;
        }
    }

    // The design system's .pill-tab is a complete control, so it no longer
    // stacks .btn underneath it the way the legacy pill did.
    private string ModeButtonClass(EditorMode mode) =>
        _mode == mode ? "pill-tab is-active" : "pill-tab";

    /// <summary>
    /// Renders the current form state as TOML for the Form → TOML mode switch.
    /// Falls back to a placeholder when the embedded JSON columns are
    /// unparseable so the editor still opens - the admin can fix the JSON in
    /// the form pane and switch back without losing it.
    /// </summary>
    private string BuildTomlFromFormState()
    {
        if (_form is null) return string.Empty;
        try
        {
            return TemplateTomlMapper.ToToml(_form.ToAuthoring());
        }
        catch (JsonException ex)
        {
            return $"# Could not render TOML - Defaults or AppSourceCop JSON is invalid:\n# {ex.Message}\n";
        }
        catch (Exception ex)
        {
            Log.LogWarning(ex, "Failed to render TOML from form state.");
            return $"# Could not render TOML: {ex.Message}\n";
        }
    }

    /// <summary>
    /// Folder-tree preview for the right column. Walks the form's extensions
    /// list and emits one extension subtree per <c>[[extensions]]</c> row.
    /// In TOML mode this reflects the last validated form state - typing in
    /// the TOML editor doesn't refresh the preview until the admin clicks
    /// "Refresh preview" or switches back to the form view.
    /// </summary>
    private PreviewNode BuildPreview()
    {
        if (_form is null)
        {
            return PreviewNode.Folder("(no template)");
        }

        var rootName = string.IsNullOrWhiteSpace(_form.Key) ? "template" : _form.Key;

        // Split the template's opted-in org files by scope so the preview
        // matches what WorkspaceZipBuilder emits: workspace-root files
        // graft into the workspace tree; per-extension files duplicate
        // into each extension folder. The legacy AppSourceCop.Include
        // flag is no longer consulted - admins author AppSourceCop.json
        // as an OrganizationFile with Scope = EveryExtension.
        var workspaceRootPaths = new List<string>();
        var perExtensionPaths = new List<string>();
        var pickedPaths = new HashSet<string>(_form.IncludedFilePaths, StringComparer.Ordinal);
        foreach (var f in _availableOrgFiles)
        {
            if (!pickedPaths.Contains(f.Path)) continue;
            if (f.Scope == ALDevToolbox.Domain.ValueObjects.OrganizationFileScope.EveryExtension)
            {
                perExtensionPaths.Add(f.Path);
            }
            else
            {
                workspaceRootPaths.Add(f.Path);
            }
        }

        var children = new List<PreviewNode>();
        foreach (var ext in _form.Extensions)
        {
            children.Add(BuildExtensionPreview(ext, perExtensionPaths));
        }

        // Workspace-root org files + the generator-emitted side-cars
        // ({{short_name}}.code-workspace, workspace.aldt.toml). Use the
        // template key as the workspace short name placeholder. Shared with
        // New Workspace and New Extension so all three previews stay identical.
        return PreviewTreeBuilder.BuildWorkspacePreview(
            rootName, children, WorkspaceConfigService.FileName, workspaceRootPaths);
    }

    private static PreviewNode BuildExtensionPreview(ExtensionForm ext, IReadOnlyList<string> perExtensionFilePaths)
    {
        // app.json is no longer hard-emitted; it arrives through
        // perExtensionFilePaths when the template opts into the seeded
        // EveryExtension org file (every fresh template does by default).
        var contents = new List<PreviewNode>();
        foreach (var path in perExtensionFilePaths)
        {
            PreviewTreeBuilder.GraftFile(contents, path);
        }

        foreach (var folder in ext.Folders.Where(f => !string.IsNullOrWhiteSpace(f.Path)))
        {
            contents.Add(BuildFolderPreview(folder));
        }

        var name = string.IsNullOrWhiteSpace(ext.Path) ? "(unnamed)" : ext.Path;
        return PreviewNode.Extension(name, contents);
    }

    private static PreviewNode BuildFolderPreview(TemplateFolderForm folder)
    {
        var children = new List<PreviewNode>();
        foreach (var file in folder.Files.Where(f => !string.IsNullOrWhiteSpace(f.Path)))
        {
            children.Add(PreviewNode.File(file.Path));
        }
        foreach (var child in folder.Folders.Where(f => !string.IsNullOrWhiteSpace(f.Path)))
        {
            children.Add(BuildFolderPreview(child));
        }
        if (children.Count == 0)
        {
            children.Add(PreviewNode.File(".gitkeep"));
        }
        return PreviewNode.Folder(folder.Path, children);
    }

    private async Task SaveTomlAsync()
    {
        if (_form is null || _saving) return;
        _saving = true;
        _saveError = null;
        _saveSuccess = null;
        _fieldErrors = new Dictionary<string, string>();
        _tomlIssues = new();

        // Pull the latest text from CodeMirror; the editor doesn't two-way
        // bind to _toml, so a stale value here would silently save the
        // pre-edit document.
        if (_editorId != 0 && _editorModule is not null)
        {
            try
            {
                _toml = await _editorModule.InvokeAsync<string>("getValue", _editorId);
                _editorMountedToml = _toml;
            }
            catch (Exception ex)
            {
                Log.LogError(ex, "Failed to read TOML value from editor before save.");
                _saveError = "Couldn't read the editor contents. Try again or refresh.";
                _saving = false;
                return;
            }
        }

        try
        {
            var payload = TemplateTomlMapper.FromToml(_toml, deprecated: _form.Deprecated);

            if (IsEdit && _existingId is not null)
            {
                await Templates.UpdateAsync(_existingId.Value, payload);
                var refreshed = await Templates.GetAuthoringByKeyAsync(Key!);
                if (refreshed is not null)
                {
                    _form = TemplateFormState.From(refreshed);
                    _formBaselineJson = SerializeFormForDirtyCheck(_form);
                    _toml = TemplateTomlMapper.ToToml(refreshed);
                    _editorMountedToml = _toml;
                    if (_editorId != 0 && _editorModule is not null)
                    {
                        await _editorModule.InvokeVoidAsync("setValue", _editorId, _toml);
                        await _editorModule.InvokeVoidAsync("markPristine", _editorId);
                    }
                }
                _saveSuccess = "Saved from TOML.";
            }
            else
            {
                await Templates.CreateAsync(payload);
                if (_editorId != 0 && _editorModule is not null)
                {
                    await _editorModule.InvokeVoidAsync("markPristine", _editorId);
                }
                // Reset the structured-form baseline so the post-save
                // navigation doesn't trip the leave-confirm dialog.
                _formBaselineJson = _form is null ? null : SerializeFormForDirtyCheck(_form);
                Nav.NavigateTo("/admin/templates");
                return;
            }
        }
        catch (TomlParseException ex)
        {
            _tomlIssues = ex.Issues.ToList();
            _editorIssueSyncPending = true;
            _saveError = _tomlIssues.Count == 1
                ? $"TOML parse error on line {_tomlIssues[0].Line}."
                : $"TOML parse error: {_tomlIssues.Count} issue(s). See gutter markers.";
        }
        catch (InvalidDataException ex)
        {
            _saveError = ex.Message;
        }
        catch (PlanValidationException ex)
        {
            _fieldErrors = ex.Errors;
            _saveError = $"Couldn't save: {ex.Errors.Count} validation error(s).";
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "Unexpected error saving template from TOML.");
            _saveError = "An unexpected error occurred. The change was not saved.";
        }
        finally
        {
            _saving = false;
        }
    }
}
