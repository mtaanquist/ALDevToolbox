@page "/admin/templates/defaults"
@attribute [Authorize(Roles = "Admin,Editor")]
@rendermode InteractiveServer
@inject OrganizationConfigService Config
@inject OrganizationBrandingService Branding
@inject NavigationManager Nav
@inject ILogger<AdminTemplateDefaults> Log
@using ALDevToolbox.Components.Shared
@using ALDevToolbox.Domain.Entities
@using ALDevToolbox.Domain.ValueObjects
@using Microsoft.AspNetCore.Components.Forms
@using ALDevToolbox.Services.Organizations

@*
    Defaults sub-page (Issue #61). Pre-fills for the New Workspace and New
    Extension forms. The form posts only this section's columns; the other
    configuration sub-pages save independently.
*@

<PageTitle>Defaults · Configuration · AL Dev Toolbox</PageTitle>

<div class="page">
    <header class="page-head">
        <div>
            <h1 class="page-head__title">Defaults</h1>
            <p class="page-head__sub">
                Pre-filled into the New Workspace and New Extension forms. Users
                can still edit on the form - these are defaults, not locks.
            </p>
        </div>
        <div class="page-head__actions">
            <a class="btn btn--sm" href="/admin">
                <Icon Name="arrow-left" Width="14" Height="14" />
                <span>Back to admin</span>
            </a>
            @* Save lives in the sticky .form-actions bar at the foot of the form,
               not up here — this page is longer than a viewport and the archetype
               ends a long form with its action bar. *@
        </div>
    </header>

    @if (_loading)
    {
        <div class="loading-block"><span class="spinner"></span><span>Loading...</span></div>
    }
    else
    {
        @if (!string.IsNullOrEmpty(_okMessage))
        {
            <p class="alert alert--success" role="status">
                <Icon Name="circle-check" Width="16" Height="16" /><span>@_okMessage</span>
            </p>
        }
        @if (!string.IsNullOrEmpty(_errMessage))
        {
            <p class="alert alert--danger" role="alert">
                <Icon Name="circle-alert" Width="16" Height="16" /><span>@_errMessage</span>
            </p>
        }

        <section class="card">
            <div class="card__head"><h2 class="card__title">App details</h2></div>
            <div class="card__body form-sec">
                <div class="form-grid">
                    <div class="field">
                        <label class="field__label" for="cfg-publisher">Publisher</label>
                        <input class="input" id="cfg-publisher" type="text" required
                               placeholder="e.g. CRONUS A/S"
                               @bind="_publisher" @bind:event="oninput" />
                        <span class="field__hint">The publisher name on every extension you generate.</span>
                    </div>

                    <div class="field">
                        <label class="field__label" for="cfg-url">Default URL</label>
                        <input class="input" id="cfg-url" type="text"
                               placeholder="e.g. https://cronus.com"
                               @bind="_url" @bind:event="oninput" />
                        <span class="field__hint">Your support or company URL. Leave blank to omit it.</span>
                    </div>

                    <div class="field">
                        <label class="field__label" for="cfg-logo-path">Default logo path</label>
                        <input class="input" id="cfg-logo-path" type="text"
                               placeholder="e.g. ../.assets/images/logo.png"
                               @bind="_logoPath" @bind:event="oninput" />
                        <span class="field__hint">Where each extension looks for the logo below. Leave blank to omit it.</span>
                    </div>

                    @* IdRangeEditor rather than a hand-rolled pair, so this page gets
                       the running "N IDs" count the generator pages have. A range is
                       a size; without the count you subtract in your head. *@
                    <IdRangeEditor IdPrefix="cfg" FromName="cfg-from" ToName="cfg-to"
                                   Label="Default ID range"
                                   FromLabel="First object ID" ToLabel="Last object ID"
                                   Hint="Pre-fills the range on New Workspace and New Extension."
                                   From="_idFrom" FromChanged="v => _idFrom = v"
                                   To="_idTo" ToChanged="v => _idTo = v" />

                    <div class="field field--full">
                        <label class="field__label" for="cfg-brief">Default brief</label>
                        <input class="input" id="cfg-brief" type="text"
                               placeholder="e.g. Customisations and reports for {{workspace_name}}."
                               @bind="_brief" @bind:event="oninput" />
                    </div>

                    <div class="field field--full">
                        <label class="field__label" for="cfg-desc">Default core description</label>
                        <textarea class="textarea" id="cfg-desc" rows="3"
                                  placeholder="Longer description prefilled into the New Workspace form."
                                  @bind="_description" @bind:event="oninput"></textarea>
                    </div>
                </div>

                <MustacheVarsHint />
            </div>
        </section>

        @* Logo section - folded in from the retired /admin/templates/logo page so
           admins manage one Defaults form instead of two. The image is bundled
           into every generated workspace under .assets/images/logo.<ext>.
           SVG uploads have <script> tags and on* attributes stripped on save. *@
        <section class="card">
            <div class="card__head">
                <div>
                    <h2 class="card__title">Logo</h2>
                    <p class="card__sub">
                        Bundled into every generated workspace. SVG or PNG,
                        up to @(OrganizationBrandingService.MaxLogoBytes / 1024) KB.
                    </p>
                </div>
                @* .btn--file hides the native input under the label. It used to
                   have no styling at all, so the browser's own "Choose File /
                   No file chosen" rendered inside our button. *@
                <label class="btn btn--sm btn--file">
                    <Icon Name="upload" Width="14" Height="14" />
                    <span>Choose file...</span>
                    <InputFile id="cfg-logo-file" OnChange="OnLogoChosen" accept="image/png,image/svg+xml" />
                </label>
            </div>
            <div class="card__body form-sec">
                @if (_pendingLogoBytes is not null)
                {
                    <p class="alert alert--info" role="status">
                        <Icon Name="circle-check" Width="16" Height="16" />
                        <span>New logo selected (@_pendingLogoFileName). Click <strong>Save changes</strong> to apply.</span>
                    </p>
                }
                else if (_removeLogo)
                {
                    <p class="alert alert--warn" role="status">
                        <Icon Name="triangle-alert" Width="16" Height="16" />
                        <span>The logo will be removed when you save.</span>
                    </p>
                }
                else if (_logo is not null)
                {
                    <span class="logo-preview">
                        <img src="/admin/configuration/logo/preview?t=@_logoCacheBust" alt="Current logo" class="logo-preview__img" />
                    </span>
                }
                else
                {
                    <div class="empty-state empty-state--quiet">
                        <span class="empty-state__title">No logo yet</span>
                        <span class="empty-state__text">Generated workspaces will ship without one.</span>
                    </div>
                }
            </div>
            @if (_logo is not null || _pendingLogoBytes is not null)
            {
                <div class="card__foot">
                    @if (_pendingLogoBytes is not null || _removeLogo)
                    {
                        <button type="button" class="btn btn--sm" @onclick="ResetLogoChanges">
                            <Icon Name="rotate-ccw" Width="14" Height="14" />
                            <span>Undo</span>
                        </button>
                    }
                    <button type="button" class="btn btn--sm" @onclick="MarkLogoForRemoval" disabled="@_removeLogo">
                        <Icon Name="trash-2" Width="14" Height="14" />
                        <span>Remove logo</span>
                    </button>
                </div>
            }
        </section>

        <div class="form-actions form-actions--sticky">
            <span class="form-actions__spacer"></span>
            @if (IsDirty)
            {
                <span class="form-actions__note">Unsaved changes</span>
            }
            <button type="button" class="btn btn--primary"
                    @onclick="SaveAsync"
                    disabled="@(_saving || !IsDirty)">
                <Icon Name="save" Width="16" Height="16" />
                <span>@(_saving ? "Saving..." : "Save changes")</span>
            </button>
        </div>
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "ok")] public string? OkParam { get; set; }

    private bool _loading = true;
    private bool _saving;
    private string? _okMessage;
    private string? _errMessage;

    private string _publisher = string.Empty;
    private int _idFrom;
    private int _idTo;
    private string _brief = string.Empty;
    private string _description = string.Empty;
    private string _url = string.Empty;
    private string _logoPath = string.Empty;

    private string _basePublisher = string.Empty;
    private int _baseIdFrom;
    private int _baseIdTo;
    private string _baseBrief = string.Empty;
    private string _baseDescription = string.Empty;
    private string _baseUrl = string.Empty;
    private string _baseLogoPath = string.Empty;

    // Logo upload state - folded in from the retired /admin/templates/logo
    // page. Pending bytes live in memory until Save commits via UploadLogoAsync.
    private OrganizationAsset? _logo;
    private byte[]? _pendingLogoBytes;
    private string? _pendingLogoContentType;
    private string? _pendingLogoFileName;
    private bool _removeLogo;
    private long _logoCacheBust = DateTimeOffset.UtcNow.ToUnixTimeSeconds();

    private bool IsDirty =>
        _publisher != _basePublisher
        || _idFrom != _baseIdFrom
        || _idTo != _baseIdTo
        || _brief != _baseBrief
        || _description != _baseDescription
        || _url != _baseUrl
        || _logoPath != _baseLogoPath
        || _pendingLogoBytes is not null
        || _removeLogo;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        _okMessage = OkParam == "saved" ? "Defaults saved." : null;
    }

    private async Task LoadAsync()
    {
        var config = await Config.GetCurrentAsync();
        _publisher = _basePublisher = config.Settings.DefaultPublisher;
        _idFrom = _baseIdFrom = config.Settings.DefaultIdRangeFrom;
        _idTo = _baseIdTo = config.Settings.DefaultIdRangeTo;
        _brief = _baseBrief = config.Settings.DefaultBrief;
        _description = _baseDescription = config.Settings.DefaultCoreDescription;
        _url = _baseUrl = config.Settings.DefaultUrl ?? string.Empty;
        _logoPath = _baseLogoPath = config.Settings.DefaultLogo ?? string.Empty;
        _logo = config.Logo;
        _pendingLogoBytes = null;
        _pendingLogoContentType = null;
        _pendingLogoFileName = null;
        _removeLogo = false;
        _logoCacheBust = DateTimeOffset.UtcNow.ToUnixTimeSeconds();
        _loading = false;
    }

    private async Task OnLogoChosen(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file is null) return;
        if (file.Size > OrganizationBrandingService.MaxLogoBytes)
        {
            _errMessage = $"Logo must be {OrganizationBrandingService.MaxLogoBytes / 1024} KB or smaller.";
            return;
        }
        try
        {
            await using var stream = file.OpenReadStream(OrganizationBrandingService.MaxLogoBytes);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            _pendingLogoBytes = ms.ToArray();
            _pendingLogoContentType = file.ContentType;
            _pendingLogoFileName = file.Name;
            _removeLogo = false;
            _errMessage = null;
        }
        catch (Exception ex)
        {
            Log.LogWarning(ex, "Failed to read uploaded logo '{Name}'.", file.Name);
            _errMessage = $"Could not read the file: {ex.Message}";
        }
    }

    private void MarkLogoForRemoval()
    {
        _removeLogo = true;
        _pendingLogoBytes = null;
        _pendingLogoContentType = null;
        _pendingLogoFileName = null;
    }

    private void ResetLogoChanges()
    {
        _pendingLogoBytes = null;
        _pendingLogoContentType = null;
        _pendingLogoFileName = null;
        _removeLogo = false;
    }

    private async Task SaveAsync()
    {
        if (_saving || !IsDirty) return;
        _saving = true;
        _errMessage = null;
        _okMessage = null;
        try
        {
            await Config.SaveSettingsAsync(new OrganizationSettingsInput(
                DefaultPublisher: _publisher.Trim(),
                DefaultIdRangeFrom: _idFrom,
                DefaultIdRangeTo: _idTo,
                DefaultBrief: _brief,
                DefaultCoreDescription: _description,
                DefaultUrl: _url,
                DefaultLogo: _logoPath));
            // Settings landed; now apply the logo change (if any). Both calls
            // touch the same org-config cache, so a partial failure here still
            // leaves the settings save committed - surface the error so the
            // admin can retry the logo step.
            if (_removeLogo)
            {
                await Branding.RevertLogoAsync();
            }
            else if (_pendingLogoBytes is not null)
            {
                await Branding.UploadLogoAsync(_pendingLogoContentType ?? string.Empty, _pendingLogoBytes);
            }
            Nav.NavigateTo("/admin/templates/defaults?ok=saved", forceLoad: true);
        }
        catch (PlanValidationException ex)
        {
            _errMessage = ex.Errors.FirstOrDefault().Value ?? "Validation failed.";
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "Failed to save organisation defaults.");
            _errMessage = "An unexpected error occurred. The change was not saved.";
        }
        finally
        {
            _saving = false;
        }
    }
}
