@page "/forgot-password"
@layout ALDevToolbox.Components.Layout.AuthLayout
@using ALDevToolbox.Components.Shared

<PageTitle>Forgot password · AL Dev Toolbox</PageTitle>

@*
    Two states on the auth-card archetype, both drawn in
    .design/handoff/PageAuth.dc.html: the form, and the hand-off's third card
    ("Check your email") once it has been sent.

    DIVERGENCE: the hand-off's confirmation names the address it sent to, in
    .auth__mail. Ours cannot. The endpoint deliberately redirects with nothing
    but ok=1, because showing the same confirmation whether or not the email
    matched is what stops this page being an account-enumeration oracle — and
    echoing the address back through the query string would put it in browser
    history and any proxy log for no gain. The .auth__ok block is otherwise the
    hand-off's, icon and all.
*@

@if (Ok == "1")
{
    <AuthCard>
        <Head>
            <div class="auth__ok">
                <span class="auth__ok-icon"><Icon Name="mail" Width="20" Height="20" /></span>
                <h1 class="auth__title">Check your email</h1>
                <p class="auth__sub">
                    If that email matches an account, a reset link is on its way.
                    The link works once and expires in an hour.
                </p>
            </div>
        </Head>
        <ChildContent>
            <a class="btn" href="/forgot-password">Send it again</a>
        </ChildContent>
        <Foot>
            <a class="auth__link" href="/login">Back to sign in</a>
        </Foot>
        <Legal>Nothing after a few minutes? Check your spam folder, then ask your administrator to reset your password for you.</Legal>
    </AuthCard>
}
else if (Error == "not-configured")
{
    @* The form is gone rather than disabled: leaving a live "Send reset link"
       under an alert saying we cannot send it is two halves of one card
       contradicting each other, and people press the big button anyway. *@
    <AuthCard Title="Password resets are turned off">
        <Sub>
            This copy of AL Dev Toolbox can't send email yet, so it can't send you a
            reset link. Ask your administrator to set a new password for you.
        </Sub>
        <Foot>
            <a class="auth__link" href="/login">Back to sign in</a>
        </Foot>
    </AuthCard>
}
else
{
    <AuthCard Title="Forgot password" FormAction="/auth/forgot-password">
        <Sub>
            Enter your email and we'll send a single-use reset link, good for one hour.
        </Sub>
        <ChildContent>
            <div class="auth__fields">
                <div class="field">
                    <label class="field__label" for="fp-email">Email</label>
                    <input class="input" id="fp-email" type="email" name="Email" required autofocus
                           autocomplete="username" placeholder="you@cronus.example" />
                </div>
            </div>
            <button type="submit" class="btn btn--primary" style="height: var(--control-h-lg)">
                <Icon Name="mail" Width="16" Height="16" />
                <span>Send reset link</span>
            </button>
        </ChildContent>
        <Foot>
            <a class="auth__link" href="/login">Back to sign in</a>
        </Foot>
    </AuthCard>
}

@code {
    [SupplyParameterFromQuery(Name = "err")] public string? Error { get; set; }
    [SupplyParameterFromQuery(Name = "ok")] public string? Ok { get; set; }
}
