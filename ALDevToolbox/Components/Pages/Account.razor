@page "/account"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@rendermode InteractiveServer
@using ALDevToolbox.Data
@using ALDevToolbox.Domain.Entities
@using ALDevToolbox.Domain.ValueObjects
@using ALDevToolbox.Services
@using ALDevToolbox.Services.Account
@using ALDevToolbox.Services.OAuth
@using ALDevToolbox.Components.Shared
@using Microsoft.EntityFrameworkCore
@inject AppDbContext Db
@inject IOrganizationContext Org
@inject IJSRuntime JS
@inject RecoveryCodeService RecoveryCodes
@inject PasskeyService Passkeys
@inject IEmailService Email
@inject PersonalAccessTokenService Pats
@inject OAuthClientAdminService OAuthClients
@inject OrganizationConfigService OrgConfig
@inject UserRepositoryTokenService RepoTokens
@inject ILogger<Account> Logger

@*
    Your account, on page archetype 7 ("settings with sub-nav").

    Two divergences from the pre-redesign page, both forced by the design system
    rather than chosen:

    - The left rail (.set-nav) is gone. The system's settings sub-nav is
      .header-tabs, and its component inventory has no vertical nav at all, so
      the rail had nothing to port onto. The tabs are real links carrying
      ?section=, which the page already understood, so every redirect that lands
      on a section keeps working and a tab is now bookmarkable.
    - "Danger zone" is no longer a tab. Deleting your account is one destructive
      setting, and the archetype ships .setting--danger + .setting__lock for
      exactly that (its own example is "Maintenance mode"). It sits at the foot
      of Profile. ?section=danger no longer parses and falls through to Profile,
      which is where the row now lives.

    TabbedPage rather than SettingsPage: the tabs here are tables and several
    cards, not one .setting-list, which is the split those two components exist
    for. See their doc comments.
*@

<PageTitle>Your account · AL Dev Toolbox</PageTitle>

@if (_user is null)
{
    <div class="page">
        <div class="loading-block"><span class="spinner"></span><span>Loading...</span></div>
    </div>
}
else
{
    <TabbedPage Title="Your account" CrumbLabel="Home" CrumbHref="/"
                Tabs="@_tabs" TabsLabel="Account sections">
        <Sub>@_user.DisplayName · @_user.Email · @RoleWord(_user.Role) in @_organization?.Name</Sub>
        <Actions>
            <form method="post" action="/auth/logout">
                <AntiforgeryToken />
                <button type="submit" class="btn">
                    <Icon Name="log-out" Width="15" Height="15" />
                    <span>Sign out</span>
                </button>
            </form>
        </Actions>
        <ChildContent>

            @* --- page-wide flashes, above the sections ------------------- *@

            @if (!string.IsNullOrEmpty(Error) && !string.IsNullOrEmpty(Message))
            {
                @* Endpoints redirect with err=<field>&msg=<sentence>, so the pair
                   is what carries meaning - a bare err= is a field name. *@
                <p class="alert alert--danger" role="alert">
                    <Icon Name="circle-alert" Width="16" Height="16" />
                    <span><strong>@Error:</strong> @Message</span>
                </p>
            }
            @if (Ok is not null)
            {
                <p class="alert alert--success" role="status">
                    <Icon Name="circle-check" Width="16" Height="16" />
                    <span>@FlashFor(Ok)</span>
                </p>
            }
            @if (Required == "1")
            {
                <p class="alert alert--warn" role="alert">
                    <Icon Name="shield-alert" Width="16" Height="16" />
                    <span>
                        Your organisation requires either two-step verification or a passkey.
                        Set one up below - you won't be able to reach the rest of the site until you do.
                    </span>
                </p>
            }
            @if (!string.IsNullOrEmpty(_user.PendingEmail))
            {
                <p class="alert alert--info" role="status">
                    <Icon Name="mail" Width="16" Height="16" />
                    <span>
                        Pending email change to <strong>@_user.PendingEmail</strong>
                        (requested @_user.PendingEmailAt?.ToString("yyyy-MM-dd HH:mm 'UTC'")).
                        The new address still needs to click the confirmation link.
                    </span>
                </p>
            }

            @if (_section == Section.Profile)
            {
                <section class="card">
                    <div class="card__head">
                        <div>
                            <h2 class="card__title">Profile</h2>
                            <p class="card__sub">Your name and how teammates see you.</p>
                        </div>
                    </div>
                    <form method="post" action="/auth/account/display-name">
                        <AntiforgeryToken />
                        <div class="setting-list">
                            <SettingRow Name="Full name"
                                        Hint="Shown on your activity and anywhere your account appears in the toolbox.">
                                <input class="input" type="text" name="DisplayName" value="@_user.DisplayName"
                                       required minlength="2" maxlength="80" aria-label="Full name" />
                            </SettingRow>
                        </div>
                        <div class="card__foot">
                            <button type="submit" class="btn btn--primary">
                                <Icon Name="save" Width="16" Height="16" />
                                <span>Save name</span>
                            </button>
                        </div>
                    </form>
                </section>

                @* Read-only facts, so .meta-row rather than fake settings rows -
                   a .setting with no control reads as one you failed to render. *@
                <div class="meta-row">
                    <div class="meta-item">
                        <span class="meta-item__label">Email</span>
                        <span class="meta-item__value">@_user.Email</span>
                    </div>
                    <div class="meta-item">
                        <span class="meta-item__label">Role</span>
                        <span class="meta-item__value">@RoleWord(_user.Role) - @RoleBlurb(_user.Role)</span>
                    </div>
                    <div class="meta-item">
                        <span class="meta-item__label">Organisation</span>
                        <span class="meta-item__value">@_organization?.Name</span>
                    </div>
                    <div class="meta-item">
                        <span class="meta-item__label">Member since</span>
                        <span class="meta-item__value">@_user.CreatedAt.ToLocalTime().ToString("d MMMM yyyy")</span>
                    </div>
                </div>

                <p class="u-muted">
                    @if (_user.Role == UserRole.Admin)
                    {
                        <text>Need a different email? Change it on your own user under <a href="/admin/administration/users">Users</a>.</text>
                    }
                    else
                    {
                        <text>Need a different email? Ask one of your organisation's admins to change it under <strong>Users</strong>.</text>
                    }
                </p>

                <section class="card">
                    <div class="setting-list">
                        <SettingRow Name="Delete your account" Danger="true"
                                    Lock="You'll be asked to confirm first.">
                            <HintContent>
                                @if (_isLastActiveAdmin && _otherMembersExist)
                                {
                                    <text>
                                        You're the last active admin in <strong>@_organization?.Name</strong>, and the
                                        organisation has other members. Promote another user to admin before you can
                                        delete your account.
                                    </text>
                                }
                                else if (_isLastActiveAdmin)
                                {
                                    <text>
                                        You're the only member of <strong>@_organization?.Name</strong>. Deleting your
                                        account will <strong>also delete the organisation</strong> and all of its
                                        content. There is no undo.
                                    </text>
                                }
                                else
                                {
                                    <text>
                                        This permanently removes your account and signs you out everywhere. Your
                                        organisation and its projects keep running without you.
                                    </text>
                                }
                            </HintContent>
                            <ChildContent>
                                <span>
                                    <button type="button" class="btn btn--danger"
                                            disabled="@(_isLastActiveAdmin && _otherMembersExist)"
                                            @onclick="ConfirmDeleteAsync">
                                        <Icon Name="trash-2" Width="15" Height="15" />
                                        <span>Delete my account</span>
                                    </button>
                                </span>
                            </ChildContent>
                        </SettingRow>
                    </div>
                </section>

                @* Posted by the confirm dialog, never shown. *@
                <form method="post" action="/auth/account/delete" id="delete-account-form" style="display:none">
                    <AntiforgeryToken />
                    @if (_isLastActiveAdmin && !_otherMembersExist)
                    {
                        <input type="checkbox" name="AcceptOrgDeletion" value="true" checked />
                    }
                </form>
            }
            else if (_section == Section.Security)
            {
                <section class="card">
                    <div class="card__head">
                        <div>
                            <h2 class="card__title">Password</h2>
                            <p class="card__sub">A long phrase you'll remember is stronger than a short, complicated one.</p>
                        </div>
                    </div>
                    <form method="post" action="/auth/account/password">
                        <AntiforgeryToken />
                        <div class="card__body">
                            <div class="form-grid">
                                <label class="field">
                                    <span class="field__label">Current password</span>
                                    <input class="input" type="password" name="CurrentPassword" required
                                           autocomplete="current-password" placeholder="Enter your current password" />
                                </label>
                                <label class="field">
                                    <span class="field__label">New password</span>
                                    <input class="input" type="password" name="NewPassword" required minlength="12"
                                           autocomplete="new-password" placeholder="Choose a new password" />
                                    <span class="field__hint">Use at least 12 characters.</span>
                                </label>
                            </div>
                        </div>
                        <div class="card__foot">
                            <span class="form-actions__note">You'll stay signed in on this device.</span>
                            <button type="submit" class="btn btn--primary">
                                <Icon Name="lock" Width="16" Height="16" />
                                <span>Update password</span>
                            </button>
                        </div>
                    </form>
                </section>

                <section class="card">
                    <div class="card__head">
                        <div>
                            <h2 class="card__title">Two-step verification</h2>
                            <p class="card__sub">A second check at sign-in, after your password.</p>
                        </div>
                        @if (_twoStepOn)
                        {
                            <span class="status-pill status-pill--success">On</span>
                        }
                        else
                        {
                            <span class="status-pill status-pill--muted">Off</span>
                        }
                    </div>
                    <div class="setting-list">
                        <SettingRow Name="Authenticator app"
                                    Hint="Six-digit codes from an app like Google Authenticator or 1Password. This is your main second step at sign-in.">
                            @if (!_user.TotpEnabled)
                            {
                                <span class="u-row">
                                    <span class="status-pill status-pill--muted">Off</span>
                                    <a href="/account/2fa/totp/setup" class="btn btn--sm">
                                        <Icon Name="shield" Width="14" Height="14" />
                                        <span>Turn on authenticator app</span>
                                    </a>
                                </span>
                            }
                            else if (_totpAction is null)
                            {
                                <span class="u-row">
                                    <span class="status-pill status-pill--success">On</span>
                                    <button type="button" class="btn btn--sm" @onclick='() => _totpAction = "regenerate"'>
                                        <Icon Name="refresh-cw" Width="14" Height="14" />
                                        <span>Get new recovery codes</span>
                                    </button>
                                    <button type="button" class="btn btn--sm btn--danger" @onclick='() => _totpAction = "disable"'>Turn off</button>
                                </span>
                                @if (_recoveryRemaining == 0)
                                {
                                    <span class="field-error">
                                        <Icon Name="circle-alert" Width="13" Height="13" />
                                        <span>No recovery codes left. Generate new ones so you're not locked out.</span>
                                    </span>
                                }
                                else
                                {
                                    <span class="form-actions__note">@_recoveryRemaining of 10 recovery codes left</span>
                                }
                            }
                            else
                            {
                                <form method="post" class="u-row"
                                      action="@(_totpAction == "disable" ? "/auth/account/2fa/totp/disable" : "/auth/account/2fa/recovery/regenerate")">
                                    <AntiforgeryToken />
                                    <input class="input" type="password" name="Password" required
                                           autocomplete="current-password"
                                           aria-label="Confirm with your current password"
                                           placeholder="Confirm with your current password" />
                                    <button type="submit" class="btn btn--sm @(_totpAction == "disable" ? "btn--danger" : "")">
                                        @(_totpAction == "disable" ? "Turn off" : "Generate codes")
                                    </button>
                                    <button type="button" class="btn btn--sm" @onclick="() => _totpAction = null">Cancel</button>
                                </form>
                            }
                        </SettingRow>

                        <SettingRow Name="Email codes"
                                    Hint="@($"A backup code sent to {_user.Email} for the times you can't reach your authenticator app.")">
                            @if (!_smtpConfigured)
                            {
                                <span class="form-actions__note">
                                    Email codes aren't available on this site yet - a site administrator needs to set up email first.
                                </span>
                            }
                            else if (_user.EmailMfaEnabled)
                            {
                                <form method="post" action="/auth/account/2fa/email/disable" class="u-row">
                                    <AntiforgeryToken />
                                    <span class="status-pill status-pill--success">On</span>
                                    <input class="input" type="password" name="Password" required
                                           autocomplete="current-password" aria-label="Current password"
                                           placeholder="Current password" />
                                    <button type="submit" class="btn btn--sm btn--danger">Turn off email codes</button>
                                </form>
                            }
                            else if (_pendingEmailMfa)
                            {
                                <form method="post" action="/auth/account/2fa/email/confirm" class="u-row">
                                    <AntiforgeryToken />
                                    <input class="input" type="text" name="Code" inputmode="numeric" pattern="[0-9]{6}"
                                           maxlength="6" required aria-label="6-digit code" placeholder="6-digit code" />
                                    <button type="submit" class="btn btn--sm">Confirm</button>
                                </form>
                            }
                            else
                            {
                                <form method="post" action="/auth/account/2fa/email/begin" class="u-row">
                                    <AntiforgeryToken />
                                    <span class="status-pill status-pill--muted">Off</span>
                                    <button type="submit" class="btn btn--sm">
                                        <Icon Name="mail" Width="14" Height="14" />
                                        <span>Turn on email codes</span>
                                    </button>
                                </form>
                            }
                        </SettingRow>
                    </div>
                </section>

                @if (Passkeys.IsConfigured)
                {
                    <section class="card">
                        <div class="card__head">
                            <div>
                                <h2 class="card__title">Passkeys</h2>
                                <p class="card__sub">Sign in with your fingerprint, face, or a security key - no password to type.</p>
                            </div>
                        </div>
                        @if (_passkeys.Count == 0)
                        {
                            <div class="empty-state empty-state--quiet">
                                <span class="empty-state__title">No passkeys yet</span>
                                <span class="empty-state__text">
                                    Add one and your device does the checking, so there's nothing to remember or type.
                                </span>
                            </div>
                        }
                        else
                        {
                            <table class="data-table">
                                <thead>
                                    <tr>
                                        <th>Device</th>
                                        <th>Added</th>
                                        <th>Last used</th>
                                        <th class="data-table__actions"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                @foreach (var p in _passkeys)
                                {
                                    <tr>
                                        <td>@p.Nickname</td>
                                        <td class="u-muted">@p.CreatedAt.ToLocalTime().ToString("d MMM yyyy")</td>
                                        <td class="u-muted">@(p.LastUsedAt is { } lu ? lu.ToLocalTime().ToString("d MMM yyyy") : "Never")</td>
                                        <td class="data-table__actions">
                                            @* Static message: a nickname is free text and an
                                               apostrophe in it would end the JS literal. *@
                                            <form method="post" action="/auth/account/passkeys/@p.Id/delete"
                                                  onsubmit="return confirm('Remove this passkey? You will not be able to sign in with that device until you add it again.');">
                                                <AntiforgeryToken />
                                                <button type="submit" class="btn btn--sm btn--danger">Remove</button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                        }
                        @if (!string.IsNullOrEmpty(_passkeyError))
                        {
                            <div class="card__body">
                                <p class="alert alert--danger" role="alert">
                                    <Icon Name="circle-alert" Width="16" Height="16" />
                                    <span>@_passkeyError</span>
                                </p>
                            </div>
                        }
                        <div class="card__foot">
                            <button type="button" class="btn" @onclick="RegisterPasskeyAsync" disabled="@_busy">
                                <Icon Name="plus" Width="16" Height="16" />
                                <span>Add a passkey</span>
                            </button>
                        </div>
                    </section>
                }
            }
            else if (_section == Section.Ai)
            {
                <p class="u-muted">
                    Let AI coding assistants work in AL Dev Toolbox on your behalf. Desktop and
                    command-line tools (Claude Desktop, Cursor, Claude Code) sign in with an access
                    token you paste in once; Claude on the web and mobile connect through a
                    permission screen, with nothing to paste.
                    <a href="/docs/mcp">How to connect an assistant</a>.
                </p>

                <section class="card">
                    <div class="card__head">
                        <div>
                            <h2 class="card__title">Access tokens</h2>
                            <p class="card__sub">Treat a token like a password - anyone who has it can act as you in connected tools.</p>
                        </div>
                        <button type="button" class="btn btn--sm" @onclick="() => _showCreateToken = !_showCreateToken">
                            <Icon Name="plus" Width="14" Height="14" />
                            <span>Create token</span>
                        </button>
                    </div>

                    @if (_showCreateToken)
                    {
                        <form method="post" action="/auth/account/access-tokens/create">
                            <AntiforgeryToken />
                            <div class="card__body">
                                <div class="form-grid">
                                    <label class="field">
                                        <span class="field__label">Name</span>
                                        <input class="input" type="text" name="Name" required minlength="1" maxlength="80"
                                               placeholder="e.g. Cursor on laptop" />
                                        <span class="field__hint">A label that helps you remember where this token is used.</span>
                                    </label>
                                    <label class="field">
                                        <span class="field__label">Expires</span>
                                        <span class="select-wrap">
                                            <select class="select" name="TtlDays">
                                                <option value="30">30 days</option>
                                                <option value="90" selected>90 days</option>
                                                <option value="180">180 days</option>
                                                <option value="365">1 year</option>
                                                <option value="0">No expiry</option>
                                            </select>
                                            <Icon Name="chevron-down" Css="select-wrap__caret" Width="15" Height="15" />
                                        </span>
                                        <span class="field__hint">You can revoke a token at any time.</span>
                                    </label>
                                </div>
                            </div>
                            <div class="card__foot">
                                <button type="button" class="btn" @onclick="() => _showCreateToken = false">Cancel</button>
                                <button type="submit" class="btn btn--primary">
                                    <Icon Name="key-round" Width="16" Height="16" />
                                    <span>Create token</span>
                                </button>
                            </div>
                        </form>
                    }

                    @if (_tokens is null)
                    {
                        <div class="loading-block loading-block--under-table">
                            <span class="spinner"></span><span>Loading...</span>
                        </div>
                    }
                    else
                    {
                        var now = DateTime.UtcNow;
                        var active = _tokens.Where(t => PersonalAccessTokenService.IsActiveAt(t, now)).ToList();
                        var inactive = _tokens.Where(t => !PersonalAccessTokenService.IsActiveAt(t, now)).ToList();

                        @if (active.Count == 0 && !_showCreateToken)
                        {
                            <div class="empty-state empty-state--quiet">
                                <span class="empty-state__title">No access tokens yet</span>
                                <span class="empty-state__text">
                                    Create one to connect a desktop or command-line assistant.
                                </span>
                            </div>
                        }
                        else if (active.Count > 0)
                        {
                            <table class="data-table data-table--edge">
                                <thead>
                                    <tr>
                                        <th class="data-table__col-state"><span class="u-sr">Status</span></th>
                                        <th>Token</th>
                                        <th>Access</th>
                                        <th>Last used</th>
                                        <th>Expires</th>
                                        <th class="data-table__actions"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                @foreach (var t in active)
                                {
                                    var state = PersonalAccessTokenService.RowState(t, now);
                                    <tr class="@RowStateIcon.RowClass(state)">
                                        <td class="data-table__col-state"><RowStateIcon State="@state" /></td>
                                        <td>@t.Name<div class="u-muted"><code class="code">@t.TokenPrefix...</code></div></td>
                                        <td>Acts as you</td>
                                        <td class="u-muted">@(t.LastUsedAt is { } lu ? lu.ToLocalTime().ToString("d MMM yyyy") : "Never")</td>
                                        <td class="u-muted">@(t.ExpiresAt is { } exp ? exp.ToLocalTime().ToString("d MMM yyyy") : "Never")</td>
                                        <td class="data-table__actions">
                                            <form method="post" action="/auth/account/access-tokens/@t.Id/revoke"
                                                  onsubmit="return confirm('Revoke this token? Whatever is using it stops working straight away, and this cannot be undone.');">
                                                <AntiforgeryToken />
                                                <button type="submit" class="btn btn--sm btn--danger">Revoke</button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                        }

                        @if (inactive.Count > 0)
                        {
                            <details class="card__body">
                                <summary>Show @inactive.Count revoked or expired @(inactive.Count == 1 ? "token" : "tokens")</summary>
                                <p class="u-muted">
                                    Kept so audit log entries that reference these tokens still resolve.
                                    They can't be used to sign in.
                                </p>
                                <table class="data-table data-table--edge">
                                    <thead>
                                        <tr>
                                            <th class="data-table__col-state"><span class="u-sr">Status</span></th>
                                            <th>Token</th>
                                            <th>Created</th>
                                            <th>Expires</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                    @foreach (var t in inactive)
                                    {
                                        var state = PersonalAccessTokenService.RowState(t, now);
                                        <tr class="@RowStateIcon.RowClass(state)">
                                            <td class="data-table__col-state"><RowStateIcon State="@state" /></td>
                                            <td>@t.Name<div class="u-muted"><code class="code">@t.TokenPrefix...</code></div></td>
                                            <td class="u-muted">@t.CreatedAt.ToString("yyyy-MM-dd")</td>
                                            <td class="u-muted">@(t.ExpiresAt?.ToString("yyyy-MM-dd") ?? "Never")</td>
                                        </tr>
                                    }
                                    </tbody>
                                </table>
                            </details>
                        }
                    }
                </section>

                <section class="card">
                    <div class="card__head">
                        <div>
                            <h2 class="card__title">Connected assistants</h2>
                            <p class="card__sub">These connect through a permission screen and can be disconnected here anytime.</p>
                        </div>
                    </div>

                    @if (_clients is null)
                    {
                        <div class="loading-block loading-block--under-table">
                            <span class="spinner"></span><span>Loading...</span>
                        </div>
                    }
                    else
                    {
                        var activeClients = _clients.Where(c => c.RevokedAt is null).ToList();
                        var inactiveClients = _clients.Where(c => c.RevokedAt is not null).ToList();

                        @if (activeClients.Count == 0)
                        {
                            <div class="empty-state empty-state--quiet">
                                <span class="empty-state__title">No assistants connected yet</span>
                                <span class="empty-state__text">
                                    Adding AL Dev Toolbox as a connector in Claude opens a permission
                                    screen; once you click <strong>Allow</strong>, the connection shows up here.
                                </span>
                            </div>
                        }
                        else
                        {
                            <table class="data-table data-table--edge">
                                <thead>
                                    <tr>
                                        <th class="data-table__col-state"><span class="u-sr">Status</span></th>
                                        <th>Assistant</th>
                                        <th>Permissions</th>
                                        <th>Connected</th>
                                        <th class="data-table__actions"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                @foreach (var c in activeClients)
                                {
                                    <tr class="@RowStateIcon.RowClass("active")">
                                        <td class="data-table__col-state"><RowStateIcon State="active" /></td>
                                        <td>
                                            @c.DisplayName
                                            @if (c.RedirectHosts.Count > 0)
                                            {
                                                <div class="u-muted">@string.Join(", ", c.RedirectHosts)</div>
                                            }
                                        </td>
                                        <td>@HumanScopes(c.Scopes)</td>
                                        <td class="u-muted">@c.GrantedAt.ToLocalTime().ToString("d MMM yyyy")</td>
                                        <td class="data-table__actions">
                                            <button type="button" class="btn btn--sm btn--danger"
                                                    @onclick="() => DisconnectClientAsync(c)">Disconnect</button>
                                        </td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                        }

                        @if (inactiveClients.Count > 0)
                        {
                            <details class="card__body">
                                <summary>Show @inactiveClients.Count revoked @(inactiveClients.Count == 1 ? "connection" : "connections")</summary>
                                <p class="u-muted">
                                    Kept so audit log entries still resolve. The assistant cannot reach
                                    AL Dev Toolbox unless it reconnects.
                                </p>
                                <table class="data-table data-table--edge">
                                    <thead>
                                        <tr>
                                            <th class="data-table__col-state"><span class="u-sr">Status</span></th>
                                            <th>Assistant</th>
                                            <th>Permissions</th>
                                            <th>Approved</th>
                                            <th>Revoked</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                    @foreach (var c in inactiveClients)
                                    {
                                        <tr class="@RowStateIcon.RowClass("revoked")">
                                            <td class="data-table__col-state"><RowStateIcon State="revoked" /></td>
                                            <td>@c.DisplayName</td>
                                            <td class="u-muted">@HumanScopes(c.Scopes)</td>
                                            <td class="u-muted">@c.GrantedAt.ToString("yyyy-MM-dd")</td>
                                            <td class="u-muted">@(c.RevokedAt?.ToString("yyyy-MM-dd") ?? "Never")</td>
                                        </tr>
                                    }
                                    </tbody>
                                </table>
                            </details>
                        }
                    }
                </section>
            }
            else
            {
                <p class="u-muted">
                    Your personal sign-ins to the Git providers you build projects from. Every build
                    clones your repositories as you, so a build will fail if one of these has expired
                    or been removed.
                </p>

                @if (!string.IsNullOrEmpty(_repoOk))
                {
                    <p class="alert alert--success" role="status">
                        <Icon Name="circle-check" Width="16" Height="16" /><span>@_repoOk</span>
                    </p>
                }
                @if (!string.IsNullOrEmpty(_repoErr))
                {
                    <p class="alert alert--danger" role="alert">
                        <Icon Name="circle-alert" Width="16" Height="16" /><span>@_repoErr</span>
                    </p>
                }

                <section class="card">
                    <div class="card__head">
                        <div>
                            <h2 class="card__title">Repository access</h2>
                            <p class="card__sub">Tokens are stored encrypted and only used to clone.</p>
                        </div>
                    </div>

                    @if (_repoLoading)
                    {
                        <div class="loading-block loading-block--under-table">
                            <span class="spinner"></span><span>Loading...</span>
                        </div>
                    }
                    else if (_repoProviders.Count == 0)
                    {
                        <div class="empty-state empty-state--quiet">
                            <span class="empty-state__title">No Git providers turned on yet</span>
                            <span class="empty-state__text">
                                An administrator enables these for your organisation under
                                Administration → Repositories. Once one is on, you connect it here.
                            </span>
                        </div>
                    }
                    else
                    {
                        <table class="data-table data-table--edge">
                            <thead>
                                <tr>
                                    <th class="data-table__col-state"><span class="u-sr">Status</span></th>
                                    <th>Provider</th>
                                    <th>Last used</th>
                                    <th class="data-table__actions"></th>
                                </tr>
                            </thead>
                            <tbody>
                            @foreach (var p in _repoProviders)
                            {
                                var f = _repoFields[p];
                                var state = f.HasToken ? "connected" : "not-connected";
                                <tr class="@RowStateIcon.RowClass(state)">
                                    <td class="data-table__col-state"><RowStateIcon State="@state" /></td>
                                    <td>
                                        @p.DisplayName()
                                        <div class="u-muted">@(f.HasToken ? "Token stored" : "Not connected")</div>
                                    </td>
                                    <td class="u-muted">@(f.LastUsedAt is { } lu ? lu.ToLocalTime().ToString("d MMM yyyy") : "Never")</td>
                                    <td class="data-table__actions">
                                        @if (f.HasToken)
                                        {
                                            <button type="button" class="btn btn--sm btn--danger"
                                                    @onclick="() => DisconnectRepoAsync(p)">Disconnect</button>
                                        }
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </table>

                        @if (_showRepoForm)
                        {
                            <div class="card__body">
                                <div class="form-grid">
                                    @foreach (var p in _repoProviders)
                                    {
                                        var f = _repoFields[p];
                                        <label class="field">
                                            <span class="field__label">@p.DisplayName() token</span>
                                            <input class="input" type="password" autocomplete="off"
                                                   placeholder="@(f.HasToken ? "Leave blank to keep the stored token" : RepoPlaceholder(p))"
                                                   @bind="f.NewValue" disabled="@_repoSaving" />
                                            <span class="field__hint">@RepoScopeHint(p)</span>
                                        </label>
                                    }
                                </div>
                            </div>
                            <div class="card__foot">
                                <button type="button" class="btn" @onclick="() => _showRepoForm = false" disabled="@_repoSaving">Cancel</button>
                                <button type="button" class="btn btn--primary" @onclick="SaveRepoTokensAsync" disabled="@_repoSaving">
                                    <Icon Name="save" Width="16" Height="16" />
                                    <span>@(_repoSaving ? "Saving..." : "Save tokens")</span>
                                </button>
                            </div>
                        }
                        else
                        {
                            <div class="card__foot">
                                <span class="form-actions__note">Works with Azure DevOps and GitHub.</span>
                                <button type="button" class="btn" @onclick="() => _showRepoForm = true">
                                    <Icon Name="plus" Width="16" Height="16" />
                                    <span>@(_connectedRepoCount > 0 ? "Add or update a token" : "Connect a provider")</span>
                                </button>
                            </div>
                        }
                    }
                </section>
            }
        </ChildContent>
    </TabbedPage>
}

<ConfirmDialog @ref="_confirmDelete" />

@code {
    private enum Section { Profile, Security, Ai, Repos }

    [SupplyParameterFromQuery(Name = "section")] public string? SectionParam { get; set; }
    [SupplyParameterFromQuery(Name = "err")] public string? Error { get; set; }
    [SupplyParameterFromQuery(Name = "msg")] public string? Message { get; set; }
    [SupplyParameterFromQuery(Name = "ok")] public string? Ok { get; set; }
    [SupplyParameterFromQuery(Name = "required")] public string? Required { get; set; }

    private Section _section = Section.Profile;
    private IReadOnlyList<HeaderTabs.HeaderTabItem> _tabs = Array.Empty<HeaderTabs.HeaderTabItem>();

    private User? _user;
    private Organization? _organization;
    private bool _isLastActiveAdmin;
    private bool _otherMembersExist;
    private bool _smtpConfigured;
    private bool _pendingEmailMfa;
    private int _recoveryRemaining;
    private string? _totpAction; // null, "regenerate" or "disable" — drives the inline password confirm
    private bool _busy;
    private string? _passkeyError;
    private IReadOnlyList<UserPasskey> _passkeys = Array.Empty<UserPasskey>();
    private ConfirmDialog? _confirmDelete;

    // AI assistants
    private IReadOnlyList<PersonalAccessToken>? _tokens;
    private IReadOnlyList<ConnectedClient>? _clients;
    private bool _showCreateToken;

    // Repository access
    private bool _repoLoading = true;
    private bool _repoSaving;
    private bool _showRepoForm;
    private string? _repoOk;
    private string? _repoErr;
    private List<RepositoryProvider> _repoProviders = new();
    private readonly Dictionary<RepositoryProvider, RepoField> _repoFields = new();

    private sealed class RepoField
    {
        public bool HasToken { get; set; }
        public DateTime? LastUsedAt { get; set; }
        public string? NewValue { get; set; }
    }

    private bool _twoStepOn => _user is { } u && (u.TotpEnabled || u.EmailMfaEnabled);
    private int _connectedRepoCount => _repoFields.Values.Count(f => f.HasToken);

    protected override async Task OnInitializedAsync()
    {
        var userId = Org.CurrentUserId;
        if (userId is null) return;
        _user = await Db.Users.IgnoreQueryFilters().FirstOrDefaultAsync(u => u.Id == userId.Value);
        if (_user is null) return;
        _organization = await Db.Organizations.IgnoreQueryFilters().FirstOrDefaultAsync(o => o.Id == _user.OrganizationId);
        var activeAdmins = await Db.Users.IgnoreQueryFilters()
            .CountAsync(u => u.OrganizationId == _user.OrganizationId
                             && u.Role == UserRole.Admin
                             && u.Status == UserStatus.Active);
        _isLastActiveAdmin = _user.Role == UserRole.Admin && _user.Status == UserStatus.Active && activeAdmins <= 1;
        _otherMembersExist = await Db.Users.IgnoreQueryFilters()
            .AnyAsync(u => u.OrganizationId == _user.OrganizationId && u.Id != _user.Id);
        _smtpConfigured = await Email.IsConfiguredAsync();
        _pendingEmailMfa = Ok == "email-mfa-sent";
        _recoveryRemaining = await RecoveryCodes.RemainingAsync(_user.Id);
        if (Passkeys.IsConfigured)
        {
            _passkeys = await Passkeys.ListForUserAsync(_user.Id);
        }

        _tokens = await Db.PersonalAccessTokens
            .Where(p => p.UserId == _user.Id)
            .OrderByDescending(p => p.CreatedAt)
            .AsNoTracking()
            .ToListAsync();
        _clients = await OAuthClients.ListForUserAsync(_user.Id);

        await ReloadReposAsync();
        _repoLoading = false;
    }

    /// <summary>
    /// Runs on every parameter change, not just the first, because the section
    /// tabs are real links carrying <c>?section=</c>: clicking one re-renders
    /// this same component with new query parameters and never re-runs
    /// <see cref="OnInitializedAsync"/>, so the loaded data is kept.
    /// </summary>
    protected override void OnParametersSet()
    {
        _section = ResolveSection();
        _tabs = new HeaderTabs.HeaderTabItem[]
        {
            new("Profile", "/account?section=profile", _section == Section.Profile),
            new("Sign-in & security", "/account?section=security", _section == Section.Security),
            new("AI assistants", "/account?section=ai", _section == Section.Ai),
            new("Repository access", "/account?section=repos", _section == Section.Repos),
        };
    }

    /// <summary>
    /// Picks the section to show. An explicit <c>?section=</c> wins; otherwise we
    /// land the user where a redirect's <c>ok=</c>/<c>err=</c> code (or the
    /// strong-auth gate's <c>required=1</c>) belongs, so the success/error banner
    /// shows in context rather than on Profile.
    /// </summary>
    private Section ResolveSection()
    {
        if (Enum.TryParse<Section>(SectionParam, ignoreCase: true, out var explicitSection))
        {
            return explicitSection;
        }
        if (Required == "1") return Section.Security;
        var code = Ok ?? Error;
        return code switch
        {
            "display-name" => Section.Profile,
            "password" or "totp-disabled" or "email-mfa-sent" or "email-mfa-enabled"
                or "email-mfa-disabled" or "passkey-deleted" or "passkey-renamed"
                or "Totp" or "Email" or "Code" or "Password" => Section.Security,
            "token-revoked" or "token-created" => Section.Ai,
            _ => Section.Profile,
        };
    }

    private static string FlashFor(string ok) => ok switch
    {
        "password" => "Password updated.",
        "display-name" => "Full name updated.",
        "totp-disabled" => "Authenticator app turned off.",
        "email-mfa-sent" => "We sent you a verification code. Enter it below to turn on email codes.",
        "email-mfa-enabled" => "Email codes turned on.",
        "email-mfa-disabled" => "Email codes turned off.",
        "passkey-deleted" => "Passkey removed.",
        "passkey-renamed" => "Passkey renamed.",
        "token-revoked" => "Access token revoked.",
        _ => "Saved.",
    };

    private static string RoleWord(UserRole role) => role switch
    {
        UserRole.Admin => "Admin",
        UserRole.Editor => "Editor",
        _ => "User",
    };

    private static string RoleBlurb(UserRole role) => role switch
    {
        UserRole.Admin => "Full access",
        UserRole.Editor => "Can author content",
        _ => "Uses the generator",
    };

    // --- Passkeys --------------------------------------------------------

    private async Task RegisterPasskeyAsync()
    {
        _busy = true;
        _passkeyError = null;
        try
        {
            await JS.InvokeVoidAsync("aldtPasskey.register");
        }
        catch (JSDisconnectedException)
        {
            // The circuit went away mid-ceremony — nothing to show the user.
        }
        catch (Exception ex)
        {
            // Don't surface the raw JS-interop / .NET exception text to the user;
            // log the detail and show a friendly line instead.
            Logger.LogWarning(ex, "Passkey registration failed for user {UserId}.", Org.CurrentUserId);
            _passkeyError = "We couldn't finish adding that passkey. Try again, or use a different authenticator.";
        }
        finally
        {
            _busy = false;
        }
    }

    // --- Connected assistants -------------------------------------------

    /// <summary>
    /// Disconnecting stops an assistant reaching the toolbox as you, so it asks
    /// first — the old row button did it on a single click with no way back.
    /// </summary>
    private async Task DisconnectClientAsync(ConnectedClient client)
    {
        if (_user is null || _confirmDelete is null) return;
        var confirmed = await _confirmDelete.OpenAsync(
            title: "Disconnect this assistant?",
            message: $"{client.DisplayName} will lose access straight away. You can reconnect it from the assistant itself.",
            confirmLabel: "Disconnect",
            confirmButtonClass: "btn--danger");
        if (!confirmed) return;
        await OAuthClients.RevokeConsentAsync(client.ConsentId, _user.Id);
        _clients = await OAuthClients.ListForUserAsync(_user.Id);
    }

    private static string HumanScopes(string scopes)
    {
        var parts = scopes.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        var labels = parts.Select(s => s switch
        {
            "mcp" => "Use AL Dev Toolbox tools",
            "offline_access" => "Stay signed in",
            _ => s,
        });
        return string.Join(", ", labels);
    }

    // --- Repository access ----------------------------------------------

    private async Task ReloadReposAsync()
    {
        _repoProviders = (await OrgConfig.GetAllowedProvidersAsync()).ToList();
        var status = await RepoTokens.GetTokenStatusAsync();
        _repoFields.Clear();
        foreach (var p in _repoProviders)
        {
            status.TryGetValue(p, out var s);
            _repoFields[p] = new RepoField { HasToken = s is not null, LastUsedAt = s?.LastUsedAt };
        }
    }

    private async Task SaveRepoTokensAsync()
    {
        if (_repoSaving) return;
        _repoSaving = true;
        _repoOk = _repoErr = null;
        try
        {
            var saved = 0;
            foreach (var p in _repoProviders)
            {
                var f = _repoFields[p];
                if (!string.IsNullOrWhiteSpace(f.NewValue))
                {
                    await RepoTokens.SaveTokenAsync(p, f.NewValue, clear: false);
                    saved++;
                }
            }
            await ReloadReposAsync();
            _showRepoForm = false;
            _repoOk = saved == 1 ? "Repository token saved." : saved > 1 ? "Repository tokens saved." : null;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to save repository tokens.");
            _repoErr = "An unexpected error occurred. The change was not saved.";
        }
        finally
        {
            _repoSaving = false;
        }
    }

    private async Task DisconnectRepoAsync(RepositoryProvider provider)
    {
        if (_confirmDelete is null) return;
        var confirmed = await _confirmDelete.OpenAsync(
            title: $"Disconnect {provider.DisplayName()}?",
            message: $"Your stored {provider.DisplayName()} token will be removed. Builds you start that clone {provider.DisplayName()} repositories will fail until you reconnect.",
            confirmLabel: "Disconnect",
            confirmButtonClass: "btn--danger");
        if (!confirmed) return;
        try
        {
            await RepoTokens.SaveTokenAsync(provider, plaintext: null, clear: true);
            await ReloadReposAsync();
            _repoOk = $"{provider.DisplayName()} disconnected.";
            _repoErr = null;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to disconnect repository provider {Provider}.", provider);
            _repoErr = "An unexpected error occurred. The change was not saved.";
        }
    }

    private static string RepoScopeHint(RepositoryProvider p) => p switch
    {
        RepositoryProvider.GitHub => "Needs repo (read) scope. Used for repositories on github.com.",
        RepositoryProvider.AzureDevOps => "Needs Code (Read) scope. Used for repositories on dev.azure.com.",
        _ => string.Empty,
    };

    private static string RepoPlaceholder(RepositoryProvider p) => p switch
    {
        RepositoryProvider.GitHub => "Paste a GitHub personal access token",
        RepositoryProvider.AzureDevOps => "Paste an Azure DevOps personal access token",
        _ => "Paste a token",
    };

    // --- Deleting your account -------------------------------------------

    private async Task ConfirmDeleteAsync()
    {
        if (_confirmDelete is null) return;
        var message = _isLastActiveAdmin && !_otherMembersExist
            ? $"This will delete the {_organization?.Name} organisation and every template, module and audit row in it. There is no undo."
            : "Your account will be removed. The organisation keeps running.";
        var confirmed = await _confirmDelete.OpenAsync(
            title: "Delete your account?",
            message: message,
            confirmLabel: "Delete account",
            confirmButtonClass: "btn--danger");
        if (!confirmed) return;
        try
        {
            await JS.InvokeVoidAsync("document.getElementById('delete-account-form').submit");
        }
        catch (JSDisconnectedException)
        {
            // Circuit gone before the form could post — the user can retry.
        }
    }
}
