@page "/object-explorer/module/{ModuleId:long}"
@attribute [Authorize]
@rendermode InteractiveServer
@inject ALDevToolbox.Services.ObjectExplorer.ObjectExplorerService ObjectExplorer
@inject IJSRuntime JS
@using ALDevToolbox.Services.ObjectExplorer
@using Microsoft.EntityFrameworkCore
@using ALDevToolbox.Components.Shared

<PageTitle>@(_moduleName ?? "Extension") · AL Dev Toolbox</PageTitle>

<div class="page">
    @if (_moduleName is null && _loaded)
    {
        @* Same fix as OeObjectDetail: an id that resolves to nothing used to
           leave the page on "Loading..." for ever, which reads as a hang. A
           stale bookmark into a re-imported release lands here. *@
        <div class="card">
            <div class="empty-state">
                <span class="empty-state__icon"><Icon Name="funnel-x" Width="21" Height="21" /></span>
                <span class="empty-state__title">We couldn't find that extension</span>
                <span class="empty-state__text">
                    The release it belonged to may have been removed or re-imported
                    since this link was made.
                </span>
                <a class="btn empty-state__action" href="/object-explorer">Back to Object Explorer</a>
            </div>
        </div>
    }
    else if (_moduleName is null)
    {
        <div class="loading-block"><span class="spinner"></span><span>Loading extension...</span></div>
    }
    else
    {
        <div class="page-head">
            <div>
                <div class="page-head__crumbs">
                    <a href="/object-explorer">Object Explorer</a>
                    @if (_releaseId is { } rid)
                    {
                        <Icon Name="chevron-right" Width="14" Height="14" />
                        <a href="@($"/object-explorer/release/{rid}")">@_releaseLabel</a>
                    }
                    <Icon Name="chevron-right" Width="14" Height="14" />
                    <span>@_moduleName</span>
                </div>
                <h1 class="page-head__title">@_moduleName</h1>
                <p class="page-head__sub">@_modulePublisher · @_moduleVersion</p>
            </div>
        </div>

        @* The list archetype's filter bar, not a form section: these two
           controls narrow a list, they are not fields being filled in. Both
           carry aria-labels rather than visible ones - the bar sits directly
           under the page head, so what it filters is never in doubt. *@
        <div class="filter-bar">
            <span class="search filter-bar__search">
                <Icon Name="search" Width="15" Height="15" Css="search__icon" />
                @*
                    Uncontrolled input - no `value="@_search"` binding.
                    See wwwroot/uncontrolled-input.js for the rationale.
                *@
                <input type="search"
                       class="input"
                       placeholder="Filter by name or object id..."
                       @ref="_searchInputRef"
                       @oninput="OnSearch"
                       aria-label="Filter this module's objects by name or id" />
            </span>
            <span class="select-wrap" style="width: 190px">
                @* The AL keywords, not prose: this is the word the grid below
                   prints and the word the user types into a search box. The
                   dropdown said "Control add-in" while the row said
                   "controladdin", one screen apart. *@
                <select value="@_kind" @onchange="OnKindChange" class="select"
                        aria-label="Filter by object type">
                    <option value="">All types</option>
                    <option value="codeunit">codeunit</option>
                    <option value="table">table</option>
                    <option value="page">page</option>
                    <option value="report">report</option>
                    <option value="xmlport">xmlport</option>
                    <option value="query">query</option>
                    <option value="interface">interface</option>
                    <option value="enum">enum</option>
                    <option value="tableextension">tableextension</option>
                    <option value="pageextension">pageextension</option>
                    <option value="reportextension">reportextension</option>
                    <option value="enumextension">enumextension</option>
                    <option value="permissionset">permissionset</option>
                    <option value="controladdin">controladdin</option>
                    <option value="menusuite">menusuite</option>
                    <option value="form">form</option>
                    <option value="dataport">dataport</option>
                </select>
                <Icon Name="chevron-down" Css="select-wrap__caret" />
            </span>
        </div>

        @if (_objects is { Rows.Count: 0 })
        {
            <div class="card">
                <div class="empty-state">
                    <span class="empty-state__icon"><Icon Name="funnel-x" Width="21" Height="21" /></span>
                    <span class="empty-state__title">No objects match</span>
                    <span class="empty-state__text">
                        Clear the search or pick All types to see everything this extension ships.
                    </span>
                </div>
            </div>
        }
        else
        {
            @if (_objects is not null)
            {
                <p class="u-muted">@_objects.TotalCount.ToString("N0") object@(_objects.TotalCount == 1 ? "" : "s").</p>
            }
            <table class="data-table">
                <thead>
                    <tr>
                        <th scope="col">Type</th>
                        <th class="data-table__num">Id</th>
                        <th scope="col">Name</th>
                        <th scope="col">Namespace</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_objects is null)
                    {
                        <TableSkeletonRows Columns="4" StateColumn="false" />
                    }
                    @foreach (var o in _objects?.Rows ?? Array.Empty<ObjectListItem>())
                    {
                        <tr>
                            <td><OeKindCell Kind="@o.Kind" /></td>
                            <td class="data-table__num">@(o.ObjectId?.ToString() ?? "—")</td>
                            <td><a href="@($"/object-explorer/object/{o.Id}")">@o.Name</a></td>
                            <td class="u-muted">@(o.Namespace ?? "—")</td>
                        </tr>
                    }
                </tbody>
            </table>
            @if (_objects is null)
            {
                <div class="loading-block loading-block--under-table">
                    <span class="spinner"></span><span>Loading objects...</span>
                </div>
            }
        }
    }
</div>

@code {
    [Parameter] public long ModuleId { get; set; }

    /// <summary>Set once the lookup has run, so a null name can be told apart
    /// from one that has not been fetched yet.</summary>
    private bool _loaded;

    private string? _moduleName;
    private string? _modulePublisher;
    private string? _moduleVersion;
    private int? _releaseId;
    private string? _releaseLabel;
    private ObjectListPage? _objects;
    private string _kind = string.Empty;
    private string _search = string.Empty;
    private const int PageSize = 200;
    private ElementReference _searchInputRef;

    // Debounce + serialisation guard. Without these, every keystroke
    // triggers an immediate ReloadAsync; the scoped EF context can't
    // run two queries concurrently, so a fast typer hits exceptions.
    // 250ms matches the OeReleaseDetail debounce so the two pages feel
    // identical under fast typing.
    private static readonly TimeSpan SearchDebounce = TimeSpan.FromMilliseconds(250);
    private CancellationTokenSource? _searchDebounceCts;
    private readonly SemaphoreSlim _reloadGate = new(1, 1);

    protected override async Task OnInitializedAsync()
    {
        var header = await ObjectExplorer.GetModuleHeaderAsync(ModuleId);
        _loaded = true;
        if (header is null) return;

        _moduleName = header.Name;
        _modulePublisher = header.Publisher;
        _moduleVersion = header.Version;
        _releaseId = header.ReleaseId;
        _releaseLabel = header.ReleaseLabel;

        await ReloadAsync();
    }

    private async Task OnSearch(ChangeEventArgs args)
    {
        _search = args.Value?.ToString() ?? string.Empty;
        await DebounceReloadAsync();
    }

    private async Task OnKindChange(ChangeEventArgs args)
    {
        _kind = args.Value?.ToString() ?? string.Empty;
        await ReloadAsync();
    }

    private async Task DebounceReloadAsync()
    {
        _searchDebounceCts?.Cancel();
        _searchDebounceCts?.Dispose();
        var cts = new CancellationTokenSource();
        _searchDebounceCts = cts;
        try { await Task.Delay(SearchDebounce, cts.Token); }
        catch (TaskCanceledException) { return; }
        if (cts.IsCancellationRequested) return;
        await ReloadAsync();
        StateHasChanged();
    }

    private async Task ReloadAsync()
    {
        await _reloadGate.WaitAsync();
        try
        {
            _objects = await ObjectExplorer.ListObjectsAsync(
                ModuleId,
                new ObjectListFilter(
                    Kinds: string.IsNullOrEmpty(_kind) ? null : new[] { _kind },
                    Search: string.IsNullOrWhiteSpace(_search) ? null : _search),
                skip: 0,
                take: PageSize);
        }
        finally { _reloadGate.Release(); }
    }
}
