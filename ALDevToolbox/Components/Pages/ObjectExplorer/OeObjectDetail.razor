@page "/object-explorer/object/{ObjectId:long}"
@attribute [Authorize]
@rendermode InteractiveServer
@inject ALDevToolbox.Services.ObjectExplorer.ObjectExplorerService ObjectExplorer
@inject ALDevToolbox.Services.ObjectExplorer.ObjectExplorerLinks Links
@inject ALDevToolbox.Services.ObjectExplorer.ReferenceSessionService ReferenceSessions
@inject ALDevToolbox.Data.AppDbContext Db
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthState
@using ALDevToolbox.Services.ObjectExplorer
@using Microsoft.EntityFrameworkCore
@using ALDevToolbox.Components.Shared

<PageTitle>@(_object?.Name ?? "Object") · AL Dev Toolbox</PageTitle>

@*
    Archetype 6 (detail) from the BC design handoff. The object's own facts sit
    in a .meta-row under the head rather than as a run-on muted line, and each
    of the three panels is a .card so "Find references" reads as a thing you do
    here rather than a paragraph that happens to have a button in it.
*@

<div class="page">
    @if (_object is null && _loaded)
    {
        @* An id that resolves to nothing used to leave the page on "Loading..."
           for ever, which reads as a hang rather than an answer. *@
        <div class="card">
            <div class="empty-state">
                <span class="empty-state__icon"><Icon Name="funnel-x" Width="21" Height="21" /></span>
                <span class="empty-state__title">We couldn't find that object</span>
                <span class="empty-state__text">
                    The release it belonged to may have been removed or re-indexed
                    since this link was made.
                </span>
                <a class="btn empty-state__action" href="/object-explorer">Back to Object Explorer</a>
            </div>
        </div>
    }
    else if (_object is null)
    {
        <div class="loading-block"><span class="spinner"></span><span>Loading object...</span></div>
    }
    else
    {
        <div class="page-head">
            <div>
                <div class="page-head__crumbs">
                    <a href="/object-explorer">Object Explorer</a>
                    @if (_releaseId is { } rid)
                    {
                        <Icon Name="chevron-right" Width="14" Height="14" />
                        <a href="@($"/object-explorer/release/{rid}")">@_releaseLabel</a>
                    }
                    <Icon Name="chevron-right" Width="14" Height="14" />
                    <a href="@($"/object-explorer/module/{_object.ModuleId}")">@_object.ModuleName</a>
                </div>
                <h1 class="page-head__title">@_object.Name</h1>
            </div>
            @if (_object.SourceFileId is { } fid)
            {
                <div class="page-head__actions">
                    <a class="btn btn--primary" href="@Links.SourceFile(fid, _object.LineNumber)">
                        <Icon Name="file-code" Width="16" Height="16" />
                        <span>View source</span>
                    </a>
                </div>
            }
        </div>

        <div class="meta-row">
            <div class="meta-item">
                <span class="meta-item__label">Type</span>
                <span class="meta-item__value">@_object.Kind</span>
            </div>
            <div class="meta-item">
                <span class="meta-item__label">Object ID</span>
                <span class="meta-item__value meta-item__value--mono">@(_object.ObjectId?.ToString() ?? "—")</span>
            </div>
            <div class="meta-item">
                <span class="meta-item__label">Extension</span>
                <span class="meta-item__value" title="@_object.ModuleName">@_object.ModuleName</span>
            </div>
            <div class="meta-item">
                <span class="meta-item__label">Namespace</span>
                <span class="meta-item__value meta-item__value--mono"
                      title="@(_object.Namespace ?? "None")">@(string.IsNullOrEmpty(_object.Namespace) ? "—" : _object.Namespace)</span>
            </div>
        </div>

        <section class="card">
            <div class="card__head"><h2 class="card__title">Symbols</h2>
                @* No chip on an empty section - the empty state says the same
                   thing in words directly below it. *@
                @if (_object.Symbols.Count > 0)
                {
                    <span class="badge">@_object.Symbols.Count.ToString("N0")</span>
                }</div>
            @if (_object.Symbols.Count == 0)
            {
                <div class="card__body">
                    <div class="empty-state empty-state--quiet">
                        <span class="empty-state__title">No symbols recorded</span>
                        <span class="empty-state__text">
                            No fields, procedures or triggers were found for this object.
                            That usually means the app shipped without its source.
                        </span>
                    </div>
                </div>
            }
            else
            {
                <table class="data-table data-table--edge">
                    <thead>
                        <tr>
                            <th scope="col">Kind</th>
                            <th scope="col">Name</th>
                            <th scope="col">Signature</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in _object.Symbols)
                        {
                            <tr>
                                <td>@s.Kind</td>
                                <td><strong>@s.Name</strong></td>
                                <td class="u-muted">@(s.Signature ?? "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </section>

        <section class="card">
            <div class="card__head"><h2 class="card__title">Variables</h2>
                @if (_object.Variables.Count > 0)
                {
                    <span class="badge">@_object.Variables.Count.ToString("N0")</span>
                }</div>
            @if (_object.Variables.Count == 0)
            {
                <div class="card__body">
                    <div class="empty-state empty-state--quiet">
                        <span class="empty-state__title">No variables</span>
                        <span class="empty-state__text">
                            This object declares no variables of its own. Variables declared
                            inside a procedure are not listed here.
                        </span>
                    </div>
                </div>
            }
            else
            {
                <table class="data-table data-table--edge">
                    <thead>
                        <tr>
                            <th scope="col">Name</th>
                            <th scope="col">Type</th>
                            <th scope="col">Target</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var v in _object.Variables)
                        {
                            <tr>
                                <td><strong>@v.Name</strong></td>
                                <td>@v.TypeName</td>
                                <td class="u-muted">
                                    @if (v.TargetObjectName is not null)
                                    {
                                        <span>@v.TargetObjectKind "@v.TargetObjectName"</span>
                                        @if (v.TargetObjectId is { } tid)
                                        {
                                            <span> · id @tid</span>
                                        }
                                    }
                                    else
                                    {
                                        <span>—</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </section>

        <section class="card">
            <div class="card__head">
                <div>
                    <h2 class="card__title">Find references</h2>
                    <p class="card__sub">
                        Every extension in this release's chain whose code mentions
                        @_object.Name.
                        @if (_fromReleaseLabel is not null)
                        {
                            <text>Searching from <strong>@_fromReleaseLabel</strong>, so its own code is included.</text>
                        }
                    </p>
                </div>
                @if (_references is { Count: > 0 } && !_referencesLoading)
                {
                    <span class="badge">@_references.Count.ToString("N0")</span>
                }
            </div>
            @if (_referencesLoading)
            {
                <div class="card__body">
                    <div class="loading-block"><span class="spinner"></span><span>Searching the chain...</span></div>
                </div>
            }
            else if (_references is null)
            {
                <div class="card__body">
                    <button class="btn" @onclick="LoadReferences">
                        <Icon Name="search" Width="14" Height="14" />
                        <span>Find references</span>
                    </button>
                </div>
            }
            else if (_references.Count == 0)
            {
                <div class="card__body">
                    <div class="empty-state empty-state--quiet">
                        <span class="empty-state__title">No references found</span>
                        <span class="empty-state__text">
                            Nothing this release depends on refers to @_object.Name. Code in a
                            release built <em>on top of</em> this one is not searched - open the
                            object from that release to include it.
                        </span>
                    </div>
                </div>
            }
            else
            {
                <table class="data-table data-table--edge">
                    <thead>
                        <tr>
                            <th scope="col">Extension</th>
                            <th scope="col">Object</th>
                            <th scope="col">Kind</th>
                            <th scope="col">Reference kind</th>
                            <th scope="col">Source</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in _references)
                        {
                            <tr>
                                <td>@r.SourceModuleName</td>
                                <td>
                                    <a href="@($"/object-explorer/object/{r.SourceObjectId}")">@r.SourceObjectName</a>
                                </td>
                                <td>@r.SourceObjectKind</td>
                                <td>@r.ReferenceKind</td>
                                <td>
                                    @if (r.SourceFileId is { } srcFid && r.LineNumber is { } ln)
                                    {
                                        <a href="@FileLinkForRef(srcFid, ln)">L@(ln)</a>
                                    }
                                    else
                                    {
                                        <span class="u-muted">—</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </section>
    }
</div>

@code {
    [Parameter] public long ObjectId { get; set; }

    /// <summary>
    /// Release the user is viewing from, carried as <c>?from=</c>. When this is
    /// a descendant of the object's home Release (the project-on-base case),
    /// find-references seeds here so the project's own code is included - the
    /// chain walk only goes upward. Null → seed at the object's home Release.
    /// </summary>
    [SupplyParameterFromQuery(Name = "from")] public int? FromReleaseId { get; set; }

    private ObjectDetail? _object;
    private int? _releaseId;
    private string? _releaseLabel;
    private string? _fromReleaseLabel;
    private Guid? _moduleAppId;
    private List<ReferenceMatch>? _references;
    private string? _refSetToken;
    private bool _referencesLoading;

    /// <summary>Set once the lookup has run, so a null object can be told apart
    /// from one that has not been fetched yet.</summary>
    private bool _loaded;

    protected override async Task OnInitializedAsync()
    {
        _object = await ObjectExplorer.GetObjectAsync(ObjectId);
        _loaded = true;
        if (_object is null) return;

        var modInfo = await Db.OeModules.AsNoTracking()
            .Where(m => m.Id == _object.ModuleId)
            .Select(m => new { m.AppId, m.ReleaseId, ReleaseLabel = m.Release!.Label })
            .SingleOrDefaultAsync();
        if (modInfo is not null)
        {
            _moduleAppId = modInfo.AppId;
            _releaseId = modInfo.ReleaseId;
            _releaseLabel = modInfo.ReleaseLabel;
        }

        // When viewing a base object "from" a descendant Release (the
        // project-on-base case), resolve that Release's label so the panel can
        // tell the user which Release the reference search is seeded at.
        if (FromReleaseId is { } from && from != _releaseId)
        {
            _fromReleaseLabel = await Db.OeReleases.AsNoTracking()
                .Where(r => r.Id == from)
                .Select(r => r.Label)
                .SingleOrDefaultAsync();
        }
    }

    /// <summary>
    /// Runs FindReferences and mints a ReferenceSession token in the
    /// shared cache. The token rides along on the file-viewer links so the
    /// References panel stays visible across navigations.
    /// </summary>
    private async Task LoadReferences()
    {
        if (_object is null) return;
        _referencesLoading = true;
        try
        {
            var owner = await OwnerKeyAsync();
            ReferenceSession? session = owner is null
                ? null
                : await ReferenceSessions.CreateFromSymbolAsync(ObjectId, owner, FromReleaseId);
            _references = session?.Results.ToList() ?? new List<ReferenceMatch>();
            _refSetToken = session?.Token;
        }
        finally
        {
            _referencesLoading = false;
        }
    }

    private string FileLinkForRef(long fileId, int line)
    {
        var url = Links.SourceFile(fileId, line);
        if (!string.IsNullOrEmpty(_refSetToken))
        {
            url += "&refSet=" + Uri.EscapeDataString(_refSetToken);
        }
        // Keep the view-Release context as the user clicks through results, so a
        // follow-up Find references from the landed file stays seeded correctly.
        if (FromReleaseId is { } from)
        {
            url += "&from=" + from;
        }
        return url;
    }

    private async Task<string?> OwnerKeyAsync()
    {
        // AuthenticationStateProvider works in both prerender and interactive
        // contexts, unlike IHttpContextAccessor (which returns null after
        // the SignalR circuit takes over).
        var state = await AuthState.GetAuthenticationStateAsync();
        var user = state.User;
        if (user?.Identity?.IsAuthenticated != true) return null;
        return user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value
            ?? user.Identity.Name;
    }
}
