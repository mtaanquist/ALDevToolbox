@page "/Error"
@layout AuthLayout
@using System.Diagnostics
@using ALDevToolbox.Components.Shared

@* AuthLayout, not the default MainLayout: the exception handler re-executes
   this page after something has already gone wrong, and the case it matters
   most for is an unreachable database. MainLayout reads the org name from the
   database on every render, so it would throw here and the reader would get
   the framework's bare error response instead of this page. AuthLayout injects
   nothing and awaits nothing - it is the shell-less layout the sign-in pages
   already use, so /Error rides the same service-free render path rather than
   needing a layout of its own. See issue #559 - keep this page's render path
   free of service calls, and keep AuthLayout free of them too. *@

<PageTitle>Something went wrong · AL Dev Toolbox</PageTitle>

@*
    Page archetype 14 (`.errpage`, pages-content.css), the 500 variant.

    The reference is the point of this page. The hand-off gives the 500 an
    `.errpage__ref` row precisely because "an error page without a reference is
    a dead end", and it carries three: the id, the time, and the build. We have
    the first two honestly - the id from Activity/TraceIdentifier, the time from
    the server - and no build stamp to show, so that one is left out rather than
    faked.
*@

<div class="errpage">
    <div class="errpage__inner">
        <span class="errpage__glyph errpage__glyph--danger">
            <Icon Name="server-crash" Width="26" Height="26" />
        </span>
        <span class="errpage__code">Error 500 - server error</span>
        <h1 class="errpage__title">Something went wrong on our side</h1>
        <p class="errpage__text">
            Sorry - we hit an error handling that request. Nothing you had
            already saved is affected, so going back in your browser and trying
            once more is safe.
        </p>
        <span class="errpage__acts">
            <a class="btn btn--primary" href="/">
                <Icon Name="house" Width="16" Height="16" />
                <span>Go to Home</span>
            </a>
            @if (ShowRequestId)
            {
                @* The page tells the reader to send two lines to an administrator
                   and used to make them drag-select 55 characters of hex across
                   two lines at --text-2xs. Half would have sent a truncated id.
                   We already ship this affordance. *@
                <button type="button" class="btn copy-btn" data-copy-target="#err-ref">
                    <Icon Name="copy" Width="16" Height="16" />
                    <span data-copy-label>Copy reference</span>
                </button>
            }
        </span>
        @if (ShowRequestId)
        {
            @* The words "Reference" and "Time" are in the text, not just implied
               by the icons: this gets pasted into Teams or an email, where the
               icons do not come along and two bare strings arrive meaning
               nothing. #err-ref is what the copy button above reads. *@
            <span class="errpage__links" id="err-ref">
                <span class="errpage__links-h">Include this if you report it</span>
                <span class="errpage__ref">
                    <Icon Name="hash" Width="13" Height="13" />
                    <span>Reference @RequestId</span>
                </span>
                <span class="errpage__ref">
                    <Icon Name="clock" Width="13" Height="13" />
                    <span>Time @_occurredAt</span>
                </span>
            </span>
            <p class="errpage__text" style="font-size: var(--text-xs)">
                If it keeps happening, send this to whoever set up AL Dev Toolbox for
                your team - it points them straight at what failed.
            </p>
        }
    </div>
</div>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);
    private string _occurredAt = string.Empty;

    protected override void OnInitialized()
    {
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
        // UTC and spelled out: the reader is copying this into a message for
        // someone who will grep a server log, and a local-time stamp with no
        // zone on it is the thing that wastes their afternoon.
        _occurredAt = DateTime.UtcNow.ToString("yyyy-MM-dd HH:mm:ss 'UTC'");
    }
}
