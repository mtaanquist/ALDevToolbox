@* Legacy route redirect - see Components/Pages/Legacy/README.md.
   Old route: /site-admin/settings/mcp
   New route: /site-admin/settings/tools
   Redirect kept since 2026-09-03; safe to delete after 2027-03-01 if access
   logs show no hits. *@
@page "/site-admin/settings/mcp"
@attribute [Authorize(Roles = HttpOrganizationContext.SiteAdminRole)]
@inject NavigationManager Nav

@*
    The MCP toggle moved into the unified Tools tab. This legacy route just
    forwards there so old bookmarks and links keep working.
*@

@code {
    protected override void OnInitialized() =>
        Nav.NavigateTo("/site-admin/settings/tools", replace: true);
}
