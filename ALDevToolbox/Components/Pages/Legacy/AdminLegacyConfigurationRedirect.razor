@* Legacy route redirect - see Components/Pages/Legacy/README.md.
   Old route: /admin/configuration, /admin/configuration/identity
   New route: /admin/administration/identity
   Redirect kept since 2026-09-03; safe to delete after 2027-03-01 if access
   logs show no hits. *@
@page "/admin/configuration"
@page "/admin/configuration/identity"
@attribute [Authorize(Roles = "Admin")]
@inject NavigationManager Nav

@*
    Legacy redirect: /admin/configuration and /admin/configuration/identity
    moved under /admin/administration/identity when the per-org admin pages
    were consolidated. Kept so old bookmarks and outbound links still land
    in the right place.
*@

@code {
    protected override void OnInitialized()
    {
        Nav.NavigateTo("/admin/administration/identity", replace: true);
    }
}
