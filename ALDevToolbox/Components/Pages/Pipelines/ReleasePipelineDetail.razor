@page "/releases/{Id:int}"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@rendermode InteractiveServer
@implements IAsyncDisposable
@inject ALDevToolbox.Services.ObjectExplorer.Delivery.ReleasePipelineService Releases
@inject ALDevToolbox.Services.ObjectExplorer.Delivery.DeliveryService Deliveries
@inject ALDevToolbox.Services.ObjectExplorer.Projects.ArtifactService Artifacts
@inject ALDevToolbox.Services.GitHub.GitHubReleaseService GitHubReleases
@inject NavigationManager Nav
@inject ILogger<ReleasePipelineDetail> Log
@inject IServiceScopeFactory ScopeFactory
@using Microsoft.Extensions.DependencyInjection
@using ALDevToolbox.Services.ObjectExplorer.Delivery
@using ALDevToolbox.Services.ObjectExplorer.Projects
@using ALDevToolbox.Domain.Entities.ObjectExplorer
@using ALDevToolbox.Domain.ValueObjects

@*
    A release pipeline's detail page: its target + how it publishes, the canonical
    "Release" action (enabled once the source has something to send - a successful build,
    or a GitHub release with app files on it),
    and the delivery history with live status. Mirrors the build pipeline's
    /pipelines/{id} (builds) for the release side. See .design/saas-delivery.md.

    Named user: a BC consultant who set up a release target and now ships a build to it,
    then watches it install.
*@

<PageTitle>@(_rp?.Name ?? "Release pipeline") · AL Dev Toolbox</PageTitle>

<div class="page">
    @if (_loading)
    {
        <div class="loading-block"><span class="spinner"></span><span>Loading release pipeline...</span></div>
    }
    else if (_rp is null)
    {
        <div class="empty-state">
            <span class="empty-state__icon"><Icon Name="send" Width="21" Height="21" /></span>
            <h1 class="empty-state__title">This release pipeline doesn't exist</h1>
            <p class="empty-state__text">It may have been deleted. Head back to the list to pick another.</p>
            <a class="btn btn--primary empty-state__action" href="/releases"><Icon Name="arrow-left" Width="16" Height="16" /><span>All releases</span></a>
        </div>
    }
    else
    {
        @* Archetype: PageDetail.dc.html - crumbs outside the head, the state
           pill beside the title, facts in a .meta-row underneath. *@
        <div class="page-head__crumbs">
            <a href="/releases">Releases</a>
            <Icon Name="chevron-right" Width="12" Height="12" />
            <span>@_rp.Name</span>
        </div>

        <div class="detail-head">
            <div>
                <div class="detail-head__title-row">
                    <h1 class="detail-head__title">@_rp.Name</h1>
                    <span class="status-pill status-pill--@(_isProduction ? "danger" : "muted")">
                        <span class="status-pill__dot"></span>
                        <span>@_rp.ProjectEnvironment!.Type</span>
                    </span>
                </div>
                <p class="page-head__sub">
                    @if (_fromReleases)
                    {
                        <text>Releases @SourceName into @_rp.ProjectEnvironment.Name</text>
                    }
                    else
                    {
                        <text>Releases <a href="@($"/pipelines/{_rp.BuildPipelineId}")">@SourceName</a> into @_rp.ProjectEnvironment.Name</text>
                    }
                </p>
            </div>
            <div class="page-head__actions">
                <a class="btn" href="/releases"><Icon Name="arrow-left" Width="15" Height="15" /><span>All releases</span></a>
                @if (_canManage)
                {
                    <button type="button" class="btn" @onclick="EditAsync">
                        <Icon Name="pencil" Width="15" Height="15" /><span>Edit</span>
                    </button>
                    <button type="button" class="btn btn--primary" @onclick="OpenReleaseAsync" disabled="@(!HasSomethingToRelease)"
                            title="@(HasSomethingToRelease ? null : _fromReleases ? "This repository has no release with app files attached yet." : "The build pipeline has no successful build to release yet.")">
                        <Icon Name="send" Width="15" Height="15" /><span>Release</span>
                    </button>
                }
            </div>
        </div>

        <div class="meta-row">
            <span class="meta-item">
                <span class="meta-item__label">Environment</span>
                <span class="meta-item__value">@_rp.ProjectEnvironment.Name</span>
            </span>
            <span class="meta-item">
                <span class="meta-item__label">@(_fromReleases ? "Releases from" : "Build pipeline")</span>
                <span class="meta-item__value">@SourceName</span>
            </span>
            <span class="meta-item">
                <span class="meta-item__label">Releases</span>
                <span class="meta-item__value">@_deliveries.Count</span>
            </span>
        </div>

        @if (_rp.ProjectEnvironment.MissingSince is not null)
        {
            <p class="alert alert--danger" role="alert">
                <Icon Name="triangle-alert" Width="16" Height="16" />
                <span>
                    This release pipeline's target environment is no longer present in Business Central. Refresh the
                    environments on <a href="@($"/solutions/{_rp.ProjectId}")">the solution's Business Central page</a> before releasing.
                </span>
            </p>
        }
        else if (_canManage && _releasesError is { } gre)
        {
            <p class="alert alert--danger" role="alert">
                <Icon Name="triangle-alert" Width="16" Height="16" /><span>@gre</span>
            </p>
        }
        else if (_canManage && !HasSomethingToRelease)
        {
            @if (_fromReleases)
            {
                <p class="u-muted">
                    <b>@SourceName</b> has no release with app files attached yet. Publish one there, then come back to install it.
                </p>
            }
            else
            {
                <p class="u-muted">
                    <b>@SourceName</b> has no successful build yet. Run a build on
                    <a href="@($"/pipelines/{_rp.BuildPipelineId}")">the build pipeline</a>, then come back to release it.
                </p>
            }
        }

        <p class="state-label">Deliveries, newest first</p>

        @if (_deliveries.Count == 0)
        {
            <div class="empty-state">
                <span class="empty-state__icon"><Icon Name="send" Width="21" Height="21" /></span>
                <div class="empty-state__title">No releases yet</div>
                <p class="empty-state__text">
                    When you release, the apps are uploaded and installed into
                    @_rp.ProjectEnvironment.Name and the run shows up here.
                </p>
                @if (_canManage && HasSomethingToRelease)
                {
                    <button type="button" class="btn btn--primary empty-state__action" @onclick="OpenReleaseAsync">
                        <Icon Name="send" Width="16" Height="16" /><span>Release</span>
                    </button>
                }
            </div>
        }
        else
        {
            @* .run-list, not a .data-table: the archetype sheet reserves it for
               "card-like histories that are not tabular", and a delivery is
               exactly that - each release expands into one sub-row per app it
               installed, which no table column can hold. The build history on
               the pipeline page IS tabular and went the other way (#528). *@
            <div class="run-list">
                @foreach (var d in _deliveries)
                {
                    <div class="run-row run-row--@RowStateIcon.RunState(d.Status)">
                        @* The build number reads once, in the id track the run-list
                           archetype reserves for it - the title line says what the
                           release carried instead of repeating the number (#714). *@
                        <span class="run-row__id" title="Build #@d.ProjectBuildId">#@d.ProjectBuildId</span>
                        <div class="run-row__main">
                            <span class="run-row__title">
                                @RowTitle(d)
                                @if (d.ScheduledOutsideWindow)
                                {
                                    <span class="rp-outside" title="Scheduled outside the environment's update window"><Icon Name="triangle-alert" Width="12" Height="12" />outside window</span>
                                }
                            </span>
                            @if (!string.IsNullOrEmpty(d.FailureMessage))
                            {
                                <span class="run-row__sub rp-fail">@d.FailureMessage</span>
                            }
                            else if (d.Status == ProjectDeliveryStatus.HandedOff)
                            {
                                <span class="run-row__sub">Business Central has the apps and installs them with the customer's next update. Cancel it there if you need to stop it.</span>
                            }
                        </div>
                        <span class="run-row__state">
                            <Icon Name="@RowStateIcon.Glyph(d.Status)" Width="13" Height="13" />
                            <span>@RowStateIcon.StateLabel(d.Status)</span>
                        </span>
                        <span class="run-row__time" title="@(d.IsScheduled ? ScheduledAbsolute(d) : AbsoluteWhen(d))">
                            @(d.IsScheduled ? $"for {ScheduledWhen(d)}" : RelativeWhen(d))
                        </span>
                        <span class="run-row__dur">@(d.TriggeredByName ?? "")</span>
                        <span class="run-row__acts">
                            @if (d.IsScheduled && _canManage)
                            {
                                <button type="button" class="btn btn--sm" @onclick="() => OpenRescheduleAsync(d)">Reschedule</button>
                                <button type="button" class="btn btn--sm btn--danger" @onclick="() => CancelAsync(d)">Cancel</button>
                            }
                        </span>

                        @if (d.Apps.Count > 0)
                        {
                            @* The sub-rows the whole component choice is for. They
                               span the row's six tracks, the way .run-progress
                               does, so each app lines up under the release it
                               belongs to rather than starting a row of its own. *@
                            <div class="rp-apps">
                                @foreach (var a in d.Apps)
                                {
                                    <div class="rp-app">
                                        <span class="rp-app__state rp-app__state--@AppState(a.Status)"
                                              role="img" aria-label="@AppLabel(a.Status)" title="@AppLabel(a.Status)">
                                            <Icon Name="@RowStateIcon.Glyph(AppState(a.Status))" Width="12" Height="12" />
                                        </span>
                                        <span class="rp-app__name">@a.AppName</span>
                                        <span class="rp-app__ver">@a.AppVersion</span>
                                        @if (a.Status == ProjectDeliveryResultStatus.Failed && !string.IsNullOrEmpty(a.Message))
                                        {
                                            <span class="rp-app__msg">@a.Message</span>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        }
    }
</div>

<ReleasePipelineEditorDialog @ref="_editor" OnSaved="OnEditedAsync" />
<ReleaseBuildDialog @ref="_releaseDialog" OnReleased="OnReleasedAsync" />
<ConfirmDialog @ref="_cancelConfirm" Title="Cancel this delivery?"
               ConfirmLabel="Cancel delivery" CancelLabel="Keep it scheduled"
               ConfirmButtonClass="btn--danger" ConfirmIcon="circle-x" />

@if (_rescheduleId is not null)
{
    <div class="modal-layer" role="dialog" aria-modal="true" aria-labelledby="rs-title" tabindex="-1">
        <div class="modal-backdrop" @onclick="CloseReschedule" aria-hidden="true"></div>
        <div class="confirm-dialog" @onclick:stopPropagation>
            <div class="confirm-dialog__head">
                <span class="confirm-dialog__icon" aria-hidden="true">
                    <Icon Name="calendar" Width="17" Height="17" />
                </span>
                <h2 id="rs-title" class="confirm-dialog__title">Reschedule delivery</h2>
            </div>
            <div class="confirm-dialog__body">
            <div class="field">
                <label class="field__label" for="rs-when">New time</label>
                <input id="rs-when" type="datetime-local" class="input" @bind="_rescheduleLocal" @bind:event="oninput" disabled="@_rescheduling" />
                <small class="field__hint">Time is in the customer's timezone (@_tzLabel).</small>
                @if (RescheduleSecretWarning is { } secretWarn)
                {
                    <span class="field-warn"><Icon Name="triangle-alert" Width="13" Height="13" />@secretWarn</span>
                }
            </div>
            @if (_rescheduleError is { } err)
            {
                <p class="alert alert--danger" role="alert"><Icon Name="triangle-alert" Width="16" Height="16" /><span>@err</span></p>
            }
            </div>
            <div class="confirm-dialog__actions">
                <button type="button" class="btn" @onclick="CloseReschedule" disabled="@_rescheduling">Cancel</button>
                <button type="button" class="btn btn--primary" @onclick="SaveRescheduleAsync" disabled="@_rescheduling">
                    <Icon Name="save" Width="14" Height="14" /><span>@(_rescheduling ? "Saving..." : "Reschedule")</span>
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }

    private bool _loading = true;
    private OeReleasePipeline? _rp;
    private bool _canManage;
    private bool _isProduction;
    private List<DeliveryHistoryRow> _deliveries = new();
    private List<ReleaseBuildDialog.ReleasableBuildOption> _successfulBuilds = new();
    // A Release-sourced pipeline offers the repository's release tags instead of the
    // build pipeline's builds (#632).
    private List<ALDevToolbox.Services.GitHub.GitHubReleaseOption> _releaseOptions = new();
    private string? _releasesError;

    /// <summary>True when this pipeline installs apps from a repository's GitHub releases.</summary>
    private bool _fromReleases;

    /// <summary>What this pipeline draws from: the build pipeline's name, or the repository's.</summary>
    private string SourceName => _fromReleases
        ? _rp?.GithubReleaseRepository?.DisplayName ?? "the repository"
        : _rp?.BuildPipeline?.Name ?? "the build pipeline";

    /// <summary>True when there is at least one build (or release) the person could send.</summary>
    private bool HasSomethingToRelease => _fromReleases ? _releaseOptions.Count > 0 : _successfulBuilds.Count > 0;

    private ReleasePipelineEditorDialog? _editor;
    private ReleaseBuildDialog? _releaseDialog;
    private ConfirmDialog? _cancelConfirm;

    private TimeZoneInfo _tz = TimeZoneInfo.Utc;
    private string _tzLabel = "UTC";

    // Reschedule modal state.
    private int? _rescheduleId;
    private DateTime _rescheduleLocal;
    private bool _rescheduling;
    private string? _rescheduleError;

    private static readonly TimeSpan PollInterval = TimeSpan.FromSeconds(2);
    private PeriodicTimer? _poll;
    private CancellationTokenSource? _pollCts;

    protected override async Task OnInitializedAsync() => await LoadAsync(startPollIfActive: true);

    private async Task LoadAsync(bool startPollIfActive)
    {
        _loading = true;
        try
        {
            _rp = await Releases.GetReleasePipelineAsync(Id);
        }
        catch (ProjectAccessDeniedException)
        {
            // A private solution this person isn't on the team for reads the same
            // as one that no longer exists.
            _rp = null;
        }
        if (_rp is null) { _loading = false; return; }

        _isProduction = string.Equals(_rp.ProjectEnvironment?.Type, "Production", StringComparison.OrdinalIgnoreCase);
        _tz = ALDevToolbox.Domain.ValueObjects.ObjectExplorer.UpdateWindow.ResolveTimeZone(_rp.Project?.BcTimeZone);
        _tzLabel = string.IsNullOrWhiteSpace(_rp.Project?.BcTimeZone) ? "UTC" : _rp.Project!.BcTimeZone!;
        _canManage = await Releases.CanManageAsync(Id);
        _deliveries = await Deliveries.ListDeliveryHistoryAsync(Id);

        _fromReleases = _rp.ArtifactSource == ALDevToolbox.Domain.ValueObjects.ObjectExplorer.ReleaseArtifactSource.GithubRelease;
        _successfulBuilds = new();
        _releaseOptions = new();
        _releasesError = null;

        if (_fromReleases)
        {
            // Asking GitHub is the one thing on this page that can be slow or fail; a
            // refusal is shown above the history rather than replacing the page, so the
            // deliveries already made stay readable.
            try
            {
                _releaseOptions = (await GitHubReleases.ListReleasesAsync(Id))
                    .Where(r => r.AppFileNames.Count > 0)
                    .ToList();
            }
            catch (PlanValidationException ex)
            {
                _releasesError = ex.Errors.Values.FirstOrDefault() ?? "Couldn't read this repository's releases.";
            }
            catch (Exception ex)
            {
                Log.LogError(ex, "Reading GitHub releases failed for release pipeline {ReleasePipelineId}.", Id);
                _releasesError = "Couldn't read this repository's releases from GitHub. Try again in a moment.";
            }
        }
        else if (_rp.BuildPipelineId is { } buildPipelineId)
        {
            // The releasable builds are the source build pipeline's successful builds, newest first.
            var builds = await Artifacts.ListBuildsAsync(buildPipelineId);
            // The apps each build carries, so the release dialog can show what is about
            // to be installed before the consultant confirms (#714).
            var appsByBuild = await Artifacts.ListBuildAppsAsync(buildPipelineId);
            _successfulBuilds = builds
                .Where(b => b.Status == "ready")
                .OrderByDescending(b => b.FinishedAt ?? b.StartedAt)
                .Select(b =>
                {
                    var apps = appsByBuild.TryGetValue(b.Id, out var found) ? found : [];
                    return new ReleaseBuildDialog.ReleasableBuildOption(
                        b.Id,
                        BuildLabel(b, apps.Count),
                        apps.Select(a => new ReleaseBuildDialog.ReleasableBuildApp(a.AppName, a.AppVersion)).ToList());
                })
                .ToList();
        }

        _loading = false;
        if (startPollIfActive) EnsurePolling();
    }

    private async Task EditAsync()
    {
        if (_editor is null || _rp is null) return;
        var row = new ReleasePipelineRow(
            _rp.Id, _rp.ProjectId, _rp.Project?.Name ?? "", _rp.Name, _rp.BuildPipelineId, _rp.BuildPipeline?.Name ?? "",
            _rp.ProjectEnvironmentId, _rp.ProjectEnvironment?.Name ?? "", _rp.ProjectEnvironment?.Type ?? "",
            _rp.ProjectEnvironment?.MissingSince != null,
            _rp.DeploymentSchedule, _rp.SchemaSyncMode,
            _rp.ArtifactSource, _rp.GithubReleaseRepositoryId, _rp.GithubReleaseRepository?.DisplayName);
        await _editor.OpenForEditAsync(row);
    }

    private async Task OnEditedAsync(int _) => await LoadAsync(startPollIfActive: false);

    private async Task OpenReleaseAsync()
    {
        if (_releaseDialog is null || _rp is null || !HasSomethingToRelease) return;
        await _releaseDialog.OpenAsync(
            _rp.Id, _rp.Project?.Name ?? "", _rp.ProjectEnvironment!.Name, _rp.ProjectEnvironment.Type,
            _rp.DeploymentSchedule, _rp.SchemaSyncMode, _successfulBuilds,
            _rp.Project?.BcTimeZone, _rp.ProjectEnvironment.UpdateWindowStart, _rp.ProjectEnvironment.UpdateWindowEnd,
            _rp.Project?.BcClientSecretExpiresAt,
            _fromReleases ? _releaseOptions : null,
            _fromReleases ? SourceName : null);
    }

    private async Task OnReleasedAsync(int _)
    {
        await LoadAsync(startPollIfActive: false);
        EnsurePolling(); // a release-now delivery is active → start watching
    }

    // ── Cancel + reschedule (scheduled deliveries only) ───────────────────────

    private async Task CancelAsync(DeliveryHistoryRow d)
    {
        if (_cancelConfirm is null) return;
        var confirmed = await _cancelConfirm.OpenAsync(
            "Cancel this delivery?",
            $"Cancel the delivery of build #{d.ProjectBuildId} scheduled for {ScheduledWhen(d)}? It won't run.",
            "Cancel delivery");
        if (!confirmed) return;
        try
        {
            await Deliveries.CancelDeliveryAsync(d.Id);
            await LoadAsync(startPollIfActive: false);
        }
        catch (PlanValidationException ex)
        {
            // Lost the race — it already started. Reflect the new state.
            Log.LogInformation(ex, "Cancel race on delivery {DeliveryId}.", d.Id);
            await LoadAsync(startPollIfActive: true);
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "Failed to cancel delivery {DeliveryId}.", d.Id);
        }
    }

    private void OpenRescheduleAsync(DeliveryHistoryRow d)
    {
        _rescheduleId = d.Id;
        _rescheduleError = null;
        _rescheduling = false;
        // Prefill to the delivery's current time in the customer's tz.
        var local = TimeZoneInfo.ConvertTimeFromUtc(DateTime.SpecifyKind(d.ScheduledFor, DateTimeKind.Utc), _tz);
        _rescheduleLocal = new DateTime(local.Year, local.Month, local.Day, local.Hour, local.Minute, 0, DateTimeKind.Unspecified);
    }

    private void CloseReschedule()
    {
        if (_rescheduling) return;
        _rescheduleId = null;
    }

    /// <summary>
    /// Warn-but-allow, mirroring the release dialog: flag when the new time falls after the
    /// BC client secret expires (the run would hard-fail). See .design/saas-delivery.md.
    /// </summary>
    private string? RescheduleSecretWarning
    {
        get
        {
            if (_rp?.Project?.BcClientSecretExpiresAt is not { } expiry) return null;
            if (expiry <= DateTime.UtcNow)
            {
                return "The Business Central client secret has expired. Rotate it in Entra and re-enter it before this can install.";
            }
            var utc = TimeZoneInfo.ConvertTimeToUtc(DateTime.SpecifyKind(_rescheduleLocal, DateTimeKind.Unspecified), _tz);
            if (utc > expiry)
            {
                var localExpiry = TimeZoneInfo.ConvertTimeFromUtc(DateTime.SpecifyKind(expiry, DateTimeKind.Utc), _tz);
                return $"The Business Central client secret expires {localExpiry:yyyy-MM-dd}. This time is after that and will fail unless the secret is rotated first.";
            }
            return null;
        }
    }

    private async Task SaveRescheduleAsync()
    {
        if (_rescheduleId is not { } id) return;
        _rescheduling = true;
        _rescheduleError = null;
        try
        {
            var utc = TimeZoneInfo.ConvertTimeToUtc(DateTime.SpecifyKind(_rescheduleLocal, DateTimeKind.Unspecified), _tz);
            await Deliveries.RescheduleDeliveryAsync(id, utc);
            _rescheduleId = null;
            await LoadAsync(startPollIfActive: true);
        }
        catch (PlanValidationException ex)
        {
            _rescheduleError = ex.Errors.Values.FirstOrDefault() ?? "Couldn't reschedule the delivery.";
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "Failed to reschedule delivery {DeliveryId}.", id);
            _rescheduleError = "Couldn't reschedule the delivery.";
        }
        finally
        {
            _rescheduling = false;
        }
    }

    // ── Live polling of in-flight deliveries ──────────────────────────────────

    private void EnsurePolling()
    {
        if (_poll is not null) return;
        if (!_deliveries.Any(d => d.IsActive)) return;
        _pollCts = new CancellationTokenSource();
        _poll = new PeriodicTimer(PollInterval);
        _ = PollLoopAsync(_poll, _pollCts.Token);
    }

    private async Task PollLoopAsync(PeriodicTimer timer, CancellationToken token)
    {
        try
        {
            while (await timer.WaitForNextTickAsync(token))
            {
                // Own DI scope per tick: this runs on a thread-pool continuation, not the
                // circuit's dispatcher, so sharing the circuit's DbContext would let a tick
                // and a click have two commands in flight on one context. See #679.
                List<DeliveryHistoryRow> rows;
                await using (var scope = ScopeFactory.CreateAsyncScope())
                {
                    rows = await scope.ServiceProvider.GetRequiredService<DeliveryService>()
                        .ListDeliveryHistoryAsync(Id, token);
                }

                // Disposal can happen while we were parked on the query; touching the
                // renderer after that logs an error for what is a normal navigate-away.
                if (token.IsCancellationRequested) break;
                await InvokeAsync(() => { _deliveries = rows; StateHasChanged(); });
                if (!rows.Any(d => d.IsActive)) { StopPoll(); break; }
            }
        }
        catch (OperationCanceledException) { /* navigating away */ }
        catch (ObjectDisposedException) when (token.IsCancellationRequested) { /* torn down mid-poll */ }
        catch (Exception ex)
        {
            Log.LogError(ex, "Delivery poll failed for release pipeline {ReleasePipelineId}.", Id);
        }
        finally
        {
            StopPoll();
        }
    }

    /// <summary>
    /// Idempotent, single-shot teardown: disposal (renderer thread) and the poll loop's
    /// finally (thread pool) both call this, so the fields are claimed atomically to avoid
    /// a double Dispose / Cancel-on-disposed race.
    /// </summary>
    private void StopPoll()
    {
        var cts = Interlocked.Exchange(ref _pollCts, null);
        var timer = Interlocked.Exchange(ref _poll, null);
        cts?.Cancel();
        cts?.Dispose();
        timer?.Dispose();
    }

    public ValueTask DisposeAsync()
    {
        StopPoll();
        return ValueTask.CompletedTask;
    }

    // ── Display helpers ───────────────────────────────────────────────────────

    /// <summary>
    /// The picker label for one releasable build: what it is, not just when it ran.
    /// A consultant picking a build for a customer's live tenant needs the branch,
    /// the commit it was built at and how many apps it carries (#714) - e.g.
    /// "#412 · main @a3f9c21 · 3 apps · built 29 Aug 14:21". Parts the build has no
    /// value for are dropped rather than shown empty.
    /// </summary>
    private static string BuildLabel(BuildRow b, int appCount)
    {
        var parts = new List<string> { $"#{b.Id}" };

        var source = string.Join(" ", new[]
        {
            b.Branch,
            string.IsNullOrEmpty(b.HeadCommitShort) ? null : $"@{b.HeadCommitShort}",
        }.Where(s => !string.IsNullOrEmpty(s)));
        if (!string.IsNullOrEmpty(source)) parts.Add(source);

        if (appCount > 0) parts.Add(appCount == 1 ? "1 app" : $"{appCount} apps");
        if (!string.IsNullOrEmpty(b.BcVersion)) parts.Add($"BC {b.BcVersion}");
        parts.Add("built " + (b.FinishedAt ?? b.StartedAt).ToString("d MMM HH:mm", System.Globalization.CultureInfo.InvariantCulture));

        return string.Join(" · ", parts);
    }

    /// <summary>
    /// The history row's title line. The build number is already in the row's id
    /// chip, so the title says what the release carried instead of repeating it.
    /// </summary>
    private static string RowTitle(DeliveryHistoryRow d) => d.Apps.Count switch
    {
        0 => d.IsScheduled ? "Scheduled release" : "Release",
        1 => "1 app",
        var n => $"{n} apps",
    };

    /// <summary>
    /// A per-app result in the run-family vocabulary, so its glyph comes off the
    /// same table as the delivery's own. The old private CSS spelled these as
    /// five coloured dots (ok / fail / busy / skip / pending) with the state word
    /// only on a title attribute - colour alone, which is the one thing the
    /// design system's status rule exists to prevent.
    /// </summary>
    private static string AppState(string status) => status switch
    {
        ProjectDeliveryResultStatus.Completed => "succeeded",
        ProjectDeliveryResultStatus.Failed => "failed",
        ProjectDeliveryResultStatus.Uploading or ProjectDeliveryResultStatus.Installing => "running",
        ProjectDeliveryResultStatus.Skipped => "cancelled",
        ProjectDeliveryResultStatus.Scheduled => "handed_off",
        _ => "queued",
    };

    private static string AppLabel(string status) => status switch
    {
        ProjectDeliveryResultStatus.Completed => "Installed",
        ProjectDeliveryResultStatus.Failed => "Failed",
        ProjectDeliveryResultStatus.Uploading => "Uploading",
        ProjectDeliveryResultStatus.Installing => "Installing",
        ProjectDeliveryResultStatus.Skipped => "Skipped",
        ProjectDeliveryResultStatus.Scheduled => "Waiting for Business Central to install it",
        _ => "Pending",
    };

    private static string AbsoluteWhen(DeliveryHistoryRow d) => d.CreatedAt.ToString("yyyy-MM-dd HH:mm");

    /// <summary>The scheduled time in the customer's timezone, e.g. "2026-07-01 22:00".</summary>
    private string ScheduledWhen(DeliveryHistoryRow d) =>
        TimeZoneInfo.ConvertTimeFromUtc(DateTime.SpecifyKind(d.ScheduledFor, DateTimeKind.Utc), _tz).ToString("yyyy-MM-dd HH:mm");

    private string ScheduledAbsolute(DeliveryHistoryRow d) => $"{ScheduledWhen(d)} ({_tzLabel})";

    private static string RelativeWhen(DeliveryHistoryRow d)
    {
        var span = DateTime.UtcNow - d.CreatedAt;
        if (span < TimeSpan.Zero) span = TimeSpan.Zero;
        return span switch
        {
            { TotalSeconds: < 60 } => "just now",
            { TotalMinutes: < 60 } => $"{(int)span.TotalMinutes} min ago",
            { TotalHours: < 24 } => $"{(int)span.TotalHours} hr ago",
            { TotalDays: < 7 } => $"{(int)span.TotalDays} day{((int)span.TotalDays == 1 ? "" : "s")} ago",
            _ => $"on {d.CreatedAt:yyyy-MM-dd}",
        };
    }

    private static string Initials(string name)
    {
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        if (parts.Length == 0) return "?";
        var first = char.ToUpperInvariant(parts[0][0]);
        return parts.Length > 1 ? $"{first}{char.ToUpperInvariant(parts[^1][0])}" : first.ToString();
    }
}
