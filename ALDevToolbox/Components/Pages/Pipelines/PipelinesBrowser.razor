@page "/pipelines"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@rendermode InteractiveServer
@inject ALDevToolbox.Services.ObjectExplorer.ArtifactService Artifacts
@inject ALDevToolbox.Services.ObjectExplorer.ProjectService Projects
@inject NavigationManager Nav
@using ALDevToolbox.Services.ObjectExplorer
@using ALDevToolbox.Components.Shared

@*
    The Pipelines landing: every pipeline across the org's projects, with its latest
    build at a glance and a one-click download of its latest successful build. A
    pipeline is a named build flow under a project (a project can have several, each
    compiling a different set of extensions). Open one for its build history, run a
    build, or edit which extensions it compiles. Any signed-in user can browse and
    download. See .design/artifacts.md.

    Named user: a BC developer who needs the latest compiled .app for a customer
    environment. New pipelines are created here (pick a project) or from a project.

    Archetype 2 (list / browser), table view. This was a bespoke .alr row grid; the
    handoff is explicit that a history like this "is a real .data-table ... not a
    bespoke row layout, so it sorts, filters and scans like every other table in the
    toolbox". Build status is the row's edge keyline plus a leading glyph, and the
    passive counts strip became .pill-tabs that actually filter.
    See .design/design-migration.md.
*@

<PageTitle>Pipelines · AL Dev Toolbox</PageTitle>

<div class="page">
    <div class="page-head">
        <div>
            <h1 class="page-head__title">Pipelines</h1>
            <p class="page-head__sub">
                A pipeline compiles a chosen set of a project's extensions into downloadable
                <span class="u-nowrap"><code>.app</code> files</span> — make one per environment
                (Production, Test, ...).
            </p>
        </div>
        @* While there are pipelines, offer "New pipeline" up here. When there are
           none, the empty-state card below carries the single, guided call to
           action — so we don't also surface a redundant button (which, with no
           projects, would read as a bare "go make a project"). *@
        @if (_rows is not null && _totalCount > 0)
        {
            <div class="page-head__actions">
                <button type="button" class="btn btn--primary" @onclick="NewPipelineAsync">
                    <Icon Name="plus" Width="16" Height="16" />
                    <span>New pipeline</span>
                </button>
            </div>
        }
    </div>

    @if (_rows is null)
    {
        <table class="data-table data-table--edge">
            <thead><tr>
                <th class="data-table__col-state"><span class="u-sr">Latest build</span></th>
                <th>Pipeline</th><th>Project</th><th>Owner</th><th>Latest build</th><th>When</th>
                <th class="data-table__actions"></th>
            </tr></thead>
            <tbody><TableSkeletonRows Columns="6" /></tbody>
        </table>
        <div class="loading-block loading-block--under-table">
            <span class="spinner"></span><span>Loading pipelines...</span>
        </div>
    }
    else if (_totalCount == 0)
    {
        <div class="card">
            <div class="empty-state">
                <span class="empty-state__icon"><Icon Name="rocket" Width="21" Height="21" /></span>
                <span class="empty-state__title">No pipelines yet</span>
                @if (_projectOptions.Count > 0)
                {
                    <span class="empty-state__text">
                        A pipeline picks which of a project's extensions to compile. Create one to
                        start producing downloadable <code>.app</code> files.
                    </span>
                    <button type="button" class="btn btn--primary empty-state__action" @onclick="NewPipelineAsync">
                        <Icon Name="plus" Width="15" Height="15" />
                        <span>New pipeline</span>
                    </button>
                }
                else
                {
                    <span class="empty-state__text">
                        A pipeline compiles the code in a project (a customer), so the first step is
                        creating that project and pointing it at its repositories. Once a project
                        exists you can add a pipeline to it.
                    </span>
                    <a class="btn btn--primary empty-state__action" href="/projects/new">
                        <Icon Name="plus" Width="15" Height="15" />
                        <span>Create a project</span>
                    </a>
                }
            </div>
        </div>
    }
    else
    {
        <div class="filter-bar">
            @* A plain GET form, so the search survives a reload and stays a
               shareable URL. The status tabs beside it filter in memory — they're
               a view of what's already loaded, not a second round trip. *@
            <form method="get" role="search" class="filter-bar__search">
                <span class="search">
                    <Icon Name="search" Width="15" Height="15" Css="search__icon" />
                    <input type="search" name="q" value="@_search" class="input"
                           placeholder="Search pipelines by name, project, or owner..."
                           aria-label="Search pipelines" />
                </span>
            </form>

            <div class="pill-tabs" role="group" aria-label="Filter by build status">
                <button type="button" class="pill-tab @(_statusFilter is null ? "is-active" : "")"
                        @onclick="() => _statusFilter = null" aria-pressed="@(_statusFilter is null)">
                    All<span class="pill-tab__count">@_rows.Count</span>
                </button>
                @if (_buildingCount > 0)
                {
                    <button type="button" class="pill-tab @(_statusFilter == "building" ? "is-active" : "")"
                            @onclick="@(() => _statusFilter = "building")" aria-pressed="@(_statusFilter == "building")">
                        Building<span class="pill-tab__count">@_buildingCount</span>
                    </button>
                }
                @if (_failedCount > 0)
                {
                    <button type="button" class="pill-tab @(_statusFilter == "failed" ? "is-active" : "")"
                            @onclick="@(() => _statusFilter = "failed")" aria-pressed="@(_statusFilter == "failed")">
                        Needs attention<span class="pill-tab__count">@_failedCount</span>
                    </button>
                }
            </div>

            <span class="filter-bar__spacer"></span>
            @if (!string.IsNullOrEmpty(_search))
            {
                <a class="btn btn--sm" href="/pipelines">Clear search</a>
            }
        </div>

        @if (Visible.Count == 0)
        {
            <div class="card">
                <div class="empty-state">
                    <span class="empty-state__icon"><Icon Name="funnel-x" Width="21" Height="21" /></span>
                    <span class="empty-state__title">
                        @if (string.IsNullOrEmpty(_search))
                        {
                            <text>No pipelines are @(_statusFilter == "failed" ? "failing" : "building") right now</text>
                        }
                        else
                        {
                            <text>No pipelines match "@_search"</text>
                        }
                    </span>
                    <span class="empty-state__text">
                        Try a shorter search term, or clear the filters to see all @_totalCount.
                    </span>
                    @if (string.IsNullOrEmpty(_search))
                    {
                        <button type="button" class="btn empty-state__action" @onclick="() => _statusFilter = null">Clear filters</button>
                    }
                    else
                    {
                        <a class="btn empty-state__action" href="/pipelines">Clear filters</a>
                    }
                </div>
            </div>
        }
        else
        {
            <table class="data-table data-table--edge">
                <thead>
                    <tr>
                        <th class="data-table__col-state"><span class="u-sr">Latest build</span></th>
                        <th scope="col">Pipeline</th>
                        <th scope="col">Project</th>
                        <th scope="col">Owner</th>
                        <th scope="col">Latest build</th>
                        <th scope="col">When</th>
                        <th scope="col" class="data-table__actions"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Visible)
                    {
                        var sb = p.LatestSuccessfulBuildId;
                        var failedLatest = p.Latest?.Status == "failed";
                        <tr class="@(p.Latest is { } s ? RowStateIcon.RowClass(s.Status) : null)">
                            <td class="data-table__col-state">
                                @if (p.Latest is { } st)
                                {
                                    <RowStateIcon State="@st.Status" />
                                }
                            </td>
                            <td><a href="@($"/pipelines/{p.Id}")"><strong>@p.Name</strong></a></td>
                            <td><a href="@($"/projects/{p.ProjectId}")">@p.ProjectName</a></td>
                            <td class="u-muted">@(p.OwnerName ?? "—")</td>
                            <td>
                                @if (p.Latest is { } b)
                                {
                                    <span class="pl-build">
                                        @if (!string.IsNullOrEmpty(b.CommitShort))
                                        {
                                            <span class="commit-chip">
                                                <Icon Name="git-commit-vertical" Width="11" Height="11" />@b.CommitShort
                                            </span>
                                        }
                                        @if (!string.IsNullOrEmpty(b.Branch))
                                        {
                                            <span class="pl-branch"><Icon Name="git-branch" Width="12" Height="12" />@b.Branch</span>
                                        }
                                        <span class="u-muted">@(string.IsNullOrEmpty(b.BcVersion) ? "BC —" : $"BC {b.BcVersion}")</span>
                                    </span>
                                }
                                else
                                {
                                    <span class="u-muted">No builds yet</span>
                                }
                            </td>
                            <td class="u-muted">
                                @if (p.Latest is { } w)
                                {
                                    <span title="@AbsoluteWhen(w)">@Verb(w.Status) @RelativeTime.Ago(w.FinishedAt ?? w.StartedAt)</span>
                                }
                                else
                                {
                                    <span>—</span>
                                }
                            </td>
                            <td class="data-table__actions">
                                <span class="ra">
                                    <button type="button" class="btn btn--icon btn--sm" data-ra-toggle
                                            title="More actions" aria-label="More actions"
                                            aria-haspopup="menu" aria-expanded="false">
                                        <Icon Name="ellipsis-vertical" Width="17" Height="17" />
                                    </button>
                                    <div class="ra__menu menu" role="menu">
                                        <a class="menu__item" href="@($"/pipelines/{p.Id}")" role="menuitem">
                                            <Icon Name="package" Width="15" Height="15" />
                                            <span>View builds</span>
                                        </a>
                                        @if (sb is { } good2)
                                        {
                                            <a class="menu__item" href="@($"/artifacts/build/{good2}/all")" role="menuitem">
                                                <Icon Name="archive" Width="15" Height="15" />
                                                <span>@(failedLatest ? "Download last good build" : "Download all .app files")</span>
                                            </a>
                                        }
                                        <a class="menu__item" href="@($"/projects/{p.ProjectId}")" role="menuitem">
                                            <Icon Name="folder-git-2" Width="15" Height="15" />
                                            <span>Project settings</span>
                                        </a>
                                        <div class="menu__sep"></div>
                                        <button type="button" class="menu__item" data-copy-url="@($"/pipelines/{p.Id}")" role="menuitem">
                                            <Icon Name="copy" Width="15" Height="15" />
                                            <span data-copy-label>Copy link</span>
                                        </button>
                                    </div>
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    }
</div>

<PipelineEditorDialog @ref="_editor" OnSaved="OnPipelineCreatedAsync" />

@code {
    private List<PipelineArtifactsRow>? _rows;
    private List<PipelineProjectOption> _projectOptions = new();
    private int _totalCount;
    private int _buildingCount;
    private int _failedCount;

    /// <summary>
    /// The search term, taken from <c>?q=</c>.
    ///
    /// Read as a query parameter rather than from <c>IHttpContextAccessor</c>,
    /// which is what this page did before and why its search never worked: an
    /// interactive page runs OnInitializedAsync twice — once while prerendering,
    /// where HttpContext exists, and again on the circuit, where it is null. The
    /// second run silently reset the term and every row came back. This is
    /// populated in both passes.
    /// </summary>
    [Parameter, SupplyParameterFromQuery(Name = "q")]
    public string? Q { get; set; }

    private string _search = string.Empty;

    /// <summary>What <see cref="_rows"/> was last loaded for, so a re-render doesn't re-query.</summary>
    private string? _loadedFor;

    /// <summary>
    /// The status tab in force, or null for "All". Filters the loaded rows in
    /// memory — the search is what goes back to the server.
    /// </summary>
    private string? _statusFilter;

    private PipelineEditorDialog? _editor;

    /// <summary>The rows the table actually renders: the search result, narrowed by the status tab.</summary>
    private List<PipelineArtifactsRow> Visible =>
        _rows is null ? new()
        : _statusFilter switch
        {
            "building" => _rows.Where(p => p.Latest?.Status is "building" or "queued").ToList(),
            "failed" => _rows.Where(p => p.Latest?.Status == "failed").ToList(),
            _ => _rows,
        };

    // OnParametersSetAsync rather than OnInitializedAsync so submitting the
    // search form — which is a navigation, not a new component — reloads.
    protected override async Task OnParametersSetAsync()
    {
        _search = (Q ?? string.Empty).Trim();
        if (_loadedFor == _search) return;
        _loadedFor = _search;

        var projects = await Projects.ListProjectsAsync();
        _projectOptions = projects.Select(p => new PipelineProjectOption(p.Id, p.Name)).ToList();

        var all = await Artifacts.ListPipelinesAsync();
        _totalCount = all.Count;
        _buildingCount = all.Count(p => p.Latest?.Status is "building" or "queued");
        _failedCount = all.Count(p => p.Latest?.Status == "failed");
        _rows = string.IsNullOrEmpty(_search) ? all : await Artifacts.ListPipelinesAsync(_search);
    }

    private async Task NewPipelineAsync()
    {
        if (_editor is null || _projectOptions.Count == 0) return;
        await _editor.OpenForCreateAsync(_projectOptions);
    }

    private void OnPipelineCreatedAsync(int pipelineId) => Nav.NavigateTo($"/pipelines/{pipelineId}");

    private static string Verb(string status) => status switch
    {
        "ready" => "Built",
        "failed" => "Failed",
        "building" => "Started",
        _ => "Queued",
    };

    /// <summary>The full local timestamp, shown as a hover title behind the relative "when".</summary>
    private static string AbsoluteWhen(BuildSummary b) =>
        (b.FinishedAt ?? b.StartedAt).ToString("yyyy-MM-dd HH:mm");
}
