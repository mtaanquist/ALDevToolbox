@page "/releases"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@rendermode InteractiveServer
@inject ALDevToolbox.Services.ObjectExplorer.ReleasePipelineService Releases
@inject ALDevToolbox.Services.ObjectExplorer.ProjectService Projects
@inject ILogger<ReleasePipelinesBrowser> Log
@using ALDevToolbox.Services.ObjectExplorer
@using ALDevToolbox.Domain.Entities.ObjectExplorer
@using ALDevToolbox.Domain.ValueObjects.ObjectExplorer

@*
    The Releases landing: every release pipeline across the org's projects. A release
    pipeline is a reusable "publish this build pipeline's apps to this Business Central
    environment" target — build once, deploy that same build to several environments.
    Create one here (pick a project that's BC-connected) or edit/remove an existing one.
    Scheduling an actual release lands in a later slice. See .design/saas-delivery.md.

    Named user: a BC consultant who has connected a customer's environment and now sets
    up where its compiled apps get published.

    Archetype 2 (list / browser), table view, replacing the bespoke .alr row grid.
    A release pipeline has no build status, so the edge keyline carries the one
    thing that can be wrong with it instead: an environment that has disappeared
    from Business Central takes is-failed, and everything else has a clear row.
    See .design/design-migration.md.
*@

<PageTitle>Releases · AL Dev Toolbox</PageTitle>

<div class="page">
    <div class="page-head">
        <div>
            <h1 class="page-head__title">Releases</h1>
            <p class="page-head__sub">
                A release pipeline publishes a build pipeline's compiled
                <span class="u-nowrap"><code>.app</code> files</span> to a Business Central
                environment — one target per customer environment (Production, Sandbox, ...).
            </p>
        </div>
        @if (_rows is not null && _rows.Count > 0)
        {
            <div class="page-head__actions">
                <button type="button" class="btn btn--primary" @onclick="NewReleaseAsync">
                    <Icon Name="plus" Width="16" Height="16" />
                    <span>New release pipeline</span>
                </button>
            </div>
        }
    </div>

    @if (_rows is null)
    {
        <table class="data-table data-table--edge">
            <thead><tr>
                <th class="data-table__col-state"><span class="u-sr">Target health</span></th>
                <th>Release pipeline</th><th>Project</th><th>Target environment</th>
                <th>Build pipeline</th><th>Versioning</th>
                <th class="data-table__actions"></th>
            </tr></thead>
            <tbody><TableSkeletonRows Columns="6" /></tbody>
        </table>
        <div class="loading-block loading-block--under-table">
            <span class="spinner"></span><span>Loading release pipelines...</span>
        </div>
    }
    else if (_rows.Count == 0)
    {
        <div class="card">
            <div class="empty-state">
                <span class="empty-state__icon"><Icon Name="send" Width="21" Height="21" /></span>
                <span class="empty-state__title">No release pipelines yet</span>
                @if (_projectOptions.Count > 0)
                {
                    <span class="empty-state__text">
                        A release pipeline points a build pipeline's apps at a Business Central
                        environment. You'll pick the project, its build pipeline, and the target
                        environment.
                    </span>
                    <button type="button" class="btn btn--primary empty-state__action" @onclick="NewReleaseAsync">
                        <Icon Name="plus" Width="15" Height="15" />
                        <span>New release pipeline</span>
                    </button>
                }
                else
                {
                    <span class="empty-state__text">
                        Releases publish a project's compiled apps to its Business Central
                        environment, so the first step is creating a project, connecting Business
                        Central, and adding a build pipeline. Then you can set up a release.
                    </span>
                    <a class="btn btn--primary empty-state__action" href="/projects/new">
                        <Icon Name="plus" Width="15" Height="15" />
                        <span>Create a project</span>
                    </a>
                }
            </div>
        </div>
    }
    else
    {
        <table class="data-table data-table--edge">
            <thead>
                <tr>
                    <th class="data-table__col-state"><span class="u-sr">Target health</span></th>
                    <th scope="col">Release pipeline</th>
                    <th scope="col">Project</th>
                    <th scope="col">Target environment</th>
                    <th scope="col">Build pipeline</th>
                    <th scope="col">Versioning</th>
                    <th scope="col" class="data-table__actions"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in _rows)
                {
                    <tr class="@(r.EnvironmentMissing ? "is-failed" : null)">
                        <td class="data-table__col-state">
                            @if (r.EnvironmentMissing)
                            {
                                <span class="data-table__state data-table__state--icon" role="img"
                                      aria-label="Environment not found" title="This environment wasn't found the last time we checked Business Central">
                                    <Icon Name="circle-x" Width="15" Height="15" />
                                </span>
                            }
                        </td>
                        <td>
                            <a href="@($"/releases/{r.Id}")"><strong>@r.Name</strong></a>
                            @if (r.SchemaSyncMode == BcSyncMode.ForceSync)
                            {
                                <span class="rp-force" title="Installs use Force sync, which can drop columns">
                                    <Icon Name="triangle-alert" Width="12" Height="12" />Force sync
                                </span>
                            }
                        </td>
                        <td><a href="@($"/projects/{r.ProjectId}")">@r.ProjectName</a></td>
                        <td>
                            <span class="rp-env">
                                <span class="status-pill @(IsProduction(r) ? "status-pill--danger" : "status-pill--muted")">@r.EnvironmentType</span>
                                <span>@r.EnvironmentName</span>
                                @if (r.EnvironmentMissing)
                                {
                                    <span class="u-muted">no longer present</span>
                                }
                                else if (r.CompanyName is { } co)
                                {
                                    <span class="u-muted">@co</span>
                                }
                            </span>
                        </td>
                        <td class="u-muted">@r.BuildPipelineName</td>
                        <td class="u-muted">@DeliveryModeDisplay.Schedule(r.DeploymentSchedule)</td>
                        <td class="data-table__actions">
                            <span class="ra">
                                <button type="button" class="btn btn--icon btn--sm" data-ra-toggle
                                        title="More actions" aria-label="More actions"
                                        aria-haspopup="menu" aria-expanded="false">
                                    <Icon Name="ellipsis-vertical" Width="17" Height="17" />
                                </button>
                                <div class="ra__menu menu" role="menu">
                                    <button type="button" class="menu__item" @onclick="() => EditAsync(r)" role="menuitem">
                                        <Icon Name="pencil" Width="15" Height="15" />
                                        <span>Edit</span>
                                    </button>
                                    <a class="menu__item" href="@($"/projects/{r.ProjectId}")" role="menuitem">
                                        <Icon Name="folder-git-2" Width="15" Height="15" />
                                        <span>Project settings</span>
                                    </a>
                                    <div class="menu__sep"></div>
                                    <button type="button" class="menu__item menu__item--danger" @onclick="() => DeleteAsync(r)" role="menuitem">
                                        <Icon Name="trash-2" Width="15" Height="15" />
                                        <span>Delete</span>
                                    </button>
                                </div>
                            </span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

<ReleasePipelineEditorDialog @ref="_editor" OnSaved="OnSavedAsync" />
<ConfirmDialog @ref="_deleteConfirm" Title="Delete release pipeline?"
               ConfirmLabel="Delete release pipeline" ConfirmButtonClass="btn--danger" ConfirmIcon="trash-2" />

@code {
    private List<ReleasePipelineRow>? _rows;
    private List<PipelineProjectOption> _projectOptions = new();
    private ReleasePipelineEditorDialog? _editor;
    private ConfirmDialog? _deleteConfirm;

    /// <summary>
    /// Production targets read louder than sandboxes: publishing to one is the
    /// action with consequences, so it gets the danger fill rather than a
    /// neutral chip. Cards and cells keep pills; only table *rows* take the edge.
    /// </summary>
    private static bool IsProduction(ReleasePipelineRow r) =>
        r.EnvironmentType.Equals("Production", StringComparison.OrdinalIgnoreCase);

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task ReloadAsync()
    {
        var projects = await Projects.ListProjectsAsync();
        _projectOptions = projects.Select(p => new PipelineProjectOption(p.Id, p.Name)).ToList();
        _rows = await Releases.ListReleasePipelinesAsync();
    }

    private async Task NewReleaseAsync()
    {
        if (_editor is null || _projectOptions.Count == 0) return;
        await _editor.OpenForCreateAsync(_projectOptions);
    }

    private async Task EditAsync(ReleasePipelineRow row)
    {
        if (_editor is null) return;
        await _editor.OpenForEditAsync(row);
    }

    private async Task OnSavedAsync(int _) => await ReloadAsync();

    private async Task DeleteAsync(ReleasePipelineRow row)
    {
        if (_deleteConfirm is null) return;
        var confirmed = await _deleteConfirm.OpenAsync(
            "Delete release pipeline?",
            $"Delete \"{row.Name}\"? This removes the release target. Build pipelines and past builds are untouched.",
            "Delete release pipeline");
        if (!confirmed) return;

        try
        {
            await Releases.SoftDeleteReleasePipelineAsync(row.Id);
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "Failed to delete release pipeline {ReleasePipelineId}.", row.Id);
        }
    }
}
