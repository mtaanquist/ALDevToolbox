@page "/upgrades"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@rendermode InteractiveServer
@inject ALDevToolbox.Services.ObjectExplorer.Bc.UpgradeFleetService Fleet
@inject ALDevToolbox.Services.ObjectExplorer.Bc.ProjectConnectionService Connection
@inject ALDevToolbox.Services.ObjectExplorer.ProjectAccess Access
@inject NavigationManager Nav
@inject ILogger<UpgradesPage> Log
@using ALDevToolbox.Components.Shared
@using ALDevToolbox.Domain.ValueObjects
@using ALDevToolbox.Services.ObjectExplorer
@using ALDevToolbox.Services.ObjectExplorer.Bc

@*
    Upgrades: every customer environment in one table, with the date Business
    Central will next update it, and the two moves the upgrade team makes on
    those dates in bulk.

    Named user: a member of the BC upgrade team who schedules platform updates
    for around a hundred customers. Twice a quarter they push every customer's
    date out to the latest Microsoft allows; when a customer agrees a slot they
    start that one environment's update straight away. They know Business
    Central; they know nothing about this codebase.

    Archetype 2 (list / browser), table view, with two things no other browser
    page has: per-row checkboxes (because the whole point is doing a hundred at
    once) and an in-page run that reports per row. Filters stay a plain GET form
    so a filtered fleet is a shareable address.

    Both actions are outline buttons - the app's only primary button is Generate.
    See .design/saas-delivery.md and issue #657.
*@

<PageTitle>Upgrades · AL Dev Toolbox</PageTitle>

<div class="page">
    <div class="page-head">
        <div>
            <h1 class="page-head__title">Upgrades</h1>
            @* The subtitle describes what you do here; someone who can't do it is
               told that instead, by the card below. *@
            @if (!_denied)
            {
                <p class="page-head__sub">
                    When each customer's environment moves to its next Business Central version,
                    and how much longer you can put that off. Pick the environments you want,
                    then move their dates or start their update.
                </p>
            }
        </div>
    </div>

    @if (_denied)
    {
        <div class="card">
            <div class="empty-state">
                <span class="empty-state__icon"><Icon Name="lock" Width="21" Height="21" /></span>
                <span class="empty-state__title">You don't have access to Upgrades</span>
                <span class="empty-state__text">
                    Changing a customer's update date acts on their live Business Central
                    environment, so it is given out per team. Ask an administrator to let you
                    manage environment updates on one of your teams.
                </span>
                <a class="btn empty-state__action" href="/">
                    <Icon Name="house" Width="15" Height="15" />
                    <span>Go to Home</span>
                </a>
            </div>
        </div>
    }
    else if (_rows is null)
    {
        <table class="data-table data-table--edge">
            <thead><tr>
                <th class="upg__pick"><span class="u-sr">Select</span></th>
                <th scope="col">Customer</th>
                <th scope="col">Environment</th>
                <th scope="col">Status</th>
                <th scope="col">Now on</th>
                <th scope="col">Next update</th>
                <th scope="col">Latest possible date</th>
                <th scope="col">Checked</th>
            </tr></thead>
            <tbody><TableSkeletonRows Columns="8" /></tbody>
        </table>
        <div class="loading-block loading-block--under-table">
            <span class="spinner"></span><span>Loading environments...</span>
        </div>
    }
    else if (_totalCount == 0)
    {
        <div class="card">
            <div class="empty-state">
                <span class="empty-state__icon"><Icon Name="calendar" Width="21" Height="21" /></span>
                <span class="empty-state__title">No customer environments yet</span>
                <span class="empty-state__text">
                    This page lists the Business Central environments of the customers you can
                    see. Connect a customer's Business Central from their project, and their
                    environments show up here.
                </span>
                <a class="btn empty-state__action" href="/projects">
                    <Icon Name="folder-git-2" Width="15" Height="15" />
                    <span>Go to Projects</span>
                </a>
            </div>
        </div>
    }
    else
    {
        @* Search is a plain GET form (press Enter), so a filtered fleet is an
           address you can send to a colleague; the two narrow filters navigate to
           the same kind of address when they change. Both keep the other filters
           in the URL. *@
        <div class="filter-bar">
            <form method="get" class="filter-bar__search" role="search">
                <span class="search">
                    <Icon Name="search" Width="15" Height="15" Css="search__icon" />
                    <input type="search" name="q" value="@_search" class="input"
                           placeholder="Search by customer or environment name..."
                           aria-label="Search customers and environments" />
                </span>
                <input type="hidden" name="type" value="@_type" />
                <input type="hidden" name="waiting" value="@(_onlyWaiting ? "1" : "")" />
            </form>
            <label class="u-sr" for="upg-type">Environment type</label>
            <span class="select-wrap">
                <select id="upg-type" class="select" value="@_type" @onchange="OnTypeChanged">
                    <option value="">All environment types</option>
                    @foreach (var option in _typeOptions)
                    {
                        <option value="@option">@option</option>
                    }
                </select>
                <Icon Name="chevron-down" Width="15" Height="15" Css="select-wrap__caret" />
            </span>
            <label class="upg-check">
                <input type="checkbox" checked="@_onlyWaiting" @onchange="OnWaitingChanged" />
                <span>Only those with an update waiting</span>
            </label>
        </div>

        <div class="upg-bar">
            <span class="upg-bar__count">
                @if (_selected.Count == 0)
                {
                    <text>Nothing selected</text>
                }
                else
                {
                    <text><b>@_selected.Count</b> selected</text>
                }
            </span>
            <span class="upg-bar__acts">
                <button type="button" class="btn btn--sm" disabled="@(_selected.Count == 0 || _running)"
                        @onclick="ConfirmPushAsync">
                    <Icon Name="calendar" Width="14" Height="14" />
                    <span>Move dates to the latest</span>
                </button>
                <button type="button" class="btn btn--sm" disabled="@(_selected.Count == 0 || _running)"
                        @onclick="ConfirmUpdateNowAsync">
                    <Icon Name="zap" Width="14" Height="14" />
                    <span>Start the update now</span>
                </button>
                <button type="button" class="btn btn--sm" disabled="@_running" @onclick="RefreshDataAsync">
                    <Icon Name="refresh-cw" Width="14" Height="14" />
                    <span>Ask Business Central for fresh answers</span>
                </button>
            </span>
        </div>

        @if (_notice is { } notice)
        {
            <div class="upg-notice">
                <Icon Name="info" Width="14" Height="14" />
                <span>@notice</span>
            </div>
        }

        @if (_running)
        {
            <div class="upg-notice upg-notice--busy">
                <span class="spinner"></span>
                <span>@_progressText</span>
                <button type="button" class="btn btn--sm" @onclick="() => _stopRequested = true" disabled="@_stopRequested">
                    <span>@(_stopRequested ? "Stopping after this one" : "Stop")</span>
                </button>
            </div>
        }

        @if (_rows.Count == 0)
        {
            <div class="card">
                <div class="empty-state">
                    <span class="empty-state__icon"><Icon Name="funnel-x" Width="21" Height="21" /></span>
                    <span class="empty-state__title">No environments match these filters</span>
                    <span class="empty-state__text">
                        Try a shorter search, or clear the filters to see all @_totalCount.
                    </span>
                    <a class="btn empty-state__action" href="/upgrades">Clear filters</a>
                </div>
            </div>
        }
        else
        {
            <table class="data-table data-table--edge">
                <thead>
                    <tr>
                        <th class="upg__pick">
                            @if (_actionableRows.Count > 0)
                            {
                                <input type="checkbox" aria-label="Select every environment listed"
                                       checked="@AllPicked" @onchange="ToggleAll" disabled="@_running" />
                            }
                            else
                            {
                                <span class="u-sr">Select</span>
                            }
                        </th>
                        <th scope="col">Customer</th>
                        <th scope="col">Environment</th>
                        <th scope="col">Status</th>
                        <th scope="col">Now on</th>
                        <th scope="col">Next update</th>
                        <th scope="col">Latest possible date</th>
                        <th scope="col">Checked</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in _rows)
                    {
                        <tr @key="row.EnvironmentId" class="@(row.CanAct ? null : "upg-row--locked")">
                            <td class="upg__pick">
                                @if (row.CanAct)
                                {
                                    <input type="checkbox"
                                           aria-label="@($"Select {row.ProjectName} {row.EnvironmentName}")"
                                           checked="@_selected.Contains(row.EnvironmentId)"
                                           @onchange="e => TogglePick(row.EnvironmentId, e)"
                                           disabled="@_running" />
                                }
                                else
                                {
                                    <span title="You can't change this customer's update dates">
                                        <Icon Name="lock" Width="13" Height="13" />
                                    </span>
                                }
                            </td>
                            <td class="upg-customer"><a href="@($"/projects/{row.ProjectId}")"><strong>@row.ProjectName</strong></a></td>
                            <td>
                                <div>@row.EnvironmentName</div>
                                <span class="status-pill status-pill--muted@(row.IsProduction ? " upg-prod" : "")">
                                    <span class="status-pill__dot"></span>
                                    <span>@row.EnvironmentType</span>
                                </span>
                            </td>
                            <td>
                                @if (string.IsNullOrWhiteSpace(row.Status))
                                {
                                    <span class="status-pill status-pill--muted">
                                        <span class="status-pill__dot"></span>
                                        <span>Not checked yet</span>
                                    </span>
                                }
                                else
                                {
                                    <span class="status-pill status-pill--@StatusPillTone(row.Status)">
                                        <span class="status-pill__dot"></span>
                                        <span>@BcEnvironmentStatus.Humanise(row.Status)</span>
                                    </span>
                                }
                            </td>
                            <td class="u-muted">@(string.IsNullOrWhiteSpace(row.Version) ? "—" : row.Version)</td>
                            <td>
                                @if (!row.HasUpdate)
                                {
                                    <span class="u-muted">Nothing waiting</span>
                                }
                                else
                                {
                                    <div><b>@row.NextUpdateVersion</b></div>
                                    <div class="u-muted">@UpdateWhen(row)</div>
                                    @if (row.NextUpdateIgnoresWindow == true)
                                    {
                                        <div class="upg-note upg-note--warn">
                                            <Icon Name="triangle-alert" Width="12" Height="12" />
                                            <span>Runs outside the customer's update window</span>
                                        </div>
                                    }
                                }
                                @if (_results.TryGetValue(row.EnvironmentId, out var result))
                                {
                                    <div class="@result.CssClass">
                                        @if (result.Tone == "busy")
                                        {
                                            <span class="spinner"></span>
                                        }
                                        <span>@result.Text</span>
                                    </div>
                                }
                            </td>
                            <td class="u-muted">@LatestText(row)</td>
                            <td class="upg-checked @(IsStale(row) ? "upg-stale" : "u-muted")">
                                @if (row.FetchedAt is { } at)
                                {
                                    @($"checked {RelativeTime.Ago(at)}")
                                }
                                else
                                {
                                    <text>never checked</text>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    }
</div>

@* Both confirms preview exactly what the run will do, row by row, including the
   rows it will pass over - the alternative is a person pressing a button on
   ninety customers and finding out afterwards. *@
<ConfirmDialog @ref="_pushConfirm" Wide="true"
               Title="Move these update dates?"
               Message="Each environment below keeps the same version, but the date moves to the last one Business Central still offers."
               ConfirmLabel="Move the dates" ConfirmButtonClass="btn" ConfirmIcon="calendar">
    <ul class="upg-preview">
        @foreach (var item in _preview)
        {
            <li class="@(item.Skipped ? "upg-preview__skip" : null)">
                <span class="upg-preview__who">@item.Who</span>
                <span class="upg-preview__what">@item.What</span>
            </li>
        }
    </ul>
</ConfirmDialog>

<ConfirmDialog @ref="_nowConfirm" Wide="true"
               Title="Start these updates now?"
               Message="Business Central will start updating these environments as soon as it picks them up, whatever time of day their update window says. Once it starts you cannot stop it."
               ConfirmLabel="Start the updates" ConfirmButtonClass="btn--danger" ConfirmIcon="zap"
               RequireWord="update">
    <ul class="upg-preview">
        @foreach (var item in _preview)
        {
            <li class="@(item.Skipped ? "upg-preview__skip" : null)">
                <span class="upg-preview__who">@item.Who</span>
                <span class="upg-preview__what">@item.What</span>
            </li>
        }
    </ul>
</ConfirmDialog>

@code {
    [Parameter, SupplyParameterFromQuery(Name = "q")] public string? Query { get; set; }
    [Parameter, SupplyParameterFromQuery(Name = "type")] public string? TypeFilter { get; set; }
    [Parameter, SupplyParameterFromQuery(Name = "waiting")] public string? WaitingFilter { get; set; }

    /// <summary>The fleet after the filters, or null while it is still loading.</summary>
    private List<UpgradeFleetRow>? _rows;
    private List<UpgradeFleetRow> _all = new();
    private List<UpgradeFleetRow> _actionableRows = new();
    private List<string> _typeOptions = new();
    private int _totalCount;

    private bool _denied;
    private string _search = string.Empty;
    private string _type = string.Empty;
    private bool _onlyWaiting;

    private readonly HashSet<int> _selected = new();
    private readonly Dictionary<int, RowResult> _results = new();
    private List<PreviewItem> _preview = new();

    private bool _running;
    private bool _stopRequested;
    private string _progressText = string.Empty;
    private string? _notice;

    private ConfirmDialog? _pushConfirm;
    private ConfirmDialog? _nowConfirm;

    protected override async Task OnInitializedAsync()
    {
        var snapshot = await Access.GetSnapshotAsync();
        // The grant is deliberately not in the sign-in claims, so the page asks the
        // same service the sidebar does rather than reading a role.
        if (!snapshot.CanUseEnvironmentOps)
        {
            _denied = true;
            return;
        }

        ReadQuery();
        await LoadAsync();
    }

    protected override void OnParametersSet()
    {
        if (_denied) return;
        ReadQuery();
        // Only once the fleet is in hand: the first pass runs before it is loaded.
        if (_rows is not null) ApplyFilters();
    }

    private void ReadQuery()
    {
        _search = (Query ?? string.Empty).Trim();
        _type = (TypeFilter ?? string.Empty).Trim();
        _onlyWaiting = WaitingFilter == "1";
    }

    private void OnTypeChanged(ChangeEventArgs e) => GoToFilters(
        type: e.Value?.ToString() ?? string.Empty, waiting: _onlyWaiting);

    private void OnWaitingChanged(ChangeEventArgs e) => GoToFilters(
        type: _type, waiting: e.Value is true);

    /// <summary>
    /// Applies a filter change by changing the address, so every state of this table
    /// has a link - including the one someone wants to send to a colleague.
    /// </summary>
    private void GoToFilters(string type, bool waiting)
    {
        var parts = new List<string>();
        if (_search.Length > 0) parts.Add("q=" + Uri.EscapeDataString(_search));
        if (type.Length > 0) parts.Add("type=" + Uri.EscapeDataString(type));
        if (waiting) parts.Add("waiting=1");
        Nav.NavigateTo(parts.Count == 0 ? "/upgrades" : "/upgrades?" + string.Join("&", parts));
    }

    private async Task LoadAsync()
    {
        _all = await Fleet.ListFleetAsync();
        _totalCount = _all.Count;
        _typeOptions = _all
            .Select(r => r.EnvironmentType)
            .Where(t => !string.IsNullOrWhiteSpace(t))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(t => t, StringComparer.OrdinalIgnoreCase)
            .ToList();
        ApplyFilters();
    }

    private void ApplyFilters()
    {
        IEnumerable<UpgradeFleetRow> q = _all;
        if (_search.Length > 0)
        {
            q = q.Where(r =>
                r.ProjectName.Contains(_search, StringComparison.OrdinalIgnoreCase)
                || r.EnvironmentName.Contains(_search, StringComparison.OrdinalIgnoreCase));
        }
        if (_type.Length > 0)
        {
            q = q.Where(r => string.Equals(r.EnvironmentType, _type, StringComparison.OrdinalIgnoreCase));
        }
        if (_onlyWaiting)
        {
            q = q.Where(r => r.HasUpdate);
        }

        _rows = q.ToList();
        _actionableRows = _rows.Where(r => r.CanAct).ToList();
        // A row that is no longer listed can't stay picked - the buttons count what
        // the person can see.
        _selected.RemoveWhere(id => !_actionableRows.Any(r => r.EnvironmentId == id));
    }

    private bool AllPicked =>
        _actionableRows.Count > 0 && _actionableRows.All(r => _selected.Contains(r.EnvironmentId));

    private void ToggleAll(ChangeEventArgs e)
    {
        if (e.Value is true)
        {
            foreach (var row in _actionableRows) _selected.Add(row.EnvironmentId);
        }
        else
        {
            _selected.Clear();
        }
    }

    private void TogglePick(int environmentId, ChangeEventArgs e)
    {
        if (e.Value is true) _selected.Add(environmentId);
        else _selected.Remove(environmentId);
    }

    private List<UpgradeFleetRow> SelectedRows() =>
        _actionableRows.Where(r => _selected.Contains(r.EnvironmentId)).ToList();

    // ── The two bulk actions ────────────────────────────────────────────

    private async Task ConfirmPushAsync()
    {
        var rows = SelectedRows();
        if (rows.Count == 0 || _pushConfirm is null) return;

        _preview = rows.Select(r => r.CanPushDate
            ? new PreviewItem($"{r.ProjectName} - {r.EnvironmentName}",
                $"{WhenText(r.NextUpdateDate)} moves to {DateText(r.NextUpdateLatestDate)}", false)
            : new PreviewItem($"{r.ProjectName} - {r.EnvironmentName}",
                $"will be skipped - {WhyNoPush(r)}", true)).ToList();

        if (await _pushConfirm.OpenAsync())
        {
            await RunBatchAsync(push: true);
        }
    }

    private async Task ConfirmUpdateNowAsync()
    {
        var rows = SelectedRows();
        if (rows.Count == 0 || _nowConfirm is null) return;

        _preview = rows.Select(r => r.HasUpdate
            ? new PreviewItem($"{r.ProjectName} - {r.EnvironmentName}",
                $"starts updating to {r.NextUpdateVersion}", false)
            : new PreviewItem($"{r.ProjectName} - {r.EnvironmentName}",
                "will be skipped - no update is waiting", true)).ToList();

        if (await _nowConfirm.OpenAsync())
        {
            await RunBatchAsync(push: false);
        }
    }

    /// <summary>
    /// Runs the selection one environment at a time, in this page's own circuit.
    /// Each row reports for itself and a refusal never costs the rest of the batch -
    /// the whole point of the sweep is that ninety-nine customers still get done when
    /// one of them has nothing to move. Stop applies before the next environment;
    /// nothing is ever abandoned half-written on a customer's tenant.
    /// </summary>
    private async Task RunBatchAsync(bool push)
    {
        var rows = SelectedRows();
        if (rows.Count == 0) return;

        _running = true;
        _stopRequested = false;
        _notice = null;
        _results.Clear();
        foreach (var row in rows) _results[row.EnvironmentId] = new RowResult("Waiting", "muted");

        var done = 0;
        var skipped = 0;
        var failed = 0;
        for (var i = 0; i < rows.Count; i++)
        {
            var row = rows[i];
            if (_stopRequested)
            {
                _results[row.EnvironmentId] = new RowResult("Stopped before this one", "muted");
                continue;
            }

            _progressText = $"Working through {i + 1} of {rows.Count}...";
            _results[row.EnvironmentId] = new RowResult(
                push ? "Moving the date..." : "Starting the update...", "busy");
            StateHasChanged();

            try
            {
                if (push) await Connection.PushUpdateDateToLatestAsync(row.ProjectId, row.EnvironmentId);
                else await Connection.RunUpdateNowAsync(row.ProjectId, row.EnvironmentId);
                _results[row.EnvironmentId] = new RowResult(
                    push ? "Date moved" : "Update started", "ok");
                done++;
            }
            catch (PlanValidationException ex)
            {
                _results[row.EnvironmentId] = new RowResult("Skipped - " + FirstMessage(ex), "muted");
                skipped++;
            }
            catch (ProjectAccessDeniedException ex)
            {
                _results[row.EnvironmentId] = new RowResult("Skipped - " + ex.Message, "muted");
                skipped++;
            }
            catch (Exception ex)
            {
                Log.LogError(ex,
                    "The upgrades page failed on environment {EnvironmentId} of project {ProjectId}.",
                    row.EnvironmentId, row.ProjectId);
                _results[row.EnvironmentId] = new RowResult("Didn't work - " + ex.Message, "bad");
                failed++;
            }

            StateHasChanged();
        }

        _running = false;
        _progressText = string.Empty;
        _notice = Summary(done, skipped, failed, push);

        // Re-read the fleet so the table shows what Business Central now says rather
        // than what we asked it for.
        var keep = _selected.ToList();
        await LoadAsync();
        foreach (var id in keep)
        {
            if (_actionableRows.Any(r => r.EnvironmentId == id)) _selected.Add(id);
        }
    }

    /// <summary>
    /// The one line above the table after a run. "Moved the date on 0 environments"
    /// is a sentence nobody wants to read, so a run that changed nothing leads with
    /// that instead of with a zero.
    /// </summary>
    private static string Summary(int done, int skipped, int failed, bool push)
    {
        var parts = new List<string>();
        if (done == 0)
        {
            parts.Add(push ? "No dates were moved" : "No updates were started");
        }
        else
        {
            var verb = push ? "Moved the date on" : "Started the update on";
            parts.Add($"{verb} {done} environment{(done == 1 ? "" : "s")}");
        }
        if (skipped > 0) parts.Add($"{skipped} skipped");
        if (failed > 0) parts.Add($"{failed} didn't work");
        return string.Join(", ", parts) + ".";
    }

    // ── Refresh ─────────────────────────────────────────────────────────

    private async Task RefreshDataAsync()
    {
        // With a selection, refresh those customers; with none, everything you can act
        // on - which is what someone starting their morning wants.
        var projectIds = _selected.Count > 0
            ? SelectedRows().Select(r => r.ProjectId).Distinct().ToList()
            : _actionableRows.Select(r => r.ProjectId).Distinct().ToList();

        if (projectIds.Count == 0)
        {
            _notice = "There is nothing here you can refresh.";
            return;
        }

        var result = await Fleet.RequestRefreshAsync(projectIds);
        var asked = result.Queued + result.AlreadyRunning;
        _notice =
            $"Asked Business Central about {asked} customer{(asked == 1 ? "" : "s")} - "
            + "the answers land in this table as they come back, so give it a minute and reload.";
    }

    // ── Wording ─────────────────────────────────────────────────────────

    /// <summary>
    /// When the environment's next update happens, in the same words the project
    /// page uses for the same fact - a person who reads both must not have to learn
    /// two vocabularies.
    /// </summary>
    private static string UpdateWhen(UpgradeFleetRow row)
    {
        if (row.NextUpdateDate is { } at) return $"scheduled for {at:yyyy-MM-dd HH:mm} UTC";
        return string.IsNullOrWhiteSpace(row.NextUpdateStatus) ? "no date set yet" : row.NextUpdateStatus;
    }

    private static string LatestText(UpgradeFleetRow row) =>
        row.NextUpdateLatestDate is { } latest ? DateText(latest) : "—";

    private static string DateText(DateTime? at) =>
        at is { } value ? value.ToString("yyyy-MM-dd") : "no date";

    private static string WhenText(DateTime? at) =>
        at is { } value ? value.ToString("yyyy-MM-dd") : "No date set";

    /// <summary>
    /// Why a selected row won't move, in the same words the service refuses with, so
    /// the preview and the run never disagree.
    /// </summary>
    private static string WhyNoPush(UpgradeFleetRow row)
    {
        if (!row.HasUpdate) return "no update is waiting";
        if (row.NextUpdateLatestDate is null) return "Business Central hasn't given it a last possible date";
        return "its date is already the latest allowed";
    }

    /// <summary>
    /// A mirror older than a day and a half has missed a nightly refresh, so the row
    /// is saying something nobody has checked since. Muted, not alarming: the answer
    /// is probably still right, it is just old.
    /// </summary>
    private static bool IsStale(UpgradeFleetRow row) =>
        row.FetchedAt is null || DateTime.UtcNow - row.FetchedAt.Value > TimeSpan.FromHours(36);

    private static string StatusPillTone(string? status) => BcEnvironmentStatus.Classify(status) switch
    {
        BcEnvironmentReadiness.Ready => "success",
        BcEnvironmentReadiness.Busy => "warn",
        BcEnvironmentReadiness.Deleting or BcEnvironmentReadiness.Failed => "danger",
        _ => "muted",
    };

    private static string FirstMessage(PlanValidationException ex) =>
        ex.Errors.Values.FirstOrDefault() ?? "Business Central refused the change.";

    /// <summary>One line in a confirm dialog's preview: who it is about, and what will happen to them.</summary>
    private sealed record PreviewItem(string Who, string What, bool Skipped);

    /// <summary>
    /// One row's live result during and after a run. The class is built here rather
    /// than interpolated into the markup, so every class name the page renders is a
    /// whole name a stylesheet can be checked against.
    /// </summary>
    private sealed record RowResult(string Text, string Tone)
    {
        public string CssClass => $"upg-note upg-note--{Tone}";
    }
}
