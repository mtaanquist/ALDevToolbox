@page "/teams"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using ALDevToolbox.Services
@using ALDevToolbox.Services.Organizations
@inject TeamService Teams

@*
    The teams the signed-in person is on. Deliberately only their own: an admin
    who wants the full list has Administration → Teams, and showing everyone
    every team here would bury the one thing this page is for. Admins get a
    quiet link across rather than a second list.

    Named user: a consultant who wants to check who else is on their team, or
    who — as its manager — needs to add somebody. No primary action: joining a
    team is not something you do to yourself.
    See .design/teams-and-visibility.md.
*@

<PageTitle>Your teams · AL Dev Toolbox</PageTitle>

<div class="page">
    <div class="page-head">
        <div>
            <h1 class="page-head__title">Your teams</h1>
            @* Says what a team is today. What it will *gate* belongs in the
               future tense until the visibility slice ships — see the design doc. *@
            <p class="page-head__sub">
                The teams you're on. A team groups the colleagues who work on the same customer.
                Open one to see who else is on it.
            </p>
        </div>
        @if (_canAdminister)
        {
            <div class="page-head__actions">
                <a class="btn" href="/admin/administration/teams">
                    <Icon Name="settings" Width="15" Height="15" />
                    <span>Manage all teams</span>
                </a>
            </div>
        }
    </div>

    @if (_teams is null)
    {
        <div class="loading-block"><span class="spinner"></span><span>Loading teams...</span></div>
    }
    else if (_teams.Count == 0)
    {
        <div class="card">
            <div class="empty-state">
                <span class="empty-state__icon"><Icon Name="users" Width="21" Height="21" /></span>
                <span class="empty-state__title">You're not on a team yet</span>
                @* The title carries the state; the body carries the way out of it.
                   Nothing here is self-service, so there is no button to offer. *@
                <span class="empty-state__text">
                    Ask an organisation admin to add you to the team for your customer.
                </span>
            </div>
        </div>
    }
    else
    {
        <table class="data-table">
            <thead>
                <tr>
                    <th scope="col">Team</th>
                    <th scope="col">Members</th>
                    <th scope="col">Managed by</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var team in _teams)
            {
                <tr>
                    <td><a href="/teams/@team.Id">@team.Name</a></td>
                    <td class="u-num">@team.MemberCount</td>
                    @* Names, not a count: "2" tells you nothing you can act on,
                       whereas a name tells you who to ask. *@
                    <td>
                        @if (team.ManagerNames.Count == 0)
                        {
                            <span class="u-muted">No manager yet</span>
                        }
                        else
                        {
                            @string.Join(", ", team.ManagerNames)
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    }
</div>

@code {
    private List<TeamListRow>? _teams;
    private bool _canAdminister;

    protected override async Task OnInitializedAsync()
    {
        _teams = await Teams.ListMyTeamsAsync();
        _canAdminister = await Teams.CanAdministerTeamsAsync();
    }
}
