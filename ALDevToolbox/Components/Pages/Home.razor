                            <span class="tool-tile__lock"><Icon Name="lock" Width="11" Height="11" /><span>Sign in</span></span>
                            <div class="tool-tile__body">
                                <div class="tool-tile__title">Templates</div>
                                <div class="tool-tile__text">Browse the runtime templates available for your organisation.</div>
