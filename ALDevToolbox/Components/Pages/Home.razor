                        </a>
                    }
                    @if (ToolAvailability.IsSiteEnabled(ToolKey.Piper))
                    {
                        <a class="tool-tile tool-tile--locked" href="/login?returnUrl=%2Fpiper">
                            <span class="tool-tile__icon"><Icon Name="git-merge" Width="19" Height="19" /></span>
                            <span class="tool-tile__lock"><Icon Name="lock" Width="11" Height="11" /><span>Sign in</span></span>
                            <div class="tool-tile__body">
