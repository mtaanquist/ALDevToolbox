</AuthorizeView>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }

    private HashSet<ToolKey> _orgDisabled = new();
    private ToolCounts _counts = ToolCounts.Empty;

    // OnInitializedAsync, not OnParametersSetAsync: cascading parameters are
    // supplied before initialisation, so the auth state is already here, and
    // this runs once per component rather than on every cascading notification.
    // The page is static SSR today, where the difference is invisible - but the
    // moment anyone adds @rendermode InteractiveServer, the old hook would fire
    // four DB queries onto the circuit's shared context on every notification,
    // which is the shape of issue #551.
    protected override async Task OnInitializedAsync()
    {
        if (AuthStateTask is null) return;
        var state = await AuthStateTask;
        _orgDisabled = EndpointHelpers.ReadDisabledTools(state.User);
        // Signed-out visitors have no organisation, so there is nothing to
        // count and the tenant filter would match nothing anyway.
        if (state.User.Identity?.IsAuthenticated == true)
        {
            _counts = await Dashboard.GetToolCountsAsync();
        }
    }

    // Site-enabled and not switched off for this org — mirrors the sidebar.
    private bool ToolVisible(ToolKey key) =>
        ToolAvailability.IsSiteEnabled(key) && !_orgDisabled.Contains(key);

    private string TemplatesMeta() => _counts.Templates == 0
        ? "None yet - ask an admin to import some"
        : Plural(_counts.Templates, "template");

    private string CookbookMeta() => _counts.Recipes == 0
        ? "No recipes yet - suggest the first one"
        : Plural(_counts.Recipes, "recipe");

    private string ObjectExplorerMeta() => _counts.Releases == 0
        ? "No BC releases yet - ask an admin to import one"
        : Plural(_counts.Releases, "BC release");

    private string ProjectsMeta() => _counts.Projects == 0
        ? "No solutions yet - add your first"
        : Plural(_counts.Projects, "solution");

    private static string Plural(int n, string noun) => $"{n:N0} {noun}{(n == 1 ? "" : "s")}";
}
