@page "/tools/mcp"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@rendermode InteractiveServer
@using ALDevToolbox.Domain.Tools
@using ALDevToolbox.Services
@using ALDevToolbox.Services.Mcp
@using ALDevToolbox.Components.Shared
@inject IMcpAvailability McpAvailability
@inject IHttpContextAccessor Http
@inject IJSRuntime JS
@inject NavigationManager Nav

<PageTitle>MCP · AL Dev Toolbox</PageTitle>

@*
    Page archetype 13 (setup steps): `.steps` / `.step` from pages-content.css,
    which retires this page's 190-line `Mcp.razor.css`. That sheet had been
    quietly broken for a while - `.mcp-step__number` and `.mcp-tab--active`
    painted themselves with `var(--blue)` and `var(--blue-50)`, and
    `.mcp-snippet` set `font-family: var(--mono)`; none of those three tokens
    survived the move to tokens.css, so the step numbers had no fill and the
    snippet was rendering in the body font.

    Step 1 is a genuine fork rather than a step - two ways to authenticate - so
    it keeps the two cards inside one step body. Steps 2 and 3 are the sequence
    the reader is actually walking.

    The tool table is `McpToolCatalog` rather than a literal: this page listed
    13 of the 38 registered tools and two names that no longer exist. See
    Components/Pages/Docs/McpDocs.razor for the same change and
    ALDevToolbox.Tests/Tools/McpToolCatalogTests.cs for the guard.

    The "switched off" state is belt-and-braces rather than the usual path: MCP
    is a toggleable tool, and ToolAccessGate 404s a disabled tool's routes before
    this page renders at all (verified - with mcp_enabled false, /tools/mcp is a
    404, not this card). It stays because the flag it reads is real and the guard
    is correct; do not go looking for how to see it on screen.

    NOT resolved here: issue #556, which asks whether this tool should be called
    "AI assistants" (as the Account page already calls it) rather than by its
    protocol acronym. That rename spans the sidebar, the launcher, ToolCatalog
    and this page, so it is its own change rather than a rider on the port.
*@

<div class="page">
    <header class="page-head">
        <div>
            <h1 class="page-head__title">Model Context Protocol</h1>
            <p class="page-head__sub">
                Connect an AI assistant so it can generate workspaces, search Business
                Central objects and read your recipes on your behalf.
            </p>
        </div>
        <div class="page-head__actions">
            <a class="btn" href="/docs/mcp">
                <Icon Name="book-open" Width="16" Height="16" />
                <span>Full setup guide</span>
            </a>
        </div>
    </header>

    @* No loading branch: OnInitialized reads a singleton and a header, both
       synchronously, so it has already run before the first render. The old
       one could not be reached. *@
    @if (!_mcpEnabled)
    {
        <div class="empty-state">
            <span class="empty-state__icon"><Icon Name="plug" Width="21" Height="21" /></span>
            <span class="empty-state__title">AI assistants are switched off here</span>
            <span class="empty-state__text">
                Nobody can connect an assistant to this site until an administrator
                turns the server on. Ask yours - there is nothing to set up on your
                side in the meantime.
            </span>
        </div>
    }
    else
    {
        <div class="steps">
            <div class="step">
                <span class="step__n">1</span>
                <span class="step__head"><span class="step__title">Choose how your assistant signs in</span></span>
                <span class="step__text">
                    Both end up as a Bearer token the assistant sends with every request.
                    Which one you need depends on the assistant.
                </span>
                <span class="step__body">
                    <div class="mcp-choice">
                        <div class="card">
                            <div class="card__head">
                                <span class="u-row">
                                    <Icon Name="key-round" Width="18" Height="18" />
                                    <span class="card__title">A personal access token</span>
                                </span>
                            </div>
                            <div class="card__body">
                                Quickest to set up, and what desktop and command-line
                                assistants use - VS Code, Claude Desktop, Cursor, Claude
                                Code. The token acts as you, with your organisation and
                                your role, and its full value is shown only once.
                            </div>
                            <div class="card__foot">
                                <a class="btn" href="/account?section=ai">
                                    <Icon Name="key-round" Width="16" Height="16" />
                                    <span>Manage tokens</span>
                                </a>
                            </div>
                        </div>

                        <div class="card">
                            <div class="card__head">
                                <span class="u-row">
                                    <Icon Name="plug" Width="18" Height="18" />
                                    <span class="card__title">A permission screen</span>
                                </span>
                            </div>
                            <div class="card__body">
                                No token to paste at all. Claude on the web and mobile,
                                and ChatGPT, add this server as a connector and ask you
                                to approve it once.
                            </div>
                            <div class="card__foot">
                                <a class="btn" href="/account?section=ai">
                                    <Icon Name="plug" Width="16" Height="16" />
                                    <span>Connected assistants</span>
                                </a>
                            </div>
                        </div>
                    </div>
                </span>
            </div>

            <div class="step">
                <span class="step__n">2</span>
                <span class="step__head"><span class="step__title">Add the server to your assistant</span></span>
                <span class="step__text">
                    Pick your client below, then paste the snippet into its config.
                    Replace <code>${TOKEN}</code> with the token from step 1, or leave it
                    for the connector flow to fill in.
                </span>
                <span class="step__body">
                    <span class="pill-tabs" role="tablist" aria-label="Client">
                        @foreach (var tab in Tabs)
                        {
                            <button type="button" role="tab"
                                    aria-selected="@(tab == _selectedTab ? "true" : "false")"
                                    class="pill-tab @(tab == _selectedTab ? "is-active" : "")"
                                    @onclick="() => Select(tab)">
                                @tab
                            </button>
                        }
                    </span>
                    <div class="codeblock">
                        <div class="codeblock__bar">
                            <span class="codeblock__lang">@CurrentLang</span>
                            @if (CurrentFile is { } file)
                            {
                                <span class="codeblock__name">@file</span>
                            }
                            <span class="codeblock__spacer"></span>
                            <button type="button" class="btn btn--sm copy-btn @(_copied ? "is-copied" : "")"
                                    @onclick="CopySnippetAsync">
                                <Icon Name="copy" Width="14" Height="14" />
                                <span>@(_copied ? "Copied" : "Copy")</span>
                            </button>
                        </div>
                        <pre class="codeblock__pre">@CurrentSnippet</pre>
                    </div>
                    <span class="step__text">@CurrentHint</span>
                </span>
            </div>

            <div class="step">
                <span class="step__n">3</span>
                <span class="step__head"><span class="step__title">Try it</span></span>
                <span class="step__text">
                    Reload your assistant, then ask it something only the toolbox can
                    answer. If it comes back with a real answer, you're connected.
                </span>
                <span class="step__body">
                    <ul class="mcp-prompts">
                        <li>"Make a new workspace for CRONUS using the default template."</li>
                        <li>"Which procedures touch the No. field on Sales Line in BC 28.1?"</li>
                        <li>"Walk me through what happens when you post a sales order in BC 28.1."</li>
                        <li>"Find me a recipe for posting validation overrides."</li>
                    </ul>
                </span>
            </div>
        </div>

        <section class="card">
            <div class="card__head">
                <div>
                    <p class="card__title">Every tool your assistant can use</p>
                    <p class="card__sub">
                        @McpToolCatalog.All.Count tools. You don't need to name them - the
                        assistant picks the right one.
                    </p>
                </div>
            </div>
            <div class="card__body">
                <table class="data-table">
                    <thead>
                        <tr><th>Tool</th><th>Reaches</th><th>What it does</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var tool in McpToolCatalog.All)
                        {
                            <tr>
                                <td><code>@tool.Name</code></td>
                                <td>@tool.Group</td>
                                <td>
                                    @tool.Blurb
                                    @if (tool.Writes)
                                    {
                                        @* &#160; rather than a literal space: Razor trims
                                           leading whitespace inside an element, so the
                                           marker rendered glued to the full stop. *@
                                        <strong>&#160;Changes something.</strong>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>

        <section class="card">
            <div class="card__head">
                <p class="card__title">If it isn't working</p>
            </div>
            <div class="card__body">
                <div class="note note--info">
                    <span class="note__icon"><Icon Name="info" Width="17" Height="17" /></span>
                    <span class="note__title">The server doesn't show up in my client</span>
                    <span class="note__body">
                        Check the URL is reachable from your machine and that the config
                        file is saved where your client looks for it. VS Code needs Copilot
                        agent mode switched on; Claude Desktop needs a restart after the
                        config changes.
                    </span>
                </div>
                <div class="note note--info">
                    <span class="note__icon"><Icon Name="info" Width="17" Height="17" /></span>
                    <span class="note__title">401 Unauthorized</span>
                    <span class="note__body">
                        The token is missing, expired or revoked. Issue a fresh one from
                        <a href="/account?section=ai">your account page</a> and update the
                        client.
                    </span>
                </div>
                <div class="note note--info">
                    <span class="note__icon"><Icon Name="info" Width="17" Height="17" /></span>
                    <span class="note__title">404 Not Found</span>
                    <span class="note__body">
                        Either the URL is wrong, or an administrator has switched the server
                        off since you set it up. Reload this page - if it tells you assistants
                        are off, that's the answer.
                    </span>
                </div>
            </div>
        </section>
    }
</div>

@code {
    private static readonly string[] Tabs = new[] { "VS Code", "Claude Desktop", "Cursor", "Claude Code" };

    private bool _mcpEnabled;
    private string _serverUrl = string.Empty;
    private string _selectedTab = "VS Code";
    private bool _copied;

    protected override void OnInitialized()
    {
        _mcpEnabled = McpAvailability.IsEnabled;
        var ctx = Http.HttpContext;
        if (ctx is not null)
        {
            _serverUrl = $"{ctx.Request.Scheme}://{ctx.Request.Host}/mcp";
        }
        else
        {
            // OnInitialized after the SSR pass - fall back to the URL the
            // page itself is on so the snippet still has a sensible default.
            var uri = new Uri(Nav.Uri);
            _serverUrl = $"{uri.Scheme}://{uri.Authority}/mcp";
        }
    }

    private void Select(string tab)
    {
        _selectedTab = tab;
        _copied = false;
    }

    private async Task CopySnippetAsync()
    {
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", CurrentSnippet);
        _copied = true;
    }

    private string CurrentSnippet => _selectedTab switch
    {
        "Claude Desktop" => ClaudeDesktopSnippet(_serverUrl),
        "Cursor" => CursorSnippet(_serverUrl),
        "Claude Code" => ClaudeCodeSnippet(_serverUrl),
        _ => VsCodeSnippet(_serverUrl),
    };

    private string CurrentLang => _selectedTab == "Claude Code" ? "shell" : "json";

    /// <summary>
    /// The file the snippet belongs in, shown on the code block's bar. Claude
    /// Code has none - it is a command you run, not a file you edit.
    /// </summary>
    private string? CurrentFile => _selectedTab switch
    {
        "Claude Desktop" => "claude_desktop_config.json",
        "Cursor" => "~/.cursor/mcp.json",
        "Claude Code" => null,
        _ => ".vscode/mcp.json",
    };

    private string CurrentHint => _selectedTab switch
    {
        "VS Code" => "Save this in your workspace and reload the window. Needs Copilot agent mode.",
        "Claude Desktop" => "Settings → Developer → Edit Config, then restart the app.",
        "Cursor" => "Cursor Settings → MCP, or edit the file directly. It reloads on its own.",
        "Claude Code" => "Run it in any project directory; Claude Code remembers it there.",
        _ => string.Empty,
    };

    private static string VsCodeSnippet(string url) => $$"""
        {
          "servers": {
            "aldevtoolbox": {
              "type": "http",
              "url": "{{url}}",
              "headers": {
                "Authorization": "Bearer ${TOKEN}"
              }
            }
          }
        }
        """;

    private static string ClaudeDesktopSnippet(string url) => $$"""
        {
          "mcpServers": {
            "aldevtoolbox": {
              "type": "http",
              "url": "{{url}}",
              "headers": {
                "Authorization": "Bearer ${TOKEN}"
              }
            }
          }
        }
        """;

    private static string CursorSnippet(string url) => $$"""
        {
          "mcpServers": {
            "aldevtoolbox": {
              "url": "{{url}}",
              "headers": {
                "Authorization": "Bearer ${TOKEN}"
              }
            }
          }
        }
        """;

    private static string ClaudeCodeSnippet(string url) =>
        $"claude mcp add aldevtoolbox \\\n  --transport http \\\n  --url {url} \\\n  --header \"Authorization: Bearer ${{TOKEN}}\"";
}
