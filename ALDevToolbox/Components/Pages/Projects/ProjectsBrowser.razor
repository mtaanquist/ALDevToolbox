@page "/solutions"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject ALDevToolbox.Services.ObjectExplorer.Projects.ArtifactService Artifacts
@inject IHttpContextAccessor Http
@inject CustomerModuleService CustomerModules
@inject ProjectCustomerInfoService CustomerInfo
@using ALDevToolbox.Components.Pages.Projects.Customer
@using ALDevToolbox.Domain.Entities.ObjectExplorer
@using ALDevToolbox.Services.ObjectExplorer.Projects

@*
    The Solutions directory: every customer/solution in the org, who owns it, how
    many repositories it pulls together, and the state of its newest build. This
    is the setup-and-trigger surface — open a solution to manage its repos and
    start a build; follow "Builds" to download the compiled .app deliverables in
    the Artifacts tool. Any signed-in user can create and browse; only a solution's
    owner (or an admin) can change or build it. See .design/artifacts.md.

    Named user: a BC consultant who wants to find a customer's solution and either
    download its latest build or set up a new one. Primary action: New solution.

    Archetype 2 (list / browser), table view. The latest build's status is the
    row's 4px edge keyline plus a leading glyph rather than a pill in a cell —
    the handoff's one rule for tables. A solution with no build yet gets neither:
    an absent build is not a status. Only a pipeline's builds count - a
    pull-request build the GitHub App ran is a check on a pull request, not the
    state of anything this list offers to download, so a solution without a
    pipeline shows no status however many of those have failed (the query in
    ArtifactService is where that line is drawn). Search stays a plain GET form, so the page
    needs no interactivity and a filtered result stays a shareable URL.
    See .design/design-migration.md.
*@

<PageTitle>Solutions · AL Workbench</PageTitle>

<ListPage Title="Solutions" SearchForm="true" Rail="@(_summary is null ? null : SummaryRail())" RailLabel="Customer info"
          IsLoading="@(_rows is null)" IsEmpty="@(_totalCount == 0)" HasNoMatches="@(_rows is { Count: 0 })"
          Trail='@([new("Home", "/"), new("Solutions")])'>
    <SubtitleContent>
        One solution per customer: what they run, how to reach them, and the repositories that
        build their extensions. Customer info shows the access notes, contacts and modules beside the list.
    </SubtitleContent>
    <Actions>
        <a class="btn btn--primary" href="/solutions/new">
            <Icon Name="plus" Width="16" Height="16" />
            <span>New solution</span>
        </a>
    </Actions>
    <Notices>
        @* The one interactive island on an otherwise static page: it asks GitHub
           what this person can see, which a GET-rendered page cannot do. It renders
           nothing at all unless the organisation has connected GitHub and the
           viewer has linked their account. See .design/github-integration-phase2.md. *@
        <UntrackedRepositoriesPanel @rendermode="InteractiveServer" />

        @* The second island: which tracked repositories still target an older
           Business Central than the newest release imported here, and the pull
           requests that move them on. Silent when nothing is behind.
           See .design/github-integration-phase2.md. *@
        <DependencyDriftPanel @rendermode="InteractiveServer" />
    </Notices>
    <Search>
        <input type="search" name="q" value="@_search" class="input"
               placeholder="Search by name, owner, or repository..."
               aria-label="Search solutions" />
    </Search>
    <SearchFormExtras>
        @* "Who has Document Capture?" - only once the organisation has a module catalogue.
           Inside the GET form so the answer is a shareable address; choosing one submits
           it, and without scripting Enter in the search box still does. *@
        @if (_modules.Count > 0)
        {
            <SelectBox style="width: 240px">
                <select class="select" name="module" aria-label="Filter by module" onchange="this.form.requestSubmit()">
                    <option value="">All solutions</option>
                    @foreach (var module in _modules)
                    {
                        <option value="@module.Id" selected="@(module.Id == _moduleId)">Has @module.Name</option>
                    }
                </select>
            </SelectBox>
        }
    </SearchFormExtras>
    <Loading>
        <table class="data-table data-table--edge">
            <thead>
                <tr>
                    <th class="data-table__col-state"><span class="u-sr">Latest build</span></th>
                    <th scope="col">Solution</th>
                    <th scope="col">Hosted by</th>
                    <th scope="col">BC version</th>
                    <th scope="col">Latest build</th>
                    <th scope="col">Owner</th>
                    <th scope="col" class="data-table__actions">Actions</th>
                </tr>
            </thead>
            <tbody><TableSkeletonRows Columns="6" /></tbody>
        </table>
        <LoadingBlock Text="Loading solutions..." UnderTable="true" />
    </Loading>
    <Empty>
        <div class="card">
            <EmptyState Icon="folder-git-2" Title="No solutions yet">
                <Text>
                    Create one and point it at the repositories that make up a customer's solution —
                    then build them into downloadable <code>.app</code> files.
                </Text>
                <Action>
                    <a class="btn btn--primary" href="/solutions/new">
                        <Icon Name="plus" Width="15" Height="15" />
                        <span>New solution</span>
                    </a>
                </Action>
            </EmptyState>
        </div>
    </Empty>
    <NoMatches>
        <div class="card">
            <EmptyState Icon="funnel-x" Title="@NoMatchTitle()">
                <Text>@(_moduleId is null ? "Try a shorter search term" : "Try another module or a shorter search term"), or clear it to see all @_totalCount.</Text>
                <Action><a class="btn" href="/solutions">@(_moduleId is null ? "Clear search" : "Show all solutions")</a></Action>
            </EmptyState>
        </div>
    </NoMatches>
    <ChildContent>
        <table class="data-table data-table--edge">
            <thead>
                <tr>
                    <th class="data-table__col-state"><span class="u-sr">Latest build</span></th>
                    <th scope="col">Solution</th>
                    <th scope="col">Hosted by</th>
                    <th scope="col">BC version</th>
                    <th scope="col">Latest build</th>
                    <th scope="col">Owner</th>
                    <th scope="col" class="data-table__actions">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in _rows ?? new())
                {
                    @if (p.IsLocked)
                    {
                        @* A private solution the viewer isn't on. Its name is here
                           so it doesn't just vanish — they can see it exists and
                           ask for access — and nothing else is, because owner,
                           status and counts all report activity on the customer. *@
                        <tr class="projects__locked" title="Private — visible to its team">
                            <td class="data-table__col-state">
                                <Icon Name="lock" Width="14" Height="14" />
                            </td>
                            <td><span>@p.Name</span></td>
                            <td colspan="4">Private — visible to its team</td>
                            <td class="data-table__actions"></td>
                        </tr>
                    }
                    else
                    {
                    var rowState = RowClass(p);
                    <tr class="@rowState">
                        <td class="data-table__col-state">
                            @if (p.Latest is { } b1)
                            {
                                <RowStateIcon State="@b1.Status" />
                            }
                        </td>
                        <td><a href="@($"/solutions/{p.Id}")"><strong>@p.Name</strong></a></td>
                        <td>@(_facts.GetValueOrDefault(p.Id)?.HostingType is { } hosting ? ShortHosting(hosting) : "—")</td>
                        <td>@(_facts.GetValueOrDefault(p.Id)?.BcVersion ?? "—")</td>
                        <td>
                            @if (p.Latest is { } b2)
                            {
                                @if (!string.IsNullOrEmpty(b2.BcVersion))
                                {
                                    <span>Built for <span class="code">BC @b2.BcVersion</span></span>
                                }
                                else
                                {
                                    <span class="u-muted">@LabelFor(b2.Status)</span>
                                }
                            }
                            else
                            {
                                <span class="u-muted">No builds yet</span>
                            }
                        </td>
                        <td class="u-muted">@(p.OwnerName ?? "—")</td>
                        <td class="data-table__actions">
                            @* The summary is a link, not a click handler: the page stays a plain
                               GET page, and a list with one customer's summary open is an address
                               that can be sent to a colleague. *@
                            <a class="btn btn--sm" href="@SummaryHref(p.Id)" aria-label="@($"Customer info for {p.Name}")"
                               aria-current="@(p.Id == _selectedId ? "true" : null)">
                                <Icon Name="eye" Width="14" Height="14" />
                                <span>Customer info</span>
                            </a>
                            <a class="btn btn--sm" href="@($"/solutions/{p.Id}")">
                                <Icon Name="settings" Width="14" Height="14" />
                                <span>Open</span>
                            </a>
                        </td>
                    </tr>
                    }
                }
            </tbody>
        </table>
    </ChildContent>
</ListPage>

@code {
    private List<ProjectArtifactsRow>? _rows;
    private int _totalCount;
    private string _search = string.Empty;
    private List<CatalogModule> _modules = new();
    private int? _moduleId;
    private Dictionary<int, CustomerListFacts> _facts = new();
    private int? _selectedId;
    private Summary? _summary;

    /// <summary>What the rail shows for the selected solution. Read only when one is selected.</summary>
    private sealed record Summary(string Name, CustomerInfoSnapshot Info, SolutionModules Modules);

    protected override async Task OnInitializedAsync()
    {
        _search = Http.HttpContext?.Request.Query["q"].ToString().Trim() ?? string.Empty;
        var all = await Artifacts.ListProjectsAsync();
        _totalCount = all.Count;
        _rows = string.IsNullOrEmpty(_search) ? all : await Artifacts.ListProjectsAsync(_search);

        _modules = await CustomerModules.ListCatalogAsync();
        if (int.TryParse(Http.HttpContext?.Request.Query["module"], out var moduleId) && _modules.Any(m => m.Id == moduleId))
        {
            // The rows are already the ones this person may see; the module only narrows them.
            _moduleId = moduleId;
            var having = await CustomerModules.ListProjectIdsWithModuleAsync(moduleId);
            _rows = _rows.Where(r => having.Contains(r.Id)).ToList();
        }

        _facts = await CustomerInfo.ListFactsAsync(_rows.Where(r => !r.IsLocked).Select(r => r.Id).ToList());

        // Only a row that is on screen and open to this person can be selected; anything
        // else in the address is ignored rather than answered.
        if (int.TryParse(Http.HttpContext?.Request.Query["selected"], out var selected)
            && _rows.FirstOrDefault(r => r.Id == selected && !r.IsLocked) is { } row
            && await CustomerInfo.GetAllAsync(selected) is { } info)
        {
            _selectedId = selected;
            _summary = new Summary(row.Name, info, await CustomerModules.GetSolutionModulesAsync(selected));
        }
    }

    /// <summary>
    /// The factboxes of the AL prototype this model came from: what support needs about
    /// the selected customer without leaving the list. It summarises and links; the
    /// Customer tab is the only place any of it is changed.
    /// </summary>
    private RenderFragment SummaryRail() => @<div class="sol-rail">
        <section class="card">
            <div class="card__head">
                <h2 class="card__title sol-rail__name">@_summary!.Name</h2>
                <a class="btn btn--sm btn--ghost" href="@SummaryHref(null)" aria-label="Close customer info">
                    <Icon Name="x" Width="14" Height="14" />
                </a>
            </div>
            <div class="card__body sol-rail__body">
                <div class="meta-item"><span class="meta-item__label">Hosted by</span><span class="sol-rail__value">@(_summary.Info.Basics.HostingType is { } h ? ProjectDetailCustomer.HostingText(h) : "Not recorded")</span></div>
                <div class="meta-item"><span class="meta-item__label">BC version</span><span class="sol-rail__value">@(_summary.Info.Basics.EffectiveVersion ?? "Not recorded")</span></div>
                @if (_summary.Info.Basics.EffectiveClientUrl is { } url)
                {
                    <div class="meta-item"><span class="meta-item__label">Business Central address</span><a class="sol-rail__value" href="@url" target="_blank" rel="noopener noreferrer">@url</a></div>
                }
                <a class="btn btn--sm" href="@($"/solutions/{_selectedId}")">Open solution</a>
            </div>
        </section>

        <section class="card">
            <div class="card__head"><h2 class="card__title">Getting in</h2></div>
            <div class="card__body sol-rail__body">
                @if (_summary.Info.Notes.AccessDescription is { } access)
                {
                    <p class="sol-rail__text">@access</p>
                }
                else
                {
                    <p class="u-muted sol-rail__text">Nobody has written down how to get in.</p>
                }
            </div>
        </section>

        <section class="card">
            <div class="card__head"><h2 class="card__title">Contacts</h2></div>
            <div class="card__body sol-rail__body">
                @if (_summary.Info.Contacts.Count == 0)
                {
                    <p class="u-muted sol-rail__text">No contacts yet.</p>
                }
                @foreach (var contact in _summary.Info.Contacts)
                {
                    <div class="sol-rail__item">
                        <span class="sol-rail__strong">@contact.Name</span>
                        <span class="u-muted">@CustomerContactsSection.TypeText(contact.Type)@(contact.Company is { } company ? $" - {company}" : "")</span>
                        @if (contact.Phone is { } phone)
                        {
                            <a href="@($"tel:{phone.Replace(" ", string.Empty)}")">@phone</a>
                        }
                        @if (contact.Email is { } email)
                        {
                            <a href="@($"mailto:{email}")">@email</a>
                        }
                    </div>
                }
            </div>
        </section>

        <section class="card">
            <div class="card__head"><h2 class="card__title">Modules</h2></div>
            <div class="card__body sol-rail__body">
                @if (_summary.Modules.Modules.Count == 0)
                {
                    <p class="u-muted sol-rail__text">No modules recorded for this customer.</p>
                }
                @foreach (var module in _summary.Modules.Modules)
                {
                    <div class="sol-rail__item">
                        <span class="sol-rail__strong">@module.Name</span>
                        <span class="u-num sol-rail__version">@(module.Version ?? "Version not recorded")</span>
                    </div>
                }
            </div>
        </section>

        <section class="card">
            <div class="card__head"><h2 class="card__title">Who knows this customer</h2></div>
            <div class="card__body sol-rail__body">
                @if (_summary.Info.People.Count == 0)
                {
                    <p class="u-muted sol-rail__text">Nobody is listed yet.</p>
                }
                @foreach (var person in _summary.Info.People)
                {
                    <div class="sol-rail__item">
                        <span class="sol-rail__strong">@person.Name</span>
                        <span class="u-muted">@CustomerPeopleSection.RoleText(person.Role)@(person.Areas is { } areas ? $" - {areas}" : "")</span>
                    </div>
                }
            </div>
        </section>

        <p class="u-muted sol-rail__foot">
            Something missing or out of date? It is kept on the solution's
            <a href="@($"/solutions/{_selectedId}")">Customer tab</a>.
        </p>
    </div>;

    private string RowClass(ProjectArtifactsRow p)
    {
        var state = p.Latest is { } s ? RowStateIcon.RowClass(s.Status) : null;
        return p.Id == _selectedId ? $"{state} is-selected".Trim() : state ?? string.Empty;
    }

    /// <summary>The list as it is now - search and module filter kept - with one solution's summary open, or closed.</summary>
    private string SummaryHref(int? id)
    {
        var parts = new List<string>();
        if (_search.Length > 0) parts.Add($"q={Uri.EscapeDataString(_search)}");
        if (_moduleId is { } module) parts.Add($"module={module}");
        if (id is { } selected) parts.Add($"selected={selected}");
        // No fragment: the rail is beside the list and sticky, and jumping to it scrolls the
        // page head out of view - the same bump in-page anchors gave the environment page.
        return parts.Count == 0 ? "/solutions" : "/solutions?" + string.Join("&", parts);
    }

    /// <summary>
    /// The column is narrow, so the hosting in a word or two; the Customer tab has the
    /// sentence. The words themselves moved to <see cref="ProjectHostingText"/> once the
    /// command palette started describing the same solution in a result row.
    /// </summary>
    private static string ShortHosting(ProjectHostingType hosting) => ProjectHostingText.Short(hosting);

    private string NoMatchTitle()
    {
        var module = _modules.FirstOrDefault(m => m.Id == _moduleId)?.Name;
        return (module, _search) switch
        {
            (null, _) => $"No solutions match \"{_search}\"",
            (_, "") => $"No solution has {module}",
            _ => $"No solution matching \"{_search}\" has {module}",
        };
    }

    /// <summary>
    /// Fallback for the "Latest build" cell when a build carries no BC version —
    /// a queued or failed build never got far enough to have one, so the cell
    /// says which, rather than sitting empty next to a coloured edge.
    /// </summary>
    private static string LabelFor(string status) => status switch
    {
        "ready" => "Ready",
        "failed" => "Failed",
        "building" => "Building",
        "queued" => "Queued",
        _ => status,
    };
}
