@page "/solutions"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject ALDevToolbox.Services.ObjectExplorer.ArtifactService Artifacts
@inject IHttpContextAccessor Http
@using ALDevToolbox.Services.ObjectExplorer

@*
    The Solutions directory: every customer/solution in the org, who owns it, how
    many repositories it pulls together, and the state of its newest build. This
    is the setup-and-trigger surface — open a solution to manage its repos and
    start a build; follow "Builds" to download the compiled .app deliverables in
    the Artifacts tool. Any signed-in user can create and browse; only a solution's
    owner (or an admin) can change or build it. See .design/artifacts.md.

    Named user: a BC consultant who wants to find a customer's solution and either
    download its latest build or set up a new one. Primary action: New solution.

    Archetype 2 (list / browser), table view. The latest build's status is the
    row's 4px edge keyline plus a leading glyph rather than a pill in a cell —
    the handoff's one rule for tables. A solution with no build yet gets neither:
    an absent build is not a status. Search stays a plain GET form, so the page
    needs no interactivity and a filtered result stays a shareable URL.
    See .design/design-migration.md.
*@

<PageTitle>Solutions · AL Dev Toolbox</PageTitle>

<div class="page">
    <div class="page-head">
        <div>
            <h1 class="page-head__title">Solutions</h1>
            <p class="page-head__sub">
                Each solution points at one or more Git repositories and builds them into a set of
                compiled <code>.app</code> files. Open one to manage its repositories and start a build.
            </p>
        </div>
        <div class="page-head__actions">
            <a class="btn btn--primary" href="/solutions/new">
                <Icon Name="plus" Width="16" Height="16" />
                <span>New solution</span>
            </a>
        </div>
    </div>

    @* The one interactive island on an otherwise static page: it asks GitHub
       what this person can see, which a GET-rendered page cannot do. It renders
       nothing at all unless the organisation has connected GitHub and the
       viewer has linked their account. See .design/github-integration-phase2.md. *@
    <UntrackedRepositoriesPanel @rendermode="InteractiveServer" />

    @* The second island: which tracked repositories still target an older
       Business Central than the newest release imported here, and the pull
       requests that move them on. Silent when nothing is behind.
       See .design/github-integration-phase2.md. *@
    <DependencyDriftPanel @rendermode="InteractiveServer" />

    @if (_rows is null)
    {
        <table class="data-table data-table--edge">
            <thead>
                <tr>
                    <th class="data-table__col-state"><span class="u-sr">Latest build</span></th>
                    <th scope="col">Solution</th>
                    <th scope="col">Owner</th>
                    <th scope="col">Repositories</th>
                    <th scope="col">Latest build</th>
                    <th scope="col" class="data-table__actions"></th>
                </tr>
            </thead>
            <tbody><TableSkeletonRows Columns="5" /></tbody>
        </table>
        <div class="loading-block loading-block--under-table">
            <span class="spinner"></span><span>Loading solutions...</span>
        </div>
    }
    else if (_totalCount == 0)
    {
        <div class="card">
            <div class="empty-state">
                <span class="empty-state__icon"><Icon Name="folder-git-2" Width="21" Height="21" /></span>
                <span class="empty-state__title">No solutions yet</span>
                <span class="empty-state__text">
                    Create one and point it at the repositories that make up a customer's solution —
                    then build them into downloadable <code>.app</code> files.
                </span>
                <a class="btn btn--primary empty-state__action" href="/solutions/new">
                    <Icon Name="plus" Width="15" Height="15" />
                    <span>New solution</span>
                </a>
            </div>
        </div>
    }
    else
    {
        <form method="get" class="filter-bar" role="search">
            <span class="search filter-bar__search">
                <Icon Name="search" Width="15" Height="15" Css="search__icon" />
                <input type="search" name="q" value="@_search" class="input"
                       placeholder="Search by name, owner, or repository..."
                       aria-label="Search solutions" />
            </span>
        </form>

        @if (_rows.Count == 0)
        {
            <div class="card">
                <div class="empty-state">
                    <span class="empty-state__icon"><Icon Name="funnel-x" Width="21" Height="21" /></span>
                    <span class="empty-state__title">No solutions match "@_search"</span>
                    <span class="empty-state__text">
                        Try a shorter search term, or clear it to see all @_totalCount.
                    </span>
                    <a class="btn empty-state__action" href="/solutions">Clear search</a>
                </div>
            </div>
        }
        else
        {
            <table class="data-table data-table--edge">
                <thead>
                    <tr>
                        <th class="data-table__col-state"><span class="u-sr">Latest build</span></th>
                        <th scope="col">Solution</th>
                        <th scope="col">Owner</th>
                        <th scope="col">Repositories</th>
                        <th scope="col">Latest build</th>
                        <th scope="col" class="data-table__actions"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in _rows)
                    {
                        @if (p.IsLocked)
                        {
                            @* A private solution the viewer isn't on. Its name is here
                               so it doesn't just vanish — they can see it exists and
                               ask for access — and nothing else is, because owner,
                               status and counts all report activity on the customer. *@
                            <tr class="projects__locked" title="Private — visible to its team">
                                <td class="data-table__col-state">
                                    <Icon Name="lock" Width="14" Height="14" />
                                </td>
                                <td><span>@p.Name</span></td>
                                <td colspan="3">Private — visible to its team</td>
                                <td class="data-table__actions"></td>
                            </tr>
                        }
                        else
                        {
                        <tr class="@(p.Latest is { } s ? RowStateIcon.RowClass(s.Status) : null)">
                            <td class="data-table__col-state">
                                @if (p.Latest is { } b1)
                                {
                                    <RowStateIcon State="@b1.Status" />
                                }
                            </td>
                            <td><a href="@($"/solutions/{p.Id}")"><strong>@p.Name</strong></a></td>
                            <td class="u-muted">@(p.OwnerName ?? "—")</td>
                            <td>@p.RepoCount repo@(p.RepoCount == 1 ? "" : "s")</td>
                            <td>
                                @if (p.Latest is { } b2)
                                {
                                    @if (!string.IsNullOrEmpty(b2.BcVersion))
                                    {
                                        <span class="code">BC @b2.BcVersion</span>
                                    }
                                    else
                                    {
                                        <span class="u-muted">@LabelFor(b2.Status)</span>
                                    }
                                }
                                else
                                {
                                    <span class="u-muted">No builds yet</span>
                                }
                            </td>
                            <td class="data-table__actions">
                                <a class="btn btn--sm" href="@($"/solutions/{p.Id}")">
                                    <Icon Name="settings" Width="14" Height="14" />
                                    <span>Open</span>
                                </a>
                            </td>
                        </tr>
                        }
                    }
                </tbody>
            </table>
        }
    }
</div>

@code {
    private List<ProjectArtifactsRow>? _rows;
    private int _totalCount;
    private string _search = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        _search = Http.HttpContext?.Request.Query["q"].ToString().Trim() ?? string.Empty;
        var all = await Artifacts.ListProjectsAsync();
        _totalCount = all.Count;
        _rows = string.IsNullOrEmpty(_search) ? all : await Artifacts.ListProjectsAsync(_search);
    }

    /// <summary>
    /// Fallback for the "Latest build" cell when a build carries no BC version —
    /// a queued or failed build never got far enough to have one, so the cell
    /// says which, rather than sitting empty next to a coloured edge.
    /// </summary>
    private static string LabelFor(string status) => status switch
    {
        "ready" => "Ready",
        "failed" => "Failed",
        "building" => "Building",
        "queued" => "Queued",
        _ => status,
    };
}
