@page "/solutions/new"
@page "/solutions/{Id:int}"
@attribute [Authorize]
@rendermode InteractiveServer
@inject ALDevToolbox.Services.ObjectExplorer.ProjectService Projects
@inject ALDevToolbox.Services.ObjectExplorer.PipelineService PipelinesSvc
@inject ALDevToolbox.Services.ObjectExplorer.ArtifactService Artifacts
@inject ALDevToolbox.Services.OrganizationConfigService Config
@inject ALDevToolbox.Services.TeamService Teams
@inject ALDevToolbox.Services.GitHub.GitHubRepositoryService GitHubRepos
@inject NavigationManager Nav
@inject ILogger<ProjectDetail> Log
@using ALDevToolbox.Domain.Entities.ObjectExplorer
@using ALDevToolbox.Domain.ValueObjects
@using ALDevToolbox.Domain.ValueObjects.ObjectExplorer
@using ALDevToolbox.Services
@using ALDevToolbox.Services.ObjectExplorer
@using ALDevToolbox.Services.GitHub

@*
    One solution's settings, grouped behind a left sub-nav so each concern loads on
    its own instead of one long scroll: General (name + localisation, with a
    read-only audit trail), Repositories, the Business Central connection, and the
    solution's Pipelines. Doubles as the create form (/solutions/new), which shows
    just General + Repositories until the solution exists.

    Only the owner or an org admin can edit or delete — the management sections are
    hidden for everyone else, who still sees the repositories read-only and can
    follow through to download builds. Named user: the BC consultant who owns a
    customer's solution, opening Settings to point it at a repo or wire up delivery.
    Primary action: Create solution on /solutions/new, Save solution once it exists.
    See .design/artifacts.md.

    Each tab is its own component - ProjectDetailGeneral, ProjectDetailRepositories,
    ProjectDetailBc, ProjectDetailPipelines, ProjectDetailAccess. What stays here is
    what the page is: the route, the load, the header, the tab strip, and the state
    more than one tab reads (the shared edit model behind one Save, and the loaded
    solution the header reports).
*@

<PageTitle>@(_header?.Name ?? (Id is null ? "New solution" : "Solution")) · Solutions · AL Dev Toolbox</PageTitle>

<div class="page">
    @if (_loading)
    {
        <div class="loading-block"><span class="spinner"></span><span>Loading solution...</span></div>
    }
    else if (_notFound)
    {
        <div class="empty-state">
            <span class="empty-state__icon"><Icon Name="package" Width="21" Height="21" /></span>
            <h1 class="empty-state__title">This solution doesn't exist</h1>
            <p class="empty-state__text">It may have been deleted. Head back to the list to pick another.</p>
            <a class="btn btn--primary empty-state__action" href="/solutions"><Icon Name="arrow-left" Width="16" Height="16" /><span>All solutions</span></a>
        </div>
    }
    else if (_providers.Count == 0)
    {
        <div class="empty-state">
            <span class="empty-state__icon"><Icon Name="package" Width="21" Height="21" /></span>
            <h1 class="empty-state__title">No source-control providers yet</h1>
            <p class="empty-state__text">
                Your organisation hasn't enabled any source-control providers, so solutions can't be built.
                An administrator turns them on under <a href="/admin/administration/repositories">Administration → Repositories</a>.
            </p>
            <a class="btn empty-state__action" href="/solutions"><Icon Name="arrow-left" Width="16" Height="16" /><span>All solutions</span></a>
        </div>
    }
    else
    {
        @* Archetype: PageDetail.dc.html - crumbs outside the head. No state
           pill: a solution has no run state of its own. *@
        <div class="page-head__crumbs">
            <a href="/solutions">Solutions</a>
            <Icon Name="chevron-right" Width="12" Height="12" />
            <span>@(Id is null ? "New solution" : _header?.Name)</span>
        </div>

        <div class="detail-head">
            <div>
                <div class="detail-head__title-row">
                    <h1 class="detail-head__title">@(Id is null ? "New solution" : _header?.Name)</h1>
                    @* Which fence this solution is behind, on every tab. Nothing for
                       Public - the default needs no telling, and a badge on every
                       solution would stop meaning anything. The title row already
                       exists for a marker beside the name. *@
                    @if (VisibilityBadge is { } badge)
                    {
                        @* No status dot: the pill is a label for a setting, not a
                           run state, and the dot beside a title reads as a divider. *@
                        <span class="status-pill status-pill--muted"><span>@badge</span></span>
                    }
                </div>
                <p class="page-head__sub">
                    @if (Id is not null)
                    {
                        @($"{_edit.Repos.Count} repositor{(_edit.Repos.Count == 1 ? "y" : "ies")}")
                        @if (_header?.OwnerName is { } owner)
                        {
                            <text> · @owner</text>
                        }
                    }
                    else
                    {
                        <text>Name the solution and add its repositories, then save.</text>
                    }
                </p>
            </div>
            <div class="page-head__actions">
                <a class="btn" href="/solutions">
                    <Icon Name="arrow-left" Width="15" Height="15" />
                    <span>All solutions</span>
                </a>
                @* Save solution applies to General + Repositories. The Business Central and
                   Pipelines sections have their own save/actions, so the header primary is
                   hidden there to avoid implying it would save those edits. *@
                @if (_canManage && _section is Section.General or Section.Repos)
                {
                    @if (_dirty)
                    {
                        <span class="form-actions__note">Unsaved changes</span>
                    }
                    <button type="button" class="btn btn--primary" @onclick="SaveAsync" disabled="@_saving">
                        <Icon Name="@(Id is null ? "plus" : "save")" Width="15" Height="15" />
                        <span>@(_saving ? "Saving..." : Id is null ? "Create solution" : "Save solution")</span>
                    </button>
                }
            </div>
        </div>

        @if (_message is not null)
        {
            <p class="alert alert--success" role="status"><Icon Name="circle-check" Width="16" Height="16" /><span>@_message</span></p>
        }
        @* Only the page-level failures ("_") stack up here; everything the user typed
           gets its error inline next to the field, the way the Access tab does. *@
        @if (_errors.TryGetValue("_", out var pageError))
        {
            <div class="alert alert--danger" role="alert">
                <p>@pageError</p>
            </div>
        }

        @if (!_canManage)
        {
            <p class="u-muted">
                You're viewing this solution. Only its owner@(_header?.OwnerName is { } ownerName ? $" ({ownerName})" : "") or an admin can change or build it — you can still
                <a href="@($"/pipelines/{Id}")">download its builds</a>.
            </p>
        }

        @*
            Horizontal section tabs, not the left rail this page used to carry:
            archetype 7 and every other settings family in the app (site-admin,
            Administration, Account) put them under the title. The tabs switch a
            section in page state rather than navigating, because General and
            Repositories share one Save - a real navigation between them would
            discard whatever the user had typed with no warning.
        *@
        <div class="settings">
            <div class="settings__tabs">
                <HeaderTabs Items="@SectionTabs" AriaLabel="Solution settings" />
            </div>

            <div class="settings__body @(ShowBcAside ? "" : "settings__body--wide")">
                @if (_section == Section.General)
                {
                    <ProjectDetailGeneral Id="Id"
                                          CanManage="_canManage"
                                          Saving="_saving"
                                          Edit="_edit"
                                          Errors="_errors"
                                          LoadedProject="_loadedProject"
                                          OwnerName="@_header?.OwnerName"
                                          SolutionName="@_header?.Name"
                                          OnDirty="MarkDirty"
                                          OnDelete="ConfirmDeleteAsync" />
                }
                else if (_section == Section.Repos)
                {
                    <ProjectDetailRepositories CanManage="_canManage"
                                               Saving="_saving"
                                               Edit="_edit"
                                               Providers="_providers"
                                               CanPickFromGitHub="_canPickFromGitHub"
                                               RepoErrors="_repoErrors"
                                               OnDirty="MarkDirty" />
                }
                else if (_section == Section.Bc && Id is not null && _canManage)
                {
                    <ProjectDetailBc Id="Id.Value" />
                }
                else if (_section == Section.Pipelines && Id is not null && _canManage)
                {
                    <ProjectDetailPipelines Id="Id.Value"
                                            SolutionName="@(_header?.Name ?? _edit.Name)"
                                            Pipelines="_pipelines"
                                            Saving="_saving" />
                }
                else if (_section == Section.Access && Id is not null && _canManage)
                {
                    <ProjectDetailAccess Id="Id.Value"
                                         AllTeams="_allTeams"
                                         Baseline="_accessBaseline"
                                         OnSaved="OnAccessSavedAsync" />
                }
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public int? Id { get; set; }

    private enum Section { General, Repos, Bc, Pipelines, Access }
    private Section _section = Section.General;

    /// <summary>
    /// Only the Business Central tab has anything to put in the 280px rail, and an
    /// empty rail would stop the other tabs' cards short of the page edge for no
    /// reason a reader could see - so the column is reserved per section, not per page.
    /// </summary>
    private bool ShowBcAside => _section == Section.Bc && Id is not null && _canManage;

    /// <summary>
    /// The section tab row. Every tab carries OnSelected rather than an Href:
    /// see the note above the markup - General and Repositories share one Save,
    /// so a real navigation between them would drop unsaved edits.
    ///
    /// Labels only, as archetype 7 renders them. The left rail this replaced
    /// also carried a repository count and a dot for the Business Central
    /// connection; the count is already in the page head's sub-line, and the
    /// dot is a deliberate loss rather than a badge bolted onto a tab row the
    /// design system renders as plain text.
    /// </summary>
    private List<HeaderTabs.HeaderTabItem> SectionTabs
    {
        get
        {
            var tabs = new List<HeaderTabs.HeaderTabItem>
            {
                Tab("General", Section.General),
                Tab("Repositories", Section.Repos),
            };

            if (Id is not null && _canManage)
            {
                tabs.Add(Tab("Business Central", Section.Bc));
                tabs.Add(Tab("Pipelines", Section.Pipelines));
                tabs.Add(Tab("Access", Section.Access));
                }

            return tabs;
        }
    }

    private HeaderTabs.HeaderTabItem Tab(string label, Section section) =>
        new(label, Href: null, IsActive: _section == section,
            OnSelected: EventCallback.Factory.Create(this, () => _section = section));

    /// <summary>
    /// The label beside the solution name, or null for Public. Read off the loaded
    /// solution so a viewer who can't manage it still sees why the page looks the
    /// way it does.
    /// </summary>
    private string? VisibilityBadge => _loadedProject?.Visibility switch
    {
        ProjectVisibility.Private => "Private",
        ProjectVisibility.ReadOnly => "Read-only",
        _ => null,
    };

    private bool _loading = true;
    private bool _notFound;
    private bool _saving;
    private bool _dirty;
    private bool _canManage;
    private string? _message;
    private Dictionary<string, string> _errors = new();

    private ProjectHeader? _header;
    private List<Pipeline> _pipelines = new();
    private List<RepositoryProvider> _providers = new();

    /// <summary>
    /// Whether this person can be offered repositories to pick from, rather than
    /// left to type a URL. False for an organisation on Azure DevOps only, one
    /// that has not connected a GitHub organisation, and anyone who has not
    /// connected their own GitHub account - all of which fall back to the field
    /// they already had. Answered from the database; GitHub is not asked.
    /// </summary>
    private bool _canPickFromGitHub;

    private EditModel _edit = new();

    // Access (visibility + teams). Read here with the solution and handed to the
    // Access tab, which owns the edit in progress and the write.
    private List<TeamListRow> _allTeams = new();
    private ProjectAccessSettings? _accessBaseline;

    private async Task LoadAccessAsync()
    {
        _allTeams = await Teams.ListTeamsAsync();
        _accessBaseline = await Projects.GetAccessAsync(Id!.Value);
    }

    /// <summary>
    /// After the Access tab saves: re-read the baseline (which puts its form back
    /// to what is now stored) and move the badge beside the solution name, because
    /// the level the whole page reports just changed.
    /// </summary>
    private async Task OnAccessSavedAsync(ProjectVisibility visibility)
    {
        await LoadAccessAsync();
        if (_loadedProject is not null) _loadedProject.Visibility = visibility;
    }

    protected override async Task OnInitializedAsync()
    {
        _providers = (await Config.GetAllowedProvidersAsync()).ToList();

        if (Id is null)
        {
            // Anyone may create. The creator becomes the owner.
            _canManage = true;
            // No seeded blank row: with none, the Repositories tab shows its empty
            // state and the "Add repository" button, which is what a first-time
            // user needs. A seeded row hid both and made the "0 added" pill lie.
            _edit = new EditModel();
        }
        else
        {
            await LoadAsync();
            if (!_notFound)
            {
                _canManage = await Projects.CanManageAsync(Id.Value);
                HydrateEdit();
                if (_canManage)
                {
                    await LoadAccessAsync();
                }
            }
        }
        await LoadGitHubAssistAsync();
        _loading = false;
    }

    /// <summary>
    /// Decides whether the Repositories tab can offer a list to pick from. Two
    /// reads and no call to GitHub, so a slow or unreachable GitHub cannot hold
    /// up the page - and a no is silent: someone who cannot use the picker is
    /// not shown machinery explaining why.
    /// </summary>
    private async Task LoadGitHubAssistAsync()
    {
        if (!_canManage || _notFound || !_providers.Contains(RepositoryProvider.GitHub)) return;
        try
        {
            _canPickFromGitHub = (await GitHubRepos.GetAccessAsync()).IsReady;
        }
        catch (Exception ex)
        {
            Log.LogWarning(ex, "Could not tell whether solution {ProjectId} can pick repositories from GitHub.", Id);
        }
    }

    private async Task LoadAsync()
    {
        try
        {
            var solution = await Projects.GetProjectAsync(Id!.Value);
            if (solution is null) { _notFound = true; return; }
            _header = await Artifacts.GetProjectHeaderAsync(Id.Value);
            _pipelines = await PipelinesSvc.ListPipelinesAsync(Id.Value);
            _loadedProject = solution;
        }
        catch (ProjectAccessDeniedException)
        {
            // A private solution this person isn't on the team for. The solutions
            // list already shows them its name; the detail page says no more than
            // that, so navigating straight here confirms nothing extra.
            _notFound = true;
        }
    }

    private Project? _loadedProject;

    private void HydrateEdit()
    {
        _edit = new EditModel
        {
            Name = _loadedProject!.Name,
            Country = _loadedProject.DefaultArtifactCountry ?? string.Empty,
            Repos = _loadedProject.Repositories
                .Select(r => new RepoRow { Provider = r.Provider, Url = r.Url, DisplayName = r.DisplayName })
                .ToList(),
        };
        _dirty = false;
    }

    private void MarkDirty() => _dirty = true;

    /// <summary>
    /// Per-row repository errors, so each message renders under the row it belongs to
    /// instead of stacking in a page-level alert that never names the row.
    /// </summary>
    private Dictionary<RepoRow, Dictionary<string, string>> _repoErrors = new();

    /// <summary>
    /// Re-keys the service's positional repository errors (<c>Repositories[i].Url</c>)
    /// onto the rows that were sent, and moves the user to the tab holding the first
    /// problem - otherwise an inline-only error can sit on a tab they can't see.
    /// </summary>
    private void SpreadRepoErrors(List<RepoRow> sent)
    {
        foreach (var (key, message) in _errors)
        {
            if (!key.StartsWith("Repositories[", StringComparison.Ordinal)) continue;
            var close = key.IndexOf(']');
            if (close < 0 || !int.TryParse(key.AsSpan(13, close - 13), out var i)) continue;
            if (i < 0 || i >= sent.Count) continue;
            var field = key[(close + 2)..];
            if (!_repoErrors.TryGetValue(sent[i], out var errs))
            {
                errs = new();
                _repoErrors[sent[i]] = errs;
            }
            errs[field] = message;
        }

        var generalProblem = _errors.ContainsKey("Name") || _errors.ContainsKey("DefaultArtifactCountry");
        if (generalProblem) _section = Section.General;
        else if (_repoErrors.Count > 0) _section = Section.Repos;
    }

    /// <summary>Up-to-two-letter avatar initials for the audit trail and header.</summary>
    private static string Initials(string name)
    {
        var parts = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 0) return "?";
        var letters = parts.Take(2).Select(p => char.ToUpperInvariant(p[0]));
        return string.Concat(letters);
    }

    private async Task SaveAsync()
    {
        if (_saving) return;
        _saving = true;
        _message = null;
        _errors = new();
        _repoErrors = new();
        // The rows actually sent, in order: the service keys repository errors by
        // position in this list, so it is what maps an error back to a visible row.
        var sent = _edit.Repos.Where(r => !r.IsBlank()).ToList();
        try
        {
            var repos = sent
                .Select(r => new ProjectRepositoryInput(r.Provider, r.Url, r.DisplayName))
                .ToList();
            var input = new ProjectInput(_edit.Name, string.IsNullOrWhiteSpace(_edit.Country) ? null : _edit.Country, repos);

            if (Id is null)
            {
                var newId = await Projects.CreateProjectAsync(input);
                Nav.NavigateTo($"/solutions/{newId}");
                return;
            }
            await Projects.UpdateProjectAsync(Id.Value, input);
            await LoadAsync();
            HydrateEdit();
            _message = "Solution saved.";
        }
        catch (PlanValidationException ex)
        {
            _errors = new(ex.Errors);
            SpreadRepoErrors(sent);
        }
        catch (ProjectAccessDeniedException)
        {
            _errors = new() { ["_"] = "Only the solution owner or an admin can change this solution." };
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "Failed to save solution {ProjectId}.", Id);
            _errors = new() { ["_"] = "An unexpected error occurred. The change was not saved." };
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task ConfirmDeleteAsync()
    {
        try
        {
            await Projects.SoftDeleteProjectAsync(Id!.Value);
            Nav.NavigateTo("/solutions");
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "Failed to delete solution {ProjectId}.", Id);
            _errors = new() { ["_"] = "Could not delete the solution." };
        }
    }

    /// <summary>
    /// The name and localisation the General tab edits and the repositories the
    /// Repositories tab edits, in one model because one Save writes both.
    /// Public so those two components can take it as a parameter; it is still
    /// this page's state.
    /// </summary>
    public sealed class EditModel
    {
        public string Name { get; set; } = string.Empty;
        public string Country { get; set; } = string.Empty;
        public List<RepoRow> Repos { get; set; } = new();
    }

    /// <summary>One row of the Repositories tab's table. Identity, not value, keys its errors.</summary>
    public sealed class RepoRow
    {
        public RepositoryProvider Provider { get; set; } = RepositoryProvider.GitHub;
        public string Url { get; set; } = string.Empty;
        public string DisplayName { get; set; } = string.Empty;
        public bool IsBlank() => string.IsNullOrWhiteSpace(Url) && string.IsNullOrWhiteSpace(DisplayName);
    }
}
