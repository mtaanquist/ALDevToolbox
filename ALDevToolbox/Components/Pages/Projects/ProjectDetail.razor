    // control rather than in the page-wide alert at the top.
    private List<TeamListRow> _allTeams = new();
    private AccessEdit _accessEdit = new();
    private ProjectAccessSettings? _accessBaseline;
    private bool _savingAccess;
    private string? _accessMessage;
    private Dictionary<string, string> _accessErrors = new();

    private sealed class AccessEdit
    {
        public ProjectVisibility Visibility { get; set; } = ProjectVisibility.Public;
        public HashSet<int> TeamIds { get; } = new();
    }

    /// <summary>
    /// True when the form differs from what was loaded. Gates the save so the
    /// button can't fire a write that changes nothing, and shows the discard
    /// action only when there is something to discard.
    /// </summary>
    private bool AccessDirty =>
        _accessBaseline is { } baseline
        && (_accessEdit.Visibility != baseline.Visibility
            || !_accessEdit.TeamIds.SetEquals(baseline.TeamIds));

    /// <summary>
    /// The three levels with the copy a solution owner reads, in the order they
    /// widen the fence. Labels say what the reader gets, not what the enum is
    /// called.
    /// </summary>
    /// <summary>
    /// The three levels with the copy a solution owner reads, in the order they
    /// tighten the fence. Each caption answers the same two questions in the same
    /// order - who can see it, then who can change it - so the reader compares
    /// three sentences rather than parsing three shapes. Public has no teams by
    /// the model's invariant, which is why only it says "you and the admins".
    /// </summary>
    private static readonly (ProjectVisibility Value, string Label, string Caption)[] VisibilityChoices =
    {
        (ProjectVisibility.Public, "Public",
            "Anyone in your organisation can see it and download its builds. Only you and the admins can change it."),
        (ProjectVisibility.ReadOnly, "Read-only for others",
            "Anyone can see it and download builds. Only the teams you pick below, you, and the admins can change it or run builds."),
        (ProjectVisibility.Private, "Private",
            "Only the teams you pick below, you, and the admins can see it. Everyone else sees just the name in the solution list."),
    };

    /// <summary>
    /// A team card's second line: who is actually on it. Picking the wrong team is
    /// the failure this tab exists to prevent, and two names catch it where a
    /// count does not. Falls back to the count for a team with nobody on it.
    /// </summary>
    private static string TeamRoster(TeamListRow team) =>
        team.MemberCount == 0 ? "No members yet" : team.MemberSummary();

    private void PickVisibility(ProjectVisibility visibility)
    {
        _accessEdit.Visibility = visibility;
        // Choosing Public clears the picks rather than keeping them greyed but
        // set: the service refuses Public-with-teams, and a disabled control
        // still holding values is a trap on the next save.
        if (visibility == ProjectVisibility.Public) _accessEdit.TeamIds.Clear();
    }

    private void ToggleTeam(int teamId, bool on)
    {
        if (on) _accessEdit.TeamIds.Add(teamId);
        else _accessEdit.TeamIds.Remove(teamId);
    }

    private async Task LoadAccessAsync()
    {
        _allTeams = await Teams.ListTeamsAsync();
        _accessBaseline = await Projects.GetAccessAsync(Id!.Value);
        ResetAccessEdit();
    }

    private void ResetAccessEdit()
    {
        var baseline = _accessBaseline ?? new ProjectAccessSettings(ProjectVisibility.Public, Array.Empty<int>());
        _accessEdit = new AccessEdit { Visibility = baseline.Visibility };
        foreach (var id in baseline.TeamIds) _accessEdit.TeamIds.Add(id);
    }

    private Task DiscardAccessAsync()
    {
        ResetAccessEdit();
        _accessErrors = new();
        _accessMessage = null;
        return Task.CompletedTask;
    }

    private async Task SaveAccessAsync()
    {
        if (_savingAccess) return;
        _savingAccess = true;
        _accessMessage = null;
        _accessErrors = new();
        try
        {
            await Projects.SetAccessAsync(Id!.Value, _accessEdit.Visibility, _accessEdit.TeamIds.ToList());
            await LoadAccessAsync();
            // Refresh the header badge: the level the whole page reports just moved.
            if (_loadedProject is not null) _loadedProject.Visibility = _accessEdit.Visibility;
            _accessMessage = "Access saved.";
        }
        catch (PlanValidationException ex)
        {
            _accessErrors = new(ex.Errors);
        }
        catch (ProjectAccessDeniedException)
        {
            _accessErrors = new() { ["Visibility"] = "Only the solution owner or an admin can change who sees this solution." };
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "Failed to save access for solution {ProjectId}.", Id);
            _accessErrors = new() { ["Visibility"] = "An unexpected error occurred. The change was not saved." };
        }
        finally
        {
            _savingAccess = false;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        _providers = (await Config.GetAllowedProvidersAsync()).ToList();

        if (Id is null)
        {
            // Anyone may create. The creator becomes the owner.
            _canManage = true;
            _edit = new EditModel { Repos = { new RepoRow { Provider = DefaultProvider } } };
        }
        else
        {
            await LoadAsync();
            if (!_notFound)
            {
                _canManage = await Projects.CanManageAsync(Id.Value);
                HydrateEdit();
                if (_canManage)
                {
                    await LoadBcAsync();
                    await LoadAccessAsync();
                }
            }
        }
        _loading = false;
    }

    private async Task LoadBcAsync()
    {
        _bc = await Connection.GetConnectionAsync(Id!.Value);
        _environments = (await Connection.ListEnvironmentsAsync(Id.Value)).ToList();
        HydrateBcEdit();
    }

    private void HydrateBcEdit()
    {
        _bcEdit = new BcEdit
        {
            TenantId = _bc?.TenantId?.ToString() ?? string.Empty,
            ClientId = _bc?.ClientId ?? string.Empty,
            Secret = string.Empty,
            SecretExpires = _bc?.SecretExpiresAt?.Date,
            TimeZone = _bc?.TimeZone ?? string.Empty,
        };
    }

    private async Task LoadAsync()
    {
        try
        {
            var solution = await Projects.GetProjectAsync(Id!.Value);
            if (solution is null) { _notFound = true; return; }
            _header = await Artifacts.GetProjectHeaderAsync(Id.Value);
            _pipelines = await PipelinesSvc.ListPipelinesAsync(Id.Value);
            _loadedProject = solution;
        }
        catch (ProjectAccessDeniedException)
        {
            // A private solution this person isn't on the team for. The solutions
            // list already shows them its name; the detail page says no more than
            // that, so navigating straight here confirms nothing extra.
            _notFound = true;
        }
    }

    private async Task NewPipelineAsync()
    {
        if (_editor is null || Id is null) return;
        await _editor.OpenForCreateAsync(Id.Value, _header?.Name ?? _edit.Name);
    }

    private void OnPipelineCreatedAsync(int pipelineId) => Nav.NavigateTo($"/pipelines/{pipelineId}");

    private Project? _loadedProject;

    private void HydrateEdit()
    {
        _edit = new EditModel
        {
            Name = _loadedProject!.Name,
            Country = _loadedProject.DefaultArtifactCountry ?? string.Empty,
            Repos = _loadedProject.Repositories
                .Select(r => new RepoRow { Provider = r.Provider, Url = r.Url, DisplayName = r.DisplayName })
                .ToList(),
        };
        _dirty = false;
    }

    private void MarkDirty() => _dirty = true;
    private void AddRepo() { _edit.Repos.Add(new RepoRow { Provider = DefaultProvider }); _dirty = true; }
    private void RemoveRepo(RepoRow row) { _edit.Repos.Remove(row); _dirty = true; }

    private RepositoryProvider DefaultProvider =>
        _providers.Contains(RepositoryProvider.GitHub) ? RepositoryProvider.GitHub
        : _providers.FirstOrDefault();

    /// <summary>
    /// One-line scope summary for a pipeline row: how many extensions it builds.
    /// A null/empty <see cref="Pipeline.RequestedAppIdsJson"/> means "build everything".
    /// </summary>
    private static string PipelineScope(Pipeline pl)
    {
        if (string.IsNullOrWhiteSpace(pl.RequestedAppIdsJson)) return "Builds all extensions";
        try
        {
            var ids = System.Text.Json.JsonSerializer.Deserialize<List<string>>(pl.RequestedAppIdsJson);
            var n = ids?.Count ?? 0;
            return n == 0 ? "Builds all extensions" : $"Builds {n} selected extension{(n == 1 ? "" : "s")}";
        }
        catch
        {
            return "Builds selected extensions";
        }
    }

    /// <summary>Up-to-two-letter avatar initials for the audit trail and header.</summary>
    private static string Initials(string name)
    {
        var parts = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 0) return "?";
        var letters = parts.Take(2).Select(p => char.ToUpperInvariant(p[0]));
        return string.Concat(letters);
    }

    private async Task SaveAsync()
    {
        if (_saving) return;
        _saving = true;
        _message = null;
        _errors = new();
        try
        {
            var repos = _edit.Repos.Where(r => !r.IsBlank())
                .Select(r => new ProjectRepositoryInput(r.Provider, r.Url, r.DisplayName))
                .ToList();
            var input = new ProjectInput(_edit.Name, string.IsNullOrWhiteSpace(_edit.Country) ? null : _edit.Country, repos);

            if (Id is null)
            {
                var newId = await Projects.CreateProjectAsync(input);
                Nav.NavigateTo($"/solutions/{newId}");
                return;
            }
            await Projects.UpdateProjectAsync(Id.Value, input);
            await LoadAsync();
            HydrateEdit();
            _message = "Solution saved.";
        }
        catch (PlanValidationException ex)
        {
            _errors = new(ex.Errors);
        }
        catch (ProjectAccessDeniedException)
        {
            _errors = new() { ["_"] = "Only the solution owner or an admin can change this solution." };
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "Failed to save solution {ProjectId}.", Id);
            _errors = new() { ["_"] = "An unexpected error occurred. The change was not saved." };
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task ConfirmDeleteAsync()
    {
        try
        {
            await Projects.SoftDeleteProjectAsync(Id!.Value);
            Nav.NavigateTo("/solutions");
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "Failed to delete solution {ProjectId}.", Id);
            _errors = new() { ["_"] = "Could not delete the solution." };
            _confirmingDelete = false;
        }
    }

    private async Task SaveBcAsync()
    {
        if (_bcSaving) return;
        _bcSaving = true;
        _bcMessage = null;
        _bcErrors = new();
        try
        {
            Guid? tenant = null;
            if (!string.IsNullOrWhiteSpace(_bcEdit.TenantId))
            {
                if (Guid.TryParse(_bcEdit.TenantId.Trim(), out var g)) tenant = g;
                else _bcErrors["BcTenantId"] = "That doesn't look like a tenant ID. It should look like 00000000-0000-0000-0000-000000000000.";
            }
            if (_bcErrors.Count == 0)
            {
                var expires = _bcEdit.SecretExpires is { } d ? DateTime.SpecifyKind(d, DateTimeKind.Utc) : (DateTime?)null;
                var input = new BcConnectionInput(
                    tenant,
                    _bcEdit.ClientId,
                    string.IsNullOrWhiteSpace(_bcEdit.Secret) ? null : _bcEdit.Secret,
                    expires,
                    string.IsNullOrWhiteSpace(_bcEdit.TimeZone) ? null : _bcEdit.TimeZone);
                await Connection.SaveConnectionAsync(Id!.Value, input);
                await LoadBcAsync();
                _bcOk = true;
                _bcMessage = "Connection saved. Test it to fetch this customer's environments.";
            }
        }
        catch (PlanValidationException ex)
        {
            _bcErrors = new(ex.Errors);
        }
        catch (ProjectAccessDeniedException)
        {
            _bcErrors = new() { ["_"] = "Only the solution owner or an admin can change the connection." };
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "Failed to save BC connection for solution {ProjectId}.", Id);
            _bcErrors = new() { ["_"] = "An unexpected error occurred. The connection was not saved." };
        }
        finally
        {
            _bcSaving = false;
        }
    }

    private async Task TestConnectionAsync()
    {
        if (_bcTesting) return;
        _bcTesting = true;
        _bcMessage = null;
        _bcErrors = new();
        try
        {
            var result = await Connection.TestConnectionAsync(Id!.Value);
            _bcOk = result.IsSuccess;
            _bcMessage = result.Message;
            await LoadBcAsync();
        }
        catch (ProjectAccessDeniedException)
        {
            _bcErrors = new() { ["_"] = "Only the solution owner or an admin can test the connection." };
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "Failed to test BC connection for solution {ProjectId}.", Id);
            _bcErrors = new() { ["_"] = "An unexpected error occurred while testing the connection." };
        }
        finally
        {
            _bcTesting = false;
        }
    }

    private int? _windowEditEnvId;
    private TimeOnly? _winStart;
    private TimeOnly? _winEnd;
    private string? _windowError;

    /// <summary>
    /// The environments header pill: how many, and how fresh. The statuses and versions
    /// in the table are only as good as the last fetch, so the count alone would invite
    /// trusting a stale row. Uses the newest <c>FetchedAt</c> across the rows, since a
    /// Refresh stamps them together.
    /// </summary>
    private string EnvironmentsSummary()
    {
        var count = _environments.Count;
        var noun = count == 1 ? "environment" : "environments";
        var newest = _environments.Max(e => e.FetchedAt);
        return $"{count} {noun} · checked {ALDevToolbox.Components.Shared.RelativeTime.Ago(newest)}";
    }

    /// <summary>
    /// The row's state family, from what Business Central says the environment is doing.
    /// An unknown status takes the neutral not-connected state rather than the green
    /// tick: we haven't checked, and "we don't know" must not read as "ready". The
    /// delivery gate still lets an unknown status through — that's deliberate, and this
    /// is presentation only.
    /// </summary>
    private static string EnvRowState(string? status) => BcEnvironmentStatus.Classify(status) switch
    {
        BcEnvironmentReadiness.Busy => "running",
        BcEnvironmentReadiness.Deleting or BcEnvironmentReadiness.Failed => "failed",
        BcEnvironmentReadiness.Unknown => "not-connected",
        _ => "connected",
    };

    /// <summary>Reads a machine-cased status as a sentence; shared with the release-pipeline editor.</summary>
    private static string HumaniseStatus(string? status) => BcEnvironmentStatus.Humanise(status);

    /// <summary>
    /// What a non-ready status means for the thing the consultant came to do. The pill
    /// names the state; this names the consequence.
    /// </summary>
    private static string? EnvStatusConsequence(string? status) => BcEnvironmentStatus.Classify(status) switch
    {
        BcEnvironmentReadiness.Busy => "Deliveries are paused while this upgrades.",
        BcEnvironmentReadiness.Deleting => "Deliveries are refused while this is being removed.",
        BcEnvironmentReadiness.Failed => "Deliveries are refused until this is fixed in Business Central.",
        _ => null,
    };

    /// <summary>
    /// The accessible name for the row's state glyph, and its hover title — why this row
    /// is the colour it is. Sighted users can't discover a glyph's meaning by looking at
    /// it, so the same sentence is the tooltip.
    /// </summary>
    private static string EnvRowLabel(ProjectEnvironmentRow env, bool gone)
    {
        if (gone) return "No longer present in Business Central";
        var shown = HumaniseStatus(env.Status);
        return BcEnvironmentStatus.Classify(env.Status) switch
        {
            BcEnvironmentReadiness.Busy => $"Busy in Business Central ({shown}) - deliveries are paused",
            BcEnvironmentReadiness.Deleting => $"Being removed in Business Central ({shown}) - deliveries are refused",
            BcEnvironmentReadiness.Failed => $"In a failed state in Business Central ({shown}) - deliveries are refused",
            BcEnvironmentReadiness.Unknown => "Not checked yet - refresh to see whether this is ready",
            _ => "Ready to deliver to",
        };
    }

    /// <summary>
    /// Pill tone for an environment's Business Central status, so a consultant can tell
    /// at a glance whether a release will go through. Classification lives in
    /// <see cref="BcEnvironmentStatus"/> — the same one the delivery gate uses, so the
    /// badge and the refusal never disagree.
    /// </summary>
    private static string StatusPillTone(string? status) => BcEnvironmentStatus.Classify(status) switch
    {
        BcEnvironmentReadiness.Ready => "success",
        BcEnvironmentReadiness.Busy => "warn",
        BcEnvironmentReadiness.Deleting or BcEnvironmentReadiness.Failed => "danger",
        _ => "muted",
    };

    /// <summary>The window summary shown under an environment's name.</summary>
    /// <summary>
    /// Opens the environment panel, or closes it if it is already open. Opening always
    /// re-reads: the panel's whole point is that it says what is true now.
    /// </summary>
    private async Task TogglePanelAsync(int environmentId)
    {
        if (_panelEnvId == environmentId)
        {
            _panelEnvId = null;
            _panel = null;
            _panelError = null;
            return;
        }
        _panelEnvId = environmentId;
        await LoadPanelAsync(environmentId);
    }

    /// <summary>
    /// This environment's upgrade history — who moved its update dates and what is still
    /// booked. Null while the panel is loading. See <c>.design/saas-delivery.md</c>.
    /// </summary>
    private List<ALDevToolbox.Services.ObjectExplorer.Bc.UpgradeActionRow>? _activity;

    /// <summary>True when this person may cancel a booked update here — the environment-updates grant, not solution-manage.</summary>
    private bool _canManageUpdates;

    private async Task LoadPanelAsync(int environmentId)
    {
        _panelLoading = true;
        _panelError = null;
        _panel = null;
        _activity = null;
        StateHasChanged();
        try
        {
            // Ours first, and outside the try that follows: the history is in our own
            // database, so it must not be lost to a tenant that won't answer. Cancelling
            // a booked update rides the environment-updates grant, which is a different
            // axis from managing the solution — a consultant can manage this customer
            // without being on the upgrade team, and vice versa.
            _canManageUpdates = await Access.CanManageEnvironmentUpdatesAsync(Id!.Value);
            _activity = await UpgradeActions.ListEnvironmentActivityAsync(Id!.Value, environmentId);

            _panel = await Connection.GetEnvironmentPanelAsync(Id!.Value, environmentId);
            _cadence = BcAppUpdateCadence.Normalize(
                _environments.FirstOrDefault(e => e.Id == environmentId)?.AppSourceAppsUpdateCadence)
                ?? BcAppUpdateCadence.Default;
            _targetVersion = string.Empty;
            _settingError = null;
            _m365 = await Connection.GetM365AccessAsync(Id!.Value, environmentId);
        }
        catch (PlanValidationException ex)
        {
            _panelError = ex.Errors.Values.FirstOrDefault() ?? "Couldn't read this environment.";
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "Failed to read the environment panel for {EnvId}.", environmentId);
            _panelError = "Couldn't read this environment from Business Central.";
        }
        finally
        {
            _panelLoading = false;
        }
    }

    /// <summary>
    /// Cancels an update booked for a later slot, from the environment's history. A
    /// cancel that loses the race with the update actually starting comes back as a plain
    /// refusal, shown where the other panel messages are; either way the history is
    /// re-read so the panel says what is now true.
    /// </summary>
    private async Task CancelUpgradeActionAsync(int actionId, int environmentId)
    {
        try
        {
            await UpgradeActions.CancelUpgradeActionAsync(actionId);
            _settingError = null;
            _settingDone = "The booked update was cancelled.";
        }
        catch (PlanValidationException ex)
        {
            _settingError = ex.Errors.Values.FirstOrDefault() ?? "Couldn't cancel that.";
        }
        catch (ProjectAccessDeniedException ex)
        {
            _settingError = ex.Message;
        }

        _activity = await UpgradeActions.ListEnvironmentActivityAsync(Id!.Value, environmentId);
    }

    /// <summary>
    /// Cancels one scheduled install, behind a confirm — it deletes the uploaded package
    /// in Business Central, so the version has to be released again afterwards.
    /// </summary>
    private async Task CancelScheduledAsync(int environmentId, Guid appId, BcScheduledPteOperation op)
    {
        if (_cancelInstallConfirm is null) return;
        var name = string.IsNullOrWhiteSpace(op.Name) ? "this extension" : op.Name;
        var confirmed = await _cancelInstallConfirm.OpenAsync(
            "Cancel this scheduled install?",
            $"Business Central will drop the copy of {name} {op.TargetAppVersion} it is holding for this environment. "
            + "To install it later you'll have to release it again.",
            "Cancel the install");
        if (!confirmed) return;

        try
        {
            await Connection.CancelScheduledInstallAsync(
                Id!.Value, environmentId, appId, op.TargetAppVersion, op.ScheduleKind ?? string.Empty);
            await LoadPanelAsync(environmentId);
        }
        catch (PlanValidationException ex)
        {
            _panelError = ex.Errors.Values.FirstOrDefault() ?? "Couldn't cancel the scheduled install.";
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "Failed to cancel a scheduled install on {EnvId}.", environmentId);
            _panelError = "Couldn't cancel the scheduled install.";
        }
    }

    /// <summary>
    /// Changes how often the customer's AppSource apps update. Confirmed because it is a
    /// write to their tenant, even though it is the mildest of the three.
    /// </summary>
    private async Task SaveCadenceAsync(ProjectEnvironmentRow env)
    {
        if (_settingConfirm is null) return;
        var chosen = _cadence;
        var confirmed = await _settingConfirm.OpenAsync(
            "Change the AppSource update cadence?",
            BcAppUpdateCadence.ConfirmSentence(chosen, env.Name),
            "Change cadence", "btn--primary");
        if (!confirmed) return;

        await RunSettingWriteAsync(env.Id, "cadence",
            () => Connection.SetAppUpdateCadenceAsync(Id!.Value, env.Id, chosen),
            $"Couldn't change the update cadence on {env.Name}. Check the app still has admin access in the Business Central admin center, then try again.",
            () => $"Business Central now updates AppSource apps on {env.Name}: {BcAppUpdateCadence.Display(chosen)}.");
    }

    /// <summary>Turns Microsoft 365 licence sign-in on or off — it changes who can get in.</summary>
    private async Task SaveM365Async(ProjectEnvironmentRow env, bool enable)
    {
        if (_settingConfirm is null) return;
        var confirmed = await _settingConfirm.OpenAsync(
            enable ? "Allow Microsoft 365 sign-in?" : "Stop allowing Microsoft 365 sign-in?",
            enable
                ? $"Anyone in the customer's organisation with a Microsoft 365 licence will be able to sign in to {env.Name} and read data there."
                : $"People who hold only a Microsoft 365 licence will lose access to {env.Name}. Anyone with a Business Central licence keeps theirs.",
            enable ? "Allow it" : "Stop allowing it",
            enable ? "btn--primary" : "btn--danger");
        if (!confirmed) return;

        await RunSettingWriteAsync(env.Id, "m365",
            () => Connection.SetM365AccessAsync(Id!.Value, env.Id, enable),
            $"Couldn't change Microsoft 365 licence access on {env.Name}. Check the app still has admin access in the Business Central admin center, then try again.",
            () => enable
                ? $"Business Central now allows Microsoft 365 licence sign-in on {env.Name}."
                : $"Business Central no longer allows Microsoft 365 licence sign-in on {env.Name}.");
    }

    /// <summary>
    /// Reschedules the customer's platform upgrade. The most consequential button on the
    /// page, so the confirm names the environment, says out loud when it is a production
    /// one, and states which version it is moving from and to.
    /// </summary>
    private async Task SaveTargetVersionAsync(ProjectEnvironmentRow env, BcEnvironmentPanel panel)
    {
        if (_settingConfirm is null || string.IsNullOrEmpty(_targetVersion)) return;

        var version = _targetVersion;
        var current = panel.EnvironmentUpdates.FirstOrDefault(u => u.Selected)?.TargetVersion;
        var isProduction = string.Equals(env.Type, "Production", StringComparison.OrdinalIgnoreCase);
        // Only worth saying "instead of X" when X is a different version; the picker
        // already refuses the one that is queued, so this is belt and braces.
        var from = current is null || string.Equals(current, version, StringComparison.OrdinalIgnoreCase)
            ? ""
            : $" instead of {current}";

        // When the upgrade actually happens is the thing a consultant is answering for
        // the customer, so say it if Business Central told us.
        var chosenRow = panel.EnvironmentUpdates.FirstOrDefault(u =>
            string.Equals(u.TargetVersion, version, StringComparison.OrdinalIgnoreCase));
        var when = chosenRow?.SelectedDateTime is { } at
            ? $"Microsoft runs the upgrade on {at.UtcDateTime:yyyy-MM-dd HH:mm} UTC"
            : "Microsoft runs the upgrade in this environment's update window";

        var confirmed = await _settingConfirm.OpenAsync(
            isProduction ? $"Reschedule the update on {env.Name}, a production environment?" : $"Reschedule the update on {env.Name}?",
            $"{env.Name} ({env.Type}) will update to Business Central {version}{from}. "
            + $"{when}, and the environment is unavailable while it does.",
            $"Schedule {version}");
        if (!confirmed) return;

        await RunSettingWriteAsync(env.Id, "version",
            () => Connection.SelectTargetVersionAsync(Id!.Value, env.Id, version),
            $"Couldn't schedule the update on {env.Name}. Check the app still has admin access in the Business Central admin center, then try again.",
            () => $"Business Central now shows {version} as the next update for {env.Name}.");
    }

    /// <summary>
    /// Runs one settings write with a loading state, then re-reads the panel so the page
    /// shows what the tenant now says rather than what we asked for.
    /// </summary>
    private async Task RunSettingWriteAsync(
        int environmentId, string busyKey, Func<Task> write, string failureMessage, Func<string> successMessage)
    {
        _settingSaving = true;
        _settingBusy = busyKey;
        _settingError = null;
        _settingDone = null;
        StateHasChanged();
        try
        {
            await write();
            // Re-read before claiming anything: the line the user reads afterwards
            // describes what Business Central now reports, not what we asked for.
            await LoadBcAsync();
            await LoadPanelAsync(environmentId);
            _settingDone = successMessage();
        }
        catch (PlanValidationException ex)
        {
            // The service's own message is more specific when it has one (an unavailable
            // version, a rejected value); the generic line names the setting and the fix.
            _settingError = ex.Errors.Values.FirstOrDefault() ?? failureMessage;
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "An environment settings write failed for {EnvId}.", environmentId);
            _settingError = failureMessage;
        }
        finally
        {
            _settingSaving = false;
            _settingBusy = null;
        }
    }

    /// <summary>When a scheduled install will actually run, in the words the picker uses.</summary>
    private static string ScheduleWhen(string? scheduleKind) =>
        BcDeploymentSchedule.Normalize(scheduleKind) is { } known
            ? DeliveryModeDisplay.Schedule(known).ToLowerInvariant()
            : "waiting";

    /// <summary>Microsoft's plan for a target version, in one phrase.</summary>
    private static string UpdateWhen(BcEnvironmentUpdate update)
    {
        if (!update.Available)
        {
            return update.ExpectedAvailability is { } when ? $"expected {when}" : "not released yet";
        }
        if (update.SelectedDateTime is { } at) return $"scheduled for {at.UtcDateTime:yyyy-MM-dd HH:mm} UTC";
        return string.IsNullOrWhiteSpace(update.UpdateStatus) ? "available" : update.UpdateStatus;
    }

    private static string WindowText(ProjectEnvironmentRow env) =>
        env.UpdateWindowStart is { } s && env.UpdateWindowEnd is { } e
            ? $"{s:HH\\:mm}–{e:HH\\:mm}"
            : "any time";

    /// <summary>
    /// Microsoft's update window for the environment, in its own zone. Deliberately
    /// worded and placed apart from the delivery window: this one is not ours to set,
    /// and reading them as the same thing is the mistake the whole column exists to
    /// prevent.
    /// </summary>
    private string BcWindowText(ProjectEnvironmentRow env)
    {
        if (env.BcUpdateWindowFetchedAt is null) return "not read yet";
        if (env.BcUpdateWindowStart is not { } s || env.BcUpdateWindowEnd is not { } e) return "no window set";

        var zone = BcUpdateWindow.ResolveDisplayZone(env.BcUpdateWindowTimeZoneIana, _bc?.TimeZone);
        var label = ZoneLabel(zone, env.BcUpdateWindowTimeZoneIana);
        return $"{s:HH\\:mm}–{e:HH\\:mm} ({label})";
    }

    /// <summary>
    /// The city half of an IANA id (<c>Europe/Copenhagen</c> → <c>Copenhagen</c>), which
    /// is what a consultant recognises. Falls back to naming the fallback honestly when
    /// the Windows id had no mapping, so a wrong-looking time is explicable.
    /// </summary>
    private string ZoneLabel(TimeZoneInfo zone, string? bcIana)
    {
        if (!string.IsNullOrWhiteSpace(bcIana))
        {
            var city = bcIana.Contains('/') ? bcIana[(bcIana.LastIndexOf('/') + 1)..] : bcIana;
            return city.Replace('_', ' ');
        }
        return string.IsNullOrWhiteSpace(_bc?.TimeZone) ? "UTC" : "this solution's time zone";
    }

    /// <summary>
    /// Warns when the delivery window overlaps Microsoft's update window — a release
    /// aimed into Microsoft's maintenance hours is exactly what the environment-status
    /// check then refuses, and finding that out at 22:00 is worse than seeing it here.
    /// </summary>
    private string? OverlapWarning(ProjectEnvironmentRow env)
    {
        if (env.BcUpdateWindowStart is null || env.BcUpdateWindowEnd is null) return null;
        if (env.UpdateWindowStart is null || env.UpdateWindowEnd is null) return null;

        var ourZone = UpdateWindow.ResolveTimeZone(_bc?.TimeZone);
        var bcZone = BcUpdateWindow.ResolveDisplayZone(env.BcUpdateWindowTimeZoneIana, _bc?.TimeZone);
        var clash = BcUpdateWindow.Overlaps(
            env.UpdateWindowStart, env.UpdateWindowEnd, ourZone,
            env.BcUpdateWindowStart, env.BcUpdateWindowEnd, bcZone,
            DateTime.UtcNow);

        return clash
            ? "Overlaps Business Central's update window - a release landing then is refused while the environment is updating."
            : null;
    }

    private void OpenWindowEditor(ProjectEnvironmentRow env)
    {
        _windowEditEnvId = env.Id;
        _windowError = null;
        _winStart = env.UpdateWindowStart;
        _winEnd = env.UpdateWindowEnd;
    }

    private void CancelWindowEdit()
    {
        _windowEditEnvId = null;
        _windowError = null;
    }

    private async Task SaveWindowAsync(int environmentId)
    {
        if (_winStart is not { } start || _winEnd is not { } end)
        {
            _windowError = "Enter both a start and an end time, or use Clear for 'any time'.";
            return;
        }
        await PersistWindowAsync(environmentId, start, end);
    }

    private Task ClearWindowAsync(int environmentId) => PersistWindowAsync(environmentId, null, null);

    private async Task PersistWindowAsync(int environmentId, TimeOnly? start, TimeOnly? end)
    {
        _windowError = null;
        try
        {
            await Connection.SetUpdateWindowAsync(Id!.Value, environmentId, start, end);
            _windowEditEnvId = null;
            await LoadBcAsync();
        }
        catch (PlanValidationException ex)
        {
            _windowError = ex.Errors.Values.FirstOrDefault() ?? "Could not save the update window.";
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "Failed to save update window for environment {EnvId}.", environmentId);
            _windowError = "Could not save the update window.";
        }
    }

