@page "/projects/new"
@page "/projects/{Id:int}"
@attribute [Authorize]
@rendermode InteractiveServer
@inject ALDevToolbox.Services.ObjectExplorer.ProjectService Projects
@inject ALDevToolbox.Services.ObjectExplorer.PipelineService PipelinesSvc
@inject ALDevToolbox.Services.ObjectExplorer.ArtifactService Artifacts
@inject ALDevToolbox.Services.ObjectExplorer.Bc.ProjectConnectionService Connection
@inject ALDevToolbox.Services.OrganizationConfigService Config
@inject NavigationManager Nav
@inject ILogger<ProjectDetail> Log
@using ALDevToolbox.Domain.Entities.ObjectExplorer
@using ALDevToolbox.Domain.ValueObjects
@using ALDevToolbox.Services
@using ALDevToolbox.Services.ObjectExplorer
@using ALDevToolbox.Services.ObjectExplorer.Bc

@*
    One project's settings, grouped behind a left sub-nav so each concern loads on
    its own instead of one long scroll: General (name + localisation, with a
    read-only audit trail), Repositories, the Business Central connection, and the
    project's Pipelines. Doubles as the create form (/projects/new), which shows
    just General + Repositories until the project exists.

    Only the owner or an org admin can edit or delete — the management sections are
    hidden for everyone else, who still sees the repositories read-only and can
    follow through to download builds. Named user: the BC consultant who owns a
    customer's project, opening Settings to point it at a repo or wire up delivery.
    Primary action: Save project. See .design/artifacts.md.
*@

<PageTitle>@(_header?.Name ?? (Id is null ? "New project" : "Project")) · Projects · AL Dev Toolbox</PageTitle>

<div class="page">
    @if (_loading)
    {
        <div class="loading-block"><span class="spinner"></span><span>Loading project...</span></div>
    }
    else if (_notFound)
    {
        <div class="empty-state">
            <span class="empty-state__icon"><Icon Name="package" Width="21" Height="21" /></span>
            <h1 class="empty-state__title">This project doesn't exist</h1>
            <p class="empty-state__text">It may have been deleted. Head back to the list to pick another.</p>
            <a class="btn btn--primary empty-state__action" href="/projects"><Icon Name="arrow-left" Width="16" Height="16" /><span>All projects</span></a>
        </div>
    }
    else if (_providers.Count == 0)
    {
        <div class="empty-state">
            <span class="empty-state__icon"><Icon Name="package" Width="21" Height="21" /></span>
            <h1 class="empty-state__title">No source-control providers yet</h1>
            <p class="empty-state__text">
                Your organisation hasn't enabled any source-control providers, so projects can't be built.
                An administrator turns them on under <a href="/admin/administration/repositories">Administration → Repositories</a>.
            </p>
            <a class="btn empty-state__action" href="/projects"><Icon Name="arrow-left" Width="16" Height="16" /><span>All projects</span></a>
        </div>
    }
    else
    {
        @* Archetype: PageDetail.dc.html - crumbs outside the head. No state
           pill: a project has no run state of its own. *@
        <div class="page-head__crumbs">
            <a href="/projects">Projects</a>
            <Icon Name="chevron-right" Width="12" Height="12" />
            <span>@(Id is null ? "New project" : _header?.Name)</span>
        </div>

        <div class="detail-head">
            <div>
                <div class="detail-head__title-row">
                    <h1 class="detail-head__title">@(Id is null ? "New project" : _header?.Name)</h1>
                </div>
                <p class="page-head__sub">
                    @if (Id is not null)
                    {
                        @($"{_edit.Repos.Count} repositor{(_edit.Repos.Count == 1 ? "y" : "ies")}")
                        @if (_header?.OwnerName is { } owner)
                        {
                            <text> · @owner</text>
                        }
                    }
                    else
                    {
                        <text>Name the project and add its repositories, then save.</text>
                    }
                </p>
            </div>
            <div class="page-head__actions">
                <a class="btn" href="/projects">
                    <Icon Name="arrow-left" Width="15" Height="15" />
                    <span>All projects</span>
                </a>
                @* Save project applies to General + Repositories. The Business Central and
                   Pipelines sections have their own save/actions, so the header primary is
                   hidden there to avoid implying it would save those edits. *@
                @if (_canManage && _section is Section.General or Section.Repos)
                {
                    @if (_dirty)
                    {
                        <span class="form-actions__note">Unsaved changes</span>
                    }
                    <button type="button" class="btn btn--primary" @onclick="SaveAsync" disabled="@_saving">
                        <Icon Name="save" Width="15" Height="15" />
                        <span>@(_saving ? "Saving..." : "Save project")</span>
                    </button>
                }
            </div>
        </div>

        @if (_message is not null)
        {
            <p class="alert alert--success" role="status"><Icon Name="circle-check" Width="16" Height="16" /><span>@_message</span></p>
        }
        @if (_errors.Count > 0)
        {
            <div class="alert alert--danger" role="alert">
                @foreach (var err in _errors.Values.Distinct())
                {
                    <p>@err</p>
                }
            </div>
        }

        @if (!_canManage)
        {
            <p class="u-muted">
                You're viewing this project. Only its owner@(_header?.OwnerName is { } ownerName ? $" ({ownerName})" : "") or an admin can change or build it — you can still
                <a href="@($"/pipelines/{Id}")">download its builds</a>.
            </p>
        }

        @*
            Horizontal section tabs, not the left rail this page used to carry:
            archetype 7 and every other settings family in the app (site-admin,
            Administration, Account) put them under the title. The tabs switch a
            section in page state rather than navigating, because General and
            Repositories share one Save - a real navigation between them would
            discard whatever the user had typed with no warning.
        *@
        <div class="settings">
            <div class="settings__tabs">
                <HeaderTabs Items="@SectionTabs" AriaLabel="Project settings" />
            </div>

            <div class="settings__body @(ShowBcAside ? "" : "settings__body--wide")">
                @if (_section == Section.General)
                {
                    <div class="form-sec__head">
                            <h2 class="card__title">General</h2>
                        </div>
                        <p class="form-sec__cap">Identifies the project across the toolbox and tells the compiler which Business Central localisation to target.</p>
                    <div class="card">
                        <div class="card__body">
                            <div class="form-grid">
                                <section class="field">
                                    <label class="field__label" for="proj-name">Name</label>
                                    <input id="proj-name" type="text" class="input" maxlength="200" @bind="_edit.Name" @bind:after="MarkDirty"
                                           disabled="@(_saving || !_canManage)" placeholder="e.g. CRONUS A/S" />
                                    <small class="field__hint">Labels each build, e.g. "CRONUS A/S on BC 26.0".</small>
                                </section>
                                <section class="field">
                                    <label class="field__label" for="proj-country">Country code</label>
                                    <input id="proj-country" type="text" class="input" maxlength="20" pattern="[A-Za-z0-9]{2,10}" required style="max-width:220px"
                                           @bind="_edit.Country" @bind:after="MarkDirty" disabled="@(_saving || !_canManage)" placeholder="e.g. dk or w1" />
                                    <small class="field__hint">Country code of the Microsoft localisation to compile against (e.g. dk for Denmark, w1 for the base/worldwide version). Some localisations include extra regulatory features, so pick the one this project actually targets.</small>
                                </section>
                            </div>
                        </div>
                    </div>

                    @if (Id is not null && _loadedProject is { } proj)
                    {
                        <div class="form-sec__head"><span class="section-label">Audit trail</span></div>
                        <div class="card">
                            <div class="card__body">
                                <div class="meta-row">
                                    <div class="meta-item">
                                        <span class="meta-item__label">Created by</span>
                                        <span class="meta-item__value">
                                            @if (_header?.OwnerName is { } creator)
                                            {
                                                @creator
                                            }
                                            else
                                            {
                                                <span class="u-muted">Unknown</span>
                                            }
                                        </span>
                                        <span class="meta-item__value meta-item__value--mono">@proj.CreatedAt.ToLocalTime().ToString("d MMM yyyy · HH:mm")</span>
                                    </div>
                                    <div class="meta-item">
                                        <span class="meta-item__label">Last updated</span>
                                        <span class="meta-item__value">@(proj.UpdatedAt == proj.CreatedAt ? "Not changed since creation" : "")</span>
                                        <span class="meta-item__value meta-item__value--mono">@proj.UpdatedAt.ToLocalTime().ToString("d MMM yyyy · HH:mm")</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }

                    @* Deleting a project is one destructive setting, and the
                       settings archetype ships .setting--danger + .setting__lock
                       for exactly that, on the shared SettingRow. It sits at the
                       foot of General rather than behind a tab of its own - a
                       whole tab for one button is a lot of navigation. *@
                    @if (Id is not null && _canManage)
                    {
                        <div class="card pd-danger">
                            <SettingRow Name="Delete this project" Danger="true"
                                        Hint="Removes its setup - the name and its repositories. Past builds stay downloadable from the Pipelines tool."
                                        Lock="Cannot be undone">
                                @if (_confirmingDelete)
                                {
                                    <span class="setting__hint">Delete <strong>@_header?.Name</strong>?</span>
                                    <span class="u-row">
                                        <button type="button" class="btn btn--sm btn--danger" @onclick="ConfirmDeleteAsync">Yes, delete</button>
                                        <button type="button" class="btn btn--sm" @onclick="() => _confirmingDelete = false">Cancel</button>
                                    </span>
                                }
                                else
                                {
                                    <span>
                                        <button type="button" class="btn btn--danger" @onclick="() => _confirmingDelete = true">
                                            <Icon Name="trash-2" Width="14" Height="14" />
                                            <span>Delete project</span>
                                        </button>
                                    </span>
                                }
                            </SettingRow>
                        </div>
                    }
                }
                else if (_section == Section.Repos)
                {
                    <div class="form-sec__head">
                        <h2 class="card__title">
                            Repositories
                            <span class="status-pill status-pill--muted"><span class="status-pill__dot"></span><span>@_edit.Repos.Count(r => !r.IsBlank()) added</span></span>
                        </h2>
                    </div>
                    <p class="form-sec__cap">Source repositories compiled into this project's <code>.app</code> deliverables. Each build pulls the latest commit from every repository.</p>
                    <div class="card">
                        <div class="card__body">
                            @if (_edit.Repos.Count == 0)
                            {
                                <p class="u-muted">No repositories yet. Add the Git repositories that make up this project's solution.</p>
                            }
                            else
                            {
                                <div class="row-editor">
                                    <table class="data-table row-editor__table">
                                        <thead>
                                            <tr>
                                                <th scope="col">Host</th>
                                                <th scope="col">Repository URL</th>
                                                <th scope="col">Display name</th>
                                                @if (_canManage)
                                                {
                                                    <th scope="col"></th>
                                                }
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var repo in _edit.Repos)
                                            {
                                                <tr @key="repo">
                                                    <td>
                                                        @if (_canManage && _providers.Count > 1)
                                                        {
                                                            <span class="select-wrap">
                                                                <select class="select select--sm" @bind="repo.Provider" @bind:after="MarkDirty" disabled="@_saving" aria-label="Host">
                                                                    @foreach (var prov in _providers)
                                                                    {
                                                                        <option value="@prov">@prov.DisplayName()</option>
                                                                    }
                                                                </select>
                                                                <Icon Name="chevron-down" Width="15" Height="15" Css="select-wrap__caret" />
                                                            </span>
                                                        }
                                                        else
                                                        {
                                                            <span>@repo.Provider.DisplayName()</span>
                                                        }
                                                    </td>
                                                    <td>
                                                        @if (_canManage)
                                                        {
                                                            <input type="text" class="input input--sm" @bind="repo.Url" @bind:event="oninput" @bind:after="MarkDirty"
                                                                   disabled="@_saving" placeholder="https://github.com/org/repo" aria-label="Repository URL" />
                                                        }
                                                        else
                                                        {
                                                            <span class="pd-url">@repo.Url</span>
                                                        }
                                                    </td>
                                                    <td>
                                                        @if (_canManage)
                                                        {
                                                            <input type="text" class="input input--sm" @bind="repo.DisplayName" @bind:event="oninput" @bind:after="MarkDirty"
                                                                   disabled="@_saving" placeholder="optional" aria-label="Display name" />
                                                        }
                                                        else
                                                        {
                                                            <span>@repo.DisplayName</span>
                                                        }
                                                    </td>
                                                    @if (_canManage)
                                                    {
                                                        <td class="row-editor__cell-center">
                                                            <button type="button" class="btn btn--sm" @onclick="() => RemoveRepo(repo)"
                                                                    disabled="@_saving" aria-label="Remove repository">
                                                                <Icon Name="trash-2" Width="14" Height="14" />
                                                            </button>
                                                        </td>
                                                    }
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            @if (_canManage)
                            {
                                <div class="form-actions">
                                    <button type="button" class="btn btn--sm" @onclick="AddRepo" disabled="@_saving">
                                        <Icon Name="plus" Width="14" Height="14" />
                                        <span>Add repository</span>
                                    </button>
                                </div>
                            }
                        </div>
                    </div>
                }
                else if (_section == Section.Bc && Id is not null && _canManage)
                {
                    @* The Business Central section is the one tab with a rail, so the
                       body drops --wide only here. The content is wrapped because the
                       grid needs the main column to be a single item. *@
                    <div class="pd-bc">
                        <div class="form-sec__head">
                            <h2 class="card__title">
                                Business Central
                                @if (_bc?.IsConfigured == true)
                                {
                                    <span class="status-pill status-pill--success"><span class="status-pill__dot"></span><span>Connected</span></span>
                                }
                                else
                                {
                                    <span class="status-pill status-pill--muted"><span class="status-pill__dot"></span><span>Not connected</span></span>
                                }
                            </h2>
                        </div>
                        <p class="form-sec__cap">Connect the Business Central tenant this project delivers to - your own or a customer's. The client secret is stored encrypted and never shown again.</p>

                        @if (_bcMessage is not null)
                        {
                            <p class="alert @(_bcOk ? "alert--success" : "alert--danger")" role="status"><Icon Name="@(_bcOk ? "circle-check" : "triangle-alert")" Width="16" Height="16" /><span>@_bcMessage</span></p>
                        }
                        @if (_bcErrors.Count > 0)
                        {
                            <div class="alert alert--danger" role="alert">
                                @foreach (var err in _bcErrors.Values.Distinct())
                                {
                                    <p>@err</p>
                                }
                            </div>
                        }

                        <div class="card">
                            <div class="card__body">
                                <div class="form-grid">
                                    <section class="field">
                                        <label class="field__label" for="bc-tenant">Tenant ID</label>
                                        <input id="bc-tenant" type="text" class="input" @bind="_bcEdit.TenantId" disabled="@_bcSaving"
                                               placeholder="00000000-0000-0000-0000-000000000000" />
                                        <small class="field__hint">The Microsoft Entra tenant that owns the Business Central environments.</small>
                                    </section>
                                    <section class="field">
                                        <label class="field__label" for="bc-client">Client ID</label>
                                        <input id="bc-client" type="text" class="input" @bind="_bcEdit.ClientId" disabled="@_bcSaving"
                                               placeholder="the app registration's application (client) ID" />
                                        <small class="field__hint">From the app registration set up for service-to-service access. See the steps beside this form.</small>
                                    </section>
                                    <section class="field">
                                        <label class="field__label" for="bc-secret">Client secret</label>
                                        <input id="bc-secret" type="password" class="input" @bind="_bcEdit.Secret" disabled="@_bcSaving"
                                               placeholder="@(_bc?.HasSecret == true ? "•••••••• (leave blank to keep)" : "the app registration's client secret")" />
                                        <small class="field__hint">@(_bc?.HasSecret == true ? "A secret is stored. Enter a new one only to replace it." : "Stored encrypted; never shown again.")</small>
                                    </section>
                                    <section class="field">
                                        <label class="field__label" for="bc-expiry">Secret expires</label>
                                        <input id="bc-expiry" type="date" class="input" style="max-width:220px" @bind="_bcEdit.SecretExpires" disabled="@_bcSaving" />
                                        <small class="field__hint">
                                            Entra shows this when you create the secret (it lasts at most two years).
                                            @if (_bc?.SecretExpiresAt is { } exp)
                                            {
                                                <text> Current: @exp.ToString("yyyy-MM-dd").</text>
                                            }
                                        </small>
                                    </section>
                                    <section class="field">
                                        <label class="field__label" for="bc-tz">Time zone <span class="u-muted">· optional</span></label>
                                        <input id="bc-tz" type="text" class="input" style="max-width:320px" @bind="_bcEdit.TimeZone" disabled="@_bcSaving"
                                               placeholder="e.g. Europe/Copenhagen" />
                                        <small class="field__hint">Local time where the environments are used, so scheduled deliveries land in their working hours. Blank uses the organisation default.</small>
                                    </section>
                                </div>
                                <div class="form-actions">
                                    <button type="button" class="btn btn--sm" @onclick="SaveBcAsync" disabled="@(_bcSaving || _bcTesting)">
                                        <Icon Name="save" Width="14" Height="14" />
                                        <span>@(_bcSaving ? "Saving..." : "Save connection")</span>
                                    </button>
                                    <button type="button" class="btn btn--sm" @onclick="TestConnectionAsync" disabled="@(_bcSaving || _bcTesting || _bc?.IsConfigured != true)">
                                        <Icon Name="plug" Width="14" Height="14" />
                                        <span>@(_bcTesting ? "Testing..." : "Test connection")</span>
                                    </button>
                                    @if (_bc?.VerifiedAt is { } verified)
                                    {
                                        <span class="form-actions__spacer"></span>
                                        <span class="form-actions__note">Last verified @verified.ToLocalTime().ToString("d MMM yyyy · HH:mm")</span>
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="form-sec__head">
                            <span class="section-label">Environments</span>
                            @if (_environments.Count > 0)
                            {
                                <span class="status-pill status-pill--success" style="margin-left:auto"><span class="status-pill__dot"></span><span>@_environments.Count synced</span></span>
                            }
                        </div>
                        <div class="card">
                            <div class="card__body">
                                @if (_environments.Count == 0)
                                {
                                    <div class="empty-state empty-state--quiet">
                                        <span class="empty-state__title">No environments yet. Save the connection, then <b>Test connection</b> to fetch them.</span>
                                    </div>
                                }
                                else
                                {
                                    @* A table of environments, per the archetype's
                                       rule for lists like this - it scans like every
                                       other table in the toolbox, and the update-window
                                       editor opens as a sub-row underneath the
                                       environment it belongs to. *@
                                    <table class="data-table data-table--edge">
                                        <thead>
                                            <tr>
                                                <th class="data-table__col-state"><span class="u-sr">State</span></th>
                                                <th>Environment</th>
                                                <th>Type</th>
                                                <th>Company</th>
                                                <th>Update window</th>
                                                <th class="data-table__actions"><span class="u-sr">Actions</span></th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var env in _environments)
                                            {
                                                var isProd = string.Equals(env.Type, "Production", StringComparison.OrdinalIgnoreCase);
                                                var gone = env.MissingSince is not null;
                                                <tr class="@RowStateIcon.RowClass(gone ? "failed" : "connected")" @key="env.Id">
                                                    <td class="data-table__col-state">
                                                        <RowStateIcon State="@(gone ? "failed" : "connected")"
                                                                      Label="@(gone ? "No longer present in Business Central" : "Connected")" />
                                                    </td>
                                                    <td>
                                                        @env.Name
                                                        @if (gone)
                                                        {
                                                            <span class="pd-gone">no longer present</span>
                                                        }
                                                    </td>
                                                    <td>
                                                        <span class="status-pill status-pill--@(isProd ? "danger" : "muted")">
                                                            <span class="status-pill__dot"></span>
                                                            <span>@env.Type</span>
                                                        </span>
                                                    </td>
                                                    <td>
                                                        @if (_companyPickerEnvId == env.Id)
                                                        {
                                                            @if (_loadingCompanies)
                                                            {
                                                                <span class="u-muted">Loading companies...</span>
                                                            }
                                                            else
                                                            {
                                                                <span class="select-wrap">
                                                                    <select class="select select--sm" @bind="_selectedCompanyId" aria-label="Company">
                                                                        <option value="">Select a company...</option>
                                                                        @foreach (var co in _companyOptions)
                                                                        {
                                                                            <option value="@co.Id">@co.Name</option>
                                                                        }
                                                                    </select>
                                                                    <Icon Name="chevron-down" Width="15" Height="15" Css="select-wrap__caret" />
                                                                </span>
                                                            }
                                                        }
                                                        else
                                                        {
                                                            @(env.CompanyName ?? "—")
                                                        }
                                                    </td>
                                                    <td>@WindowText(env)</td>
                                                    <td class="data-table__actions">
                                                        @if (_companyPickerEnvId == env.Id)
                                                        {
                                                            <button type="button" class="btn btn--sm" @onclick="() => SaveCompanyAsync(env.Id)"
                                                                    disabled="@(_loadingCompanies || string.IsNullOrEmpty(_selectedCompanyId))">Use</button>
                                                            <button type="button" class="btn btn--sm" @onclick="CancelCompanyPicker">Cancel</button>
                                                        }
                                                        else if (!gone)
                                                        {
                                                            <button type="button" class="btn btn--sm" @onclick="() => OpenCompanyPickerAsync(env.Id)" disabled="@_bcSaving">
                                                                @(env.CompanyId is null ? "Choose company" : "Change")
                                                            </button>
                                                            @if (_windowEditEnvId != env.Id)
                                                            {
                                                                <button type="button" class="btn btn--sm" @onclick="() => OpenWindowEditor(env)" disabled="@_bcSaving">Window</button>
                                                            }
                                                        }
                                                    </td>
                                                </tr>
                                                @if (_windowEditEnvId == env.Id)
                                                {
                                                    <tr class="is-subrow" @key="@($"win-{env.Id}")">
                                                        <td colspan="6">
                                                            <div class="pd-window">
                                                                <label class="pd-window__time">From <input type="time" class="input input--sm" @bind="_winStart" disabled="@_bcSaving" /></label>
                                                                <label class="pd-window__time">To <input type="time" class="input input--sm" @bind="_winEnd" disabled="@_bcSaving" /></label>
                                                                <button type="button" class="btn btn--sm btn--primary" @onclick="() => SaveWindowAsync(env.Id)" disabled="@_bcSaving">Save window</button>
                                                                <button type="button" class="btn btn--sm" @onclick="() => ClearWindowAsync(env.Id)" disabled="@_bcSaving">Clear (any time)</button>
                                                                <button type="button" class="btn btn--sm" @onclick="CancelWindowEdit" disabled="@_bcSaving">Cancel</button>
                                                            </div>
                                                            <small class="field__hint">In the project's timezone (@(_bc?.TimeZone ?? "set one above")). Deliveries prefill to the next opening; you can still release outside it. A window may run past midnight (e.g. 22:00 to 06:00).</small>
                                                            @if (_windowError is { } we)
                                                            {
                                                                <span class="field-error"><Icon Name="triangle-alert" Width="13" Height="13" />@we</span>
                                                            }
                                                        </td>
                                                    </tr>
                                                }
                                            }
                                        </tbody>
                                    </table>
                                    <div class="form-actions">
                                        <button type="button" class="btn btn--sm" @onclick="TestConnectionAsync" disabled="@(_bcSaving || _bcTesting)">
                                            <Icon Name="refresh-cw" Width="14" Height="14" />
                                            <span>Refresh environments</span>
                                        </button>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    @* Three separate registrations, in three different portals, stand
                       between a valid app registration and a working connection - and
                       only the first is visible from Entra, which is why a setup that
                       looks finished still fails. Reference rather than action, so it
                       belongs beside the form, not in it. *@
                    <aside class="settings__aside">
                        <section class="card">
                            <div class="card__head"><div><h2 class="card__title">Before this will connect</h2></div></div>
                            <div class="card__body settings-aside__body">
                                <p class="pd-setup__lead">Business Central has to be told about the app in three separate places. Miss one and the test below fails.</p>
                                <ol class="pd-setup">
                                    <li>
                                        <span class="pd-setup__where">Microsoft Entra admin center</span>
                                        <span>Register an app, add the Business Central permissions <code>AdminCenter.ReadWrite.All</code>, <code>Automation.ReadWrite.All</code> and <code>API.ReadWrite.All</code>, then grant admin consent.</span>
                                    </li>
                                    <li>
                                        <span class="pd-setup__where">Business Central admin center → Authorized Microsoft Entra apps</span>
                                        <span>Add the client ID and grant consent there too. Until you do, no environments come back.</span>
                                    </li>
                                    <li>
                                        <span class="pd-setup__where">Each environment → Microsoft Entra applications</span>
                                        <span>Add the client ID, set State to Enabled, and assign the D365 AUTOMATION and EXTEN. MGT. - ADMIN permission sets. Needed before you can pick a company or publish.</span>
                                    </li>
                                </ol>
                                <p class="pd-setup__note">Managing this tenant for someone else as their partner? Also add the app to the AdminAgents group in Partner Center, and check that the delegated admin (GDAP) relationship covers Business Central.</p>
                                <a class="btn btn--sm" href="https://learn.microsoft.com/dynamics365/business-central/dev-itpro/administration/automation-apis-using-s2s-authentication" target="_blank" rel="noopener">
                                    <Icon Name="external-link" Width="14" Height="14" />
                                    <span>Microsoft's setup guide</span>
                                </a>
                            </div>
                        </section>
                    </aside>
                }
                else if (_section == Section.Pipelines && Id is not null && _canManage)
                {
                    <div class="form-sec__head">
                        <h2 class="card__title">
                            Pipelines
                            <span class="status-pill status-pill--muted"><span class="status-pill__dot"></span><span>@_pipelines.Count pipeline@(_pipelines.Count == 1 ? "" : "s")</span></span>
                        </h2>
                    </div>
                    <p class="form-sec__cap">Build automation for this project. Each pipeline chooses which extensions to compile; open one to start builds and download its <code>.app</code> files.</p>
                    <div class="card">
                        <div class="card__body">
                            @if (_pipelines.Count == 0)
                            {
                                <div class="empty-state empty-state--quiet">
                                    <span class="empty-state__title">No pipelines yet. Add one to choose which extensions to build and start producing <code>.app</code> files.</span>
                                </div>
                            }
                            else
                            {
                                <div class="sub-rows sub-rows--plain">
                                    @foreach (var pl in _pipelines)
                                    {
                                        <a class="sub-row pd-pipe" href="@($"/pipelines/{pl.Id}")">
                                            <div class="sub-row__stack">
                                                <span class="sub-row__name">@pl.Name</span>
                                                <span class="sub-row__val">@PipelineScope(pl)</span>
                                            </div>
                                            <span class="sub-row__acts">
                                                <Icon Name="chevron-right" Width="16" Height="16" Css="pd-pipe__chev" />
                                            </span>
                                        </a>
                                    }
                                </div>
                            }
                            <div class="form-actions">
                                <button type="button" class="btn btn--sm" @onclick="NewPipelineAsync" disabled="@_saving">
                                    <Icon Name="plus" Width="14" Height="14" />
                                    <span>New pipeline</span>
                                </button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

<PipelineEditorDialog @ref="_editor" OnSaved="OnPipelineCreatedAsync" />

@code {
    [Parameter] public int? Id { get; set; }

    private enum Section { General, Repos, Bc, Pipelines }
    private Section _section = Section.General;

    /// <summary>
    /// Only the Business Central tab has anything to put in the 280px rail, and an
    /// empty rail would stop the other tabs' cards short of the page edge for no
    /// reason a reader could see - so the column is reserved per section, not per page.
    /// </summary>
    private bool ShowBcAside => _section == Section.Bc && Id is not null && _canManage;

    /// <summary>
    /// The section tab row. Every tab carries OnSelected rather than an Href:
    /// see the note above the markup - General and Repositories share one Save,
    /// so a real navigation between them would drop unsaved edits.
    ///
    /// Labels only, as archetype 7 renders them. The left rail this replaced
    /// also carried a repository count and a dot for the Business Central
    /// connection; the count is already in the page head's sub-line, and the
    /// dot is a deliberate loss rather than a badge bolted onto a tab row the
    /// design system renders as plain text.
    /// </summary>
    private List<HeaderTabs.HeaderTabItem> SectionTabs
    {
        get
        {
            var tabs = new List<HeaderTabs.HeaderTabItem>
            {
                Tab("General", Section.General),
                Tab("Repositories", Section.Repos),
            };

            if (Id is not null && _canManage)
            {
                tabs.Add(Tab("Business Central", Section.Bc));
                tabs.Add(Tab("Pipelines", Section.Pipelines));
                }

            return tabs;
        }
    }

    private HeaderTabs.HeaderTabItem Tab(string label, Section section) =>
        new(label, Href: null, IsActive: _section == section,
            OnSelected: EventCallback.Factory.Create(this, () => _section = section));

    private bool _loading = true;
    private bool _notFound;
    private bool _saving;
    private bool _dirty;
    private bool _confirmingDelete;
    private bool _canManage;
    private string? _message;
    private Dictionary<string, string> _errors = new();

    private ProjectHeader? _header;
    private List<Pipeline> _pipelines = new();
    private List<RepositoryProvider> _providers = new();
    private EditModel _edit = new();
    private PipelineEditorDialog? _editor;

    // Business Central connection (owner/admin only).
    private BcConnectionStatus? _bc;
    private BcEdit _bcEdit = new();
    private bool _bcSaving;
    private bool _bcTesting;
    private bool _bcOk;
    private string? _bcMessage;
    private Dictionary<string, string> _bcErrors = new();
    private List<ProjectEnvironmentRow> _environments = new();
    private int? _companyPickerEnvId;
    private List<BcCompany> _companyOptions = new();
    private bool _loadingCompanies;
    private string? _selectedCompanyId;

    protected override async Task OnInitializedAsync()
    {
        _providers = (await Config.GetAllowedProvidersAsync()).ToList();

        if (Id is null)
        {
            // Anyone may create. The creator becomes the owner.
            _canManage = true;
            _edit = new EditModel { Repos = { new RepoRow { Provider = DefaultProvider } } };
        }
        else
        {
            await LoadAsync();
            if (!_notFound)
            {
                _canManage = await Projects.CanManageAsync(Id.Value);
                HydrateEdit();
                if (_canManage) await LoadBcAsync();
            }
        }
        _loading = false;
    }

    private async Task LoadBcAsync()
    {
        _bc = await Connection.GetConnectionAsync(Id!.Value);
        _environments = (await Connection.ListEnvironmentsAsync(Id.Value)).ToList();
        HydrateBcEdit();
    }

    private void HydrateBcEdit()
    {
        _bcEdit = new BcEdit
        {
            TenantId = _bc?.TenantId?.ToString() ?? string.Empty,
            ClientId = _bc?.ClientId ?? string.Empty,
            Secret = string.Empty,
            SecretExpires = _bc?.SecretExpiresAt?.Date,
            TimeZone = _bc?.TimeZone ?? string.Empty,
        };
    }

    private async Task LoadAsync()
    {
        try
        {
            var project = await Projects.GetProjectAsync(Id!.Value);
            if (project is null) { _notFound = true; return; }
            _header = await Artifacts.GetProjectHeaderAsync(Id.Value);
            _pipelines = await PipelinesSvc.ListPipelinesAsync(Id.Value);
            _loadedProject = project;
        }
        catch (ProjectAccessDeniedException)
        {
            // A private project this person isn't on the team for. The projects
            // list already shows them its name; the detail page says no more than
            // that, so navigating straight here confirms nothing extra.
            _notFound = true;
        }
    }

    private async Task NewPipelineAsync()
    {
        if (_editor is null || Id is null) return;
        await _editor.OpenForCreateAsync(Id.Value, _header?.Name ?? _edit.Name);
    }

    private void OnPipelineCreatedAsync(int pipelineId) => Nav.NavigateTo($"/pipelines/{pipelineId}");

    private Project? _loadedProject;

    private void HydrateEdit()
    {
        _edit = new EditModel
        {
            Name = _loadedProject!.Name,
            Country = _loadedProject.DefaultArtifactCountry ?? string.Empty,
            Repos = _loadedProject.Repositories
                .Select(r => new RepoRow { Provider = r.Provider, Url = r.Url, DisplayName = r.DisplayName })
                .ToList(),
        };
        _dirty = false;
    }

    private void MarkDirty() => _dirty = true;
    private void AddRepo() { _edit.Repos.Add(new RepoRow { Provider = DefaultProvider }); _dirty = true; }
    private void RemoveRepo(RepoRow row) { _edit.Repos.Remove(row); _dirty = true; }

    private RepositoryProvider DefaultProvider =>
        _providers.Contains(RepositoryProvider.GitHub) ? RepositoryProvider.GitHub
        : _providers.FirstOrDefault();

    /// <summary>
    /// One-line scope summary for a pipeline row: how many extensions it builds.
    /// A null/empty <see cref="Pipeline.RequestedAppIdsJson"/> means "build everything".
    /// </summary>
    private static string PipelineScope(Pipeline pl)
    {
        if (string.IsNullOrWhiteSpace(pl.RequestedAppIdsJson)) return "Builds all extensions";
        try
        {
            var ids = System.Text.Json.JsonSerializer.Deserialize<List<string>>(pl.RequestedAppIdsJson);
            var n = ids?.Count ?? 0;
            return n == 0 ? "Builds all extensions" : $"Builds {n} selected extension{(n == 1 ? "" : "s")}";
        }
        catch
        {
            return "Builds selected extensions";
        }
    }

    /// <summary>Up-to-two-letter avatar initials for the audit trail and header.</summary>
    private static string Initials(string name)
    {
        var parts = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 0) return "?";
        var letters = parts.Take(2).Select(p => char.ToUpperInvariant(p[0]));
        return string.Concat(letters);
    }

    private async Task SaveAsync()
    {
        if (_saving) return;
        _saving = true;
        _message = null;
        _errors = new();
        try
        {
            var repos = _edit.Repos.Where(r => !r.IsBlank())
                .Select(r => new ProjectRepositoryInput(r.Provider, r.Url, r.DisplayName))
                .ToList();
            var input = new ProjectInput(_edit.Name, string.IsNullOrWhiteSpace(_edit.Country) ? null : _edit.Country, repos);

            if (Id is null)
            {
                var newId = await Projects.CreateProjectAsync(input);
                Nav.NavigateTo($"/projects/{newId}");
                return;
            }
            await Projects.UpdateProjectAsync(Id.Value, input);
            await LoadAsync();
            HydrateEdit();
            _message = "Project saved.";
        }
        catch (PlanValidationException ex)
        {
            _errors = new(ex.Errors);
        }
        catch (ProjectAccessDeniedException)
        {
            _errors = new() { ["_"] = "Only the project owner or an admin can change this project." };
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "Failed to save project {ProjectId}.", Id);
            _errors = new() { ["_"] = "An unexpected error occurred. The change was not saved." };
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task ConfirmDeleteAsync()
    {
        try
        {
            await Projects.SoftDeleteProjectAsync(Id!.Value);
            Nav.NavigateTo("/projects");
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "Failed to delete project {ProjectId}.", Id);
            _errors = new() { ["_"] = "Could not delete the project." };
            _confirmingDelete = false;
        }
    }

    private async Task SaveBcAsync()
    {
        if (_bcSaving) return;
        _bcSaving = true;
        _bcMessage = null;
        _bcErrors = new();
        try
        {
            Guid? tenant = null;
            if (!string.IsNullOrWhiteSpace(_bcEdit.TenantId))
            {
                if (Guid.TryParse(_bcEdit.TenantId.Trim(), out var g)) tenant = g;
                else _bcErrors["BcTenantId"] = "That doesn't look like a tenant ID. It should look like 00000000-0000-0000-0000-000000000000.";
            }
            if (_bcErrors.Count == 0)
            {
                var expires = _bcEdit.SecretExpires is { } d ? DateTime.SpecifyKind(d, DateTimeKind.Utc) : (DateTime?)null;
                var input = new BcConnectionInput(
                    tenant,
                    _bcEdit.ClientId,
                    string.IsNullOrWhiteSpace(_bcEdit.Secret) ? null : _bcEdit.Secret,
                    expires,
                    string.IsNullOrWhiteSpace(_bcEdit.TimeZone) ? null : _bcEdit.TimeZone);
                await Connection.SaveConnectionAsync(Id!.Value, input);
                await LoadBcAsync();
                _bcOk = true;
                _bcMessage = "Connection saved. Test it to fetch this customer's environments.";
            }
        }
        catch (PlanValidationException ex)
        {
            _bcErrors = new(ex.Errors);
        }
        catch (ProjectAccessDeniedException)
        {
            _bcErrors = new() { ["_"] = "Only the project owner or an admin can change the connection." };
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "Failed to save BC connection for project {ProjectId}.", Id);
            _bcErrors = new() { ["_"] = "An unexpected error occurred. The connection was not saved." };
        }
        finally
        {
            _bcSaving = false;
        }
    }

    private async Task TestConnectionAsync()
    {
        if (_bcTesting) return;
        _bcTesting = true;
        _bcMessage = null;
        _bcErrors = new();
        try
        {
            var result = await Connection.TestConnectionAsync(Id!.Value);
            _bcOk = result.IsSuccess;
            _bcMessage = result.Message;
            await LoadBcAsync();
        }
        catch (ProjectAccessDeniedException)
        {
            _bcErrors = new() { ["_"] = "Only the project owner or an admin can test the connection." };
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "Failed to test BC connection for project {ProjectId}.", Id);
            _bcErrors = new() { ["_"] = "An unexpected error occurred while testing the connection." };
        }
        finally
        {
            _bcTesting = false;
        }
    }

    private async Task OpenCompanyPickerAsync(int environmentId)
    {
        _companyPickerEnvId = environmentId;
        _selectedCompanyId = null;
        _companyOptions = new();
        _loadingCompanies = true;
        _bcErrors = new();
        try
        {
            _companyOptions = (await Connection.FetchCompaniesAsync(Id!.Value, environmentId)).ToList();
        }
        catch (PlanValidationException ex)
        {
            _bcErrors = new(ex.Errors);
            _companyPickerEnvId = null;
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "Failed to fetch companies for environment {EnvId}.", environmentId);
            _bcErrors = new() { ["_"] = "Could not list companies for this environment." };
            _companyPickerEnvId = null;
        }
        finally
        {
            _loadingCompanies = false;
        }
    }

    private void CancelCompanyPicker()
    {
        _companyPickerEnvId = null;
        _companyOptions = new();
        _selectedCompanyId = null;
    }

    private async Task SaveCompanyAsync(int environmentId)
    {
        if (string.IsNullOrEmpty(_selectedCompanyId) || !Guid.TryParse(_selectedCompanyId, out var companyId)) return;
        var name = _companyOptions.FirstOrDefault(c => c.Id == companyId)?.Name ?? string.Empty;
        try
        {
            await Connection.PickCompanyAsync(Id!.Value, environmentId, companyId, name);
            CancelCompanyPicker();
            await LoadBcAsync();
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "Failed to set company for environment {EnvId}.", environmentId);
            _bcErrors = new() { ["_"] = "Could not save the company selection." };
        }
    }

    // ── Per-environment update window ─────────────────────────────────────────

    private int? _windowEditEnvId;
    private TimeOnly? _winStart;
    private TimeOnly? _winEnd;
    private string? _windowError;

    /// <summary>The window summary shown under an environment's name.</summary>
    private static string WindowText(ProjectEnvironmentRow env) =>
        env.UpdateWindowStart is { } s && env.UpdateWindowEnd is { } e
            ? $"{s:HH\\:mm}–{e:HH\\:mm}"
            : "any time";

    private void OpenWindowEditor(ProjectEnvironmentRow env)
    {
        CancelCompanyPicker();
        _windowEditEnvId = env.Id;
        _windowError = null;
        _winStart = env.UpdateWindowStart;
        _winEnd = env.UpdateWindowEnd;
    }

    private void CancelWindowEdit()
    {
        _windowEditEnvId = null;
        _windowError = null;
    }

    private async Task SaveWindowAsync(int environmentId)
    {
        if (_winStart is not { } start || _winEnd is not { } end)
        {
            _windowError = "Enter both a start and an end time, or use Clear for 'any time'.";
            return;
        }
        await PersistWindowAsync(environmentId, start, end);
    }

    private Task ClearWindowAsync(int environmentId) => PersistWindowAsync(environmentId, null, null);

    private async Task PersistWindowAsync(int environmentId, TimeOnly? start, TimeOnly? end)
    {
        _windowError = null;
        try
        {
            await Connection.SetUpdateWindowAsync(Id!.Value, environmentId, start, end);
            _windowEditEnvId = null;
            await LoadBcAsync();
        }
        catch (PlanValidationException ex)
        {
            _windowError = ex.Errors.Values.FirstOrDefault() ?? "Could not save the update window.";
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "Failed to save update window for environment {EnvId}.", environmentId);
            _windowError = "Could not save the update window.";
        }
    }

    private sealed class BcEdit
    {
        public string TenantId { get; set; } = string.Empty;
        public string ClientId { get; set; } = string.Empty;
        public string Secret { get; set; } = string.Empty;
        public DateTime? SecretExpires { get; set; }
        public string TimeZone { get; set; } = string.Empty;
    }

    private sealed class EditModel
    {
        public string Name { get; set; } = string.Empty;
        public string Country { get; set; } = string.Empty;
        public List<RepoRow> Repos { get; set; } = new();
    }

    private sealed class RepoRow
    {
        public RepositoryProvider Provider { get; set; } = RepositoryProvider.GitHub;
        public string Url { get; set; } = string.Empty;
        public string DisplayName { get; set; } = string.Empty;
        public bool IsBlank() => string.IsNullOrWhiteSpace(Url) && string.IsNullOrWhiteSpace(DisplayName);
    }
}
