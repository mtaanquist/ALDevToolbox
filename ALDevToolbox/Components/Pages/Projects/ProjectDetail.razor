@page "/solutions/new"
@page "/solutions/{Id:int}"
@attribute [Authorize]
@rendermode InteractiveServer
@inject ALDevToolbox.Services.ObjectExplorer.ProjectService Projects
@inject ALDevToolbox.Services.ObjectExplorer.PipelineService PipelinesSvc
@inject ALDevToolbox.Services.ObjectExplorer.ArtifactService Artifacts
@inject ALDevToolbox.Services.ObjectExplorer.Bc.ProjectConnectionService Connection
@inject ALDevToolbox.Services.ObjectExplorer.Bc.UpgradeActionService UpgradeActions
@inject ALDevToolbox.Services.ObjectExplorer.ProjectAccess Access
@inject ALDevToolbox.Services.OrganizationConfigService Config
@inject ALDevToolbox.Services.TeamService Teams
@inject NavigationManager Nav
@inject ILogger<ProjectDetail> Log
@using ALDevToolbox.Domain.Entities.ObjectExplorer
@using ALDevToolbox.Domain.ValueObjects
@using ALDevToolbox.Domain.ValueObjects.ObjectExplorer
@using ALDevToolbox.Services
@using ALDevToolbox.Services.ObjectExplorer
@using ALDevToolbox.Services.ObjectExplorer.Bc

@*
    One solution's settings, grouped behind a left sub-nav so each concern loads on
    its own instead of one long scroll: General (name + localisation, with a
    read-only audit trail), Repositories, the Business Central connection, and the
    solution's Pipelines. Doubles as the create form (/solutions/new), which shows
    just General + Repositories until the solution exists.

    Only the owner or an org admin can edit or delete — the management sections are
    hidden for everyone else, who still sees the repositories read-only and can
    follow through to download builds. Named user: the BC consultant who owns a
    customer's solution, opening Settings to point it at a repo or wire up delivery.
    Primary action: Save solution. See .design/artifacts.md.
*@

<PageTitle>@(_header?.Name ?? (Id is null ? "New solution" : "Solution")) · Solutions · AL Dev Toolbox</PageTitle>

<div class="page">
    @if (_loading)
    {
        <div class="loading-block"><span class="spinner"></span><span>Loading solution...</span></div>
    }
    else if (_notFound)
    {
        <div class="empty-state">
            <span class="empty-state__icon"><Icon Name="package" Width="21" Height="21" /></span>
            <h1 class="empty-state__title">This solution doesn't exist</h1>
            <p class="empty-state__text">It may have been deleted. Head back to the list to pick another.</p>
            <a class="btn btn--primary empty-state__action" href="/solutions"><Icon Name="arrow-left" Width="16" Height="16" /><span>All solutions</span></a>
        </div>
    }
    else if (_providers.Count == 0)
    {
        <div class="empty-state">
            <span class="empty-state__icon"><Icon Name="package" Width="21" Height="21" /></span>
            <h1 class="empty-state__title">No source-control providers yet</h1>
            <p class="empty-state__text">
                Your organisation hasn't enabled any source-control providers, so solutions can't be built.
                An administrator turns them on under <a href="/admin/administration/repositories">Administration → Repositories</a>.
            </p>
            <a class="btn empty-state__action" href="/solutions"><Icon Name="arrow-left" Width="16" Height="16" /><span>All solutions</span></a>
        </div>
    }
    else
    {
        @* Archetype: PageDetail.dc.html - crumbs outside the head. No state
           pill: a solution has no run state of its own. *@
        <div class="page-head__crumbs">
            <a href="/solutions">Solutions</a>
            <Icon Name="chevron-right" Width="12" Height="12" />
            <span>@(Id is null ? "New solution" : _header?.Name)</span>
        </div>

        <div class="detail-head">
            <div>
                <div class="detail-head__title-row">
                    <h1 class="detail-head__title">@(Id is null ? "New solution" : _header?.Name)</h1>
                    @* Which fence this solution is behind, on every tab. Nothing for
                       Public - the default needs no telling, and a badge on every
                       solution would stop meaning anything. The title row already
                       exists for a marker beside the name. *@
                    @if (VisibilityBadge is { } badge)
                    {
                        @* No status dot: the pill is a label for a setting, not a
                           run state, and the dot beside a title reads as a divider. *@
                        <span class="status-pill status-pill--muted"><span>@badge</span></span>
                    }
                </div>
                <p class="page-head__sub">
                    @if (Id is not null)
                    {
                        @($"{_edit.Repos.Count} repositor{(_edit.Repos.Count == 1 ? "y" : "ies")}")
                        @if (_header?.OwnerName is { } owner)
                        {
                            <text> · @owner</text>
                        }
                    }
                    else
                    {
                        <text>Name the solution and add its repositories, then save.</text>
                    }
                </p>
            </div>
            <div class="page-head__actions">
                <a class="btn" href="/solutions">
                    <Icon Name="arrow-left" Width="15" Height="15" />
                    <span>All solutions</span>
                </a>
                @* Save solution applies to General + Repositories. The Business Central and
                   Pipelines sections have their own save/actions, so the header primary is
                   hidden there to avoid implying it would save those edits. *@
                @if (_canManage && _section is Section.General or Section.Repos)
                {
                    @if (_dirty)
                    {
                        <span class="form-actions__note">Unsaved changes</span>
                    }
                    <button type="button" class="btn btn--primary" @onclick="SaveAsync" disabled="@_saving">
                        <Icon Name="save" Width="15" Height="15" />
                        <span>@(_saving ? "Saving..." : "Save solution")</span>
                    </button>
                }
            </div>
        </div>

        @if (_message is not null)
        {
            <p class="alert alert--success" role="status"><Icon Name="circle-check" Width="16" Height="16" /><span>@_message</span></p>
        }
        @if (_errors.Count > 0)
        {
            <div class="alert alert--danger" role="alert">
                @foreach (var err in _errors.Values.Distinct())
                {
                    <p>@err</p>
                }
            </div>
        }

        @if (!_canManage)
        {
            <p class="u-muted">
                You're viewing this solution. Only its owner@(_header?.OwnerName is { } ownerName ? $" ({ownerName})" : "") or an admin can change or build it — you can still
                <a href="@($"/pipelines/{Id}")">download its builds</a>.
            </p>
        }

        @*
            Horizontal section tabs, not the left rail this page used to carry:
            archetype 7 and every other settings family in the app (site-admin,
            Administration, Account) put them under the title. The tabs switch a
            section in page state rather than navigating, because General and
            Repositories share one Save - a real navigation between them would
            discard whatever the user had typed with no warning.
        *@
        <div class="settings">
            <div class="settings__tabs">
                <HeaderTabs Items="@SectionTabs" AriaLabel="Solution settings" />
            </div>

            <div class="settings__body @(ShowBcAside ? "" : "settings__body--wide")">
                @if (_section == Section.General)
                {
                    <div class="form-sec__head">
                            <h2 class="card__title">General</h2>
                        </div>
                        <p class="form-sec__cap">Identifies the solution across the toolbox and tells the compiler which Business Central localisation to target.</p>
                    <div class="card">
                        <div class="card__body">
                            <div class="form-grid">
                                <section class="field">
                                    <label class="field__label" for="proj-name">Name</label>
                                    <input id="proj-name" type="text" class="input" maxlength="200" @bind="_edit.Name" @bind:after="MarkDirty"
                                           disabled="@(_saving || !_canManage)" placeholder="e.g. CRONUS A/S" />
                                    <small class="field__hint">Labels each build, e.g. "CRONUS A/S on BC 26.0".</small>
                                </section>
                                <section class="field">
                                    <label class="field__label" for="proj-country">Country code</label>
                                    <input id="proj-country" type="text" class="input" maxlength="20" pattern="[A-Za-z0-9]{2,10}" required style="max-width:220px"
                                           @bind="_edit.Country" @bind:after="MarkDirty" disabled="@(_saving || !_canManage)" placeholder="e.g. dk or w1" />
                                    <small class="field__hint">Country code of the Microsoft localisation to compile against (e.g. dk for Denmark, w1 for the base/worldwide version). Some localisations include extra regulatory features, so pick the one this solution actually targets.</small>
                                </section>
                            </div>
                        </div>
                    </div>

                    @if (Id is not null && _loadedProject is { } proj)
                    {
                        <div class="form-sec__head"><span class="section-label">Audit trail</span></div>
                        <div class="card">
                            <div class="card__body">
                                <div class="meta-row">
                                    <div class="meta-item">
                                        <span class="meta-item__label">Created by</span>
                                        <span class="meta-item__value">
                                            @if (_header?.OwnerName is { } creator)
                                            {
                                                @creator
                                            }
                                            else
                                            {
                                                <span class="u-muted">Unknown</span>
                                            }
                                        </span>
                                        <span class="meta-item__value meta-item__value--mono">@proj.CreatedAt.ToLocalTime().ToString("d MMM yyyy · HH:mm")</span>
                                    </div>
                                    <div class="meta-item">
                                        <span class="meta-item__label">Last updated</span>
                                        <span class="meta-item__value">@(proj.UpdatedAt == proj.CreatedAt ? "Not changed since creation" : "")</span>
                                        <span class="meta-item__value meta-item__value--mono">@proj.UpdatedAt.ToLocalTime().ToString("d MMM yyyy · HH:mm")</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }

                    @* Deleting a solution is one destructive setting, and the
                       settings archetype ships .setting--danger + .setting__lock
                       for exactly that, on the shared SettingRow. It sits at the
                       foot of General rather than behind a tab of its own - a
                       whole tab for one button is a lot of navigation. *@
                    @if (Id is not null && _canManage)
                    {
                        <div class="card pd-danger">
                            <SettingRow Name="Delete this solution" Danger="true"
                                        Hint="Removes its setup - the name and its repositories. Past builds stay downloadable from the Pipelines tool."
                                        Lock="Cannot be undone">
                                @if (_confirmingDelete)
                                {
                                    <span class="setting__hint">Delete <strong>@_header?.Name</strong>?</span>
                                    <span class="u-row">
                                        <button type="button" class="btn btn--sm btn--danger" @onclick="ConfirmDeleteAsync">Yes, delete</button>
                                        <button type="button" class="btn btn--sm" @onclick="() => _confirmingDelete = false">Cancel</button>
                                    </span>
                                }
                                else
                                {
                                    <span>
                                        <button type="button" class="btn btn--danger" @onclick="() => _confirmingDelete = true">
                                            <Icon Name="trash-2" Width="14" Height="14" />
                                            <span>Delete solution</span>
                                        </button>
                                    </span>
                                }
                            </SettingRow>
                        </div>
                    }
                }
                else if (_section == Section.Repos)
                {
                    <div class="form-sec__head">
                        <h2 class="card__title">
                            Repositories
                            <span class="status-pill status-pill--muted"><span class="status-pill__dot"></span><span>@_edit.Repos.Count(r => !r.IsBlank()) added</span></span>
                        </h2>
                    </div>
                    <p class="form-sec__cap">Source repositories compiled into this solution's <code>.app</code> deliverables. Each build pulls the latest commit from every repository.</p>
                    <div class="card">
                        <div class="card__body">
                            @if (_edit.Repos.Count == 0)
                            {
                                <p class="u-muted">No repositories yet. Add the Git repositories that make up this solution's solution.</p>
                            }
                            else
                            {
                                <div class="row-editor">
                                    <table class="data-table row-editor__table">
                                        <thead>
                                            <tr>
                                                <th scope="col">Host</th>
                                                <th scope="col">Repository URL</th>
                                                <th scope="col">Display name</th>
                                                @if (_canManage)
                                                {
                                                    <th scope="col"></th>
                                                }
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var repo in _edit.Repos)
                                            {
                                                <tr @key="repo">
                                                    <td>
                                                        @if (_canManage && _providers.Count > 1)
                                                        {
                                                            <span class="select-wrap">
                                                                <select class="select select--sm" @bind="repo.Provider" @bind:after="MarkDirty" disabled="@_saving" aria-label="Host">
                                                                    @foreach (var prov in _providers)
                                                                    {
                                                                        <option value="@prov">@prov.DisplayName()</option>
                                                                    }
                                                                </select>
                                                                <Icon Name="chevron-down" Width="15" Height="15" Css="select-wrap__caret" />
                                                            </span>
                                                        }
                                                        else
                                                        {
                                                            <span>@repo.Provider.DisplayName()</span>
                                                        }
                                                    </td>
                                                    <td>
                                                        @if (_canManage)
                                                        {
                                                            <input type="text" class="input input--sm" @bind="repo.Url" @bind:event="oninput" @bind:after="MarkDirty"
                                                                   disabled="@_saving" placeholder="https://github.com/org/repo" aria-label="Repository URL" />
                                                        }
                                                        else
                                                        {
                                                            <span class="pd-url">@repo.Url</span>
                                                        }
                                                    </td>
                                                    <td>
                                                        @if (_canManage)
                                                        {
                                                            <input type="text" class="input input--sm" @bind="repo.DisplayName" @bind:event="oninput" @bind:after="MarkDirty"
                                                                   disabled="@_saving" placeholder="optional" aria-label="Display name" />
                                                        }
                                                        else
                                                        {
                                                            <span>@repo.DisplayName</span>
                                                        }
                                                    </td>
                                                    @if (_canManage)
                                                    {
                                                        <td class="row-editor__cell-center">
                                                            <button type="button" class="btn btn--sm" @onclick="() => RemoveRepo(repo)"
                                                                    disabled="@_saving" aria-label="Remove repository">
                                                                <Icon Name="trash-2" Width="14" Height="14" />
                                                            </button>
                                                        </td>
                                                    }
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            @if (_canManage)
                            {
                                <div class="form-actions">
                                    <button type="button" class="btn btn--sm" @onclick="AddRepo" disabled="@_saving">
                                        <Icon Name="plus" Width="14" Height="14" />
                                        <span>Add repository</span>
                                    </button>
                                </div>
                            }
                        </div>
                    </div>
                }
                else if (_section == Section.Bc && Id is not null && _canManage)
                {
                    @* The Business Central section is the one tab with a rail, so the
                       body drops --wide only here. The content is wrapped because the
                       grid needs the main column to be a single item. *@
                    <div class="pd-bc">
                        <div class="form-sec__head">
                            <h2 class="card__title">
                                Business Central
                                @if (_bc?.IsConfigured == true)
                                {
                                    <span class="status-pill status-pill--success"><span class="status-pill__dot"></span><span>Connected</span></span>
                                }
                                else
                                {
                                    <span class="status-pill status-pill--muted"><span class="status-pill__dot"></span><span>Not connected</span></span>
                                }
                            </h2>
                        </div>
                        <p class="form-sec__cap">Connect the Business Central tenant this solution delivers to - your own or a customer's. The client secret is stored encrypted and never shown again.</p>

                        @if (_bcMessage is not null)
                        {
                            <p class="alert @(_bcOk ? "alert--success" : "alert--danger")" role="status"><Icon Name="@(_bcOk ? "circle-check" : "triangle-alert")" Width="16" Height="16" /><span>@_bcMessage</span></p>
                        }
                        @if (_bcErrors.Count > 0)
                        {
                            <div class="alert alert--danger" role="alert">
                                @foreach (var err in _bcErrors.Values.Distinct())
                                {
                                    <p>@err</p>
                                }
                            </div>
                        }

                        <div class="card">
                            <div class="card__body">
                                <div class="form-grid">
                                    <section class="field">
                                        <label class="field__label" for="bc-tenant">Tenant ID</label>
                                        <input id="bc-tenant" type="text" class="input" @bind="_bcEdit.TenantId" disabled="@_bcSaving"
                                               placeholder="00000000-0000-0000-0000-000000000000" />
                                        <small class="field__hint">The Microsoft Entra tenant that owns the Business Central environments — its Directory (tenant) ID, from the app registration's Overview page in Entra.</small>
                                    </section>
                                    <section class="field">
                                        <label class="field__label" for="bc-client">Client ID</label>
                                        <input id="bc-client" type="text" class="input" @bind="_bcEdit.ClientId" disabled="@_bcSaving"
                                               placeholder="the app registration's application (client) ID" />
                                        <small class="field__hint">From the app registration set up for service-to-service access. See the steps beside this form.</small>
                                    </section>
                                    <section class="field">
                                        <label class="field__label" for="bc-secret">Client secret</label>
                                        <input id="bc-secret" type="password" class="input" @bind="_bcEdit.Secret" disabled="@_bcSaving"
                                               placeholder="@(_bc?.HasSecret == true ? "•••••••• (leave blank to keep)" : "the app registration's client secret")" />
                                        <small class="field__hint">@(_bc?.HasSecret == true ? "A secret is stored. Enter a new one only to replace it." : "Stored encrypted; never shown again.")</small>
                                    </section>
                                    <section class="field">
                                        <label class="field__label" for="bc-expiry">Secret expires</label>
                                        <input id="bc-expiry" type="date" class="input" style="max-width:220px" @bind="_bcEdit.SecretExpires" disabled="@_bcSaving" />
                                        <small class="field__hint">
                                            Entra shows this when you create the secret (it lasts at most two years).
                                            @if (_bc?.SecretExpiresAt is { } exp)
                                            {
                                                <text> Current: @exp.ToString("yyyy-MM-dd").</text>
                                            }
                                        </small>
                                    </section>
                                    <section class="field">
                                        <label class="field__label" for="bc-tz">Time zone <span class="u-muted">· optional</span></label>
                                        <input id="bc-tz" type="text" class="input" style="max-width:320px" @bind="_bcEdit.TimeZone" disabled="@_bcSaving"
                                               placeholder="e.g. Europe/Copenhagen" />
                                        <small class="field__hint">Local time where the environments are used, so scheduled deliveries land in their working hours. Either form works — <code>Europe/Copenhagen</code> or the Windows name the admin center shows, <code>Romance Standard Time</code>. Blank uses the organisation default.</small>
                                    </section>
                                </div>
                                <div class="form-actions">
                                    <button type="button" class="btn btn--sm btn--primary" @onclick="SaveBcAsync" disabled="@(_bcSaving || _bcTesting)">
                                        <Icon Name="save" Width="14" Height="14" />
                                        <span>@(_bcSaving ? "Saving..." : "Save connection")</span>
                                    </button>
                                    <button type="button" class="btn btn--sm" @onclick="TestConnectionAsync" disabled="@(_bcSaving || _bcTesting || _bc?.IsConfigured != true)">
                                        <Icon Name="plug" Width="14" Height="14" />
                                        <span>@(_bcTesting ? "Testing..." : "Test connection")</span>
                                    </button>
                                    @if (_bc?.VerifiedAt is { } verified)
                                    {
                                        <span class="form-actions__spacer"></span>
                                        <span class="form-actions__note">Last verified @verified.ToLocalTime().ToString("d MMM yyyy · HH:mm")</span>
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="form-sec__head">
                            <span class="section-label">Environments</span>
                            @if (_environments.Count > 0)
                            {
                                <span class="status-pill status-pill--muted" style="margin-left:auto"><span class="status-pill__dot"></span><span>@EnvironmentsSummary()</span></span>
                            }
                        </div>
                        <div class="card pd-env-card">
                            <div class="card__body">
                                @if (_environments.Count == 0)
                                {
                                    <div class="empty-state empty-state--quiet">
                                        <span class="empty-state__title">No environments yet. Save the connection, then <b>Test connection</b> to fetch them.</span>
                                    </div>
                                }
                                else
                                {
                                    @* A table of environments, per the archetype's
                                       rule for lists like this - it scans like every
                                       other table in the toolbox, and the update-window
                                       editor opens as a sub-row underneath the
                                       environment it belongs to. *@
                                    <div class="pd-env-scroll">
                                    <table class="data-table data-table--edge">
                                        <thead>
                                            <tr>
                                                <th class="data-table__col-state"><span class="u-sr">State</span></th>
                                                <th>Environment</th>
                                                <th>Type</th>
                                                <th>Status</th>
                                                <th>Delivery window</th>
                                                <th>Business Central updates</th>
                                                <th class="data-table__actions"><span class="u-sr">Actions</span></th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var env in _environments)
                                            {
                                                var isProd = string.Equals(env.Type, "Production", StringComparison.OrdinalIgnoreCase);
                                                var gone = env.MissingSince is not null;
                                                @* The row's state answers "can I deploy to this right now",
                                                   not just "is it still there" - a green tick beside an
                                                   environment mid-upgrade is the wrong answer to the
                                                   question the consultant is asking. *@
                                                var rowState = gone ? "failed" : EnvRowState(env.Status);
                                                var stateLabel = EnvRowLabel(env, gone);
                                                <tr class="@RowStateIcon.RowClass(rowState)" @key="env.Id">
                                                    @* title as well as aria-label: a glyph's meaning isn't
                                                       discoverable by looking at it, and this column now
                                                       answers "can I deploy to this", not just "is it here". *@
                                                    <td class="data-table__col-state" title="@stateLabel">
                                                        <RowStateIcon State="@rowState" Label="@stateLabel" />
                                                    </td>
                                                    @* The name is the link into Business Central - the
                                                       standard "the name opens the thing" pattern. It also
                                                       keeps the actions cell to the two buttons it can fit
                                                       beside the setup rail; as a third button it pushed the
                                                       row's own actions behind a scrollbar. *@
                                                    <td>
                                                        @if (!gone && !string.IsNullOrWhiteSpace(env.WebClientLoginUrl))
                                                        {
                                                            <a class="pd-env-link" href="@env.WebClientLoginUrl" target="_blank" rel="noopener noreferrer"
                                                               title="Open @env.Name in Business Central">
                                                                <span>@env.Name</span>
                                                                <Icon Name="external-link" Width="13" Height="13" Css="pd-env-link__icon" />
                                                            </a>
                                                        }
                                                        else
                                                        {
                                                            @env.Name
                                                        }
                                                        @if (gone)
                                                        {
                                                            <span class="pd-gone">no longer present</span>
                                                        }
                                                    </td>
                                                    <td>
                                                        @* Production is emphasised, not alarming. Red in this
                                                           table now means "something is wrong with this
                                                           environment" - a Production environment is not a
                                                           problem, it is the one to be careful with. *@
                                                        <span class="status-pill status-pill--muted@(isProd ? " pd-env-prod" : "")">
                                                            <span class="status-pill__dot"></span>
                                                            <span>@env.Type</span>
                                                        </span>
                                                    </td>
                                                    <td>
                                                        @if (string.IsNullOrWhiteSpace(env.Status))
                                                        {
                                                            <span class="status-pill status-pill--muted">
                                                                <span class="status-pill__dot"></span>
                                                                <span>Not checked yet</span>
                                                            </span>
                                                        }
                                                        else
                                                        {
                                                            <span class="status-pill status-pill--@StatusPillTone(env.Status)">
                                                                <span class="status-pill__dot"></span>
                                                                <span>@HumaniseStatus(env.Status)</span>
                                                            </span>
                                                        }
                                                        @if (EnvStatusConsequence(env.Status) is { } consequence && !gone)
                                                        {
                                                            <div class="u-muted pd-env-note">@consequence</div>
                                                        }
                                                        @if (!string.IsNullOrWhiteSpace(env.Version))
                                                        {
                                                            <div class="u-muted pd-env-version">BC version @env.Version</div>
                                                        }
                                                    </td>
                                                    <td>
                                                        @WindowText(env)
                                                        @if (OverlapWarning(env) is { } clash)
                                                        {
                                                            <div class="pd-env-note pd-env-note--warn">
                                                                <Icon Name="triangle-alert" Width="12" Height="12" />
                                                                <span>@clash</span>
                                                            </div>
                                                        }
                                                    </td>
                                                    <td class="u-muted">@BcWindowText(env)</td>
                                                    <td class="data-table__actions">
                                                        @if (!gone)
                                                        {
                                                            <button type="button" class="btn btn--sm" @onclick="() => TogglePanelAsync(env.Id)"
                                                                    aria-expanded="@(_panelEnvId == env.Id ? "true" : "false")">
                                                                <Icon Name="@(_panelEnvId == env.Id ? "chevron-down" : "chevron-right")" Width="14" Height="14" />
                                                                <span>Environment details</span>
                                                            </button>
                                                        }
                                                        @if (!gone && _windowEditEnvId != env.Id)
                                                        {
                                                            <button type="button" class="btn btn--sm" @onclick="() => OpenWindowEditor(env)" disabled="@_bcSaving">Delivery window</button>
                                                        }
                                                    </td>
                                                </tr>
                                                @if (_windowEditEnvId == env.Id)
                                                {
                                                    <tr class="is-subrow" @key="@($"win-{env.Id}")">
                                                        <td colspan="7">
                                                            <div class="pd-window">
                                                                <label class="pd-window__time">From <input type="time" class="input input--sm" @bind="_winStart" disabled="@_bcSaving" /></label>
                                                                <label class="pd-window__time">To <input type="time" class="input input--sm" @bind="_winEnd" disabled="@_bcSaving" /></label>
                                                                <button type="button" class="btn btn--sm" @onclick="() => SaveWindowAsync(env.Id)" disabled="@_bcSaving">Save window</button>
                                                                <button type="button" class="btn btn--sm" @onclick="() => ClearWindowAsync(env.Id)" disabled="@_bcSaving">Clear (any time)</button>
                                                                <button type="button" class="btn btn--sm" @onclick="CancelWindowEdit" disabled="@_bcSaving">Cancel</button>
                                                            </div>
                                                            <small class="field__hint">In the solution's timezone (@(_bc?.TimeZone ?? "set one above")). Deliveries prefill to the next opening; you can still release outside it. A window may run past midnight (e.g. 22:00 to 06:00).</small>
                                                            @if (_windowError is { } we)
                                                            {
                                                                <span class="field-error"><Icon Name="triangle-alert" Width="13" Height="13" />@we</span>
                                                            }
                                                        </td>
                                                    </tr>
                                                }
                                                @if (_panelEnvId == env.Id)
                                                {
                                                    <tr class="is-subrow" @key="@($"panel-{env.Id}")">
                                                        <td colspan="7">
                                                            @if (_panelLoading)
                                                            {
                                                                <div class="loading-block">
                                                                    <span class="spinner"></span>
                                                                    <span>Asking Business Central what's on @env.Name...</span>
                                                                </div>
                                                            }
                                                            else if (_panelError is { } pe)
                                                            {
                                                                <span class="field-error"><Icon Name="triangle-alert" Width="13" Height="13" />@pe</span>
                                                            }
                                                            else if (_panel is { } panel)
                                                            {
                                                                <div class="pd-panel">
                                                                    <div class="pd-panel__head">
                                                                        <span class="u-muted">Read live from Business Central just now. Nothing here is stored.</span>
                                                                        <button type="button" class="btn btn--sm" @onclick="() => LoadPanelAsync(env.Id)">
                                                                            <Icon Name="refresh-cw" Width="13" Height="13" /><span>Refresh</span>
                                                                        </button>
                                                                    </div>

                                                                    <section class="pd-panel__sec">
                                                                        <h3 class="pd-panel__title">Scheduled installs</h3>
                                                                        @if (panel.ScheduledInstallsError is { } scheduledErr)
                                                                        {
                                                                            <span class="field-error"><Icon Name="triangle-alert" Width="13" Height="13" />@scheduledErr</span>
                                                                        }
                                                                        else if (panel.ScheduledInstalls.Count == 0)
                                                                        {
                                                                            <p class="u-muted">Nothing waiting to install.</p>
                                                                        }
                                                                        else
                                                                        {
                                                                            <ul class="pd-panel__list">
                                                                                @foreach (var op in panel.ScheduledInstalls)
                                                                                {
                                                                                    <li>
                                                                                        <span class="pd-panel__name">@(string.IsNullOrWhiteSpace(op.Name) ? "An extension" : op.Name)</span>
                                                                                        <span class="u-muted">@op.TargetAppVersion</span>
                                                                                        <span class="u-muted">@ScheduleWhen(op.ScheduleKind)</span>
                                                                                        @if (op.AppId is { } ourApp && panel.ReleasedAppIds.Contains(ourApp))
                                                                                        {
                                                                                            <span class="pd-panel__ours">released from here</span>
                                                                                        }
                                                                                        @if (op.AppId is { } appId)
                                                                                        {
                                                                                            <button type="button" class="btn btn--sm btn--danger"
                                                                                                    @onclick="() => CancelScheduledAsync(env.Id, appId, op)">Cancel</button>
                                                                                        }
                                                                                    </li>
                                                                                }
                                                                            </ul>
                                                                        }
                                                                        <small class="field__hint">Installs started from inside Business Central's own Extension Management page don't appear here until they finish, and installs scheduled here don't appear there. Use one or the other for a customer, not both.</small>
                                                                    </section>

                                                                    <section class="pd-panel__sec">
                                                                        <h3 class="pd-panel__title">Installed apps</h3>
                                                                        @if (panel.InstalledAppsError is { } installedErr)
                                                                        {
                                                                            <span class="field-error"><Icon Name="triangle-alert" Width="13" Height="13" />@installedErr</span>
                                                                        }
                                                                        else if (panel.InstalledApps.Count == 0)
                                                                        {
                                                                            <p class="u-muted">No apps reported.</p>
                                                                        }
                                                                        else
                                                                        {
                                                                            <ul class="pd-panel__list">
                                                                                @foreach (var app in panel.InstalledApps.OrderByDescending(a => a.IsPerTenant).ThenBy(a => a.Name))
                                                                                {
                                                                                    <li class="@(app.IsPerTenant ? "is-ours" : "")">
                                                                                        <span class="pd-panel__name">@app.Name</span>
                                                                                        <span class="u-muted">@app.Publisher</span>
                                                                                        <span class="u-muted">@app.Version</span>
                                                                                        <span class="u-muted">@app.State</span>
                                                                                        @if (panel.ReleasedAppIds.Contains(app.AppId))
                                                                                        {
                                                                                            <span class="pd-panel__ours">released from here</span>
                                                                                        }
                                                                                        else if (app.IsPerTenant)
                                                                                        {
                                                                                            <span class="pd-panel__ours">per-tenant extension</span>
                                                                                        }
                                                                                    </li>
                                                                                }
                                                                            </ul>
                                                                        }
                                                                    </section>

                                                                    <section class="pd-panel__sec">
                                                                        <h3 class="pd-panel__title">AppSource updates waiting</h3>
                                                                        @if (panel.AvailableUpdatesError is { } updatesErr)
                                                                        {
                                                                            <span class="field-error"><Icon Name="triangle-alert" Width="13" Height="13" />@updatesErr</span>
                                                                        }
                                                                        else if (panel.AvailableUpdates.Count == 0)
                                                                        {
                                                                            <p class="u-muted">No AppSource app has a newer version waiting.</p>
                                                                        }
                                                                        else
                                                                        {
                                                                            <ul class="pd-panel__list">
                                                                                @foreach (var up in panel.AvailableUpdates)
                                                                                {
                                                                                    <li>
                                                                                        <span class="pd-panel__name">@up.Name</span>
                                                                                        <span class="u-muted">@up.Publisher</span>
                                                                                        <span class="u-muted">to @up.Version</span>
                                                                                        @if (up.Requirements.Count > 0)
                                                                                        {
                                                                                            <span class="u-muted">needs @string.Join(", ", up.Requirements.Select(r => r.Name)) first</span>
                                                                                        }
                                                                                    </li>
                                                                                }
                                                                            </ul>
                                                                        }
                                                                        <small class="field__hint">AppSource apps only. Extensions you build and release yourself are never listed here — look under Scheduled installs and Installed apps for those.</small>
                                                                    </section>

                                                                    <section class="pd-panel__sec">
                                                                        <h3 class="pd-panel__title">Settings for this environment</h3>
                                                                        <p class="u-muted pd-panel__warn">
                                                                            <Icon Name="triangle-alert" Width="12" Height="12" />
                                                                            These change @env.Name in the customer's Business Central tenant, not just here.
                                                                        </p>

                                                                        <div class="pd-panel__setting">
                                                                            <label class="field__label" for="@($"cad-{env.Id}")">AppSource apps update cadence</label>
                                                                            <span class="select-wrap">
                                                                                <select id="@($"cad-{env.Id}")" class="select select--sm" @bind="_cadence" disabled="@_settingSaving">
                                                                                    @foreach (var option in BcAppUpdateCadence.All)
                                                                                    {
                                                                                        <option value="@option">@BcAppUpdateCadence.Display(option)</option>
                                                                                    }
                                                                                </select>
                                                                                <Icon Name="chevron-down" Width="14" Height="14" Css="select-wrap__caret" />
                                                                            </span>
                                                                            <button type="button" class="btn btn--sm" disabled="@_settingSaving"
                                                                                    @onclick="() => SaveCadenceAsync(env)">
                                                                                @if (_settingBusy == "cadence")
                                                                                {
                                                                                    <span class="spinner"></span><span>Saving...</span>
                                                                                }
                                                                                else
                                                                                {
                                                                                    <span>Change cadence</span>
                                                                                }
                                                                            </button>
                                                                            <small class="field__hint">How often AppSource apps the customer installed are updated. Doesn't affect extensions you release.</small>
                                                                        </div>

                                                                        <div class="pd-panel__setting">
                                                                            <span class="field__label">Access with Microsoft 365 licences</span>
                                                                            <span>@(_m365 is null ? "Couldn't read this setting" : _m365 == true ? "Allowed" : "Not allowed")</span>
                                                                            @if (_m365 is { } current)
                                                                            {
                                                                                <button type="button" class="btn btn--sm btn--danger" disabled="@_settingSaving"
                                                                                        @onclick="() => SaveM365Async(env, !current)">
                                                                                    @if (_settingBusy == "m365")
                                                                                    {
                                                                                        <span class="spinner"></span><span>Saving...</span>
                                                                                    }
                                                                                    else
                                                                                    {
                                                                                        <span>@(current ? "Stop allowing" : "Allow")</span>
                                                                                    }
                                                                                </button>
                                                                            }
                                                                            <small class="field__hint">
                                                                                @if (_m365 is null)
                                                                                {
                                                                                    <text>Couldn't read this setting - use Refresh above, or check the connection's permissions.</text>
                                                                                }
                                                                                else
                                                                                {
                                                                                    <text>Lets people who hold only a Microsoft 365 licence — no Business Central licence — sign in and read data in this environment.</text>
                                                                                }
                                                                            </small>
                                                                        </div>

                                                                        <div class="pd-panel__setting">
                                                                            <label class="field__label" for="@($"ver-{env.Id}")">Next Business Central update</label>
                                                                            @{
                                                                                var choosable = panel.EnvironmentUpdates.Where(u => u.Available && !u.Selected).ToList();
                                                                            }
                                                                            <span class="select-wrap">
                                                                                <select id="@($"ver-{env.Id}")" class="select select--sm" @bind="_targetVersion"
                                                                                        disabled="@(_settingSaving || choosable.Count == 0)">
                                                                                    <option value="">Choose a version...</option>
                                                                                    @foreach (var option in panel.EnvironmentUpdates.Where(u => u.Available))
                                                                                    {
                                                                                        @* The version already queued is shown so the list matches the
                                                                                           admin center, but picking it would ask BC to change nothing. *@
                                                                                        <option value="@option.TargetVersion" disabled="@option.Selected">@option.TargetVersion@(option.Selected ? " (already next)" : "")</option>
                                                                                    }
                                                                                </select>
                                                                                <Icon Name="chevron-down" Width="14" Height="14" Css="select-wrap__caret" />
                                                                            </span>
                                                                            <button type="button" class="btn btn--sm btn--danger" disabled="@(_settingSaving || string.IsNullOrEmpty(_targetVersion))"
                                                                                    @onclick="() => SaveTargetVersionAsync(env, panel)">
                                                                                @if (_settingBusy == "version")
                                                                                {
                                                                                    <span class="spinner"></span><span>Saving...</span>
                                                                                }
                                                                                else
                                                                                {
                                                                                    <span>Reschedule the update</span>
                                                                                }
                                                                            </button>
                                                                            <small class="field__hint">
                                                                                @if (choosable.Count == 0)
                                                                                {
                                                                                    <text>No other version available to choose right now.</text>
                                                                                }
                                                                                else
                                                                                {
                                                                                    <text>Moves this environment onto a different Business Central version. The upgrade itself runs in Microsoft's update window, not yours.</text>
                                                                                }
                                                                            </small>
                                                                        </div>

                                                                        @if (_settingError is { } se2)
                                                                        {
                                                                            <span class="field-error"><Icon Name="triangle-alert" Width="13" Height="13" />@se2</span>
                                                                        }
                                                                        else if (_settingDone is { } sd)
                                                                        {
                                                                            <span class="pd-panel__done"><Icon Name="circle-check" Width="13" Height="13" />@sd</span>
                                                                        }
                                                                    </section>

                                                                    <section class="pd-panel__sec">
                                                                        <h3 class="pd-panel__title">Business Central updates</h3>
                                                                        @if (panel.EnvironmentUpdatesError is { } platformErr)
                                                                        {
                                                                            <span class="field-error"><Icon Name="triangle-alert" Width="13" Height="13" />@platformErr</span>
                                                                        }
                                                                        else if (panel.EnvironmentUpdates.Count == 0)
                                                                        {
                                                                            <p class="u-muted">Microsoft hasn't announced a next version for this environment.</p>
                                                                        }
                                                                        else
                                                                        {
                                                                            <ul class="pd-panel__list">
                                                                                @foreach (var up in panel.EnvironmentUpdates)
                                                                                {
                                                                                    <li class="@(up.Selected ? "is-ours" : "")">
                                                                                        <span class="pd-panel__name">@up.TargetVersion</span>
                                                                                        <span class="u-muted">@UpdateWhen(up)</span>
                                                                                        @if (up.Selected)
                                                                                        {
                                                                                            <span class="pd-panel__ours">next for this environment</span>
                                                                                        }
                                                                                    </li>
                                                                                }
                                                                            </ul>
                                                                        }
                                                                    </section>

                                                                </div>
                                                            }

                                                            @* Who moved this environment's update dates, and what is still
                                                               booked. Outside the branches above on purpose: this is our own
                                                               record, not Business Central's, so a customer whose tenant we
                                                               can't reach today must not lose the history of what was done to
                                                               it. The same view the Upgrades page shows, so a consultant on one
                                                               customer and the upgrade team on the fleet read the same story.
                                                               Visible to anyone who can see the solution; only the
                                                               environment-updates grant gets a Cancel. *@
                                                            @if (!_panelLoading)
                                                            {
                                                                <section class="pd-panel__sec">
                                                                    <h3 class="pd-panel__title">Update history</h3>
                                                                    <EnvironmentActivityFeed Entries="_activity"
                                                                                             CanAct="_canManageUpdates"
                                                                                             TimeZone="ALDevToolbox.Domain.ValueObjects.ObjectExplorer.UpdateWindow.ResolveTimeZone(_bc?.TimeZone)"
                                                                                             TimeZoneLabel="@(string.IsNullOrWhiteSpace(_bc?.TimeZone) ? "UTC" : _bc!.TimeZone!)"
                                                                                             OnCancel="(id) => CancelUpgradeActionAsync(id, env.Id)" />
                                                                </section>
                                                            }
                                                        </td>
                                                    </tr>
                                                }
                                            }
                                        </tbody>
                                    </table>
                                    </div>
                                    <div class="form-actions">
                                        <button type="button" class="btn btn--sm" @onclick="TestConnectionAsync" disabled="@(_bcSaving || _bcTesting)">
                                            <Icon Name="refresh-cw" Width="14" Height="14" />
                                            <span>Refresh environments</span>
                                        </button>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    @* Two registrations, in two different portals, stand between a valid
                       app registration and a working connection - and only the first is
                       visible from Entra, which is why a setup that looks finished still
                       fails. (It was three until publishing moved to the admin center's
                       app management API, which needs no per-environment registration.)
                       Reference rather than action, so it belongs beside the form, not
                       in it. *@
                    <aside class="settings__aside">
                        <section class="card">
                            <div class="card__head"><div><h2 class="card__title">Before this will connect</h2></div></div>
                            <div class="card__body settings-aside__body">
                                <p class="pd-setup__lead">Business Central has to be told about the app in two separate places. Miss one and Test connection will fail.</p>
                                <ol class="pd-setup">
                                    <li>
                                        <span class="pd-setup__where">Microsoft Entra admin center</span>
                                        <span>Register an app and add the Business Central <b>application</b> permission <code>AdminCenter.ReadWrite.All</code> — not the delegated one, because this connection signs in as the app rather than as a person — then grant admin consent. Create a client secret and copy its value and expiry date into the form: Entra shows the value once and never again.</span>
                                    </li>
                                    <li>
                                        <span class="pd-setup__where">Business Central admin center → Authorized Microsoft Entra apps</span>
                                        <span>Add the client ID and grant consent there too. Until you do, no environments come back.</span>
                                    </li>
                                </ol>
                                <p class="pd-setup__note">Managing this tenant for someone else as their partner? Also add the app to the AdminAgents group in Partner Center, and check that the delegated admin (GDAP) relationship covers Business Central.</p>
                                <a class="btn btn--sm" href="https://learn.microsoft.com/dynamics365/business-central/dev-itpro/administration/administration-center-api" target="_blank" rel="noopener">
                                    <Icon Name="external-link" Width="14" Height="14" />
                                    <span>Microsoft's admin center API docs</span>
                                </a>
                            </div>
                        </section>
                    </aside>
                }
                else if (_section == Section.Pipelines && Id is not null && _canManage)
                {
                    <div class="form-sec__head">
                        <h2 class="card__title">
                            Pipelines
                            <span class="status-pill status-pill--muted"><span class="status-pill__dot"></span><span>@_pipelines.Count pipeline@(_pipelines.Count == 1 ? "" : "s")</span></span>
                        </h2>
                    </div>
                    <p class="form-sec__cap">Build automation for this solution. Each pipeline chooses which extensions to compile; open one to start builds and download its <code>.app</code> files.</p>
                    <div class="card">
                        <div class="card__body">
                            @if (_pipelines.Count == 0)
                            {
                                <div class="empty-state empty-state--quiet">
                                    <span class="empty-state__title">No pipelines yet. Add one to choose which extensions to build and start producing <code>.app</code> files.</span>
                                </div>
                            }
                            else
                            {
                                <div class="sub-rows sub-rows--plain">
                                    @foreach (var pl in _pipelines)
                                    {
                                        <a class="sub-row pd-pipe" href="@($"/pipelines/{pl.Id}")">
                                            <div class="sub-row__stack">
                                                <span class="sub-row__name">@pl.Name</span>
                                                <span class="sub-row__val">@PipelineScope(pl)</span>
                                            </div>
                                            <span class="sub-row__acts">
                                                <Icon Name="chevron-right" Width="16" Height="16" Css="pd-pipe__chev" />
                                            </span>
                                        </a>
                                    }
                                </div>
                            }
                            <div class="form-actions">
                                <button type="button" class="btn btn--sm" @onclick="NewPipelineAsync" disabled="@_saving">
                                    <Icon Name="plus" Width="14" Height="14" />
                                    <span>New pipeline</span>
                                </button>
                            </div>
                        </div>
                    </div>
                }
                else if (_section == Section.Access && Id is not null && _canManage)
                {
                    @* Its own tab rather than a block under General: it saves on its
                       own button, and the header's "Save solution" primary is hidden
                       on any tab that owns its actions (same reason Business Central
                       and Pipelines are tabs). Two save buttons in one view is the
                       thing that rule exists to prevent. *@
                    <div class="form-sec__head">
                        <h2 class="card__title">Who can see this solution</h2>
                    </div>
                    <p class="form-sec__cap">Customer work is often under an NDA. Limit this solution to the people working on that account.</p>
                    @* Tab-local confirmation, the same place and shape the Business
                       Central tab puts its own. The page-level alert above the tab
                       row belongs to Save solution. *@
                    @if (_accessMessage is not null)
                    {
                        <p class="alert alert--success" role="status"><Icon Name="circle-check" Width="16" Height="16" /><span>@_accessMessage</span></p>
                    }
                    <div class="card">
                        <div class="card__body">
                            <section class="field">
                                <div class="check-list pd-choice">
                                    @foreach (var choice in VisibilityChoices)
                                    {
                                        @* Neither of the restricted levels can be saved without a
                                           team, so with none in the org they are shown unavailable
                                           rather than left to fail on Save. *@
                                        var needsTeam = _allTeams.Count == 0 && choice.Value != ProjectVisibility.Public;
                                        <label class="module-card @(_accessEdit.Visibility == choice.Value ? "is-selected" : null) @(needsTeam ? "is-disabled" : null)">
                                            <input type="radio" name="solution-visibility"
                                                   checked="@(_accessEdit.Visibility == choice.Value)"
                                                   @onchange="() => PickVisibility(choice.Value)"
                                                   disabled="@(needsTeam || _savingAccess)" />
                                            <span class="module-card__title">@choice.Label</span>
                                            <span class="module-card__text">@choice.Caption</span>
                                            @if (needsTeam)
                                            {
                                                <span class="module-card__text pd-choice__blocked">Needs a team - none exist yet.</span>
                                            }
                                            <span class="module-card__check"><Icon Name="check" Width="12" Height="12" /></span>
                                        </label>
                                    }
                                </div>
                                <FieldError Field="Visibility" Errors="_accessErrors" />
                                @if (_allTeams.Count == 0)
                                {
                                    @* Belt and braces. The service keys its invariant error to
                                       Teams, and with no teams there is no team list below to
                                       hang it under - so it renders here instead of nowhere. *@
                                    <FieldError Field="Teams" Errors="_accessErrors" />
                                }
                            </section>
                        </div>
                    </div>

                    @if (_accessEdit.Visibility == ProjectVisibility.Public && _allTeams.Count > 0)
                    {
                        @* One quiet line rather than a greyed-out list of teams nobody
                           can tick: the list reappearing when you pick a restricted
                           level is the affordance that says teams matter there. *@
                        <p class="form-sec__cap">Teams don't apply to a public solution.</p>
                    }
                    else
                    {
                        @* With no teams in the org the section stays put even under
                           Public - it is what explains why the other two levels are
                           unavailable, and hiding it would leave that note unexplained. *@
                        <div class="form-sec__head"><span class="section-label">Teams that keep access</span></div>
                        <div class="card">
                            <div class="card__body">
                                @if (_allTeams.Count == 0)
                                {
                                    <div class="empty-state empty-state--quiet">
                                        <span class="empty-state__title">No teams yet</span>
                                        <AuthorizeView Roles="Admin">
                                            <Authorized>
                                                <span class="empty-state__text">
                                                    A team is the group of people who keep access when a solution
                                                    isn't public. <a href="/admin/administration/teams">Create one</a>,
                                                    then come back here.
                                                </span>
                                            </Authorized>
                                            <NotAuthorized>
                                                <span class="empty-state__text">
                                                    A team is the group of people who keep access when a solution isn't
                                                    public. Teams are set up by an admin - you can see your teams and
                                                    their managers on the <a href="/teams">Teams page</a>.
                                                </span>
                                            </NotAuthorized>
                                        </AuthorizeView>
                                    </div>
                                }
                                else
                                {
                                    <p class="form-sec__cap">Pick at least one team. Everyone in the teams you pick keeps full access - you and your admins always do.</p>
                                    <div class="check-list">
                                        @foreach (var team in _allTeams)
                                        {
                                            var picked = _accessEdit.TeamIds.Contains(team.Id);
                                            <label class="module-card @(picked ? "is-selected" : null)">
                                                <input type="checkbox" checked="@picked"
                                                       @onchange="e => ToggleTeam(team.Id, (bool)(e.Value ?? false))"
                                                       disabled="@_savingAccess" />
                                                <span class="module-card__title">@team.Name</span>
                                                <span class="module-card__text">@TeamRoster(team)</span>
                                                <span class="module-card__check"><Icon Name="check" Width="12" Height="12" /></span>
                                            </label>
                                        }
                                    </div>
                                    <FieldError Field="Teams" Errors="_accessErrors" />
                                }
                            </div>
                        </div>
                    }

                    @* Below both cards rather than inside the second one: it saves the
                       whole tab, not the team list. Sized like the Business Central
                       tab's own save - the header's primary is hidden on any tab that
                       owns its actions, and this page keeps one primary at a time. *@
                    @if (_allTeams.Count > 0)
                    {
                        <div class="form-actions">
                            <button type="button" class="btn btn--sm" @onclick="SaveAccessAsync"
                                    disabled="@(_savingAccess || !AccessDirty)">
                                <Icon Name="save" Width="14" Height="14" />
                                <span>@(_savingAccess ? "Saving..." : "Save access")</span>
                            </button>
                            @if (AccessDirty && !_savingAccess)
                            {
                                <button type="button" class="btn btn--ghost btn--sm" @onclick="DiscardAccessAsync">
                                    <span>Discard changes</span>
                                </button>
                            }
                        </div>
                    }
                }
            </div>
        </div>
    }
</div>

<PipelineEditorDialog @ref="_editor" OnSaved="OnPipelineCreatedAsync" />
<ConfirmDialog @ref="_cancelInstallConfirm" />
<ConfirmDialog @ref="_settingConfirm" />

@code {
    [Parameter] public int? Id { get; set; }

    private enum Section { General, Repos, Bc, Pipelines, Access }
    private Section _section = Section.General;

    /// <summary>
    /// Only the Business Central tab has anything to put in the 280px rail, and an
    /// empty rail would stop the other tabs' cards short of the page edge for no
    /// reason a reader could see - so the column is reserved per section, not per page.
    /// </summary>
    private bool ShowBcAside => _section == Section.Bc && Id is not null && _canManage;

    /// <summary>
    /// The section tab row. Every tab carries OnSelected rather than an Href:
    /// see the note above the markup - General and Repositories share one Save,
    /// so a real navigation between them would drop unsaved edits.
    ///
    /// Labels only, as archetype 7 renders them. The left rail this replaced
    /// also carried a repository count and a dot for the Business Central
    /// connection; the count is already in the page head's sub-line, and the
    /// dot is a deliberate loss rather than a badge bolted onto a tab row the
    /// design system renders as plain text.
    /// </summary>
    private List<HeaderTabs.HeaderTabItem> SectionTabs
    {
        get
        {
            var tabs = new List<HeaderTabs.HeaderTabItem>
            {
                Tab("General", Section.General),
                Tab("Repositories", Section.Repos),
            };

            if (Id is not null && _canManage)
            {
                tabs.Add(Tab("Business Central", Section.Bc));
                tabs.Add(Tab("Pipelines", Section.Pipelines));
                tabs.Add(Tab("Access", Section.Access));
                }

            return tabs;
        }
    }

    private HeaderTabs.HeaderTabItem Tab(string label, Section section) =>
        new(label, Href: null, IsActive: _section == section,
            OnSelected: EventCallback.Factory.Create(this, () => _section = section));

    /// <summary>
    /// The label beside the solution name, or null for Public. Read off the loaded
    /// solution so a viewer who can't manage it still sees why the page looks the
    /// way it does.
    /// </summary>
    private string? VisibilityBadge => _loadedProject?.Visibility switch
    {
        ProjectVisibility.Private => "Private",
        ProjectVisibility.ReadOnly => "Read-only",
