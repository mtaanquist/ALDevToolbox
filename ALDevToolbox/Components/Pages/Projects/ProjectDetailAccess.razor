@inject ALDevToolbox.Services.ObjectExplorer.ProjectService Projects
@inject ILogger<ProjectDetailAccess> Log
@using ALDevToolbox.Domain.Entities.ObjectExplorer
@using ALDevToolbox.Domain.ValueObjects
@using ALDevToolbox.Services
@using ALDevToolbox.Services.ObjectExplorer

@*
    The Access tab of a solution's settings: who can see it, and which teams keep
    access when it isn't public.

    Named user: the BC consultant who owns a customer engagement under an NDA and
    has to keep the solution to the people working that account.

    Its own tab rather than a block under General: it saves on its
    own button, and the header's "Save solution" primary is hidden
    on any tab that owns its actions (same reason Business Central
    and Pipelines are tabs). Two save buttons in one view is the
    thing that rule exists to prevent.

    The teams and the saved settings are read by the page with the solution, so
    they arrive as parameters; the edit in progress, its errors and the write are
    this tab's own. A successful save raises OnSaved so the page can re-read the
    baseline and move the badge beside the solution name.
*@

<div class="form-sec__head">
    <h2 class="card__title">Who can see this solution</h2>
</div>
<p class="form-sec__cap">Customer work is often under an NDA. Limit this solution to the people working on that account.</p>
@* Tab-local confirmation, the same place and shape the Business
   Central tab puts its own. The page-level alert above the tab
   row belongs to Save solution. *@
@if (_accessMessage is not null)
{
    <p class="alert alert--success" role="status"><Icon Name="circle-check" Width="16" Height="16" /><span>@_accessMessage</span></p>
}
<div class="card">
    <div class="card__body">
        <section class="field">
            <div class="check-list pd-choice">
                @foreach (var choice in VisibilityChoices)
                {
                    @* Neither of the restricted levels can be saved without a
                       team, so with none in the org they are shown unavailable
                       rather than left to fail on Save. *@
                    var needsTeam = AllTeams.Count == 0 && choice.Value != ProjectVisibility.Public;
                    <label class="module-card @(_accessEdit.Visibility == choice.Value ? "is-selected" : null) @(needsTeam ? "is-disabled" : null)">
                        <input type="radio" name="solution-visibility"
                               checked="@(_accessEdit.Visibility == choice.Value)"
                               @onchange="() => PickVisibility(choice.Value)"
                               disabled="@(needsTeam || _savingAccess)" />
                        <span class="module-card__title">@choice.Label</span>
                        <span class="module-card__text">@choice.Caption</span>
                        @if (needsTeam)
                        {
                            <span class="module-card__text pd-choice__blocked">Needs a team - none exist yet.</span>
                        }
                        <span class="module-card__check"><Icon Name="check" Width="12" Height="12" /></span>
                    </label>
                }
            </div>
            <FieldError Field="Visibility" Errors="_accessErrors" />
            @if (AllTeams.Count == 0)
            {
                @* Belt and braces. The service keys its invariant error to
                   Teams, and with no teams there is no team list below to
                   hang it under - so it renders here instead of nowhere. *@
                <FieldError Field="Teams" Errors="_accessErrors" />
            }
        </section>
    </div>
</div>

@if (_accessEdit.Visibility == ProjectVisibility.Public && AllTeams.Count > 0)
{
    @* One quiet line rather than a greyed-out list of teams nobody
       can tick: the list reappearing when you pick a restricted
       level is the affordance that says teams matter there. *@
    <p class="form-sec__cap">Teams don't apply to a public solution.</p>
}
else
{
    @* With no teams in the org the section stays put even under
       Public - it is what explains why the other two levels are
       unavailable, and hiding it would leave that note unexplained. *@
    <div class="form-sec__head"><span class="section-label">Teams that keep access</span></div>
    <div class="card">
        <div class="card__body">
            @if (AllTeams.Count == 0)
            {
                <div class="empty-state empty-state--quiet">
                    <span class="empty-state__title">No teams yet</span>
                    <AuthorizeView Roles="Admin">
                        <Authorized>
                            <span class="empty-state__text">
                                A team is the group of people who keep access when a solution
                                isn't public. <a href="/admin/administration/teams">Create one</a>,
                                then come back here.
                            </span>
                        </Authorized>
                        <NotAuthorized>
                            <span class="empty-state__text">
                                A team is the group of people who keep access when a solution isn't
                                public. Teams are set up by an admin - you can see your teams and
                                their managers on the <a href="/teams">Teams page</a>.
                            </span>
                        </NotAuthorized>
                    </AuthorizeView>
                </div>
            }
            else
            {
                <p class="form-sec__cap">Pick at least one team. Everyone in the teams you pick keeps full access - you and your admins always do.</p>
                <div class="check-list">
                    @foreach (var team in AllTeams)
                    {
                        var picked = _accessEdit.TeamIds.Contains(team.Id);
                        <label class="module-card @(picked ? "is-selected" : null)">
                            <input type="checkbox" checked="@picked"
                                   @onchange="e => ToggleTeam(team.Id, (bool)(e.Value ?? false))"
                                   disabled="@_savingAccess" />
                            <span class="module-card__title">@team.Name</span>
                            <span class="module-card__text">@TeamRoster(team)</span>
                            <span class="module-card__check"><Icon Name="check" Width="12" Height="12" /></span>
                        </label>
                    }
                </div>
                <FieldError Field="Teams" Errors="_accessErrors" />
            }
        </div>
    </div>
}

@* Below both cards rather than inside the second one: it saves the
   whole tab, not the team list. Sized like the Business Central
   tab's own save - the header's primary is hidden on any tab that
   owns its actions, and this page keeps one primary at a time. *@
@if (AllTeams.Count > 0)
{
    <div class="form-actions">
        <button type="button" class="btn btn--sm" @onclick="SaveAccessAsync"
                disabled="@(_savingAccess || !AccessDirty)">
            <Icon Name="save" Width="14" Height="14" />
            <span>@(_savingAccess ? "Saving..." : "Save access")</span>
        </button>
        @if (AccessDirty && !_savingAccess)
        {
            <button type="button" class="btn btn--ghost btn--sm" @onclick="DiscardAccessAsync">
                <span>Discard changes</span>
            </button>
        }
    </div>
}

@code {
    /// <summary>The solution whose access this tab sets.</summary>
    [Parameter, EditorRequired] public int Id { get; set; }

    /// <summary>Every team in the organisation, read by the page.</summary>
    [Parameter] public IReadOnlyList<TeamListRow> AllTeams { get; set; } = Array.Empty<TeamListRow>();

    /// <summary>
    /// The saved access settings. A fresh instance means "re-read from the
    /// database", which is what puts the form back after a save or a discard.
    /// </summary>
    [Parameter] public ProjectAccessSettings? Baseline { get; set; }

    /// <summary>
    /// Raised after a successful save, with the level now in force: the page
    /// re-reads the baseline and moves the badge beside the solution name.
    /// </summary>
    [Parameter] public EventCallback<ProjectVisibility> OnSaved { get; set; }

    // Access (visibility + teams). Its own error dictionary so the two field
    // keys the service throws (Visibility / Teams) render inline next to the
    // control rather than in the page-wide alert at the top.
    private AccessEdit _accessEdit = new();
    private ProjectAccessSettings? _appliedBaseline;
    private bool _savingAccess;
    private string? _accessMessage;
    private Dictionary<string, string> _accessErrors = new();

    private sealed class AccessEdit
    {
        public ProjectVisibility Visibility { get; set; } = ProjectVisibility.Public;
        public HashSet<int> TeamIds { get; } = new();
    }

    /// <summary>
    /// True when the form differs from what was loaded. Gates the save so the
    /// button can't fire a write that changes nothing, and shows the discard
    /// action only when there is something to discard.
    /// </summary>
    private bool AccessDirty =>
        Baseline is { } baseline
        && (_accessEdit.Visibility != baseline.Visibility
            || !_accessEdit.TeamIds.SetEquals(baseline.TeamIds));

    /// <summary>
    /// The three levels with the copy a solution owner reads, in the order they
    /// widen the fence. Labels say what the reader gets, not what the enum is
    /// called.
    /// </summary>
    /// <summary>
    /// The three levels with the copy a solution owner reads, in the order they
    /// tighten the fence. Each caption answers the same two questions in the same
    /// order - who can see it, then who can change it - so the reader compares
    /// three sentences rather than parsing three shapes. Public has no teams by
    /// the model's invariant, which is why only it says "you and the admins".
    /// </summary>
    private static readonly (ProjectVisibility Value, string Label, string Caption)[] VisibilityChoices =
    {
        (ProjectVisibility.Public, "Public",
            "Anyone in your organisation can see it and download its builds. Only you and the admins can change it."),
        (ProjectVisibility.ReadOnly, "Read-only for others",
            "Anyone can see it and download builds. Only the teams you pick below, you, and the admins can change it or run builds."),
        (ProjectVisibility.Private, "Private",
            "Only the teams you pick below, you, and the admins can see it. Everyone else sees just the name in the solution list."),
    };

    /// <summary>
    /// A team card's second line: who is actually on it. Picking the wrong team is
    /// the failure this tab exists to prevent, and two names catch it where a
    /// count does not. Falls back to the count for a team with nobody on it.
    /// </summary>
    private static string TeamRoster(TeamListRow team) =>
        team.MemberCount == 0 ? "No members yet" : team.MemberSummary();

    /// <summary>
    /// Re-hydrates the form whenever the page hands down a baseline it hasn't
    /// applied yet - the first render, and every re-read after a save. Compared by
    /// reference on purpose: the page builds a fresh instance per read, and a
    /// value comparison would miss a re-read that happened to land on the same
    /// answer, leaving a half-edited form claiming to be saved.
    /// </summary>
    protected override void OnParametersSet()
    {
        if (ReferenceEquals(_appliedBaseline, Baseline)) return;
        _appliedBaseline = Baseline;
        ResetAccessEdit();
    }

    private void PickVisibility(ProjectVisibility visibility)
    {
        _accessEdit.Visibility = visibility;
        // Choosing Public clears the picks rather than keeping them greyed but
        // set: the service refuses Public-with-teams, and a disabled control
        // still holding values is a trap on the next save.
        if (visibility == ProjectVisibility.Public) _accessEdit.TeamIds.Clear();
    }

    private void ToggleTeam(int teamId, bool on)
    {
        if (on) _accessEdit.TeamIds.Add(teamId);
        else _accessEdit.TeamIds.Remove(teamId);
    }

    private void ResetAccessEdit()
    {
        var baseline = Baseline ?? new ProjectAccessSettings(ProjectVisibility.Public, Array.Empty<int>());
        _accessEdit = new AccessEdit { Visibility = baseline.Visibility };
        foreach (var id in baseline.TeamIds) _accessEdit.TeamIds.Add(id);
    }

    private Task DiscardAccessAsync()
    {
        ResetAccessEdit();
        _accessErrors = new();
        _accessMessage = null;
        return Task.CompletedTask;
    }

    private async Task SaveAccessAsync()
    {
        if (_savingAccess) return;
        _savingAccess = true;
        _accessMessage = null;
        _accessErrors = new();
        try
        {
            await Projects.SetAccessAsync(Id, _accessEdit.Visibility, _accessEdit.TeamIds.ToList());
            // The page re-reads the baseline and refreshes the header badge: the
            // level the whole page reports just moved.
            await OnSaved.InvokeAsync(_accessEdit.Visibility);
            _accessMessage = "Access saved.";
        }
        catch (PlanValidationException ex)
        {
            _accessErrors = new(ex.Errors);
        }
        catch (ProjectAccessDeniedException)
        {
            _accessErrors = new() { ["Visibility"] = "Only the solution owner or an admin can change who sees this solution." };
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "Failed to save access for solution {ProjectId}.", Id);
            _accessErrors = new() { ["Visibility"] = "An unexpected error occurred. The change was not saved." };
        }
        finally
        {
            _savingAccess = false;
        }
    }
}
