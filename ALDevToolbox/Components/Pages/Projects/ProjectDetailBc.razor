@inject ALDevToolbox.Services.ObjectExplorer.Bc.ProjectConnectionService Connection
@inject ILogger<ProjectDetailBc> Log
@using ALDevToolbox.Domain.ValueObjects
@using ALDevToolbox.Domain.ValueObjects.ObjectExplorer
@using ALDevToolbox.Services
@using ALDevToolbox.Services.ObjectExplorer
@using ALDevToolbox.Services.ObjectExplorer.Bc

@*
    The Business Central tab of a solution's settings: the connection to the
    tenant this solution delivers to, the environments it reports, and the
    per-environment reads and writes a consultant makes against them.

    Named user: the BC consultant who has just been given a customer's tenant
    and is wiring the toolbox up to it, then coming back to check what is
    installed and when the next update lands.

    Owner and admin only - the page decides that and renders the tab at all
    only then. Everything here is this tab's own: it saves on its own buttons,
    so the page header's "Save solution" primary is hidden while it is open.
    The tab reads its own connection and environments rather than taking them
    from the page, because nothing outside it uses them.
*@

@* The Business Central section is the one tab with a rail, so the
   body drops --wide only here. The content is wrapped because the
   grid needs the main column to be a single item. *@
<div class="pd-bc">
    <div class="form-sec__head">
        <h2 class="card__title">
            Business Central
            @if (_bc?.IsConfigured == true)
            {
                <StatusPill Tone="success"><span>Connected</span></StatusPill>
            }
            else
            {
                <StatusPill Tone="muted"><span>Not connected</span></StatusPill>
            }
        </h2>
    </div>
    <p class="form-sec__cap">Connect the Business Central tenant this solution delivers to - your own or a customer's. The client secret is stored encrypted and never shown again.</p>

    @if (_bcMessage is not null)
    {
        <Alert Tone="@(_bcOk ? AlertTone.Success : AlertTone.Danger)" Role="status"><span>@_bcMessage</span></Alert>
    }
    @if (_bcErrors.Count > 0)
    {
        <Alert Tone="AlertTone.Danger" Icon="" Block="true">
            @foreach (var err in _bcErrors.Values.Distinct())
            {
                <p>@err</p>
            }
        </Alert>
    }

    <div class="card">
        <div class="card__body">
            <div class="form-grid">
                <section class="field">
                    <label class="field__label" for="bc-tenant">Tenant ID</label>
                    <input id="bc-tenant" type="text" class="input" @bind="_bcEdit.TenantId" disabled="@_bcSaving"
                           placeholder="00000000-0000-0000-0000-000000000000" />
                    <small class="field__hint">The Microsoft Entra tenant that owns the Business Central environments — its Directory (tenant) ID, from the app registration's Overview page in Entra.</small>
                </section>
                <section class="field">
                    <label class="field__label" for="bc-client">Client ID</label>
                    <input id="bc-client" type="text" class="input" @bind="_bcEdit.ClientId" disabled="@_bcSaving"
                           placeholder="the app registration's application (client) ID" />
                    <small class="field__hint">From the app registration set up for service-to-service access. See the steps beside this form.</small>
                </section>
                <section class="field">
                    <label class="field__label" for="bc-secret">Client secret</label>
                    <input id="bc-secret" type="password" class="input" @bind="_bcEdit.Secret" disabled="@_bcSaving"
                           placeholder="@(_bc?.HasSecret == true ? "•••••••• (leave blank to keep)" : "the app registration's client secret")" />
                    <small class="field__hint">@(_bc?.HasSecret == true ? "A secret is stored. Enter a new one only to replace it." : "Stored encrypted; never shown again.")</small>
                </section>
                <section class="field">
                    <label class="field__label" for="bc-expiry">Secret expires</label>
                    <input id="bc-expiry" type="date" class="input" style="max-width:220px" @bind="_bcEdit.SecretExpires" disabled="@_bcSaving" />
                    <small class="field__hint">
                        Entra shows this when you create the secret (it lasts at most two years).
                        @if (_bc?.SecretExpiresAt is { } exp)
                        {
                            <text> Current: @exp.ToString("yyyy-MM-dd").</text>
                        }
                    </small>
                </section>
                <section class="field">
                    <label class="field__label" for="bc-tz">Time zone <span class="u-muted">· optional</span></label>
                    <input id="bc-tz" type="text" class="input" style="max-width:320px" @bind="_bcEdit.TimeZone" disabled="@_bcSaving"
                           placeholder="e.g. Europe/Copenhagen" />
                    <small class="field__hint">Local time where the environments are used, so scheduled deliveries land in their working hours. Either form works — <code>Europe/Copenhagen</code> or the Windows name the admin center shows, <code>Romance Standard Time</code>. Blank uses the organisation default.</small>
                </section>
            </div>
            <div class="form-actions">
                <button type="button" class="btn btn--sm btn--primary" @onclick="SaveBcAsync" disabled="@(_bcSaving || _bcTesting)">
                    <Icon Name="save" Width="14" Height="14" />
                    <span>@(_bcSaving ? "Saving..." : "Save connection")</span>
                </button>
                <button type="button" class="btn btn--sm" @onclick="TestConnectionAsync" disabled="@(_bcSaving || _bcTesting || _bc?.IsConfigured != true)">
                    <Icon Name="plug" Width="14" Height="14" />
                    <span>@(_bcTesting ? "Testing..." : "Test connection")</span>
                </button>
                @if (_bc?.VerifiedAt is { } verified)
                {
                    <span class="form-actions__spacer"></span>
                    <span class="form-actions__note">Last verified @verified.ToLocalTime().ToString("d MMM yyyy · HH:mm")</span>
                }
            </div>
        </div>
    </div>

    <div class="form-sec__head">
        <span class="section-label">Environments</span>
        @if (_environments.Count > 0)
        {
            <StatusPill Tone="muted" style="margin-left:auto"><span>@EnvironmentsSummary()</span></StatusPill>
        }
    </div>
    <div class="card pd-env-card">
        <div class="card__body">
            @if (_environments.Count == 0)
            {
                <div class="empty-state empty-state--quiet">
                    <span class="empty-state__title">No environments yet. Save the connection, then <b>Test connection</b> to fetch them.</span>
                </div>
            }
            else
            {
                @* A table of environments, per the archetype's
                   rule for lists like this - it scans like every
                   other table in the toolbox, and the update-window
                   editor opens as a sub-row underneath the
                   environment it belongs to. *@
                <div class="pd-env-scroll">
                <table class="data-table data-table--edge">
                    <thead>
                        <tr>
                            <th class="data-table__col-state"><span class="u-sr">State</span></th>
                            <th>Environment</th>
                            <th>Type</th>
                            <th>Status</th>
                            <th>Delivery window</th>
                            <th>Microsoft's update window</th>
                            <th class="data-table__actions"><span class="u-sr">Actions</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var env in _environments)
                        {
                            var isProd = string.Equals(env.Type, "Production", StringComparison.OrdinalIgnoreCase);
                            var gone = env.MissingSince is not null;
                            @* The row's state answers "can I deploy to this right now",
                               not just "is it still there" - a green tick beside an
                               environment mid-upgrade is the wrong answer to the
                               question the consultant is asking. *@
                            var rowState = gone ? "failed" : EnvRowState(env.Status);
                            var stateLabel = EnvRowLabel(env, gone);
                            <tr class="@RowStateIcon.RowClass(rowState)" @key="env.Id">
                                @* title as well as aria-label: a glyph's meaning isn't
                                   discoverable by looking at it, and this column now
                                   answers "can I deploy to this", not just "is it here". *@
                                <td class="data-table__col-state" title="@stateLabel">
                                    <RowStateIcon State="@rowState" Label="@stateLabel" />
                                </td>
                                @* The name is the link into Business Central - the
                                   standard "the name opens the thing" pattern. It also
                                   keeps the actions cell to the two buttons it can fit
                                   beside the setup rail; as a third button it pushed the
                                   row's own actions behind a scrollbar. *@
                                <td>
                                    @if (!gone && !string.IsNullOrWhiteSpace(env.WebClientLoginUrl))
                                    {
                                        <a class="pd-env-link" href="@env.WebClientLoginUrl" target="_blank" rel="noopener noreferrer"
                                           title="Open @env.Name in Business Central">
                                            <span>@env.Name</span>
                                            <Icon Name="external-link" Width="13" Height="13" Css="pd-env-link__icon" />
                                        </a>
                                    }
                                    else
                                    {
                                        @env.Name
                                    }
                                    @if (gone)
                                    {
                                        <span class="pd-gone">no longer present</span>
                                    }
                                </td>
                                <td>
                                    @* Production is emphasised, not alarming. Red in this
                                       table now means "something is wrong with this
                                       environment" - a Production environment is not a
                                       problem, it is the one to be careful with. *@
                                    <StatusPill Tone="muted" Class="@(isProd ? "pd-env-prod" : null)">
                                        <span>@env.Type</span>
                                    </StatusPill>
                                </td>
                                <td>
                                    @if (string.IsNullOrWhiteSpace(env.Status))
                                    {
                                        <StatusPill Tone="muted">
                                            <span>Not checked yet</span>
                                        </StatusPill>
                                    }
                                    else
                                    {
                                        <StatusPill Tone="@StatusPillTone(env.Status)">
                                            <span>@HumaniseStatus(env.Status)</span>
                                        </StatusPill>
                                    }
                                    @if (EnvStatusConsequence(env.Status) is { } consequence && !gone)
                                    {
                                        <div class="u-muted pd-env-note">@consequence</div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(env.Version))
                                    {
                                        <div class="u-muted pd-env-version">BC version @env.Version</div>
                                    }
                                </td>
                                <td>
                                    @WindowText(env)
                                    @if (OverlapWarning(env) is { } clash)
                                    {
                                        <div class="pd-env-note pd-env-note--warn">
                                            <Icon Name="triangle-alert" Width="12" Height="12" />
                                            <span>@clash</span>
                                        </div>
                                    }
                                </td>
                                <td class="u-muted">@BcWindowText(env)</td>
                                <td class="data-table__actions">
                                    @if (!gone)
                                    {
                                        @* Apps, updates waiting and the settings that write to the
                                           customer's tenant have a page of their own now; the row
                                           links to it rather than unfolding a second copy here. *@
                                        <a class="btn btn--sm" href="@($"/environments/{env.Id}")">
                                            <Icon Name="chevron-right" Width="14" Height="14" />
                                            <span>Environment details</span>
                                        </a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                </div>
                <div class="form-actions">
                    <button type="button" class="btn btn--sm" @onclick="TestConnectionAsync" disabled="@(_bcSaving || _bcTesting)">
                        <Icon Name="refresh-cw" Width="14" Height="14" />
                        <span>Refresh environments</span>
                    </button>
                </div>
            }
        </div>
    </div>
</div>

@* Two registrations, in two different portals, stand between a valid
   app registration and a working connection - and only the first is
   visible from Entra, which is why a setup that looks finished still
   fails. (It was three until publishing moved to the admin center's
   app management API, which needs no per-environment registration.)
   Reference rather than action, so it belongs beside the form, not
   in it. *@
<aside class="settings__aside">
    <section class="card">
        <div class="card__head"><div><h2 class="card__title">Before this will connect</h2></div></div>
        <div class="card__body settings-aside__body">
            <p class="pd-setup__lead">Business Central has to be told about the app in two separate places. Miss one and Test connection will fail.</p>
            <ol class="pd-setup">
                <li>
                    <span class="pd-setup__where">Microsoft Entra admin center</span>
                    <span>Register an app and add the Business Central <b>application</b> permission <code>AdminCenter.ReadWrite.All</code> — not the delegated one, because this connection signs in as the app rather than as a person — then grant admin consent. Create a client secret and copy its value and expiry date into the form: Entra shows the value once and never again.</span>
                </li>
                <li>
                    <span class="pd-setup__where">Business Central admin center → Authorized Microsoft Entra apps</span>
                    <span>Add the client ID and grant consent there too. Until you do, no environments come back.</span>
                </li>
            </ol>
            <p class="pd-setup__note">Managing this tenant for someone else as their partner? Also add the app to the AdminAgents group in Partner Center, and check that the delegated admin (GDAP) relationship covers Business Central.</p>
            <a class="btn btn--sm" href="https://learn.microsoft.com/dynamics365/business-central/dev-itpro/administration/administration-center-api" target="_blank" rel="noopener">
                <Icon Name="external-link" Width="14" Height="14" />
                <span>Microsoft's admin center API docs</span>
            </a>
        </div>
    </section>
</aside>

@code {
    /// <summary>The solution whose Business Central connection this tab manages.</summary>
    [Parameter, EditorRequired] public int Id { get; set; }

    // Business Central connection (owner/admin only).
    private BcConnectionStatus? _bc;
    private BcEdit _bcEdit = new();
    private bool _bcSaving;
    private bool _bcTesting;
    private bool _bcOk;
    private string? _bcMessage;
    private Dictionary<string, string> _bcErrors = new();
    private List<ProjectEnvironmentRow> _environments = new();

    protected override async Task OnInitializedAsync() => await LoadBcAsync();

    private async Task LoadBcAsync()
    {
        _bc = await Connection.GetConnectionAsync(Id);
        _environments = (await Connection.ListEnvironmentsAsync(Id)).ToList();
        HydrateBcEdit();
    }

    private void HydrateBcEdit()
    {
        _bcEdit = new BcEdit
        {
            TenantId = _bc?.TenantId?.ToString() ?? string.Empty,
            ClientId = _bc?.ClientId ?? string.Empty,
            Secret = string.Empty,
            SecretExpires = _bc?.SecretExpiresAt?.Date,
            TimeZone = _bc?.TimeZone ?? string.Empty,
        };
    }

    private async Task SaveBcAsync()
    {
        if (_bcSaving) return;
        _bcSaving = true;
        _bcMessage = null;
        _bcErrors = new();
        try
        {
            Guid? tenant = null;
            if (!string.IsNullOrWhiteSpace(_bcEdit.TenantId))
            {
                if (Guid.TryParse(_bcEdit.TenantId.Trim(), out var g)) tenant = g;
                else _bcErrors["BcTenantId"] = "That doesn't look like a tenant ID. It should look like 00000000-0000-0000-0000-000000000000.";
            }
            if (_bcErrors.Count == 0)
            {
                var expires = _bcEdit.SecretExpires is { } d ? DateTime.SpecifyKind(d, DateTimeKind.Utc) : (DateTime?)null;
                var input = new BcConnectionInput(
                    tenant,
                    _bcEdit.ClientId,
                    string.IsNullOrWhiteSpace(_bcEdit.Secret) ? null : _bcEdit.Secret,
                    expires,
                    string.IsNullOrWhiteSpace(_bcEdit.TimeZone) ? null : _bcEdit.TimeZone);
                await Connection.SaveConnectionAsync(Id, input);
                await LoadBcAsync();
                _bcOk = true;
                _bcMessage = "Connection saved. Test it to fetch this solution's environments.";
            }
        }
        catch (PlanValidationException ex)
        {
            _bcErrors = new(ex.Errors);
        }
        catch (ProjectAccessDeniedException)
        {
            _bcErrors = new() { ["_"] = "Only the solution owner or an admin can change the connection." };
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "Failed to save BC connection for solution {ProjectId}.", Id);
            _bcErrors = new() { ["_"] = "An unexpected error occurred. The connection was not saved." };
        }
        finally
        {
            _bcSaving = false;
        }
    }

    private async Task TestConnectionAsync()
    {
        if (_bcTesting) return;
        _bcTesting = true;
        _bcMessage = null;
        _bcErrors = new();
        try
        {
            var result = await Connection.TestConnectionAsync(Id);
            _bcOk = result.IsSuccess;
            _bcMessage = result.Message;
            await LoadBcAsync();
        }
        catch (ProjectAccessDeniedException)
        {
            _bcErrors = new() { ["_"] = "Only the solution owner or an admin can test the connection." };
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "Failed to test BC connection for solution {ProjectId}.", Id);
            _bcErrors = new() { ["_"] = "An unexpected error occurred while testing the connection." };
        }
        finally
        {
            _bcTesting = false;
        }
    }


    /// <summary>
    /// The environments header pill: how many, and how fresh. The statuses and versions
    /// in the table are only as good as the last fetch, so the count alone would invite
    /// trusting a stale row. Uses the newest <c>FetchedAt</c> across the rows, since a
    /// Refresh stamps them together.
    /// </summary>
    private string EnvironmentsSummary()
    {
        var count = _environments.Count;
        var noun = count == 1 ? "environment" : "environments";
        var newest = _environments.Max(e => e.FetchedAt);
        return $"{count} {noun} · checked {ALDevToolbox.Components.Shared.RelativeTime.Ago(newest)}";
    }

    /// <summary>
    /// The row's state family, from what Business Central says the environment is doing.
    /// An unknown status takes the neutral not-connected state rather than the green
    /// tick: we haven't checked, and "we don't know" must not read as "ready". The
    /// delivery gate still lets an unknown status through — that's deliberate, and this
    /// is presentation only.
    /// </summary>
    private static string EnvRowState(string? status) => BcEnvironmentStatus.Classify(status) switch
    {
        BcEnvironmentReadiness.Busy => "running",
        BcEnvironmentReadiness.Deleting or BcEnvironmentReadiness.Failed => "failed",
        BcEnvironmentReadiness.Unknown => "not-connected",
        _ => "connected",
    };

    /// <summary>Reads a machine-cased status as a sentence; shared with the release-pipeline editor.</summary>
    private static string HumaniseStatus(string? status) => BcEnvironmentStatus.Humanise(status);

    /// <summary>
    /// What a non-ready status means for the thing the consultant came to do. The pill
    /// names the state; this names the consequence.
    /// </summary>
    private static string? EnvStatusConsequence(string? status) => BcEnvironmentStatus.Classify(status) switch
    {
        BcEnvironmentReadiness.Busy => "Deliveries are paused while this upgrades.",
        BcEnvironmentReadiness.Deleting => "Deliveries are refused while this is being removed.",
        BcEnvironmentReadiness.Failed => "Deliveries are refused until this is fixed in Business Central.",
        _ => null,
    };

    /// <summary>
    /// The accessible name for the row's state glyph, and its hover title — why this row
    /// is the colour it is. Sighted users can't discover a glyph's meaning by looking at
    /// it, so the same sentence is the tooltip.
    /// </summary>
    private static string EnvRowLabel(ProjectEnvironmentRow env, bool gone)
    {
        if (gone) return "No longer present in Business Central";
        var shown = HumaniseStatus(env.Status);
        return BcEnvironmentStatus.Classify(env.Status) switch
        {
            BcEnvironmentReadiness.Busy => $"Busy in Business Central ({shown}) - deliveries are paused",
            BcEnvironmentReadiness.Deleting => $"Being removed in Business Central ({shown}) - deliveries are refused",
            BcEnvironmentReadiness.Failed => $"In a failed state in Business Central ({shown}) - deliveries are refused",
            BcEnvironmentReadiness.Unknown => "Not checked yet - refresh to see whether this is ready",
            _ => "Ready to deliver to",
        };
    }

    /// <summary>
    /// Pill tone for an environment's Business Central status, so a consultant can tell
    /// at a glance whether a release will go through. Classification lives in
    /// <see cref="BcEnvironmentStatus"/> — the same one the delivery gate uses, so the
    /// badge and the refusal never disagree.
    /// </summary>
    private static string StatusPillTone(string? status) => BcEnvironmentStatus.Classify(status) switch
    {
        BcEnvironmentReadiness.Ready => "success",
        BcEnvironmentReadiness.Busy => "warn",
        BcEnvironmentReadiness.Deleting or BcEnvironmentReadiness.Failed => "danger",
        _ => "muted",
    };

    /// <summary>The window summary shown under an environment's name.</summary>
    private static string WindowText(ProjectEnvironmentRow env) =>
        env.UpdateWindowStart is { } s && env.UpdateWindowEnd is { } e
            ? $"{s:HH\\:mm}-{e:HH\\:mm}"
            : "any time";

    /// <summary>
    /// Microsoft's update window for the environment, in its own zone. Deliberately
    /// worded and placed apart from the delivery window: this one is not ours to set,
    /// and reading them as the same thing is the mistake the whole column exists to
    /// prevent.
    /// </summary>
    private string BcWindowText(ProjectEnvironmentRow env)
    {
        if (env.BcUpdateWindowFetchedAt is null) return "not read yet";
        if (env.BcUpdateWindowStart is not { } s || env.BcUpdateWindowEnd is not { } e) return "no window set";

        var zone = BcUpdateWindow.ResolveDisplayZone(env.BcUpdateWindowTimeZoneIana, _bc?.TimeZone);
        var label = ZoneLabel(zone, env.BcUpdateWindowTimeZoneIana);
        return $"{s:HH\\:mm}-{e:HH\\:mm} ({label})";
    }

    /// <summary>
    /// The city half of an IANA id (<c>Europe/Copenhagen</c> → <c>Copenhagen</c>), which
    /// is what a consultant recognises. Falls back to naming the fallback honestly when
    /// the Windows id had no mapping, so a wrong-looking time is explicable.
    /// </summary>
    private string ZoneLabel(TimeZoneInfo zone, string? bcIana)
    {
        if (!string.IsNullOrWhiteSpace(bcIana))
        {
            var city = bcIana.Contains('/') ? bcIana[(bcIana.LastIndexOf('/') + 1)..] : bcIana;
            return city.Replace('_', ' ');
        }
        return string.IsNullOrWhiteSpace(_bc?.TimeZone) ? "UTC" : "this solution's time zone";
    }

    /// <summary>
    /// Warns when the delivery window overlaps Microsoft's update window — a release
    /// aimed into Microsoft's maintenance hours is exactly what the environment-status
    /// check then refuses, and finding that out at 22:00 is worse than seeing it here.
    /// </summary>
    private string? OverlapWarning(ProjectEnvironmentRow env)
    {
        if (env.BcUpdateWindowStart is null || env.BcUpdateWindowEnd is null) return null;
        if (env.UpdateWindowStart is null || env.UpdateWindowEnd is null) return null;

        var ourZone = UpdateWindow.ResolveTimeZone(_bc?.TimeZone);
        var bcZone = BcUpdateWindow.ResolveDisplayZone(env.BcUpdateWindowTimeZoneIana, _bc?.TimeZone);
        var clash = BcUpdateWindow.Overlaps(
            env.UpdateWindowStart, env.UpdateWindowEnd, ourZone,
            env.BcUpdateWindowStart, env.BcUpdateWindowEnd, bcZone,
            DateTime.UtcNow);

        return clash
            ? "Overlaps Business Central's update window - a release landing then is refused while the environment is updating."
            : null;
    }

    private sealed class BcEdit
    {
        public string TenantId { get; set; } = string.Empty;
        public string ClientId { get; set; } = string.Empty;
        public string Secret { get; set; } = string.Empty;
        public DateTime? SecretExpires { get; set; }
        public string TimeZone { get; set; } = string.Empty;
    }
}
