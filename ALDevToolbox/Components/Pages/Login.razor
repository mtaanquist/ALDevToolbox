@page "/login"
@layout ALDevToolbox.Components.Layout.AuthLayout
@rendermode InteractiveServer
@using ALDevToolbox.Components.Shared
@using ALDevToolbox.Services.Account
@inject PasskeyService Passkeys
@inject IJSRuntime JS
@inject ILogger<Login> Logger

<PageTitle>Sign in · AL Dev Toolbox</PageTitle>

@*
    Sign in, on the auth-card archetype. See .design/handoff/PageAuth.dc.html,
    whose first two states are this page with and without an error.

    The Password / Magic link tab bar is gone. The hand-off's card has one
    primary action and an .auth__sso block underneath for everything else, and
    that reads better than a tab strip for the same reason it exists: password
    is what almost everyone does, and the alternatives are alternatives rather
    than equal halves. Magic link and passkey now sit in that block together.

    NOTE for whoever reconciles PR #553 (Entra ID sign-in): the "Sign in with
    Microsoft" button goes in the .auth__sso block below, next to the other two.
    The hand-off drew that slot for exactly this — its own sample card has a
    "Continue with CRONUS SSO" button there — so #553's markup gets smaller
    here, not bigger. Its eight `err=entra-*` branches slot into ErrorMessage()
    as more arms, and its local-login policy decides whether the password
    fields and the magic-link entry render at all.
*@

<AuthCard Title="Sign in" FormAction="/auth/login">
    <Sub>Sign in with your email and password, or use one of the options below.</Sub>
    <Alerts>
        @if (Error == "locked")
        {
            <p class="alert alert--danger" role="alert">
                <Icon Name="circle-alert" Width="16" Height="16" />
                <span>
                    Too many failed sign-ins. Try again in 15 minutes, or
                    <a class="auth__link" href="/forgot-password">reset your password</a>.
                </span>
            </p>
        }
        else if (ErrorMessage() is { } error)
        {
            <p class="alert alert--danger" role="alert">
                <Icon Name="circle-alert" Width="16" Height="16" />
                <span>@error</span>
            </p>
        }
        @if (OkMessage() is { } ok)
        {
            <p class="alert alert--success" role="status">
                <Icon Name="circle-check" Width="16" Height="16" />
                <span>@ok</span>
            </p>
        }
    </Alerts>

    <ChildContent>
    <input type="hidden" name="ReturnUrl" value="@ReturnUrl" />

    <div class="auth__fields">
        <div class="field">
            <label class="field__label" for="lg-email">Email</label>
            <input class="input" id="lg-email" type="email" name="Email" required autofocus
                   autocomplete="username" placeholder="you@cronus.example" />
        </div>
        <div class="field">
            <span class="auth__row-between">
                <label class="field__label" for="lg-password">Password</label>
                <a class="auth__link" href="/forgot-password">Forgot password?</a>
            </span>
            <input class="input" id="lg-password" type="password" name="Password" required
                   autocomplete="current-password" />
        </div>
    </div>

    <button type="submit" class="btn btn--primary" style="height: var(--control-h-lg)">
        <Icon Name="log-in" Width="16" Height="16" />
        <span>Sign in</span>
    </button>

    @* Everything that is not "type your password". The hand-off puts one
       divider above the block, however many alternatives sit under it. *@
    <div class="auth__sso">
        <span class="auth__or">or</span>
        <a class="btn" href="/login/magic">
            <Icon Name="mail" Width="16" Height="16" />
            <span>Email me a sign-in link</span>
        </a>
        @if (Passkeys.IsConfigured)
        {
            <button type="button" class="btn" @onclick="SignInWithPasskeyAsync">
                <Icon Name="key-round" Width="16" Height="16" />
                <span>Sign in with a passkey</span>
            </button>
        }
        @if (!string.IsNullOrEmpty(_passkeyError))
        {
            <span class="field-error" role="alert">
                <Icon Name="circle-alert" Width="13" Height="13" />
                @_passkeyError
            </span>
        }
    </div>
    </ChildContent>

    @* The hand-off's foot is where you go when you cannot sign in *because you
       have no account* — "Forgot password?" already sits on the password field
       and does not need saying twice. *@
    <Foot>
        <span>No account yet?</span>
        <a class="auth__link" href="/signup">Sign up</a>
    </Foot>
</AuthCard>

@code {
    [SupplyParameterFromQuery(Name = "err")]
    public string? Error { get; set; }

    [SupplyParameterFromQuery(Name = "ok")]
    public string? Ok { get; set; }

    [SupplyParameterFromQuery(Name = "return")]
    public string? ReturnUrl { get; set; }

    private string? _passkeyError;

    private string? ErrorMessage() => Error switch
    {
        "invalid" => "That email and password do not match.",
        "pending" => "Your account is still waiting for an admin to approve it.",
        "disabled" => "This account has been disabled. Ask your administrator to turn it back on.",
        "rate-limited" => "Too many attempts. Wait a moment and try again.",
        _ => null,
    };

    private string? OkMessage() => Ok switch
    {
        "password-reset" => "Password updated. Sign in with your new password.",
        "account-deleted" => "Your account has been deleted. You can sign in with another account, or sign up again.",
        _ => null,
    };

    private async Task SignInWithPasskeyAsync()
    {
        _passkeyError = null;
        try
        {
            await JS.InvokeVoidAsync("aldtPasskey.login", null);
        }
        catch (Exception ex)
        {
            // Never the exception text: this is JS interop, so ex.Message is a
            // JSException wrapping a WebAuthn constant ("NotAllowedError"), and
            // it would land verbatim on the first screen a new user ever sees.
            // The cause belongs in the log, where someone can act on it.
            Logger.LogInformation(ex, "Passkey sign-in did not complete.");
            _passkeyError = "That passkey didn't work. Try again, or sign in with your email and password.";
        }
    }
}
