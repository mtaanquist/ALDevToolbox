@page "/login"
@rendermode InteractiveServer
@using ALDevToolbox.Services.Account
@inject PasskeyService Passkeys
@inject EntraSignInService Entra
@inject IJSRuntime JS

<PageTitle>Sign in · AL Dev Toolbox</PageTitle>

<div class="login-page">
    <h1>Sign in</h1>
    @if (!_surfaceLoaded || _passwordPrimary)
    {
        <p class="caption muted">
            Enter the email and password for your AL Dev Toolbox account. Don't
            have one yet? <a href="/signup">Sign up</a>.
        </p>

        <nav class="tab-bar tab-bar--auth" aria-label="Sign-in method">
            <a href="/login" class="tab active">Password</a>
            <a href="/login/magic" class="tab">Magic link</a>
        </nav>
    }
    else
    {
        <p class="caption muted">
            Sign in with your work Microsoft account. Your organisation manages
            your account, so there's nothing to sign up for.
        </p>
    }

    @if (Error == "invalid")
    {
        <p class="form-error" role="alert">Invalid email or password.</p>
    }
    else if (Error == "pending")
    {
        <p class="form-error" role="alert">Your account is still pending admin approval.</p>
    }
    else if (Error == "disabled")
    {
        <p class="form-error" role="alert">This account has been disabled. Contact your organisation's admin.</p>
    }
    else if (Error == "locked")
    {
        <p class="form-error" role="alert">Too many failed sign-ins. Try again in 15 minutes or reset your password.</p>
    }
    else if (Error == "rate-limited")
    {
        <p class="form-error" role="alert">Too many attempts. Slow down and try again later.</p>
    }
    else if (Error == "entra-only")
    {
        <p class="form-error" role="alert">Your organisation signs in with Microsoft. Select "Sign in with Microsoft" instead.</p>
    }
    else if (Error == "entra-pending")
    {
        <p class="form-success" role="status">You're nearly in - your account was created and is waiting for your organisation's admin to approve it. We'll email you when it's approved.</p>
    }
    else if (Error == "entra-tenant")
    {
        <p class="form-error" role="alert">Your work Microsoft account isn't approved for sign-in here yet. Ask your organisation's admin to allow it, then try again.</p>
    }
    else if (Error == "entra-ambiguous")
    {
        <p class="form-error" role="alert">We couldn't tell which organisation you belong to. Ask your admin to add your email domain (for example cronus.com) to your organisation, then try again.</p>
    }
    else if (Error == "entra-email-needed")
    {
        <p class="form-error" role="alert">Enter your work email, then select "Sign in with Microsoft".</p>
    }
    else if (Error == "entra-not-configured")
    {
        <p class="form-error" role="alert">Microsoft sign-in isn't turned on for your organisation. Sign in with your password, or ask your admin to turn it on.</p>
    }
    else if (Error == "entra-email-taken")
    {
        <p class="form-error" role="alert">This email is already used by an account in a different organisation. Ask your admin which address to use here.</p>
    }
    else if (Error == "entra-failed")
    {
        <p class="form-error" role="alert">Microsoft sign-in didn't complete. Try again.</p>
    }
    @if (Ok == "password-reset")
    {
        <p class="form-success" role="status">Password updated. Sign in with your new password.</p>
    }
    else if (Ok == "account-deleted")
    {
        <p class="form-success" role="status">Your account has been deleted.</p>
    }

    @if (!_surfaceLoaded)
    {
        <p class="muted">Loading...</p>
    }
    else if (!_passwordPrimary)
    {
        @* Every organisation on this server is Microsoft-only: lead with the
           Microsoft flow and tuck the password form away for site admins
           (their break-glass password login always works). *@
        <form method="post" action="/auth/entra/challenge" class="form-grid login-form">
            <AntiforgeryToken />
            <input type="hidden" name="ReturnUrl" value="@ReturnUrl" />
            <section class="form-section">
                <label class="section-label" for="lg-ms-email">Work email</label>
                <input id="lg-ms-email" type="email" name="Email" required autofocus
                       placeholder="e.g. anna@cronus.com" autocomplete="username" />
                <small class="muted">We'll take you to your organisation's Microsoft sign-in.</small>
            </section>
            <div class="login-form__actions">
                <button type="submit" class="btn btn--primary">
                    <Icon Name="log-in" Width="16" Height="16" />
                    <span>Sign in with Microsoft</span>
                </button>
            </div>
        </form>
        <details class="login-password-fallback">
            <summary>Site administrator sign-in</summary>
            <form method="post" action="/auth/login" class="form-grid login-form">
                <AntiforgeryToken />
                <input type="hidden" name="ReturnUrl" value="@ReturnUrl" />
                <section class="form-section">
                    <label class="section-label" for="lg-email">Email</label>
                    <input id="lg-email" type="email" name="Email" required autocomplete="username" />
                </section>
                <section class="form-section">
                    <label class="section-label" for="lg-password">Password</label>
                    <input id="lg-password" type="password" name="Password" required autocomplete="current-password" />
                    <a href="/forgot-password" class="login-form__inline-link">Forgot password?</a>
                </section>
                <div class="login-form__actions">
                    <button type="submit" class="btn">
                        <Icon Name="log-in" Width="16" Height="16" />
                        <span>Sign in</span>
                    </button>
                </div>
            </form>
        </details>
    }
    else
    {
        <form method="post" action="/auth/login" class="form-grid login-form">
            <AntiforgeryToken />
            <input type="hidden" name="ReturnUrl" value="@ReturnUrl" />

            <section class="form-section">
                <label class="section-label" for="lg-email">Email</label>
                <input id="lg-email" type="email" name="Email" required autofocus autocomplete="username" />
            </section>

            <section class="form-section">
                <label class="section-label" for="lg-password">Password</label>
                <input id="lg-password" type="password" name="Password" required autocomplete="current-password" />
                <a href="/forgot-password" class="login-form__inline-link">Forgot password?</a>
            </section>

            <div class="login-form__actions">
                <button type="submit" class="btn btn--primary">
                    <Icon Name="log-in" Width="16" Height="16" />
                    <span>Sign in</span>
                </button>
                @if (_entraAvailable)
                {
                    @* Submits the same form (so the typed email routes the
                       sign-in) but to the Entra challenge, skipping the
                       password requirement. *@
                    <button type="submit" class="btn" formaction="/auth/entra/challenge" formnovalidate>
                        <Icon Name="log-in" Width="16" Height="16" />
                        <span>Sign in with Microsoft</span>
                    </button>
                }
            </div>
        </form>
    }

    @if (Passkeys.IsConfigured)
    {
        <div class="login-passkey">
            <p class="muted">or</p>
            <button type="button" class="btn" @onclick="SignInWithPasskeyAsync">
                <Icon Name="key-round" Width="16" Height="16" />
                <span>Sign in with a passkey</span>
            </button>
            @if (!string.IsNullOrEmpty(_passkeyError))
            {
                <p class="form-error" role="alert">@_passkeyError</p>
            }
        </div>
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "err")]
    public string? Error { get; set; }

    [SupplyParameterFromQuery(Name = "ok")]
    public string? Ok { get; set; }

    [SupplyParameterFromQuery(Name = "return")]
    public string? ReturnUrl { get; set; }

    private string? _passkeyError;
    private bool _entraAvailable;
    private bool _passwordPrimary = true;
    private bool _surfaceLoaded;

    protected override async Task OnInitializedAsync()
    {
        (_entraAvailable, _passwordPrimary) = await Entra.GetLoginSurfaceAsync();
        // Gate the form on this so the password layout doesn't flash and
        // then get swapped out from under a user who has started typing.
        _surfaceLoaded = true;
    }

    private async Task SignInWithPasskeyAsync()
    {
        _passkeyError = null;
        try
        {
            await JS.InvokeVoidAsync("aldtPasskey.login", null);
        }
        catch (Exception ex)
        {
            _passkeyError = ex.Message;
        }
    }
}
