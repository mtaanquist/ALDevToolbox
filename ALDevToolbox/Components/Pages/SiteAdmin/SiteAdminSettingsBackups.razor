@page "/site-admin/settings/backups"
@attribute [Authorize(Roles = HttpOrganizationContext.SiteAdminRole)]
@using ALDevToolbox.Components.Shared
@using ALDevToolbox.Services
@inject SystemSettingsService Settings

<PageTitle>Backup schedule · Site administration · AL Dev Toolbox</PageTitle>

<SiteAdminSettingsPage ActiveTab="SiteAdminSettingsPage.Tab.Backups">
    <Alerts>
        <SettingsBanner Message="@Message" Ok="@Ok" SavedText="Backup schedule saved." />
    </Alerts>
    <Body>
        @if (_view is null)
        {
            <div class="loading-block"><span class="spinner"></span><span>Loading...</span></div>
        }
        else
        {
            <form method="post" action="/site-admin/settings/backups/save" id="settings-backups-form">
                <AntiforgeryToken />
                <div class="setting-list">
                    <SettingRow Name="Nightly backup"
                                Hint="Backs up everything on this site, once a day.">
                        <Switch Name="BackupScheduleEnabled" HiddenFalse="true"
                                Checked="@_view.BackupScheduleEnabled"
                                Label="@(_view.BackupScheduleEnabled ? "On" : "Off")" />
                    </SettingRow>

                    <SettingRow Name="Time of day"
                                Hint="In UTC, so it does not move with daylight saving. Pick a quiet hour.">
                        <span class="u-row">
                            <input class="input" type="time" name="BackupScheduleTimeUtc" style="width: 128px"
                                   value="@_view.BackupScheduleTimeUtc.ToString("HH\\:mm")" aria-label="Time of day, UTC" />
                            <span class="form-actions__note">UTC</span>
                        </span>
                    </SettingRow>

                    <SettingRow Name="How many site backups to keep"
                                Hint="Older ones are deleted after each run. Backups you have pinned are never deleted.">
                        <span class="u-row">
                            <input class="input input--num" type="number" name="BackupRetentionCount"
                                   value="@_view.BackupRetentionCount" min="1" max="365" style="width: 92px"
                                   aria-label="Site backups to keep" />
                            <span class="form-actions__note">backups</span>
                        </span>
                    </SettingRow>

                    <SettingRow Name="How many per-organisation snapshots to keep"
                                Hint="Each organisation gets its own smaller snapshot, which is what a restore of a single organisation uses.">
                        <span class="u-row">
                            <input class="input input--num" type="number" name="PerTenantBackupRetentionCount"
                                   value="@_view.PerTenantBackupRetentionCount" min="1" max="365" style="width: 92px"
                                   aria-label="Per-organisation snapshots to keep" />
                            <span class="form-actions__note">snapshots each</span>
                        </span>
                    </SettingRow>
                </div>
            </form>
        }
    </Body>
    <Foot>
        @if (_view is not null)
        {
            <button type="submit" form="settings-backups-form" class="btn btn--primary">
                <Icon Name="save" Width="16" Height="16" />
                <span>Save changes</span>
            </button>
        }
    </Foot>
    <Aside>
        <SettingsAside UpdatedAt="@_view?.UpdatedAt">
            <section class="card">
                <div class="card__head"><div><h2 class="card__title">Backups themselves</h2></div></div>
                <div class="card__body settings-aside__body">
                    <a class="btn btn--sm" href="/site-admin/backup-storage/database">
                        <Icon Name="database-backup" Width="14" Height="14" />
                        <span>Browse and pin backups</span>
                    </a>
                    <a class="btn btn--sm" href="/site-admin/backup-storage/snapshots">
                        <Icon Name="hard-drive" Width="14" Height="14" />
                        <span>Per-organisation snapshots</span>
                    </a>
                </div>
            </section>
        </SettingsAside>
    </Aside>
</SiteAdminSettingsPage>

@code {
    [SupplyParameterFromQuery(Name = "msg")] public string? Message { get; set; }
    [SupplyParameterFromQuery(Name = "ok")] public string? Ok { get; set; }

    private SystemSettingsView? _view;

    protected override async Task OnInitializedAsync()
    {
        _view = await Settings.GetViewAsync();
    }
}
