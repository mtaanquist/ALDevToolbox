@page "/site-admin/settings/tools"
@attribute [Authorize(Roles = HttpOrganizationContext.SiteAdminRole)]
@using ALDevToolbox.Components.Shared
@using ALDevToolbox.Domain.Tools
@using ALDevToolbox.Services
@using ALDevToolbox.Services.Operations
@inject SystemSettingsService Settings

<PageTitle>Tools · Site administration · AL Dev Toolbox</PageTitle>

@*
    DIVERGENCE from the handoff, deliberate: its Tools tab puts every tool in
    one check-list inside a single setting row. Ours gives each tool its own
    row, because each of ours has a sentence explaining what it is and .setting
    already has the slot for that. A check-list would have to drop the blurbs or
    grow a variant to hold them.
*@

<SiteAdminSettingsPage ActiveTab="SiteAdminSettingsPage.Tab.Tools">
    <Alerts>
        <SettingsBanner Message="@Message" Ok="@Ok" SavedText="Tools saved." />
    </Alerts>
    <Body>
        @if (_view is null)
        {
            <div class="loading-block"><span class="spinner"></span><span>Loading...</span></div>
        }
        else
        {
            <form method="post" action="/site-admin/settings/tools/save" id="settings-tools-form">
                <AntiforgeryToken />
                <div class="setting-list">
                    @foreach (var tool in ToolCatalog.All)
                    {
                        var on = IsEnabled(tool.Key);
                        <SettingRow Name="@tool.Name" Hint="@tool.Blurb">
                            <Switch Name="@($"tool_{tool.Key}")" HiddenFalse="true"
                                    Checked="@on" Label="@(on ? "On" : "Off")" />
                        </SettingRow>
                    }
                </div>
            </form>
        }
    </Body>
    <Foot>
        @if (_view is not null)
        {
            <button type="submit" form="settings-tools-form" class="btn btn--primary">
                <Icon Name="save" Width="16" Height="16" />
                <span>Save changes</span>
            </button>
        }
    </Foot>
    <Aside>
        <SettingsAside UpdatedAt="@_view?.UpdatedAt">
            <p class="alert alert--info">
                <Icon Name="info" Width="16" Height="16" />
                <span>
                    Switching a tool off here hides it from everyone, in every
                    organisation, and stops it working until you switch it back on.
                    An organisation can switch off tools you leave on, but cannot
                    switch on ones you turn off.
                </span>
            </p>
        </SettingsAside>
    </Aside>
</SiteAdminSettingsPage>

@code {
    [SupplyParameterFromQuery(Name = "msg")] public string? Message { get; set; }
    [SupplyParameterFromQuery(Name = "ok")] public string? Ok { get; set; }

    private SystemSettingsView? _view;
    private HashSet<ToolKey> _disabled = new();

    protected override async Task OnInitializedAsync()
    {
        _view = await Settings.GetViewAsync();
        _disabled = ToolCatalog.ParseDisabled(_view.DisabledTools);
    }

    // MCP is part of the same list but tracked by its own McpEnabled flag, not
    // the disabled-tools set. Every other tool is on unless it's in the set.
    private bool IsEnabled(ToolKey key) =>
        key == ToolKey.Mcp ? _view!.McpEnabled : !_disabled.Contains(key);
}
