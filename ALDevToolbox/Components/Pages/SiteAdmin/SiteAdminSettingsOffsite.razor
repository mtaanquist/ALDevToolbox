@page "/site-admin/settings/offsite"
@attribute [Authorize(Roles = HttpOrganizationContext.SiteAdminRole)]
@using ALDevToolbox.Components.Shared
@using ALDevToolbox.Services
@inject SystemSettingsService Settings
@inject OffsiteBackupService Offsite

<PageTitle>Off-site backups · Site administration · AL Dev Toolbox</PageTitle>

<SiteAdminSettingsPage ActiveTab="SiteAdminSettingsPage.Tab.Offsite">
    <Alerts>
        <SettingsBanner Message="@Message" Ok="@Ok">
            @if (Ok == "offsite-saved")
            {
                <p class="alert alert--success" role="status">
                    <Icon Name="circle-check" Width="16" Height="16" />
                    <span>Off-site backup settings saved.</span>
                </p>
            }
            @if (TestResult is not null)
            {
                var passed = TestResult.StartsWith("OK");
                <p class="alert @(passed ? "alert--success" : "alert--danger")" role="status">
                    <Icon Name="@(passed ? "circle-check" : "circle-alert")" Width="16" Height="16" />
                    <span>@TestResult</span>
                </p>
            }
        </SettingsBanner>
    </Alerts>
    <Body>
        @if (_offsite is null)
        {
            <div class="loading-block"><span class="spinner"></span><span>Loading...</span></div>
        }
        else
        {
            @* NOT branching the labels on the selected provider. This page is
               static SSR, so `azure` would be the *saved* provider: picking
               Azure in the dropdown would leave every label below saying
               "Bucket" and "Access key id" until you pressed Save, which is a
               label that lies at exactly the moment you are reading it. The
               names are given for both instead, and the hints say which is
               which. `azure` is still used for the dropdown's own selected
               option, where the saved value is the right answer. *@
            var azure = _offsite.Provider == "azure-blob";
            <form method="post" action="/site-admin/settings/offsite/save" id="settings-offsite-form">
                <AntiforgeryToken />
                <div class="setting-list">
                    <SettingRow Name="Copy backups off-site"
                                Hint="After each nightly backup succeeds, upload it to the storage below and delete off-site copies past the retention window.">
                        <Switch Name="Enabled" HiddenFalse="true" Checked="@_offsite.Enabled"
                                Label="@(_offsite.Enabled ? "On" : "Off")" />
                    </SettingRow>

                    <SettingRow Name="Where to store them"
                                Hint="Pick the kind of storage first - some of the fields below only apply to one of them.">
                        <span class="select-wrap">
                            <select class="select" name="Provider">
                                <option value="s3" selected="@(!azure)">S3-compatible (AWS, MinIO, R2, B2)</option>
                                <option value="azure-blob" selected="@azure">Azure Blob Storage</option>
                            </select>
                            <Icon Name="chevron-down" Width="15" Height="15" Css="select-wrap__caret" />
                        </span>
                    </SettingRow>

                    <SettingRow Name="Bucket or container"
                                Hint="Where the backups land - S3 calls it a bucket, Azure calls it a container - and an optional folder inside it.">
                        <span class="u-row">
                            <input class="input" type="text" name="Bucket" value="@_offsite.Bucket"
                                   aria-label="Bucket or container name"
                                   placeholder="e.g. cronus-aldt-backups" />
                            <input class="input" type="text" name="Prefix" value="@_offsite.Prefix"
                                   aria-label="Folder inside it" placeholder="e.g. aldevtoolbox/" />
                        </span>
                    </SettingRow>

                    <SettingRow Name="Address"
                                Hint="Leave the address blank unless you host your own storage. The region applies to S3 only.">
                        <span class="u-row">
                            <input class="input" type="text" name="Endpoint" value="@_offsite.Endpoint"
                                   aria-label="Custom address" placeholder="Provider default" />
                            <input class="input" type="text" name="Region" value="@_offsite.Region"
                                   aria-label="Region" placeholder="e.g. eu-west-1" style="width: 150px" />
                        </span>
                    </SettingRow>

                    <SettingRow Name="Sign-in">
                        <HintContent>
                            On S3 these are the <em>access key id</em> and the
                            <em>secret access key</em>; on Azure Blob Storage they are the
                            <em>storage account name</em> and the <em>account key</em>.
                            Both are stored encrypted - leave them blank to keep what is
                            already saved.
                        </HintContent>
                        <ChildContent>
                            <span class="u-row">
                                <input class="input" type="text" name="AccessKey" autocomplete="off"
                                       aria-label="Access key id or storage account name"
                                       placeholder="@(_offsite.HasAccessKey ? "Unchanged" : "Key id or account name")" />
                                <input class="input" type="password" name="SecretKey" autocomplete="new-password"
                                       aria-label="Secret access key or account key"
                                       placeholder="@(_offsite.HasSecretKey ? "Unchanged" : "Secret key")" />
                            </span>
                            @if (_offsite.HasAccessKey || _offsite.HasSecretKey)
                            {
                                <span class="check-list">
                                    @if (_offsite.HasAccessKey)
                                    {
                                        <label class="check">
                                            <input type="checkbox" name="ClearAccessKey" value="true" />
                                            <span class="check__box"><Icon Name="check" Width="12" Height="12" /></span>
                                            <span>Forget the saved key id / account name</span>
                                        </label>
                                    }
                                    @if (_offsite.HasSecretKey)
                                    {
                                        <label class="check">
                                            <input type="checkbox" name="ClearSecretKey" value="true" />
                                            <span class="check__box"><Icon Name="check" Width="12" Height="12" /></span>
                                            <span>Forget the saved secret</span>
                                        </label>
                                    }
                                </span>
                            }
                        </ChildContent>
                    </SettingRow>

                    <SettingRow Name="Path-style addressing"
                                Hint="Needed by MinIO and most self-hosted S3 servers. Ignored for Azure Blob Storage.">
                        <Switch Name="ForcePathStyle" HiddenFalse="true" Checked="@_offsite.ForcePathStyle"
                                Label="@(_offsite.ForcePathStyle ? "On" : "Off")" />
                    </SettingRow>

                    <SettingRow Name="How long to keep off-site copies"
                                Hint="Copies older than this are deleted from the off-site storage after each upload.">
                        <span class="u-row">
                            <input class="input input--num" type="number" name="RetentionDays"
                                   value="@_offsite.RetentionDays" min="1" max="3650" style="width: 92px"
                                   aria-label="Days to keep off-site copies" />
                            <span class="form-actions__note">days</span>
                        </span>
                    </SettingRow>
                </div>
            </form>

            @* Its own form, and outside the .setting-list, for the same reason
               as the SMTP test: it checks what is *saved*, not what is typed. *@
            <div class="setting-list">
                <SettingRow Name="Test it"
                            Hint="Checks that the storage above can be reached with the credentials already saved.">
                    <form method="post" action="/site-admin/settings/offsite/test">
                        <AntiforgeryToken />
                        <button type="submit" class="btn btn--sm">
                            <Icon Name="refresh-cw" Width="14" Height="14" />
                            <span>Test the connection</span>
                        </button>
                    </form>
                </SettingRow>
            </div>
        }
    </Body>
    <Foot>
        @if (_offsite is not null)
        {
            <button type="submit" form="settings-offsite-form" class="btn btn--primary">
                <Icon Name="save" Width="16" Height="16" />
                <span>Save changes</span>
            </button>
        }
    </Foot>
    <Aside>
        <SettingsAside UpdatedAt="@_updatedAt" />
    </Aside>
</SiteAdminSettingsPage>

@code {
    [SupplyParameterFromQuery(Name = "msg")] public string? Message { get; set; }
    [SupplyParameterFromQuery(Name = "ok")] public string? Ok { get; set; }
    [SupplyParameterFromQuery(Name = "test")] public string? TestResult { get; set; }

    private OffsiteSettingsView? _offsite;
    private DateTime? _updatedAt;

    protected override async Task OnInitializedAsync()
    {
        _offsite = await Settings.GetOffsiteViewAsync();
        // Off-site settings live on the same single system_settings row, so its
        // updated_at is the one to show here too.
        _updatedAt = (await Settings.GetViewAsync()).UpdatedAt;
    }
}
