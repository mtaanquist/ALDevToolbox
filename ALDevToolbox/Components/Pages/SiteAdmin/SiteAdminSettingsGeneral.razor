@page "/site-admin/settings/general"
@attribute [Authorize(Roles = HttpOrganizationContext.SiteAdminRole)]
@using ALDevToolbox.Components.Shared
@using ALDevToolbox.Services
@inject SystemSettingsService Settings

<PageTitle>Banner &amp; signup · Site administration · AL Dev Toolbox</PageTitle>

<SiteAdminSettingsPage ActiveTab="SiteAdminSettingsPage.Tab.General">
    <Alerts>
        <SettingsBanner Message="@Message" Ok="@Ok" SavedText="Banner and signup settings saved." />
    </Alerts>
    <Body>
        @if (_view is null)
        {
            <div class="loading-block"><span class="spinner"></span><span>Loading...</span></div>
        }
        else
        {
            <form method="post" action="/site-admin/settings/general/save" id="settings-general-form">
                <AntiforgeryToken />
                <div class="setting-list">
                    <SettingRow Name="Site banner"
                                Hint="Shown at the top of every page, for everyone. Leave blank for no banner.">
                        <textarea class="textarea" name="BannerText" rows="2" maxlength="500"
                                  placeholder="e.g. Scheduled maintenance on Sunday 09:00-11:00 UTC.">@_view.BannerText</textarea>
                    </SettingRow>

                    <SettingRow Name="New signups"
                                Hint="Someone joining an organisation that already exists. Signups that create a new organisation are always reviewed.">
                        <Switch Name="DefaultSignupAutoApprove" HiddenFalse="true"
                                Checked="@_view.DefaultSignupAutoApprove"
                                Label="@(_view.DefaultSignupAutoApprove ? "Let them in straight away" : "Wait for an admin to approve")" />
                    </SettingRow>

                    <SettingRow Name="Who may sign up">
                        <HintContent>
                            One email domain per line. Leave blank to accept any address.
                            Subdomains need their own line - <code>cronus.com</code> does not
                            cover <code>user@@dept.cronus.com</code>.
                        </HintContent>
                        <ChildContent>
                            <textarea class="textarea" name="SignupEmailDomainAllowlist" rows="4"
                                      placeholder="e.g.&#10;cronus.com&#10;example.dk">@_view.SignupEmailDomainAllowlist</textarea>
                        </ChildContent>
                    </SettingRow>

                    <SettingRow Name="Release download hosts">
                        <HintContent>
                            Where Object Explorer may download a release from, one host per
                            line. Subdomains are covered - <code>microsoft.com</code> also
                            allows <code>download.microsoft.com</code>. Leave blank to turn
                            downloading by URL off.
                        </HintContent>
                        <ChildContent>
                            <textarea class="textarea" name="ReleaseDownloadDomainAllowlist" rows="3"
                                      placeholder="e.g. download.microsoft.com">@_view.ReleaseDownloadDomainAllowlist</textarea>
                        </ChildContent>
                    </SettingRow>
                </div>
            </form>
        }
    </Body>
    <Foot>
        @if (_view is not null)
        {
            <button type="submit" form="settings-general-form" class="btn btn--primary">
                <Icon Name="save" Width="16" Height="16" />
                <span>Save changes</span>
            </button>
        }
    </Foot>
    <Aside>
        <SettingsAside UpdatedAt="@_view?.UpdatedAt" />
    </Aside>
</SiteAdminSettingsPage>

@code {
    [SupplyParameterFromQuery(Name = "msg")] public string? Message { get; set; }
    [SupplyParameterFromQuery(Name = "ok")] public string? Ok { get; set; }

    private SystemSettingsView? _view;

    protected override async Task OnInitializedAsync()
    {
        _view = await Settings.GetViewAsync();
    }
}
