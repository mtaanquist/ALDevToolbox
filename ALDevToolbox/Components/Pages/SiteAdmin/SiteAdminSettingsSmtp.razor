@page "/site-admin/settings/smtp"
@attribute [Authorize(Roles = HttpOrganizationContext.SiteAdminRole)]
@using ALDevToolbox.Components.Shared
@using ALDevToolbox.Services
@using ALDevToolbox.Services.Operations
@inject SystemSettingsService Settings

<PageTitle>Email · Site administration · AL Dev Toolbox</PageTitle>

<SiteAdminSettingsPage ActiveTab="SiteAdminSettingsPage.Tab.Smtp">
    <Alerts>
        <SettingsBanner Message="@Message" Ok="@Ok" SavedText="Email settings saved.">
            @if (Ok == "test-sent")
            {
                <p class="alert alert--success" role="status">
                    <Icon Name="circle-check" Width="16" Height="16" />
                    <span>Test email sent - check your inbox.</span>
                </p>
            }
            @if (TestResult is not null)
            {
                var passed = TestResult.StartsWith("OK");
                <p class="alert @(passed ? "alert--success" : "alert--danger")" role="status">
                    <Icon Name="@(passed ? "circle-check" : "circle-alert")" Width="16" Height="16" />
                    <span>@TestResult</span>
                </p>
            }
        </SettingsBanner>
    </Alerts>
    <Body>
        @if (_view is null)
        {
            <div class="loading-block"><span class="spinner"></span><span>Loading...</span></div>
        }
        else
        {
            <form method="post" action="/site-admin/settings/smtp/save" id="settings-smtp-form">
                <AntiforgeryToken />
                <div class="setting-list">
                    <SettingRow Name="Server"
                                Hint="The mail server that sends invites, password resets and notifications.">
                        <span class="u-row">
                            <input class="input" type="text" name="SmtpHost" value="@_view.SmtpHost"
                                   placeholder="e.g. smtp.cronus.com" aria-label="Host" />
                            <input class="input input--num" type="number" name="SmtpPort" value="@_view.SmtpPort"
                                   min="1" max="65535" placeholder="587" style="width: 92px" aria-label="Port" />
                        </span>
                    </SettingRow>

                    <SettingRow Name="Encryption"
                                Hint="STARTTLS is what Microsoft 365 and most hosted relays expect.">
                        <Switch Name="SmtpUseStartTls" HiddenFalse="true"
                                Checked="@(_view.SmtpUseStartTls != false)"
                                Label="@(_view.SmtpUseStartTls != false ? "STARTTLS" : "None")" />
                    </SettingRow>

                    <SettingRow Name="Sign-in name"
                                Hint="Leave blank if the server accepts mail without signing in.">
                        <input class="input" type="text" name="SmtpUser" value="@_view.SmtpUser" autocomplete="off" />
                    </SettingRow>

                    <SettingRow Name="Password"
                                Hint="Stored encrypted. Leave blank to keep the one already saved.">
                        <input class="input" type="password" name="SmtpPassword" value="" autocomplete="new-password"
                               placeholder="@(_view.HasSmtpPassword ? "Unchanged" : "Not set")" />
                        @if (_view.HasSmtpPassword)
                        {
                            <label class="check">
                                <input type="checkbox" name="ClearSmtpPassword" value="true" />
                                <span class="check__box"><Icon Name="check" Width="12" Height="12" /></span>
                                <span>Forget the saved password</span>
                            </label>
                        }
                    </SettingRow>

                    <SettingRow Name="Sent from"
                                Hint="Must be an address the server is allowed to send as.">
                        <span class="u-row">
                            <input class="input" type="email" name="SmtpFrom" value="@_view.SmtpFrom"
                                   placeholder="e.g. noreply@@cronus.com" aria-label="From address" />
                            <input class="input" type="text" name="SmtpFromName" value="@_view.SmtpFromName"
                                   placeholder="e.g. AL Dev Toolbox" aria-label="Sender name" />
                        </span>
                    </SettingRow>
                </div>
            </form>

            @* Its own form, so testing does not submit the edits above -- and
               outside the .setting-list so it does not read as a sixth setting.
               The test uses what is *saved*, which is the thing worth knowing. *@
            <div class="setting-list">
                <SettingRow Name="Test it"
                            Hint="Sends one short email to your own address using the settings as saved.">
                    <form method="post" action="/site-admin/settings/test-email">
                        <AntiforgeryToken />
                        <button type="submit" class="btn btn--sm">
                            <Icon Name="mail" Width="14" Height="14" />
                            <span>Send a test email to me</span>
                        </button>
                    </form>
                </SettingRow>
            </div>
        }
    </Body>
    <Foot>
        @if (_view is not null)
        {
            <button type="submit" form="settings-smtp-form" class="btn btn--primary">
                <Icon Name="save" Width="16" Height="16" />
                <span>Save changes</span>
            </button>
        }
    </Foot>
    <Aside>
        <SettingsAside UpdatedAt="@_view?.UpdatedAt">
            <p class="alert alert--info">
                <Icon Name="info" Width="16" Height="16" />
                <span>
                    What you enter here wins over the mail settings this site was
                    deployed with, from the next email onwards - no restart needed.
                    Clear every field to go back to those.
                </span>
            </p>
        </SettingsAside>
    </Aside>
</SiteAdminSettingsPage>

@code {
    [SupplyParameterFromQuery(Name = "msg")] public string? Message { get; set; }
    [SupplyParameterFromQuery(Name = "ok")] public string? Ok { get; set; }
    [SupplyParameterFromQuery(Name = "test")] public string? TestResult { get; set; }

    private SystemSettingsView? _view;

    protected override async Task OnInitializedAsync()
    {
        _view = await Settings.GetViewAsync();
    }
}
