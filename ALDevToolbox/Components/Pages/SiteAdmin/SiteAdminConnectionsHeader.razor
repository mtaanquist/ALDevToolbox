@*
    The /site-admin/connections/* family. Access tokens and OAuth consents are
    both ways of letting something talk to the server on a person's behalf, so
    they share one sidebar entry and two tabs.

    Kept its name from when it rendered only a <header>; every page in the
    family references it, and what it renders now is the page.
*@

@using ALDevToolbox.Components.Shared

<TabbedPage Title="Connections"
            CrumbLabel="Site administration" CrumbHref="/site-admin"
            Tabs="@_tabs" TabsLabel="Connections sections"
            Actions="@Actions">
    <Sub>What agents and apps use to sign in as one of your users.</Sub>
    <ChildContent>@ChildContent</ChildContent>
</TabbedPage>

@code {
    public enum Tab { AccessTokens, OAuthClients }

    [Parameter, EditorRequired] public Tab ActiveTab { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private IReadOnlyList<HeaderTabs.HeaderTabItem> _tabs = Array.Empty<HeaderTabs.HeaderTabItem>();

    protected override void OnParametersSet()
    {
        _tabs = new[]
        {
            new HeaderTabs.HeaderTabItem("Access tokens", "/site-admin/connections/access-tokens", ActiveTab == Tab.AccessTokens),
            new HeaderTabs.HeaderTabItem("OAuth clients", "/site-admin/connections/oauth-clients", ActiveTab == Tab.OAuthClients),
        };
    }
}
