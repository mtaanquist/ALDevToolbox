@page "/site-admin/settings/entra"
@attribute [Authorize(Roles = HttpOrganizationContext.SiteAdminRole)]
@using ALDevToolbox.Services
@inject SystemSettingsService Settings

<PageTitle>Microsoft sign-in · Site administration · AL Dev Toolbox</PageTitle>

<div class="admin-page">
    <SiteAdminSettingsHeader ActiveTab="SiteAdminSettingsHeader.Tab.Entra">
        <Actions>
            <button type="submit" form="settings-entra-form" class="btn btn--sm btn--primary">
                <Icon Name="save" Width="14" Height="14" />
                <span>Save</span>
            </button>
        </Actions>
    </SiteAdminSettingsHeader>

    @if (!string.IsNullOrEmpty(Message))
    {
        <p class="form-error" role="alert">@Message</p>
    }
    @if (Ok == "saved")
    {
        <p class="form-info" role="status">Microsoft sign-in settings saved.</p>
    }

    <p class="muted">
        The Microsoft (Entra ID) app registration shared by every organisation
        on this deployment. Create one multi-tenant app registration in your
        own Entra tenant, then enter its IDs here. Each organisation still
        opts in and lists which tenants may sign in on its own
        Administration &gt; Identity page - filling this form alone doesn't
        let anyone in.
    </p>

    @if (_view is null)
    {
        <p class="muted">Loading...</p>
    }
    else
    {
        <form method="post" action="/site-admin/settings/entra/save" class="admin-form" id="settings-entra-form">
            <AntiforgeryToken />
            <div class="form-row">
                <label>
                    Application (client) ID
                    <input type="text" name="EntraClientId" value="@_view.ClientId" maxlength="36"
                           placeholder="e.g. 00000000-0000-0000-0000-000000000000" autocomplete="off" />
                    <small class="muted">
                        From the app registration's Overview page in the Microsoft
                        Entra admin center. Clearing it turns Microsoft sign-in off
                        deployment-wide and removes the stored secret.
                    </small>
                </label>
            </div>
            <div class="form-row">
                <label>
                    New client secret
                    <input type="password" name="EntraClientSecret" value="" autocomplete="new-password"
                           placeholder="@(_view.HasClientSecret ? "(leave blank to keep current)" : "paste the secret value")" />
                    <small class="muted">
                        Stored encrypted. Client secrets expire - note the expiry
                        date in the Entra admin center and paste a new one here
                        before it lapses.
                    </small>
                </label>
                <label class="checkbox-label">
                    <input type="checkbox" name="ClearEntraClientSecret" value="true" />
                    Clear stored secret
                </label>
            </div>
        </form>
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "msg")] public string? Message { get; set; }
    [SupplyParameterFromQuery(Name = "ok")] public string? Ok { get; set; }

    private EntraAppView? _view;

    protected override async Task OnInitializedAsync()
    {
        _view = await Settings.GetEntraAppViewAsync();
    }
}
