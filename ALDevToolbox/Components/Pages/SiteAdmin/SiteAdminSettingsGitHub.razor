@page "/site-admin/settings/github"
@attribute [Authorize(Roles = HttpOrganizationContext.SiteAdminRole)]
@rendermode InteractiveServer
@using ALDevToolbox.Components.Shared
@using ALDevToolbox.Services
@inject SystemSettingsService Settings
@inject NavigationManager Nav
@inject ALDevToolbox.Endpoints.PublicOrigin Origin
@inject ILogger<SiteAdminSettingsGitHub> Log

@*
    The deployment-wide GitHub App registration. Interactive because the removal
    control is a real ConfirmDialog rather than a browser confirm() hung off the
    form - the values on this page cannot be recovered from GitHub once lost, so
    the destructive gesture has to be explicit and its own control. The settings
    form itself is still a plain post to a minimal API endpoint, as on every
    sibling tab. See .design/github-integration.md.
*@

<PageTitle>GitHub · Site administration · AL Dev Toolbox</PageTitle>

<SiteAdminSettingsPage ActiveTab="SiteAdminSettingsPage.Tab.GitHub">
    <Alerts>
        <SettingsBanner Message="@Message" Ok="@Ok" SavedText="GitHub settings saved.">
            @if (!string.IsNullOrEmpty(Message))
            {
                @* The form posts and redirects, so a rejected save comes back with
                   empty fields. For a password that is a shrug; the private key
                   can only be downloaded from GitHub once, so say plainly that it
                   has to be pasted again rather than letting someone assume it
                   survived. *@
                <p class="alert alert--warn" role="status">
                    <Icon Name="triangle-alert" Width="16" Height="16" />
                    <span>Nothing was saved. If you had pasted the private key, paste it again before saving.</span>
                </p>
            }
            @if (Ok == "removed")
            {
                <p class="alert alert--success" role="status">
                    <Icon Name="circle-check" Width="16" Height="16" />
                    <span>Removed. No organisation on this site can use GitHub until an app is set up again.</span>
                </p>
            }
        </SettingsBanner>
    </Alerts>
    <Body>
        @if (_view is null)
        {
            <div class="loading-block"><span class="spinner"></span><span>Loading...</span></div>
        }
        else
        {
            <div class="card__body">
                <div class="steps steps--wide">
                    <div class="step @(IsConfigured ? "is-done" : "step--current")">
                        <span class="step__n">
                            @if (IsConfigured)
                            {
                                <Icon Name="check" Width="15" Height="15" />
                            }
                            else
                            {
                                <text>1</text>
                            }
                        </span>
                        <span class="step__head"><span class="step__title">Register the app on GitHub</span></span>
                        <span class="step__text">
                            Sign in to GitHub as yourself and create a new app. It is under
                            Settings, then Developer settings, then GitHub Apps. Any name will
                            do - your customers will see it when they install it.
                        </span>
                        <span class="step__body">
                            <span class="u-row">
                                <a class="btn" href="https://github.com/settings/apps/new" target="_blank" rel="noopener">
                                    <Icon Name="external-link" Width="16" Height="16" />
                                    <span>Create the app on GitHub</span>
                                </a>
                            </span>
                        </span>
                    </div>

                    <div class="step">
                        <span class="step__n">2</span>
                        <span class="step__head"><span class="step__title">Give it the three web addresses below</span></span>
                        <span class="step__text">
                            Copy the Setup URL, the Callback URL and the Webhook URL from the
                            first three fields below into the app's own boxes of the same
                            names. The first is where GitHub sends an admin back to after they
                            install the app, the second is where it sends anyone who connects
                            their own GitHub account, and the third is where it tells the
                            toolbox that a pull request has changed. Make up a webhook secret
                            of your own, paste the same text into GitHub's Webhook secret box
                            and into the Webhook secret field below. Tick "Active" beside the
                            webhook on GitHub.
                        </span>
                    </div>

                    <div class="step">
                        <span class="step__n">3</span>
                        <span class="step__head"><span class="step__title">Let it be installed on any account</span></span>
                        <span class="step__text">
                            Choose "Any account" where GitHub asks where the app can be
                            installed. Each customer installs it on their own GitHub
                            organisation, so limiting it to yours would lock everyone else out.
                        </span>
                    </div>

                    <div class="step">
                        <span class="step__n">4</span>
                        <span class="step__head"><span class="step__title">Tick the access it needs</span></span>
                        <span class="step__text">
                            Under Repository permissions and Organization permissions, allow the
                            app to: create new repositories (Administration), read and write
                            files in repositories (Contents), see repository names and
                            descriptions (Metadata), open and update pull requests (Pull
                            requests), report build results on pull requests (Checks), and see
                            who is in the organisation (Members). The name in brackets is what
                            GitHub calls the permission on its own page. Anything you leave out
                            simply turns off the part of the toolbox that needs it.
                        </span>
                    </div>

                    <div class="step">
                        <span class="step__n">5</span>
                        <span class="step__head"><span class="step__title">Subscribe it to pull requests</span></span>
                        <span class="step__text">
                            Further down the same page, under "Subscribe to events", tick
                            "Pull request". That is what lets the toolbox build a branch when
                            somebody opens a pull request and post the result back on it.
                            Leave it unticked and nothing else changes - the toolbox simply
                            never hears about pull requests.
                        </span>
                    </div>

                    <div class="step">
                        <span class="step__n">6</span>
                        <span class="step__head"><span class="step__title">Generate a private key, then fill in the form</span></span>
                        <span class="step__text">
                            At the bottom of the app's settings, generate a private key. GitHub
                            downloads the file there and then and will never show it again - if
                            you lose it, you generate a new one. Then copy the App ID, the app's
                            name, the Client ID and a new client secret into the fields below,
                            and the webhook secret you made up in step 2.
                            While you are there, tick "Expire user authorization tokens" - it is
                            on by default, and the toolbox renews them for people quietly.
                        </span>
                    </div>
                </div>
            </div>

            <form method="post" action="/site-admin/settings/github/save" id="settings-github-form">
                <AntiforgeryToken />
                <div class="setting-list">
                    <SettingRow Name="Setup URL"
                                Hint="On GitHub, put this in the app's Setup URL box before you save here. Without it, GitHub has nowhere to send an admin back to after they install the app.">
                        <input class="input input--ro" type="text" value="@SetupUrl" readonly
                               aria-label="Setup URL to copy into GitHub" />
                    </SettingRow>

                    <SettingRow Name="Callback URL"
                                Hint="On GitHub, put this in the app's Callback URL box. It is where someone lands after connecting their own GitHub account, and without it nobody on this site can do that.">
                        <input class="input input--ro" type="text" value="@CallbackUrl" readonly
                               aria-label="Callback URL to copy into GitHub" />
                    </SettingRow>

                    <SettingRow Name="Webhook URL"
                                Hint="On GitHub, put this in the app's Webhook URL box and tick Active. It is how GitHub tells the toolbox a pull request has changed, so it can build the branch and report back.">
                        <input class="input input--ro" type="text" value="@WebhookUrl" readonly
                               aria-label="Webhook URL to copy into GitHub" />
                        @if (!Origin.IsConfigured)
                        {
                            <small class="field__hint">
                                This is a guess from the address you're using right now. GitHub reaches it
                                from the internet, so if the toolbox sits behind a reverse proxy, set the
                                public https address instead.
                            </small>
                        }
                    </SettingRow>

                    @* required + pattern mirror SaveGitHubAppAsync's own rules, from
                       the same constants, so the browser catches the obvious cases
                       and the two can't drift. *@
                    <SettingRow Name="App ID"
                                Hint="A number, shown near the top of the app's own settings page on GitHub.">
                        <input class="input" type="text" name="GitHubAppId" value="@_view.AppId"
                               inputmode="numeric" maxlength="19" autocomplete="off" required
                               pattern="@SystemSettingsService.GitHubAppIdPattern"
                               placeholder="e.g. 123456" />
                    </SettingRow>

                    <SettingRow Name="App name in its URL"
                                Hint="The last part of the app's address on GitHub - for github.com/apps/al-dev-toolbox, enter al-dev-toolbox. This is what sends an admin to the right install page.">
                        <input class="input" type="text" name="GitHubAppSlug" value="@_view.AppSlug"
                               maxlength="120" autocomplete="off" required
                               pattern="@SystemSettingsService.GitHubAppSlugPattern"
                               placeholder="e.g. al-dev-toolbox" />
                    </SettingRow>

                    <SettingRow Name="Private key"
                                Hint="Stored encrypted. Open the .pem file GitHub gave you and paste all of it, including the first and last lines. Leave blank to keep the one already saved.">
                        <textarea class="textarea textarea--code" name="GitHubPrivateKey" rows="6"
                                  spellcheck="false" autocomplete="off"
                                  placeholder="@(_view.HasPrivateKey ? "Unchanged" : "-----BEGIN RSA PRIVATE KEY-----")"></textarea>
                        @if (_view.HasPrivateKey)
                        {
                            <label class="check">
                                <input type="checkbox" name="ClearGitHubPrivateKey" value="true" />
                                <span class="check__box"><Icon Name="check" Width="12" Height="12" /></span>
                                <span>Forget the saved private key</span>
                            </label>
                        }
                    </SettingRow>

                    <SettingRow Name="Client ID"
                                Hint="Also on the app's settings page, under Client ID. Without it, nobody on this site can connect their own GitHub account - and connecting a GitHub organisation needs that too.">
                        <input class="input" type="text" name="GitHubClientId" value="@_view.ClientId"
                               maxlength="120" autocomplete="off"
                               placeholder="e.g. Iv1.0123456789abcdef" />
                    </SettingRow>

                    <SettingRow Name="Client secret"
                                Hint="Stored encrypted, and needed alongside the Client ID. Generate one on the app's settings page - GitHub shows it only once. Leave blank to keep the one already saved.">
                        <input class="input" type="password" name="GitHubClientSecret" value=""
                               autocomplete="new-password"
                               placeholder="@(_view.HasClientSecret ? "Unchanged" : "Not set")" />
                        @if (_view.HasClientSecret)
                        {
                            <label class="check">
                                <input type="checkbox" name="ClearGitHubClientSecret" value="true" />
                                <span class="check__box"><Icon Name="check" Width="12" Height="12" /></span>
                                <span>Forget the saved secret</span>
                            </label>
                        }
                    </SettingRow>

                    <SettingRow Name="Webhook secret"
                                Hint="Stored encrypted. Make one up, and paste the same text into the app's Webhook secret box on GitHub. It is how the toolbox knows a message really came from GitHub - without it, nothing GitHub sends is accepted. Leave blank to keep the one already saved.">
                        <input class="input" type="password" name="GitHubWebhookSecret" value=""
                               autocomplete="new-password"
                               placeholder="@(_view.HasWebhookSecret ? "Unchanged" : "Not set")" />
                        @if (_view.HasWebhookSecret)
                        {
                            <label class="check">
                                <input type="checkbox" name="ClearGitHubWebhookSecret" value="true" />
                                <span class="check__box"><Icon Name="check" Width="12" Height="12" /></span>
                                <span>Forget the saved webhook secret</span>
                            </label>
                        }
                    </SettingRow>
                </div>
            </form>

            @if (IsConfigured || _view.AppId is not null)
            {
                <div class="setting-list">
                    <SettingRow Name="Remove the GitHub app" Danger="true"
                                Lock="Asks for confirmation and is written to the audit log"
                                Hint="Forgets the App ID, the app's name, the private key, the client secret and the webhook secret. Every organisation on this site loses GitHub until an app is set up again. Nothing on GitHub is deleted.">
                        <div class="u-row">
                            <button type="button" class="btn btn--danger" @onclick="RemoveAsync" disabled="@_removing">
                                <Icon Name="circle-minus" Width="16" Height="16" />
                                <span>@(_removing ? "Removing..." : "Remove")</span>
                            </button>
                        </div>
                    </SettingRow>
                </div>
            }
        }
    </Body>
    <Foot>
        @if (_view is not null)
        {
            <button type="submit" form="settings-github-form" class="btn btn--primary">
                <Icon Name="save" Width="16" Height="16" />
                <span>Save changes</span>
            </button>
        }
    </Foot>
    <Aside>
        <SettingsAside UpdatedAt="@_updatedAt">
            @if (_view is not null)
            {
                @* IsConfigured rather than a local: the unstyled-markup check
                   reads a bare identifier inside class="" as a CSS class name,
                   and a lowercase local would be reported as an undefined one. *@
                <p class="alert @(IsConfigured ? "alert--success" : "alert--info")" role="status">
                    <Icon Name="@(IsConfigured ? "circle-check" : "info")" Width="16" Height="16" />
                    <span>
                        @(IsConfigured
                            ? "Set up. Organisations can now connect their own GitHub organisation."
                            : "Not set up yet. Follow the steps above, then fill in the form - organisations can connect once the App ID, the app's name and the private key are saved.")
                    </span>
                </p>
            }
            <p class="alert alert--info">
                <Icon Name="info" Width="16" Height="16" />
                <span>
                    One GitHub app, shared by every organisation on this site. Filling
                    it in gives nobody access on its own: each organisation still picks
                    its own GitHub organisation, and chooses what the app may do there,
                    from its Administration &#8594; Repositories page.
                </span>
            </p>
        </SettingsAside>
    </Aside>
</SiteAdminSettingsPage>

<ConfirmDialog @ref="_confirmRemove"
               Title="Remove the GitHub app?"
               Message="Every organisation on this site loses GitHub until an app is set up again. The private key and client secret are forgotten and cannot be recovered - GitHub only shows each of them once, so you would generate new ones."
               ConfirmLabel="Remove"
               ConfirmButtonClass="btn--danger" ConfirmIcon="circle-minus" />

@code {
    [SupplyParameterFromQuery(Name = "msg")] public string? Message { get; set; }
    [SupplyParameterFromQuery(Name = "ok")] public string? Ok { get; set; }

    private GitHubAppView? _view;
    private DateTime? _updatedAt;
    private bool _removing;
    private ConfirmDialog? _confirmRemove;

    private bool IsConfigured => _view?.IsConfigured ?? false;

    private string SetupUrl => Nav.BaseUri.TrimEnd('/') + Endpoints.GitHubAppEndpoints.SetupCallbackPath;

    /// <summary>
    /// Where GitHub returns someone who has just connected their own account.
    /// The handshake sends no redirect_uri of its own, so this is the single
    /// place the address is written down - which is why it is read-only here
    /// and copied to GitHub rather than typed into both.
    /// </summary>
    private string CallbackUrl => Nav.BaseUri.TrimEnd('/') + Endpoints.GitHubAppEndpoints.LinkCallbackPath;

    /// <summary>
    /// Where GitHub posts a pull-request event. Unlike the other two this is read
    /// from the deployment's configured public address when there is one: GitHub
    /// reaches it from the internet rather than from the operator's own browser,
    /// so the host this page happens to be open on can be the wrong answer behind
    /// a reverse proxy. With nothing configured the request host is still the best
    /// guess we have, which is what the other two addresses use.
    /// </summary>
    private string WebhookUrl =>
        (Origin.Configured ?? Nav.BaseUri.TrimEnd('/')) + Endpoints.GitHubWebhookEndpoints.WebhookPath;

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task ReloadAsync()
    {
        _view = await Settings.GetGitHubAppViewAsync();
        // GitHub lives on the same system_settings singleton as the rest of the
        // family, so that row's timestamp is this tab's "last saved" too.
        _updatedAt = (await Settings.GetViewAsync()).UpdatedAt;
    }

    /// <summary>
    /// Clears the whole registration. Saving a null app id is what wipes the
    /// slug, client id and both secrets with it (see
    /// <see cref="SystemSettingsService.SaveGitHubAppAsync"/>), which is why the
    /// form's own App ID field is <c>required</c>: removing is this control's
    /// job, not an empty text box's.
    /// </summary>
    private async Task RemoveAsync()
    {
        if (_removing || _confirmRemove is null) return;
        if (!await _confirmRemove.OpenAsync()) return;

        _removing = true;
        try
        {
            await Settings.SaveGitHubAppAsync(new GitHubAppInput(
                AppId: null, AppSlug: null, ClientId: null,
                ClientSecret: null, ClearClientSecret: true,
                PrivateKeyPem: null, ClearPrivateKey: true,
                WebhookSecret: null, ClearWebhookSecret: true));
            Nav.NavigateTo("/site-admin/settings/github?ok=removed", forceLoad: true);
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "Failed to remove the deployment-wide GitHub App registration.");
            Nav.NavigateTo("/site-admin/settings/github?msg="
                + Uri.EscapeDataString("That did not work. Nothing was removed."), forceLoad: true);
        }
        finally
        {
            _removing = false;
        }
    }
}
