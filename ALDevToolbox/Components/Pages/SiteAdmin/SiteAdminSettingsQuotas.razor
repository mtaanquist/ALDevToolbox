@page "/site-admin/settings/quotas"
@attribute [Authorize(Roles = HttpOrganizationContext.SiteAdminRole)]
@using ALDevToolbox.Components.Shared
@using ALDevToolbox.Services
@using ALDevToolbox.Services.SingleTenant
@using ALDevToolbox.Services.Operations
@inject SystemSettingsService Settings
@inject ISingleTenantMode SingleTenant
@inject NavigationManager Nav

<PageTitle>Storage quotas · Site administration · AL Dev Toolbox</PageTitle>

<SiteAdminSettingsPage ActiveTab="SiteAdminSettingsPage.Tab.Quotas">
    <Alerts>
        <SettingsBanner Message="@Message" Ok="@Ok" SavedText="Storage quotas saved." />
    </Alerts>
    <Body>
        @if (_view is null)
        {
            <div class="loading-block"><span class="spinner"></span><span>Loading...</span></div>
        }
        else
        {
            <form method="post" action="/site-admin/settings/quotas/save" id="settings-quotas-form">
                <AntiforgeryToken />
                <div class="setting-list">
                    <SettingRow Name="Default storage limit">
                        <HintContent>
                            Used by any organisation without its own limit set on the
                            <a href="/site-admin/backup-storage/storage">Storage</a> page.
                            Leave blank for no limit.
                        </HintContent>
                        <ChildContent>
                            <span class="u-row">
                                <input class="input input--num" type="number" name="DefaultStorageQuotaMb"
                                       min="0" step="1" style="width: 120px" aria-label="Default storage limit in MB"
                                       value="@(_view.DefaultStorageQuotaMb?.ToString() ?? string.Empty)"
                                       placeholder="No limit" />
                                <span class="form-actions__note">MB per organisation</span>
                            </span>
                        </ChildContent>
                    </SettingRow>

                    <SettingRow Name="Charge for search data"
                                Hint="Indexes are the extra space the database uses to keep an organisation's data fast to search. 1 counts all of it against their limit, 0 counts none. If you are not sure, leave it at 1.">
                        <span class="u-row">
                            <input class="input input--num" type="number" name="IndexSizeMultiplier"
                                   min="0" max="10" step="0.1" style="width: 92px" aria-label="Index multiplier"
                                   value="@_view.IndexSizeMultiplier.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)" />
                            <span class="form-actions__note">&times; the search data</span>
                        </span>
                    </SettingRow>
                </div>
            </form>
        }
    </Body>
    <Foot>
        @if (_view is not null)
        {
            <button type="submit" form="settings-quotas-form" class="btn btn--primary">
                <Icon Name="save" Width="16" Height="16" />
                <span>Save changes</span>
            </button>
        }
    </Foot>
    <Aside>
        <SettingsAside UpdatedAt="@_view?.UpdatedAt" />
    </Aside>
</SiteAdminSettingsPage>

@code {
    [SupplyParameterFromQuery(Name = "msg")] public string? Message { get; set; }
    [SupplyParameterFromQuery(Name = "ok")] public string? Ok { get; set; }

    private SystemSettingsView? _view;

    protected override async Task OnInitializedAsync()
    {
        // Storage quotas are a multi-tenant surface - hidden in single-tenant
        // deployments. Bounce a typed URL back to the first settings tab.
        if (SingleTenant.IsEnabled)
        {
            Nav.NavigateTo("/site-admin/settings/smtp", replace: true);
            return;
        }
        _view = await Settings.GetViewAsync();
    }
}
