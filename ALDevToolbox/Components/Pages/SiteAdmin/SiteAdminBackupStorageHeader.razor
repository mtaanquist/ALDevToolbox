@*
    The /site-admin/backup-storage/* family: the whole-site backup, the
    per-organisation snapshots, and how much space each organisation may use.

    Kept its name from when it rendered only a <header>; every page in the
    family references it, and what it renders now is the page.
*@

@using ALDevToolbox.Components.Shared
@using ALDevToolbox.Services.SingleTenant
@inject ISingleTenantMode SingleTenant

<TabbedPage Title="Backup &amp; storage"
            CrumbLabel="Site administration" CrumbHref="/site-admin"
            Tabs="@_tabs" TabsLabel="Backup and storage sections"
            Actions="@Actions">
    <Sub>Copies of everything on this site, and how much space each organisation may use.</Sub>
    <ChildContent>@ChildContent</ChildContent>
</TabbedPage>

@code {
    public enum Tab { Database, Snapshots, Storage }

    [Parameter, EditorRequired] public Tab ActiveTab { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private IReadOnlyList<HeaderTabs.HeaderTabItem> _tabs = Array.Empty<HeaderTabs.HeaderTabItem>();

    protected override void OnParametersSet()
    {
        // Single-tenant deployments keep only the whole-site backup; snapshots
        // and quotas are per-organisation surfaces with nothing to show.
        // See Services/SingleTenant/ISingleTenantMode.cs.
        var tabs = new List<HeaderTabs.HeaderTabItem>
        {
            new("Whole site", "/site-admin/backup-storage/database", ActiveTab == Tab.Database),
        };
        if (!SingleTenant.IsEnabled)
        {
            tabs.Add(new("Per organisation", "/site-admin/backup-storage/snapshots", ActiveTab == Tab.Snapshots));
            tabs.Add(new("Space used",       "/site-admin/backup-storage/storage",   ActiveTab == Tab.Storage));
        }
        _tabs = tabs;
    }
}
