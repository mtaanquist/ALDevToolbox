@using ALDevToolbox.Domain.Tools
@using ALDevToolbox.Endpoints
@using ALDevToolbox.Services
@using ALDevToolbox.Services.SingleTenant
@using ALDevToolbox.Services.Tools
@inject IOrganizationContext OrgContext
@inject IToolAvailability ToolAvailability
@inject ISingleTenantMode SingleTenant
@inject IServiceScopeFactory Scopes
@inject IHttpContextAccessor Http
@inject NavigationManager Nav

@*
    Sidebar navigation. The Admin section is a single merged list - when the
    signed-in user is a SiteAdmin, the cross-org tools (Audit, Backups,
    Settings, cross-org Users) live alongside the per-org tools rather than
    in their own section. In the singleton system org we hide the per-org
    pages that don't apply (Configuration, per-org Users, per-org Backup),
    and SiteAdmin's Audit always replaces the per-org one.

    On the design system's shell.css. MainLayout owns the <nav class="app__nav">
    landmark; this file renders its two children — the scrolling list and the
    pinned foot. `.nav-group` is the grid, so `.nav-item`s are its direct
    children: the old <ul>/<li> scaffolding sat between them and both the row
    gap and the active keyline landed on the wrong box.

    Expandable groups render permanently `.is-open` and without the
    `.nav-item__caret` — see the divergence note in .design/design-migration.md.
*@

<div class="app__nav-scroll">
    @* Home stands alone. A --plain group has no header, so it is fenced off with
       a rule instead of looking like a group whose label went missing. *@
    <div class="nav-group nav-group--plain">
        <NavLink class="nav-item" href="/" Match="NavLinkMatch.All" ActiveClass="is-active">
            <Icon Name="house" Width="17" Height="17" Css="nav-item__icon" />
            <span class="nav-item__label">Home</span>
        </NavLink>
    </div>

    @* Each tool can be switched off site-wide (a SiteAdmin, via the in-memory
       IToolAvailability singleton) or per-org (an org admin, via the
       org_disabled_tools cookie claim). Hidden here and 404'd at the route by
       ToolAccessGate. Neither check touches the DB during render. See
       Domain/Tools/ToolCatalog.cs.

       The groups and their order come from the design system's sidebar section,
       which mirrors the Home launcher's own categories so the two surfaces name
       the same things the same way. A group renders only if it has something in
       it — every tool here can be switched off, and an empty labelled group is
       worse than no group. *@
    @{
        var buildOn = ToolVisible(ToolKey.Templates) || ToolVisible(ToolKey.Cookbook)
            || ToolVisible(ToolKey.ObjectExplorer);
        var textOn = ToolVisible(ToolKey.Translator) || ToolVisible(ToolKey.Compare)
            || ToolVisible(ToolKey.Piper);
        var deliverOn = ToolVisible(ToolKey.Projects) || ToolVisible(ToolKey.Pipelines)
            || ToolVisible(ToolKey.Releases) || _canUseEnvironmentOps || _isAuthenticated;
        var assistantOn = _isAuthenticated && ToolVisible(ToolKey.Mcp);
    }

    @if (buildOn)
    {
        <div class="@GroupClass(BuildGroup)" data-group="@BuildGroup">
            <NavGroupHead Key="@BuildGroup" Label="Build" Collapsed="@IsCollapsed(BuildGroup)" />
            <div class="nav-group__items">
                @if (ToolVisible(ToolKey.Templates))
                {
                    <div class="nav-parent is-open">
                        <NavLink class="nav-item" href="/templates" Match="NavLinkMatch.Prefix" ActiveClass="is-active">
                            <Icon Name="folder-plus" Width="17" Height="17" Css="nav-item__icon" />
                            <span class="nav-item__label">Templates</span>
                        </NavLink>
                        <div class="nav-sub">
                            <NavLink class="nav-item" href="/templates/workspace" Match="NavLinkMatch.All" ActiveClass="is-active">
                                <span class="nav-item__label">Workspace</span>
                            </NavLink>
                            <NavLink class="nav-item" href="/templates/extension" Match="NavLinkMatch.All" ActiveClass="is-active">
                                <span class="nav-item__label">Extension</span>
                            </NavLink>
                        </div>
                    </div>
                }
                @if (ToolVisible(ToolKey.Cookbook))
                {
                    <NavLink class="nav-item" href="/cookbook" Match="NavLinkMatch.Prefix" ActiveClass="is-active">
                        <Icon Name="square-code" Width="17" Height="17" Css="nav-item__icon" />
                        <span class="nav-item__label">Cookbook</span>
                    </NavLink>
                }
                @if (ToolVisible(ToolKey.ObjectExplorer))
                {
                    <NavLink class="nav-item" href="/object-explorer" Match="NavLinkMatch.Prefix" ActiveClass="is-active">
                        <Icon Name="package" Width="17" Height="17" Css="nav-item__icon" />
                        <span class="nav-item__label">Object Explorer</span>
                    </NavLink>
                }
            </div>
        </div>
    }

    @if (textOn)
    {
        <div class="@GroupClass(TextGroup)" data-group="@TextGroup">
            <NavGroupHead Key="@TextGroup" Label="Work with text" Collapsed="@IsCollapsed(TextGroup)" />
            <div class="nav-group__items">
                @if (ToolVisible(ToolKey.Translator))
                {
                    <NavLink class="nav-item" href="/translator" Match="NavLinkMatch.Prefix" ActiveClass="is-active">
                        <Icon Name="languages" Width="17" Height="17" Css="nav-item__icon" />
                        <span class="nav-item__label">Translator</span>
                    </NavLink>
                }
                @if (ToolVisible(ToolKey.Compare))
                {
                    <NavLink class="nav-item" href="/diff" Match="NavLinkMatch.All" ActiveClass="is-active">
                        <Icon Name="git-compare" Width="17" Height="17" Css="nav-item__icon" />
                        <span class="nav-item__label">Diff</span>
                    </NavLink>
                }
                @if (ToolVisible(ToolKey.Piper))
                {
                    <NavLink class="nav-item" href="/piper" Match="NavLinkMatch.All" ActiveClass="is-active">
                        <Icon Name="git-merge" Width="17" Height="17" Css="nav-item__icon" />
                        <span class="nav-item__label">Piper</span>
                    </NavLink>
                }
            </div>
        </div>
    }

    @if (deliverOn)
    {
        <div class="@GroupClass(DeliverGroup)" data-group="@DeliverGroup">
            <NavGroupHead Key="@DeliverGroup" Label="Deliver" Collapsed="@IsCollapsed(DeliverGroup)" />
            <div class="nav-group__items">
                @if (ToolVisible(ToolKey.Projects))
                {
                    <div class="nav-parent is-open">
                        <NavLink class="nav-item" href="/solutions" Match="NavLinkMatch.Prefix" ActiveClass="is-active">
                            <Icon Name="folder-git-2" Width="17" Height="17" Css="nav-item__icon" />
                            <span class="nav-item__label">Solutions</span>
                        </NavLink>
                        @* Upgrades is not a per-org tool toggle: it appears for the people
                           who may act on customers' Business Central update dates, and that
                           grant is a per-team flag deliberately kept out of the sign-in
                           claims - so the nav asks ProjectAccess in code. See
                           .design/saas-delivery.md and issue #657. *@
                        @if (_canUseEnvironmentOps)
                        {
                            <div class="nav-sub">
                                <NavLink class="nav-item" href="/upgrades" Match="NavLinkMatch.Prefix" ActiveClass="is-active">
                                    <span class="nav-item__label">Upgrades</span>
                                </NavLink>
                            </div>
                        }
                    </div>
                }
                else if (_canUseEnvironmentOps)
                {
                    @* Solutions is switched off but this person still schedules customers'
                       updates. Upgrades is its own grant and its own route, so it must not
                       disappear with the tool it normally nests under - it just stops being
                       a child, because a sub-item under nothing reads as a bug. *@
                    <NavLink class="nav-item" href="/upgrades" Match="NavLinkMatch.Prefix" ActiveClass="is-active">
                        <Icon Name="calendar" Width="17" Height="17" Css="nav-item__icon" />
                        <span class="nav-item__label">Upgrades</span>
                    </NavLink>
                }
                @* Teams is not a tool and has no per-org toggle: it is org plumbing every
                   signed-in person needs a way into. A team's manager is often a plain
                   User, who never sees Administration — without this entry /teams is
                   reachable only by typing the URL. See .design/teams-and-visibility.md. *@
                @if (_isAuthenticated)
                {
                    <NavLink class="nav-item" href="/teams" Match="NavLinkMatch.Prefix" ActiveClass="is-active">
                        <Icon Name="users" Width="17" Height="17" Css="nav-item__icon" />
                        <span class="nav-item__label">Teams</span>
                    </NavLink>
                }
                @if (ToolVisible(ToolKey.Pipelines))
                {
                    <NavLink class="nav-item" href="/pipelines" Match="NavLinkMatch.Prefix" ActiveClass="is-active">
                        <Icon Name="rocket" Width="17" Height="17" Css="nav-item__icon" />
                        <span class="nav-item__label">Pipelines</span>
                    </NavLink>
                }
                @if (ToolVisible(ToolKey.Releases))
                {
                    <NavLink class="nav-item" href="/releases" Match="NavLinkMatch.Prefix" ActiveClass="is-active">
                        <Icon Name="send" Width="17" Height="17" Css="nav-item__icon" />
                        <span class="nav-item__label">Releases</span>
                    </NavLink>
                }
            </div>
        </div>
    }

    @* MCP additionally requires a signed-in user — the toolbox's MCP page is
       meaningless to an anonymous visitor (e.g. on the NotFound page, which
       also renders this sidebar). *@
    @if (assistantOn)
    {
        <div class="@GroupClass(AssistantGroup)" data-group="@AssistantGroup">
            <NavGroupHead Key="@AssistantGroup" Label="Connect an assistant" Collapsed="@IsCollapsed(AssistantGroup)" />
            <div class="nav-group__items">
                <NavLink class="nav-item" href="/tools/mcp" Match="NavLinkMatch.Prefix" ActiveClass="is-active">
                    <Icon Name="bot" Width="17" Height="17" Css="nav-item__icon" />
                    <span class="nav-item__label">MCP</span>
                </NavLink>
            </div>
        </div>
    }

    <AuthorizeView Roles="Admin,Editor">
        <Authorized Context="adminCtx">
            @{
                var isSiteAdmin = adminCtx.User.IsInRole(HttpOrganizationContext.SiteAdminRole);
                var isSystemOrg = OrgContext.IsSystemOrganization;
                var isAdmin = adminCtx.User.IsInRole("Admin");
                // In single-tenant mode the lone org IS the system org, so it
                // owns its own templates and Administration - surface the
                // per-org content pages that are otherwise hidden there.
                var showPerOrgContent = !isSystemOrg || SingleTenant.IsEnabled;
            }
            <div class="@(GroupClass(AdminGroup) + " nav-group--fenced")" data-group="@AdminGroup">
                <NavGroupHead Key="@AdminGroup" Label="Admin" Collapsed="@IsCollapsed(AdminGroup)" />
                <div class="nav-group__items">
                @if (isAdmin)
                {
                    <NavLink class="nav-item" href="/admin" Match="NavLinkMatch.All" ActiveClass="is-active">
                        <Icon Name="layout-dashboard" Width="17" Height="17" Css="nav-item__icon" />
                        <span class="nav-item__label">Dashboard</span>
                    </NavLink>
                }
                @if (showPerOrgContent)
                {
                    <div class="nav-parent is-open">
                        <NavLink class="nav-item" href="/admin/templates" Match="NavLinkMatch.All" ActiveClass="is-active">
                            <Icon Name="layers" Width="17" Height="17" Css="nav-item__icon" />
                            <span class="nav-item__label">Templates</span>
                        </NavLink>
                        <div class="nav-sub">
                            <NavLink class="nav-item" href="/admin/templates/defaults" Match="NavLinkMatch.Prefix" ActiveClass="is-active">
                                <span class="nav-item__label">Defaults</span>
                            </NavLink>
                            <NavLink class="nav-item" href="/admin/templates/files" Match="NavLinkMatch.Prefix" ActiveClass="is-active">
                                <span class="nav-item__label">Always-included files</span>
                            </NavLink>
                            <NavLink class="nav-item" href="/admin/templates/workspace" Match="NavLinkMatch.Prefix" ActiveClass="is-active">
                                <span class="nav-item__label">Workspace settings</span>
                            </NavLink>
                        </div>
                    </div>
                }
                else
                {
                    @* System org still needs the templates browser, just
                       without the per-org template-shaping sub-pages. *@
                    <NavLink class="nav-item" href="/admin/templates" Match="NavLinkMatch.Prefix" ActiveClass="is-active">
                        <Icon Name="layers" Width="17" Height="17" Css="nav-item__icon" />
                        <span class="nav-item__label">Templates</span>
                    </NavLink>
                }
                <NavLink class="nav-item" href="/admin/modules" Match="NavLinkMatch.Prefix" ActiveClass="is-active">
                    <Icon Name="package" Width="17" Height="17" Css="nav-item__icon" />
                    <span class="nav-item__label">Modules</span>
                </NavLink>
                <NavLink class="nav-item" href="/admin/catalog" Match="NavLinkMatch.Prefix" ActiveClass="is-active">
                    <Icon Name="book-open" Width="17" Height="17" Css="nav-item__icon" />
                    <span class="nav-item__label">Catalogue</span>
                </NavLink>
                <NavLink class="nav-item" href="/admin/cookbook" Match="NavLinkMatch.Prefix" ActiveClass="is-active">
                    <Icon Name="square-code" Width="17" Height="17" Css="nav-item__icon" />
                    <span class="nav-item__label">Cookbook</span>
                </NavLink>
                <NavLink class="nav-item" href="/admin/application-versions" Match="NavLinkMatch.Prefix" ActiveClass="is-active">
                    <Icon Name="tag" Width="17" Height="17" Css="nav-item__icon" />
                    <span class="nav-item__label">App versions</span>
                </NavLink>
                <NavLink class="nav-item" href="/admin/object-explorer" Match="NavLinkMatch.Prefix" ActiveClass="is-active">
                    <Icon Name="file-code" Width="17" Height="17" Css="nav-item__icon" />
                    <span class="nav-item__label">Object Explorer</span>
                </NavLink>
                <NavLink class="nav-item" href="/admin/translation-memory" Match="NavLinkMatch.Prefix" ActiveClass="is-active">
                    <Icon Name="languages" Width="17" Height="17" Css="nav-item__icon" />
                    <span class="nav-item__label">Translation memory</span>
                </NavLink>

                @if (isAdmin && showPerOrgContent)
                {
                    <NavLink class="nav-item" href="/admin/administration" Match="NavLinkMatch.Prefix" ActiveClass="is-active">
                        <Icon Name="settings" Width="17" Height="17" Css="nav-item__icon" />
                        <span class="nav-item__label">Administration</span>
                    </NavLink>
                }
                @* Per-org Admin still owns its own audit-log entry for
                   non-SiteAdmins. SiteAdmins see the cross-org audit log
                   in their own section below; their org-scoped audit
                   link stays accessible by URL. Editors do not see the
                   audit log at all. *@
                @if (isAdmin && !isSiteAdmin)
                {
                    <NavLink class="nav-item" href="/admin/audit" Match="NavLinkMatch.Prefix" ActiveClass="is-active">
                        <Icon Name="history" Width="17" Height="17" Css="nav-item__icon" />
                        <span class="nav-item__label">Audit log</span>
                    </NavLink>
                }
                </div>
            </div>

            @if (isSiteAdmin)
            {
                @* Separate section so the user knows which links are
                   scoped to their org (Admin, above) and which span every
                   org (Site administration, here). Helps when one person
                   wears both hats. *@
                <div class="@GroupClass(SiteAdminGroup)" data-group="@SiteAdminGroup">
                    <NavGroupHead Key="@SiteAdminGroup" Label="Site administration" Collapsed="@IsCollapsed(SiteAdminGroup)" />
                    <div class="nav-group__items">
                    <NavLink class="nav-item" href="/site-admin/users" Match="NavLinkMatch.Prefix" ActiveClass="is-active">
                        <Icon Name="users-round" Width="17" Height="17" Css="nav-item__icon" />
                        <span class="nav-item__label">@(isSystemOrg ? "Users" : "All users")</span>
                    </NavLink>
                    <NavLink class="nav-item" href="/site-admin/audit" Match="NavLinkMatch.Prefix" ActiveClass="is-active">
                        <Icon Name="history" Width="17" Height="17" Css="nav-item__icon" />
                        <span class="nav-item__label">Audit log</span>
                    </NavLink>
                    <NavLink class="nav-item" href="/site-admin/backup-storage" Match="NavLinkMatch.Prefix" ActiveClass="is-active">
                        <Icon Name="database-backup" Width="17" Height="17" Css="nav-item__icon" />
                        <span class="nav-item__label">Backup &amp; storage</span>
                    </NavLink>
                    <NavLink class="nav-item" href="/site-admin/connections" Match="NavLinkMatch.Prefix" ActiveClass="is-active">
                        <Icon Name="plug" Width="17" Height="17" Css="nav-item__icon" />
                        <span class="nav-item__label">Connections</span>
                    </NavLink>
                    <NavLink class="nav-item" href="/site-admin/workers" Match="NavLinkMatch.Prefix" ActiveClass="is-active">
                        <Icon Name="monitor" Width="17" Height="17" Css="nav-item__icon" />
                        <span class="nav-item__label">Workers</span>
                    </NavLink>
                    <NavLink class="nav-item" href="/site-admin/settings" Match="NavLinkMatch.Prefix" ActiveClass="is-active">
                        <Icon Name="server-cog" Width="17" Height="17" Css="nav-item__icon" />
                        <span class="nav-item__label">Settings</span>
                    </NavLink>
                </div>
                </div>
            }
        </Authorized>
    </AuthorizeView>
</div>

@* Sidebar footer pinned to the bottom. Holds the capacity indicator
   (admins outside the system org only - system org isn't quota-checked,
   and StorageBar itself hides when no quota applies), the row of
   external links, and the copyright line, which is always visible.
   The GitHub mark is inlined here rather than going through
   <Icon> because Icon hard-wires Lucide's stroked-outline style and
   brand marks like the Octocat need a filled path. *@
<div class="app__nav-foot">
    <AuthorizeView Roles="Admin">
        <Authorized>
            @if (!OrgContext.IsSystemOrganization && !SingleTenant.IsEnabled)
            {
                <StorageBar />
            }
        </Authorized>
    </AuthorizeView>
    <div class="nav-links">
        <a class="nav-link-btn" href="https://github.com/mtaanquist/aldevtoolbox"
           target="_blank" rel="noopener noreferrer"
           aria-label="AL Dev Toolbox on GitHub" title="AL Dev Toolbox on GitHub">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16"
                 viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/>
            </svg>
        </a>
    </div>
    <div class="nav-copy">
        &copy; @DateTime.UtcNow.Year Mads Taanquist
        @* Only release builds carry a version stamp; dev and branch builds
           render the copyright alone rather than a link to a release this
           build isn't. See Services/BuildInfo. *@
        @if (BuildInfo.Current is { } build)
        {
            <a class="nav-version" href="@build.ReleaseUrl" title="@build.HoverTitle"
               target="_blank" rel="noopener noreferrer">Version @build.Version</a>
        }
    </div>
</div>

@code {
    // Auth state is cascaded by CascadingAuthenticationState; the org's
    // disabled-tools claim rides on the principal so reading it is free.
    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }

    private bool _isAuthenticated;
    private bool _canUseEnvironmentOps;
    private HashSet<ToolKey> _orgDisabled = new();

    // Stable keys for the collapsible groups. They are stored in the browser, so
    // renaming one silently expands that group for everyone who had collapsed it —
    // change the label above instead.
    private const string BuildGroup = "build";
    private const string TextGroup = "text";
    private const string DeliverGroup = "deliver";
    private const string AssistantGroup = "assistant";
    private const string AdminGroup = "admin";
    private const string SiteAdminGroup = "site-admin";

    /// <summary>Cookie the browser mirrors its collapsed-group list into. See wwwroot/nav-groups.js.</summary>
    private const string CollapsedCookie = "aldt-nav-collapsed";

    private HashSet<string> _collapsed = new(StringComparer.OrdinalIgnoreCase);

    protected override async Task OnParametersSetAsync()
    {
        if (AuthStateTask is null) return;
        var state = await AuthStateTask;
        _isAuthenticated = state.User.Identity?.IsAuthenticated == true;
        _orgDisabled = EndpointHelpers.ReadDisabledTools(state.User);
        _canUseEnvironmentOps = _isAuthenticated && await CanUseEnvironmentOpsAsync();
        _collapsed = ReadCollapsedGroups();
    }

    /// <summary>
    /// Which groups the browser last left collapsed. Read from the cookie the script
    /// mirrors localStorage into, so the very first response already carries
    /// <c>is-collapsed</c> — otherwise every group renders open and then snaps shut,
    /// and Blazor's enhanced-navigation diff strips the class again on each hop
    /// because the response never had it.
    /// </summary>
    private HashSet<string> ReadCollapsedGroups()
    {
        var set = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        var raw = Http.HttpContext?.Request.Cookies[CollapsedCookie];
        if (string.IsNullOrWhiteSpace(raw)) return set;

        foreach (var key in Uri.UnescapeDataString(raw).Split(',', StringSplitOptions.RemoveEmptyEntries))
        {
            set.Add(key.Trim());
        }
        return set;
    }

    private bool IsCollapsed(string key) => _collapsed.Contains(key);

    /// <summary>
    /// A group's classes. <c>has-active-page</c> is what keeps a collapsed group
    /// saying "you are in here" — the active item that normally carries the accent
    /// bar is hidden, so the header has to carry it instead.
    /// </summary>
    private string GroupClass(string key)
    {
        var classes = "nav-group";
        if (IsCollapsed(key)) classes += " is-collapsed";
        if (GroupHoldsCurrentPage(key)) classes += " has-active-page";
        return classes;
    }

    /// <summary>Whether the page being rendered lives under one of this group's routes.</summary>
    private bool GroupHoldsCurrentPage(string key)
    {
        var path = "/" + Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0].TrimEnd('/');
        var prefixes = key switch
        {
            BuildGroup => new[] { "/templates", "/cookbook", "/object-explorer" },
            TextGroup => new[] { "/translator", "/diff", "/piper" },
            DeliverGroup => new[] { "/solutions", "/upgrades", "/teams", "/pipelines", "/releases" },
            AssistantGroup => new[] { "/tools/mcp" },
            AdminGroup => new[] { "/admin" },
            SiteAdminGroup => new[] { "/site-admin" },
            _ => Array.Empty<string>(),
        };

        return prefixes.Any(p =>
            path.Equals(p, StringComparison.OrdinalIgnoreCase)
            || path.StartsWith(p + "/", StringComparison.OrdinalIgnoreCase));
    }

    /// <summary>
    /// Whether this person may run Business Central update actions anywhere — the one
    /// thing in the sidebar that isn't answerable from the sign-in claims, because the
    /// grant is a per-team flag that deliberately never enters them.
    ///
    /// <para>Read through a DI scope of its own, <em>not</em> the request's. The
    /// sidebar renders while the page's own <c>OnInitializedAsync</c> is mid-query, and
    /// both would otherwise be using the one scoped <c>AppDbContext</c> at the same
    /// moment — which is exactly the "a second operation was started on this context
    /// instance" that any query added to this component would cause. One extra
    /// membership read per page render, and no shared state with the page.</para>
    /// </summary>
    private async Task<bool> CanUseEnvironmentOpsAsync()
    {
        await using var scope = Scopes.CreateAsyncScope();
        var access = scope.ServiceProvider
            .GetRequiredService<ALDevToolbox.Services.ObjectExplorer.ProjectAccess>();
        return (await access.GetSnapshotAsync()).CanUseEnvironmentOps;
    }

    /// <summary>
    /// True when a tool should appear in the sidebar: enabled site-wide and not
    /// switched off for this org. Mirrors the gate in ToolAccessGate so the nav
    /// and the route stay in lock-step.
    /// </summary>
    private bool ToolVisible(ToolKey key) =>
        ToolAvailability.IsSiteEnabled(key) && !_orgDisabled.Contains(key);
}
