@using System.Text.Json
@using ALDevToolbox.Domain.ValueObjects

@*
    Renders a field-level diff between two audit-log snapshots. The diff itself
    is computed by .Domain.ValueObjects.AuditDiff so the rule lives in one tested
    place; this file is the rendering surface. Parameter-driven — give it
    BeforeJson / AfterJson and it works out the rest, including the redaction
    placeholders for SMTP and file-content fields.

    On the design system's .diff block, with one deliberate difference: the
    handoff's diff is line-level, with two line-number gutters. Ours is
    FIELD-level, because the inputs are JSON snapshots of a row and naming the
    field that changed beats pointing at a line number. The handoff's own
    example writes a changed line as `"idRangeFrom": 50000 -> 50100`, which is
    exactly the shape a field diff produces, so the rows read the same — they
    just have no gutters. See .design/design-migration.md.
*@

<div class="diff" aria-labelledby="@_titleId">
    <div class="diff__bar">
        <span class="diff__name" id="@_titleId">@Summary</span>
        @if (_diff.Count > 0)
        {
            <span class="diff__keys">
                <span class="diff__key diff__key--add"><span class="diff__chip"></span>added</span>
                <span class="diff__key diff__key--del"><span class="diff__chip"></span>removed</span>
                <span class="diff__key diff__key--chg"><span class="diff__chip"></span>changed</span>
            </span>
        }
    </div>

    @if (_parseError is not null)
    {
        <div class="diff__body">
            <span class="diff__ln diff__ln--del">
                <span class="diff__code">@_parseError</span>
            </span>
        </div>
    }
    else if (_diff.Count == 0)
    {
        <div class="diff__body">
            <span class="diff__ln"><span class="diff__code">No fields changed between these two snapshots.</span></span>
        </div>
    }
    else
    {
        <div class="diff__body">
            @foreach (var entry in _diff)
            {
                <span class="diff__ln diff__ln--@KindClass(entry.Kind)"
                      aria-label="@entry.Kind @entry.Path">
                    <span class="diff__code"><b>@entry.Path</b>: @CellText(entry)</span>
                </span>
            }
        </div>
    }
</div>

@code {
    /// <summary>JSON snapshot of the row's state *before* the change. Null / empty
    /// means "no prior state" (e.g. a Created audit row).</summary>
    [Parameter]
    public string? BeforeJson { get; set; }

    /// <summary>JSON snapshot of the row's state *after* the change. Null / empty
    /// means "no later state" (e.g. a Deleted audit row, or the most recent
    /// change with nothing after it yet).</summary>
    [Parameter]
    public string? AfterJson { get; set; }

    /// <summary>Optional override for the block's heading line.</summary>
    [Parameter]
    public string? Title { get; set; }

    /// <summary>Optional label for the before side (e.g. timestamp of the prior change).</summary>
    [Parameter]
    public string? BeforeLabel { get; set; }

    /// <summary>Optional label for the after side (e.g. timestamp of the next change).</summary>
    [Parameter]
    public string? AfterLabel { get; set; }

    private IReadOnlyList<AuditDiffEntry> _diff = Array.Empty<AuditDiffEntry>();
    private string? _parseError;
    private readonly string _titleId = $"audit-diff-title-{Guid.NewGuid():N}";

    protected override void OnParametersSet()
    {
        _parseError = null;
        try
        {
            _diff = AuditDiff.Compute(BeforeJson, AfterJson);
        }
        catch (JsonException ex)
        {
            _diff = Array.Empty<AuditDiffEntry>();
            _parseError = $"Couldn't parse one of the snapshots: {ex.Message}";
        }
    }

    /// <summary>
    /// The bar's line: a tally of what changed, plus the two snapshot labels
    /// when the caller supplied them. Mirrors the handoff's
    /// "template.settings.json - 3 changed, 2 added, 1 removed".
    /// </summary>
    private string Summary
    {
        get
        {
            if (!string.IsNullOrEmpty(Title)) return Title;
            if (_parseError is not null) return "Snapshot could not be read";

            var parts = new List<string>();
            var changed = _diff.Count(d => d.Kind == AuditDiffKind.Changed);
            var added = _diff.Count(d => d.Kind == AuditDiffKind.Added);
            var removed = _diff.Count(d => d.Kind == AuditDiffKind.Removed);
            if (changed > 0) parts.Add($"{changed} changed");
            if (added > 0) parts.Add($"{added} added");
            if (removed > 0) parts.Add($"{removed} removed");
            var tally = parts.Count == 0 ? "no changes" : string.Join(", ", parts);

            if (!string.IsNullOrEmpty(BeforeLabel) && !string.IsNullOrEmpty(AfterLabel))
            {
                return $"{BeforeLabel} → {AfterLabel} · {tally}";
            }
            return tally;
        }
    }

    private static string KindClass(AuditDiffKind kind) => kind switch
    {
        AuditDiffKind.Added => "add",
        AuditDiffKind.Removed => "del",
        _ => "chg",
    };

    /// <summary>
    /// The value side of a row. Changed fields read "before → after"; added and
    /// removed ones carry only the side that exists, since the other is the
    /// absence the +/- marker already states.
    /// </summary>
    private static string CellText(AuditDiffEntry entry) => entry.Kind switch
    {
        AuditDiffKind.Added => Display(entry.AfterDisplay, entry.AfterRedacted),
        AuditDiffKind.Removed => Display(entry.BeforeDisplay, entry.BeforeRedacted),
        _ => $"{Display(entry.BeforeDisplay, entry.BeforeRedacted)} → {Display(entry.AfterDisplay, entry.AfterRedacted)}",
    };

    private static string Display(string? value, bool redacted) =>
        redacted ? "<redacted>" : value ?? "<null>";
}
