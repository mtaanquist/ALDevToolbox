@using ALDevToolbox.Domain.ValueObjects

@*
    How close a Microsoft app-registration client secret is to lapsing.

    Shared by the two places a secret is edited - the site-wide registration on
    /site-admin/settings/entra and an organisation's own on
    /admin/administration/identity - so the phrasing of "expires in nine days"
    is decided once. The remediation half is the caller's, because the two
    pages have different people reading them: one can fix it, the other has to
    ask someone.

    Renders nothing when there is no date to talk about and the caller supplied
    no UnknownText, so it can be dropped into a page unconditionally.
*@

@if (_expiry.State != EntraSecretExpiryState.Unknown || !string.IsNullOrEmpty(UnknownText))
{
    @if (_expiry.State == EntraSecretExpiryState.Unknown)
    {
        <p class="alert alert--info" role="status">
            <Icon Name="calendar" Width="16" Height="16" />
            <span>@UnknownText</span>
        </p>
    }
    else if (_expiry.State != EntraSecretExpiryState.Ok || ShowWhenHealthy)
    {
        <p class="alert @AlertClass" role="@(_expiry.NeedsAttention ? "alert" : "status")">
            <Icon Name="@IconName" Width="16" Height="16" />
            <span>
                @Headline
                @if (_expiry.NeedsAttention && !string.IsNullOrEmpty(Advice))
                {
                    <text> @Advice</text>
                }
            </span>
        </p>
    }
}

@code {
    /// <summary>The recorded expiry date; null when nobody noted one.</summary>
    [Parameter, EditorRequired] public DateOnly? ExpiresAt { get; set; }

    /// <summary>
    /// Today, in UTC. Passed in rather than read here so the page keeps its
    /// one clock and the component stays a pure function of its parameters.
    /// </summary>
    [Parameter, EditorRequired] public DateOnly Today { get; set; }

    /// <summary>
    /// What the reader should do about it, appended once the secret is inside
    /// the warning window. Skipped while the date is comfortably far off.
    /// </summary>
    [Parameter] public string? Advice { get; set; }

    /// <summary>
    /// Shown in place of everything else when no date was recorded. Leave null
    /// to render nothing at all.
    /// </summary>
    [Parameter] public string? UnknownText { get; set; }

    /// <summary>
    /// Whether to confirm a date that is still far off. On by default: a page
    /// that says nothing leaves the reader unsure the date was saved.
    /// </summary>
    [Parameter] public bool ShowWhenHealthy { get; set; } = true;

    /// <summary>What the secret is called in the sentence, for pages that hold more than one.</summary>
    [Parameter] public string Subject { get; set; } = "The client secret";

    private EntraSecretExpiry _expiry = EntraSecretExpiry.Unknown;

    protected override void OnParametersSet() => _expiry = EntraSecretExpiry.From(ExpiresAt, Today);

    private string AlertClass => _expiry.State switch
    {
        EntraSecretExpiryState.Expired => "alert--danger",
        EntraSecretExpiryState.Expiring => "alert--warn",
        _ => "alert--success",
    };

    private string IconName => _expiry.State switch
    {
        EntraSecretExpiryState.Expired => "circle-alert",
        EntraSecretExpiryState.Expiring => "triangle-alert",
        _ => "circle-check",
    };

    private string Headline => _expiry.State switch
    {
        EntraSecretExpiryState.Expired =>
            $"{Subject} expired {Ago(-_expiry.DaysRemaining)}, on {OnDate}. People signing in with Microsoft are being turned away until it is replaced.",
        EntraSecretExpiryState.Expiring =>
            $"{Subject} expires {Ahead(_expiry.DaysRemaining)}, on {OnDate}.",
        _ => $"{Subject} expires on {OnDate}, in {_expiry.DaysRemaining} days.",
    };

    private string OnDate => ExpiresAt?.ToString("d MMMM yyyy") ?? string.Empty;

    private static string Ahead(int days) => days switch
    {
        0 => "today",
        1 => "tomorrow",
        _ => $"in {days} days",
    };

    private static string Ago(int days) => days == 1 ? "yesterday" : $"{days} days ago";
}
