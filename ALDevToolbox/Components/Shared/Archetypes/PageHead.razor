@*
    The page head every archetype opens with: crumbs, title, subtitle on the left,
    actions on the right. Mirrors .page-head in .design/handoff/ComponentsPanel.dc.html
    as the standard archetypes compose it (.design/handoff/PagesStandard.dc.html);
    the rules live in components.css, and .page-head--sticky in shell.css.

    The left-hand <div> is not decoration: .page-head is a space-between flex row,
    so without it the crumbs, title and subtitle become three columns.
*@

<header class="page-head@(Sticky ? " page-head--sticky" : "")">
    <div>
        <CrumbNav Trail="Trail" Crumbs="Crumbs" />
        <h1 class="page-head__title">@Title</h1>
        @if (SubtitleContent is not null)
        {
            <p class="page-head__sub">@SubtitleContent</p>
        }
        else if (!string.IsNullOrEmpty(Subtitle))
        {
            <p class="page-head__sub">@Subtitle</p>
        }
    </div>
    @if (Actions is not null && ShowActions)
    {
        <div class="page-head__actions">@Actions</div>
    }
</header>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;

    /// <summary>Plain-text subtitle. Use <see cref="SubtitleContent"/> when it needs markup.</summary>
    [Parameter] public string? Subtitle { get; set; }

    /// <summary>Subtitle with markup (a <c>code</c> span, a link). Wins over <see cref="Subtitle"/>.</summary>
    [Parameter] public RenderFragment? SubtitleContent { get; set; }

    /// <summary>The breadcrumb steps, the page itself last and unlinked.</summary>
    [Parameter] public IReadOnlyList<Crumb>? Trail { get; set; }

    /// <summary>The links and chevrons only; the component supplies the <c>nav</c>.</summary>
    [Parameter] public RenderFragment? Crumbs { get; set; }

    [Parameter] public RenderFragment? Actions { get; set; }

    /// <summary>
    /// Lets a page hide its actions for a state (a first-run empty state that carries the
    /// same button itself) without leaving an empty actions box in the row.
    /// </summary>
    [Parameter] public bool ShowActions { get; set; } = true;

    /// <summary>Pins the head to the top of the content column. One sticky element per page.</summary>
    [Parameter] public bool Sticky { get; set; }
}
