@*
    Archetype 1, the tool launcher: a hero greeting, then grouped tiles where the whole
    tile is the link. Mirrors .design/handoff/PageLauncher.dc.html (rules in pages.css).

    The groups arrive as data, not markup, so the page that owns them builds one list
    and cannot let the signed-in and signed-out renderings drift apart tile by tile.

    DIVERGENCE, kept from the page this was lifted out of: the handoff's locked tile is
    a <span role="link" aria-disabled> that cannot be followed. Ours is locked because
    the visitor is signed out, so it is a real link to the login page that returns to
    the tool - the most useful thing a locked tile can do.
*@

<div class="page">
    <div class="page__hero">
        <h1 class="page__hero-title">@Title</h1>
        <p class="page__hero-sub">@Subtitle</p>
    </div>

    @foreach (var group in Groups.Where(g => g.Tiles.Count > 0))
    {
        <p class="section-label">@group.Label</p>
        <div class="tool-grid">
            @foreach (var tile in group.Tiles)
            {
                <a class="tool-tile@(tile.Locked ? " tool-tile--locked" : "")" href="@HrefFor(tile)">
                    <span class="tool-tile__icon"><Icon Name="@tile.Icon" Width="19" Height="19" /></span>
                    @if (tile.Locked)
                    {
                        <span class="tool-tile__lock"><Icon Name="lock" Width="11" Height="11" /><span>Sign in</span></span>
                    }
                    <div class="tool-tile__body">
                        <div class="tool-tile__title">@tile.Title</div>
                        <div class="tool-tile__text">@tile.Text</div>
                        @if (!string.IsNullOrEmpty(tile.Meta))
                        {
                            <div class="tool-tile__meta">@tile.Meta</div>
                        }
                    </div>
                </a>
            }
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string Subtitle { get; set; } = string.Empty;

    /// <summary>In display order. Empty groups are skipped, so no heading is left over nothing.</summary>
    [Parameter, EditorRequired] public IReadOnlyList<LauncherGroup> Groups { get; set; } = Array.Empty<LauncherGroup>();

    private static string HrefFor(LauncherTile tile) =>
        tile.Locked ? "/login?returnUrl=" + Uri.EscapeDataString(tile.Href) : tile.Href;
}
