@*
    Underline tab row on the design system's .header-tabs / .header-tab.

    This is the *settings* archetype's section nav, and it is a different job
    from PillTabs: pills are a segmented control that sits inside a page and
    switches a view, header tabs sit under the page title and switch which
    sub-page you are on. The design system ships both; use this one for
    /site-admin/settings/* and /admin/administration/*.

    Each tab is a real <a href> - full navigation, not SPA-like - so the routes
    stay bookmarkable and the back button works. A tab with no Href renders as
    a disabled <button>, which is how the handoff shows a section that exists
    but is not available (its "Single sign-on" tab).
*@

<nav class="header-tabs" role="tablist" aria-label="@AriaLabel">
    @foreach (var item in Items)
    {
        @if (item.Href is null)
        {
            <button type="button" class="header-tab" role="tab" disabled
                    title="@item.DisabledReason">@item.Label</button>
        }
        else
        {
            <a class="header-tab @(item.IsActive ? "is-active" : "")" href="@item.Href"
               role="tab" aria-selected="@(item.IsActive ? "true" : "false")">@item.Label</a>
        }
    }
</nav>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<HeaderTabItem> Items { get; set; } = Array.Empty<HeaderTabItem>();
    [Parameter] public string AriaLabel { get; set; } = "Section";

    /// <param name="Href">Null renders the tab disabled.</param>
    public record HeaderTabItem(string Label, string? Href, bool IsActive, string? DisabledReason = null);
}
