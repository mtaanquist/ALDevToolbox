@*
    The design system's row-state glyph for a .data-table row.

    A table row never carries a status pill. Its state is shown three ways, none
    of them colour alone: a 4px keyline on the row's right edge (.data-table--edge
    plus `is-<state>` on the <tr>), a glyph in a LEADING .data-table__col-state
    cell, and the state word on aria-label + title. Per the handoff, the edge
    treatment is the default for every table in the toolbox.

    Pair the three parts — they only make sense together:

        <table class="data-table data-table--edge">
            <th class="data-table__col-state"><span class="u-sr">Status</span></th>
            ...
            <tr class="@RowStateIcon.RowClass(status)">
                <td class="data-table__col-state"><RowStateIcon State="@status" /></td>

    Row states come in families, and class, label and glyph always agree within
    one: object diffs, runs, lifecycle, XLIFF. Pills remain correct for cards,
    detail headers and inline text — anywhere status is one attribute among many.
*@

<span class="data-table__state data-table__state--icon@(Map(State).Spin ? " data-table__state--spin" : "")"
      role="img" aria-label="@(Label ?? Map(State).Label)" title="@(Label ?? Map(State).Label)">
    <Icon Name="@Map(State).Icon" Width="15" Height="15" />
</span>

@code {
    /// <summary>The raw state string, e.g. "failed", "running", "translated".</summary>
    [Parameter, EditorRequired] public string State { get; set; } = string.Empty;

    /// <summary>
    /// Overrides the accessible name. Use when the page has a better one than the
    /// state word itself — a worker's unhealthy Reason, for instance.
    /// </summary>
    [Parameter] public string? Label { get; set; }

    /// <summary>
    /// The `is-*` class for the owning &lt;tr&gt;, which colours the edge keyline.
    /// Kept beside the glyph mapping so the two can never disagree.
    /// </summary>
    public static string RowClass(string state) => "is-" + Map(state).Row;

    // The four families from the handoff. Every arm returns a row class that has
    // a matching --bar-* token in tokens.css, so the keyline always resolves.
    private static (string Row, string Icon, string Label, bool Spin) Map(string state) => state switch
    {
        // ---- runs ----
        "succeeded" or "completed" or "ready" or "deployed" or "healthy"
            => ("succeeded", "circle-check", Title(state), false),
        "failed" or "unhealthy"
            => ("failed", "circle-x", Title(state), false),
        "running" or "building" or "uploading" or "installing" or "claimed"
            => ("running", "refresh-cw", Title(state), true),
        "queued" or "scheduled" or "pending"
            => ("queued", "clock", Title(state), false),
        "cancelled" => ("cancelled", "x", Title(state), false),

        // ---- lifecycle ----
        "published" => ("published", "rocket", "Published", false),
        "active"     => ("published", "circle-check", "Active", false),
        "deprecated" => ("archived", "archive", "Deprecated", false),
        "draft"     => ("draft", "pencil", "Draft", false),
        "archived"  => ("archived", "archive", "Archived", false),
        // Soft-deleted. Archived's greyed keyline, but a glyph that says "in the
        // bin" rather than "filed away" — the admin lists show both at once and
        // the two must not read the same.
        "deleted"   => ("archived", "trash-2", "Deleted", false),
        // A consent or token that was withdrawn: archived's greyed keyline, but a
        // glyph that says "no longer allowed" rather than "filed away".
        "revoked"   => ("archived", "shield-off", "Revoked", false),
        // A token that simply ran out. Archived's greyed keyline, because it is
        // as dead as a revoked one - the fall-through would have given it the
        // "queued" keyline and a clock, which reads as *waiting to start*.
        "expired"   => ("archived", "clock", "Expired", false),
        // An account switched off. Same reasoning: the fall-through said
        // "waiting", and a disabled account is not waiting for anything.
        "disabled"  => ("archived", "circle-x", "Disabled", false),

        // ---- object diffs ----
        "new"       => ("new", "circle-plus", "New", false),
        "modified"  => ("modified", "pencil", "Modified", false),
        "unchanged" => ("unchanged", "minus", "Unchanged", false),

        // ---- XLIFF ----
        "untranslated" => ("untranslated", "circle", "Untranslated", false),
        "fuzzy"        => ("fuzzy", "circle-alert", "Needs review", false),
        "translated"   => ("translated", "check", "Translated", false),
        "final"        => ("final", "check-check", "Final", false),

        // An unrecognised state still gets a resolvable keyline and a readable
        // name rather than an invisible cell.
        _ => ("queued", "clock", Title(state), false),
    };

    private static string Title(string s) =>
        string.IsNullOrEmpty(s) ? "Unknown" : char.ToUpperInvariant(s[0]) + s[1..];
}
